                    <layout g="col" g-width="12" height="24">
                        <image src="/images/vigilia/corner.png" style="proportional" width="10" height="10" hitTest="false" align="right" margins="{top=-17,right=-17,bottom=31}" visible="false" name="t767"/>
                        <label text="Diário de sessões" fontSize="18" fontColor="#F1EDF5" fontFamily="Bitter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="left" width="205" margins="{right=12}" name="t768"/>
                    </layout>
                    <label text="Registre os acontecimentos da sessão, descobertas e decisões do grupo." fontSize="15" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" g="col" g-width="12" height="22" name="t769"/>
                    <recordList g="col" g-width="12" name="rclSessoes" field="sessoes" templateForm="frmDHSessao" autoHeight="true" height="10" layout="vertical">
                        <event name="onResize">invalidarGrade(self.rclSessoes)</event>
                    </recordList>
                    <layout g="col" g-width="12" height="30">
                        <rectangle strokeSize="0" color="#2B2D3D" height="30" cornerType="round" xradius="12" yradius="12" hitTest="true" cursor="handPoint" align="left" width="158" margins="{right=10}" name="t770">
                            <label text="Adicionar registro ＋" fontSize="12" fontColor="#C3A5EC" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="client" horzTextAlign="center" hitTest="false" name="t771"/>
                            <event name="onClick">self.rclSessoes:append()</event>
                        </rectangle>
                    </layout>
                </rectangle>
                <layout g="col" g-width="12" g-auto-height="true" g-cnt-gutter="20" g-cnt-line-spacing="20" g-gutter="0">
                    <rectangle strokeSize="1" color="#222533" g="col" g-width="12" strokeColor="#404254" cornerType="round" xradius="12" yradius="12" g-auto-height="true" g-cnt-gutter="12" g-cnt-line-spacing="16" padding="{left=18,right=18,top=24,bottom=24}" g-width-md="6" name="t772">
                        <layout g="col" g-width="12" height="24">
                            <image src="/images/vigilia/corner.png" style="proportional" width="10" height="10" hitTest="false" align="right" margins="{top=-17,right=-17,bottom=31}" visible="false" name="t773"/>
                            <label text="Pessoas e lugares" fontSize="18" fontColor="#F1EDF5" fontFamily="Bitter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="left" width="205" margins="{right=12}" name="t774"/>
                        </layout>
                        <label text="Nomes, locais e referências encontrados na campanha." fontSize="14" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="leading" g="col" g-width="12" height="40" wordWrap="true" name="t775"/>
                        <rectangle strokeSize="1" color="#2B2D3D" g="col" g-width="12" height="140" strokeColor="#404254" sides="bottom" padding="{left=10,right=10,top=8,bottom=8}" name="t776">
                            <textEditor align="client" field="anotacoes4" fontSize="14" fontColor="#F1EDF5" fontFamily="Inter" transparent="true" wordWrap="true" hint="" name="t777"/>
                        </rectangle>
                    </rectangle>
                    <rectangle strokeSize="1" color="#222533" g="col" g-width="12" strokeColor="#404254" cornerType="round" xradius="12" yradius="12" g-auto-height="true" g-cnt-gutter="12" g-cnt-line-spacing="16" padding="{left=18,right=18,top=24,bottom=24}" g-width-md="6" name="t778">
                        <layout g="col" g-width="12" height="24">
                            <image src="/images/vigilia/corner.png" style="proportional" width="10" height="10" hitTest="false" align="right" margins="{top=-17,right=-17,bottom=31}" visible="false" name="t779"/>
                            <label text="Pendências do grupo" fontSize="18" fontColor="#F1EDF5" fontFamily="Bitter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="left" width="228" margins="{right=12}" name="t780"/>
                        </layout>
                        <label text="Objetivos, perguntas em aberto e próximos passos da aventura." fontSize="14" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="leading" g="col" g-width="12" height="40" wordWrap="true" name="t781"/>
                        <rectangle strokeSize="1" color="#2B2D3D" g="col" g-width="12" height="140" strokeColor="#404254" sides="bottom" padding="{left=10,right=10,top=8,bottom=8}" name="t782">
                            <textEditor align="client" field="anotacoes5" fontSize="14" fontColor="#F1EDF5" fontFamily="Inter" transparent="true" wordWrap="true" hint="" name="t783"/>
                        </rectangle>
                    </rectangle>
                </layout>
            </layout>
            <rectangle strokeSize="1" color="#00000000" g="col" g-width="12" height="56" strokeColor="#404254" sides="top" padding="{left=32,right=32,top=0,bottom=0}" name="t784">
                <label text="◇   RRPG FIRECAST · Ficha Daggerheart v3.1.2" fontSize="11" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="right" width="320" horzTextAlign="trailing" margins="{bottom=20}" name="t785"/>
                <label text="DAGGERHEART  /  Vigília  /  Frente" fontSize="11" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" name="lblRodape" align="client" margins="{bottom=20}"/>
            </rectangle>
        </scrollBox>
        <popup name="popConfig" width="440" height="590" backOpacity="0.4" drawContainer="false">
            <rectangle strokeSize="1" color="#222533" align="client" strokeColor="#404254" cornerType="round" xradius="12" yradius="12" padding="{left=20,right=20,top=18,bottom=18}" name="t786">
                <label text="Aparência da ficha" fontSize="18" fontColor="#F1EDF5" fontFamily="Bitter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="26" name="t787"/>
                <label text="O tema fica salvo nesta ficha." fontSize="12" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="top" height="20" name="t788"/>
                <layout align="top" height="118" margins="{top=10}">
                    <rectangle strokeSize="2" color="#FFFCF5" align="left" width="176" name="optCodice" strokeColor="#D9CEBE" cornerType="round" xradius="2" yradius="2" margins="{right=12}" hitTest="true" cursor="handPoint" padding="{left=14,right=14,top=12,bottom=12}">
                        <layout align="top" height="18">
                            <rectangle strokeSize="0" color="#593B65" align="left" width="18" cornerType="round" xradius="4" yradius="4" margins="{right=6}"/>
                            <rectangle strokeSize="0" color="#96753E" align="left" width="18" cornerType="round" xradius="4" yradius="4" margins="{right=6}"/>
                            <rectangle strokeSize="1" color="#F4EFE4" align="left" width="18" strokeColor="#D9CEBE" cornerType="round" xradius="4" yradius="4"/>
                        </layout>
                        <label text="Códice" fontSize="17" fontColor="#302936" fontFamily="Bitter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="30" margins="{top=8}"/>
                        <label text="Claro, editorial — papel e tinta." fontSize="11" fontColor="#726878" fontFamily="Inter" textTrimming="none" vertTextAlign="leading" align="client" wordWrap="true"/>
                        <event name="onClick">sheet.temaFicha = "codice"</event>
                    </rectangle>
                    <rectangle strokeSize="2" color="#222533" align="left" width="176" name="optVigilia" strokeColor="#404254" cornerType="round" xradius="12" yradius="12" margins="{right=12}" hitTest="true" cursor="handPoint" padding="{left=14,right=14,top=12,bottom=12}">
                        <layout align="top" height="18">
                            <rectangle strokeSize="0" color="#C3A5EC" align="left" width="18" cornerType="round" xradius="4" yradius="4" margins="{right=6}"/>
                            <rectangle strokeSize="0" color="#CEAF73" align="left" width="18" cornerType="round" xradius="4" yradius="4" margins="{right=6}"/>
                            <rectangle strokeSize="1" color="#171923" align="left" width="18" strokeColor="#404254" cornerType="round" xradius="4" yradius="4"/>
                        </layout>
                        <label text="Vigília" fontSize="17" fontColor="#F1EDF5" fontFamily="Bitter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="30" margins="{top=8}"/>
                        <label text="Escuro, suave — para mesas noturnas." fontSize="11" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="leading" align="client" wordWrap="true"/>
                        <event name="onClick">sheet.temaFicha = "vigilia"</event>
                    </rectangle>
                </layout>
                <label text="Cores dos dados no chat" fontSize="14" fontColor="#F1EDF5" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="22" margins="{top=16}" name="t789"/>
                <layout align="top" height="30" margins="{top=8}">
                    <label text="Esperança" fontSize="13" fontColor="#F1EDF5" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="left" width="110" name="t790"/>
                    <rectangle strokeSize="0" color="#2B2D3D" height="30" cornerType="round" xradius="12" yradius="12" hitTest="true" cursor="handPoint" align="right" width="70" margins="{left=8}" name="t791">
                        <label text="Padrão" fontSize="12" fontColor="#C3A5EC" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="client" horzTextAlign="center" hitTest="false" name="t792"/>
                        <event name="onClick">sheet.corEsperanca = "#FFEA99"</event>
                    </rectangle>
                    <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=4,right=4,top=0,bottom=0}" align="right" width="92" margins="{left=8}" name="t793">
                        <edit name="edtHexEsperanca" transparent="true" fontSize="12" fontColor="#F1EDF5" horzTextAlign="center" textPrompt="#FFEA99" hint="Digite uma cor hex, ex.: #FF8800" align="client">
                            <event name="onChange">definirCorHex("corEsperanca", "Esperanca")</event>
                        </edit>
                    </rectangle>
                    <layout align="client">
                        <comboBox name="cmbEsperanca" align="client" visible="false" field="corEsperanca" items="{'Branco', 'Cinza claro', 'Cinza', 'Cinza escuro', 'Preto', 'Amarelo pálido', 'Amarelo', 'Ouro', 'Âmbar', 'Laranja', 'Coral', 'Vermelho', 'Carmesim', 'Vinho', 'Rosa choque', 'Rosa', 'Magenta', 'Roxo', 'Violeta', 'Índigo', 'Azul', 'Azul celeste', 'Ciano', 'Verde-azulado', 'Menta', 'Verde', 'Verde floresta', 'Lima', 'Marrom', 'Bronze'}" values="{'#FFFFFF', '#CCCCCC', '#999999', '#555555', '#000000', '#FFEA99', '#FFE600', '#FFD700', '#FFB300', '#FF9F1C', '#FF7F50', '#E63946', '#B00020', '#7A0019', '#FF3D9A', '#FF6FB5', '#E040FB', '#B23EFF', '#7B2CBF', '#4B3FD1', '#3A86FF', '#7CC8FF', '#00E5FF', '#1ABC9C', '#7DFFB3', '#2ECC71', '#1E8449', '#B5E61D', '#A0522D', '#CD7F32'}" fontSize="12">
                            <event name="onChange">self.cmbEsperanca.visible = false</event>
                        </comboBox>
                        <rectangle strokeSize="1" color="#FFEA99" name="swEsperanca" align="client" strokeColor="#404254" cornerType="round" xradius="4" yradius="4" hitTest="true" cursor="handPoint" hint="Clique para escolher uma cor pronta">
                            <event name="onMouseDown">self.cmbEsperanca.visible = true
self.cmbEsperanca:dropDown()</event>
                        </rectangle>
                    </layout>
                </layout>
                <layout align="top" height="30" margins="{top=8}">
                    <label text="Medo" fontSize="13" fontColor="#F1EDF5" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="left" width="110" name="t794"/>
                    <rectangle strokeSize="0" color="#2B2D3D" height="30" cornerType="round" xradius="12" yradius="12" hitTest="true" cursor="handPoint" align="right" width="70" margins="{left=8}" name="t795">
                        <label text="Padrão" fontSize="12" fontColor="#C3A5EC" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="client" horzTextAlign="center" hitTest="false" name="t796"/>
                        <event name="onClick">sheet.corMedo = "#B23EFF"</event>
                    </rectangle>
                    <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=4,right=4,top=0,bottom=0}" align="right" width="92" margins="{left=8}" name="t797">
                        <edit name="edtHexMedo" transparent="true" fontSize="12" fontColor="#F1EDF5" horzTextAlign="center" textPrompt="#B23EFF" hint="Digite uma cor hex, ex.: #FF8800" align="client">
                            <event name="onChange">definirCorHex("corMedo", "Medo")</event>
                        </edit>
                    </rectangle>
                    <layout align="client">
                        <comboBox name="cmbMedo" align="client" visible="false" field="corMedo" items="{'Branco', 'Cinza claro', 'Cinza', 'Cinza escuro', 'Preto', 'Amarelo pálido', 'Amarelo', 'Ouro', 'Âmbar', 'Laranja', 'Coral', 'Vermelho', 'Carmesim', 'Vinho', 'Rosa choque', 'Rosa', 'Magenta', 'Roxo', 'Violeta', 'Índigo', 'Azul', 'Azul celeste', 'Ciano', 'Verde-azulado', 'Menta', 'Verde', 'Verde floresta', 'Lima', 'Marrom', 'Bronze'}" values="{'#FFFFFF', '#CCCCCC', '#999999', '#555555', '#000000', '#FFEA99', '#FFE600', '#FFD700', '#FFB300', '#FF9F1C', '#FF7F50', '#E63946', '#B00020', '#7A0019', '#FF3D9A', '#FF6FB5', '#E040FB', '#B23EFF', '#7B2CBF', '#4B3FD1', '#3A86FF', '#7CC8FF', '#00E5FF', '#1ABC9C', '#7DFFB3', '#2ECC71', '#1E8449', '#B5E61D', '#A0522D', '#CD7F32'}" fontSize="12">
                            <event name="onChange">self.cmbMedo.visible = false</event>
                        </comboBox>
                        <rectangle strokeSize="1" color="#B23EFF" name="swMedo" align="client" strokeColor="#404254" cornerType="round" xradius="4" yradius="4" hitTest="true" cursor="handPoint" hint="Clique para escolher uma cor pronta">
                            <event name="onMouseDown">self.cmbMedo.visible = true
self.cmbMedo:dropDown()</event>
                        </rectangle>
                    </layout>
                </layout>
                <label text="Dados de Dualidade" fontSize="14" fontColor="#F1EDF5" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="22" margins="{top=16}" name="t798"/>
                <layout align="top" height="30" margins="{top=6}">
                    <layout align="left" width="190" margins="{right=12}">
                        <label text="Esperança" fontSize="13" fontColor="#F1EDF5" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="left" width="84" name="t799"/>
                        <comboBox align="client" field="dadoEsperanca" items="{'d4', 'd6', 'd8', 'd10', 'd12', 'd20'}" values="{'4', '6', '8', '10', '12', '20'}" fontSize="12" fontColor="#F1EDF5" hint="Dado de Esperança (padrão d12)" name="t800"/>
                        <dataLink field="dadoEsperanca" defaultValue="12">
                            <event name="onChange">atualizarDadosDualidade()</event>
                        </dataLink>
                    </layout>
                    <layout align="left" width="190" margins="{right=12}">
                        <label text="Medo" fontSize="13" fontColor="#F1EDF5" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="left" width="84" name="t801"/>
                        <comboBox align="client" field="dadoMedo" items="{'d4', 'd6', 'd8', 'd10', 'd12', 'd20'}" values="{'4', '6', '8', '10', '12', '20'}" fontSize="12" fontColor="#F1EDF5" hint="Dado de Medo (padrão d12)" name="t802"/>
                        <dataLink field="dadoMedo" defaultValue="12">
                            <event name="onChange">atualizarDadosDualidade()</event>
                        </dataLink>
                    </layout>
                </layout>
                <label text="Padrão: d12 e d12. Mude só quando um efeito alterar um dos dados." fontSize="11" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="top" height="18" margins="{top=4}" name="t803"/>
                <label text="Idioma das cartas" fontSize="14" fontColor="#F1EDF5" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="22" margins="{top=14}" name="t804"/>
                <layout align="top" height="30" margins="{top=6}">
                    <comboBox align="left" width="230" field="idiomaCartas" items="{'English (original)', 'Português (dg-builder)'}" values="{'en', 'pt'}" fontSize="12" fontColor="#F1EDF5" hint="Nome, texto e Consultar das cartas" name="t805"/>
                    <dataLink field="idiomaCartas" defaultValue="en">
                        <event name="onChange">aplicarIdioma()</event>
                    </dataLink>
                </layout>
                <layout align="top" height="30" margins="{top=12}">
                    <imageCheckBox align="left" width="16" field="usarCartaInteira" checkedImage="images/vigilia/chk_on.png" uncheckedImage="images/vigilia/chk_off.png" margins="{right=10,top=7,bottom=7}" cursor="handPoint" name="t806"/>
                    <label text="Mostrar a carta inteira no lugar da ilustração (use se as ilustrações não aparecerem)" fontSize="12" fontColor="#F1EDF5" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="client" wordWrap="true" name="t807"/>
                </layout>
                <layout align="top" height="26" margins="{top=8}">
                    <imageCheckBox align="left" width="16" field="autoEsperanca" checkedImage="images/vigilia/chk_on.png" uncheckedImage="images/vigilia/chk_off.png" margins="{right=10,top=5,bottom=5}" cursor="handPoint" name="t808"/>
                    <label text="Gerenciar Esperança automaticamente (ganhar em resultados com Esperança; gastar ao usar Experiências)" fontSize="12" fontColor="#F1EDF5" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="client" wordWrap="true" name="t809"/>
                </layout>
            </rectangle>
        </popup>
    </rectangle>
    <dataLink field="temaFicha" defaultValue="vigilia">
        <event name="onChange">aplicarTema(sheet.temaFicha)</event>
    </dataLink>
    <dataLink fields="{'hopeCheck1', 'hopeCheck2', 'hopeCheck3', 'hopeCheck4', 'hopeCheck5', 'hopeCheck6'}">
        <event name="onChange">atualizarEsperanca()</event>
    </dataLink>
    <dataLink fields="{'maxHp', 'maxStress', 'armor'}">
        <event name="onChange">atualizarMaximos()</event>
    </dataLink>
    <dataLink fields="{'atragilityCheck', 'atrstrengthCheck', 'atrfinesseCheck', 'atrinstinctCheck', 'atrpresenceCheck', 'atrknowledgeCheck'}">
        <event name="onChange">atualizarAtributos()</event>
    </dataLink>
    <dataLink fields="{'handfulCheck1', 'handfulCheck2', 'handfulCheck3', 'handfulCheck4', 'handfulCheck5', 'handfulCheck6', 'handfulCheck7', 'handfulCheck8', 'handfulCheck9', 'bagsCheck1', 'bagsCheck2', 'bagsCheck3', 'bagsCheck4', 'bagsCheck5', 'bagsCheck6', 'bagsCheck7', 'bagsCheck8', 'bagsCheck9'}">
        <event name="onChange">atualizarOuro()</event>
    </dataLink>
    <dataLink fields="{'level', 'classe', 'subclasse'}">
        <event name="onChange">atualizarTextos()</event>
    </dataLink>
    <dataLink field="usarCartaInteira">
        <event name="onChange">atualizarTodasImagens()</event>
    </dataLink>
    <dataLink fields="{'corEsperanca', 'corMedo'}">
        <event name="onChange">atualizarCoresDados()</event>
    </dataLink>
    <event name="onNodeReady">aoCarregar()</event>
</form>
