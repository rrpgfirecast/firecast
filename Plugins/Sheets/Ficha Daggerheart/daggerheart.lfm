                            <label text="/" fontSize="17" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="left" width="16" horzTextAlign="center" name="t38"/>
                            <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=4,right=4,top=0,bottom=0}" align="left" width="48" name="t39">
                                <edit field="damage2" fontSize="17" fontColor="#F1EDF5" fontFamily="Inter" transparent="true" vertTextAlign="center" horzTextAlign="center" hint="Limiar Severo" align="client" name="t40"/>
                            </rectangle>
                        </layout>
                    </layout>
                </rectangle>
            </rectangle>
            <rectangle strokeSize="1" color="#222533" g="col" g-width="12" g-auto-height="true" strokeColor="#404254" sides="top bottom" g-cnt-gutter="8" padding="{left=28,right=28,top=0,bottom=0}" name="t41">
                <rectangle strokeSize="0" color="#2B2D3D" g="col" g-width="3" g-width-md="2" height="54" name="tabFrente" hitTest="true" cursor="handPoint">
                    <rectangle strokeSize="0" color="#C3A5EC" name="tabFrenteBar" align="bottom" height="3"/>
                    <label text="Frente" fontSize="14" fontColor="#C3A5EC" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" name="tabFrenteLbl" align="client" horzTextAlign="center" hitTest="false"/>
                    <event name="onClick">mostrarAba("frente")</event>
                </rectangle>
                <rectangle strokeSize="0" color="#2B2D3D" g="col" g-width="3" g-width-md="2" height="54" name="tabInventario" hitTest="true" cursor="handPoint">
                    <rectangle strokeSize="0" color="#C3A5EC" name="tabInventarioBar" align="bottom" height="3"/>
                    <label text="Inventário" fontSize="14" fontColor="#C3A5EC" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" name="tabInventarioLbl" align="client" horzTextAlign="center" hitTest="false"/>
                    <event name="onClick">mostrarAba("inventario")</event>
                </rectangle>
                <rectangle strokeSize="0" color="#2B2D3D" g="col" g-width="3" g-width-md="2" height="54" name="tabCartas" hitTest="true" cursor="handPoint">
                    <rectangle strokeSize="0" color="#C3A5EC" name="tabCartasBar" align="bottom" height="3"/>
