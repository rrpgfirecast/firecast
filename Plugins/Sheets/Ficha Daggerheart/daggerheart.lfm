        "t795","xradius","rChip","t795","yradius","rChip","t796","fontColor","accent","t797","color","field","t797","strokeColor","border","edtHexMedo","fontColor","text",
        "swMedo","strokeColor","border","t798","fontColor","text","t799","fontColor","text","t800","fontColor","text","t801","fontColor","text","t802","fontColor","text",
