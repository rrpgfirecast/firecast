                            <edit field="subclasse" fontSize="13" fontColor="#C3A5EC" fontFamily="Inter" transparent="true" vertTextAlign="center" textPrompt="Subclasse" align="client" name="t20"/>
                        </rectangle>
                    </layout>
                </layout>
                <rectangle strokeSize="1" color="#00000000" g="col" g-width="12" g-gutter="0" g-auto-height="true" g-cnt-gutter="20" g-cnt-line-spacing="8" sides="top" strokeColor="#404254" padding="{left=0,right=0,top=16,bottom=0}" name="t21">
                    <layout g="col" g-width="4" g-width-md="2" height="54">
                        <label text="ESPERANÇA" fontSize="10" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="16" name="t22"/>
