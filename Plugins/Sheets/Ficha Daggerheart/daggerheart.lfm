                            <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=4,right=4,top=0,bottom=0}" align="left" width="48" name="t36">
                                <edit field="damage1" fontSize="17" fontColor="#F1EDF5" fontFamily="Inter" transparent="true" vertTextAlign="center" horzTextAlign="center" hint="Limiar Maior" align="client" name="t37"/>
