        "t808","checkedImage","img:chk_on","t808","uncheckedImage","img:chk_off","t809","fontColor","text",
    }


    local function resolverToken(nomeTema, pal, tok, prop)
        if string.sub(tok, 1, 4) == "img:" then
            local base = "images/"
            if prop == "src" then base = "/images/" end
            return base .. nomeTema .. "/" .. string.sub(tok, 5) .. ".png"
        end
        return pal[tok]
    end

    local function aplicarTabelaTema(form, nomeTema)
        local pal = PAL[nomeTema] or PAL.vigilia
        for i = 1, #TM, 3 do
            local c = form[TM[i]]
            if c ~= nil then
                local v = resolverToken(nomeTema, pal, TM[i + 2], TM[i + 1])
                if v ~= nil then
                    pcall(function() c[TM[i + 1]] = v end)
                end
            end
        end
        pcall(function() form.theme = pal.formTheme end)
        return pal
    end


    local temaAtual = "vigilia"
    local abaAtual = "frente"
    local patamarAtual = 2
    local ABAS = {"frente", "inventario", "cartas", "personagem"}
    local NOME_ABA = {frente = "Frente", inventario = "Inventário", cartas = "Cartas", personagem = "Personagem"}
    local ATRS = {"agility", "strength", "finesse", "instinct", "presence", "knowledge"}
    local NOME_ATR = {agility = "Agilidade", strength = "Força", finesse = "Acuidade",
                      instinct = "Instinto", presence = "Presença", knowledge = "Conhecimento"}
    local TRAIT_KEYS = {
        agilidade = "agility", agility = "agility", ["força"] = "strength", forca = "strength",
        strength = "strength", acuidade = "finesse", finesse = "finesse", instinto = "instinct",
        instinct = "instinct", ["presença"] = "presence", presenca = "presence", presence = "presence",
        conhecimento = "knowledge", knowledge = "knowledge"
    }
    local VALOR_ANCESTRY_CUSTOM = "Mixed Ancestry"
    local VALOR_TRANSFORMATION_CUSTOM = "Custom Transformation"

    local function P()
        return PAL[temaAtual] or PAL.vigilia
    end

    local function capital(s)
        return string.upper(string.sub(s, 1, 1)) .. string.sub(s, 2)
    end

    local function vazio(v)
        return v == nil or v == "" or v == "-- Selecione --"
    end

    -- aceita "#RRGGBB", "RRGGBB" e "#AARRGGBB" (o colorComboBox antigo salvava com alfa na frente)
    local function corHex(v, padrao)
        local t = string.gsub(tostring(v or ""), "%s", "")
        local h = string.match(t, "^#?%x%x(%x%x%x%x%x%x)$") or string.match(t, "^#?(%x%x%x%x%x%x)$")
        if h then return "#" .. string.upper(h) end
        return padrao
    end

    local function mesa()
        if sheet == nil then return nil end
        local m = Firecast.getMesaDe(sheet)
        if m == nil then
            showMessage("Abra esta ficha dentro de uma mesa para usar o chat.")
        end
        return m
    end

    local function invalidarGrade(ctrl)
        if ctrl ~= nil and ctrl.grid ~= nil then
            ctrl.grid:invalidate()
        end
    end

    -- ---------------------------------------------------------------- abas
    local function atualizarAbas()
        local pal = P()
        for _, k in ipairs(ABAS) do
            local K = capital(k)
            local ativo = (k == abaAtual)
            local pg = self["pg" .. K]
            if pg ~= nil then pg.visible = ativo end
            local tab = self["tab" .. K]
            if tab ~= nil then
                if ativo then tab.color = pal.accentSoft else tab.color = "#00000000" end
            end
            local bar = self["tab" .. K .. "Bar"]
            if bar ~= nil then bar.visible = ativo end
            local lb = self["tab" .. K .. "Lbl"]
            if lb ~= nil then
                if ativo then
                    lb.fontColor = pal.accent
                    lb.fontStyle = "bold"
                else
                    lb.fontColor = pal.muted
                    lb.fontStyle = ""
                end
            end
        end
        self.lblRodape.text = "DAGGERHEART  /  " .. pal.nome .. "  /  " .. (NOME_ABA[abaAtual] or "")
        invalidarGrade(self.sbMain)
    end

    local function mostrarAba(k)
        abaAtual = k
        atualizarAbas()
    end

    local function atualizarPatamares()
        local pal = P()
        for t = 2, 4 do
            local ativo = (t == patamarAtual)
            local tab = self["tierTab" .. t]
            local lb = self["tierTab" .. t .. "Lbl"]
            if tab ~= nil then
                if ativo then tab.color = pal.accent else tab.color = pal.accentSoft end
            end
            if lb ~= nil then
                if ativo then lb.fontColor = pal.onAccent else lb.fontColor = pal.muted end
            end
            local painel = self["tierPanel" .. t]
            if painel ~= nil then painel.visible = ativo end
        end
        invalidarGrade(self.pgFrente)
    end

    local function mostrarPatamar(t)
        patamarAtual = t
        atualizarPatamares()
    end

    -- ---------------------------------------------------------------- estados
    local function atualizarAtributos()
        if sheet == nil then return end
        local pal = P()
        for _, k in ipairs(ATRS) do
            local card = self["atrCard_" .. k]
            if card ~= nil then
                if sheet["atr" .. k .. "Check"] == true then
                    card.color = pal.accentSoft
                    card.strokeColor = pal.accent
                else
                    card.color = pal.surface
                    card.strokeColor = pal.border
                end
            end
        end
    end

    local function atualizarEsperanca()
        if sheet == nil then return end
        local n = 0
        for i = 1, 6 do
            if sheet["hopeCheck" .. i] == true then n = n + 1 end
        end
        self.lblResumoHope.text = n .. " / 6"
        self.lblHopeTag.text = n .. " de 6"
    end

    local function mostrarCaixas(prefixo, maximo)
        for i = 1, 12 do
            local c = self[prefixo .. i]
            if c ~= nil then c.visible = (i <= maximo) end
        end
        local r2 = self[prefixo .. "Row2"]
        if r2 ~= nil then r2.visible = (maximo > 6) end
        local r1 = self[prefixo .. "Row1"]
        if r1 ~= nil then r1.visible = (maximo > 0) end
    end

    local function limitar(v, padrao)
        local n = math.floor(tonumber(v) or padrao)
        if n < 0 then n = 0 end
        if n > 12 then n = 12 end
        return n
    end

    local function atualizarMaximos()
        if sheet == nil then return end
        local hp = limitar(sheet.maxHp, 6)
        local st = limitar(sheet.maxStress, 6)
        local ar = limitar(sheet.armor, 0)
        mostrarCaixas("hpBox", hp)
        mostrarCaixas("stBox", st)
        mostrarCaixas("arBox", ar)
        self.lblHpMax.text = "Máx. " .. hp
        self.lblStressMax.text = "Máx. " .. st
        if ar == 0 then
            self.lblArmorHint.text = "Informe o valor de armadura para exibir os espaços."
        else
            self.lblArmorHint.text = "Espaços de armadura · marque ao usar"
        end
        invalidarGrade(self.pgFrente)
    end

    local function atualizarOuro()
        if sheet == nil then return end
        local p, b = 0, 0
        for i = 1, 9 do
            if sheet["handfulCheck" .. i] == true then p = p + 1 end
            if sheet["bagsCheck" .. i] == true then b = b + 1 end
        end
        self.lblPunhados.text = tostring(p)
        self.lblBolsas.text = tostring(b)
    end

    local function atualizarTextos()
        if sheet == nil then return end
        local nv = tonumber(sheet.level) or 1
        self.lblNivelAtual.text = "Nível atual " .. nv
        self.lblClasseTag.text = sheet.classe or ""
        local partes = {}
        if not vazio(sheet.classe) then table.insert(partes, sheet.classe) end
        if not vazio(sheet.subclasse) then table.insert(partes, sheet.subclasse) end
        self.lblSubclasseSec.text = table.concat(partes, " · ")
        -- patamar sugerido pelo nível
        local t = 2
        if nv >= 8 then t = 4 elseif nv >= 5 then t = 3 end
        if t ~= patamarAtual and nv >= 2 then mostrarPatamar(t) end
    end

    local function atualizarCoresDados()
        if sheet == nil then return end
        local cE = corHex(sheet.corEsperanca, "#FFEA99")
        local cM = corHex(sheet.corMedo, "#B23EFF")
        self.dotHope.color = cE
        self.dotFear.color = cM
        self.swEsperanca.color = cE
        self.swMedo.color = cM
        if self.edtHexEsperanca.text ~= cE then self.edtHexEsperanca.text = cE end
        if self.edtHexMedo.text ~= cM then self.edtHexMedo.text = cM end
    end

    -- campo hex digitado: só grava quando for uma cor válida
    local function definirCorHex(campo, k)
        if sheet == nil then return end
        local c = corHex(self["edtHex" .. k].text, nil)
        if c ~= nil and sheet[campo] ~= c then sheet[campo] = c end
    end

    local function atualizarConfig()
        local opts = {codice = self.optCodice, vigilia = self.optVigilia}
        for k, c in pairs(opts) do
            if c ~= nil then
                if k == temaAtual then
                    c.strokeColor = PAL[k].accent
                    c.strokeSize = 3
                else
                    c.strokeColor = PAL[k].border
                    c.strokeSize = 1
                end
            end
        end
    end

    -- ---------------------------------------------------------------- cartas
    -- string.upper do Lua 5.1 não conhece acentos (UTF-8)
    local ACENTOS = {["á"] = "Á", ["à"] = "À", ["â"] = "Â", ["ã"] = "Ã", ["é"] = "É", ["ê"] = "Ê", ["í"] = "Í",
                     ["ó"] = "Ó", ["ô"] = "Ô", ["õ"] = "Õ", ["ú"] = "Ú", ["ç"] = "Ç"}
    local function maiusc(t)
        t = string.upper(t or "")
        for a, b in pairs(ACENTOS) do t = string.gsub(t, a, b) end
        return t
    end

    local function nomeCartaDominio(nome)
        nome = nome or ""
        return (string.gsub(nome, "^%[[^%]]*%]%s*", ""))
    end

    local function atualizarCartas()
        if sheet == nil then return end
        local pal = P()
        for _, k in ipairs({"Ancestry", "Community", "Transformation"}) do
            local lb = self["lblVinc" .. k]
            if lb ~= nil then
                if vazio(sheet["card" .. k .. "Nome"]) then lb.text = "" else lb.text = "VINCULADA" end
            end
        end
        local tr = sheet.cardTransformationNome
        if vazio(tr) then
            self.lblTransfStatus.text = "Nenhuma transformação vinculada. Espaço opcional."
            self.cardTransfPainel.visible = false
        else
            self.lblTransfStatus.text = tr .. " · vinculada"
            self.cardTransfPainel.visible = true
        end
        for n = 1, 3 do
            if vazio(sheet["cardClass" .. n .. "Nome"]) then
                self["lblVincClass" .. n].text = ""
            else
                self["lblVincClass" .. n].text = "VINCULADA"
            end
        end
        local ativas = 0
        for i = 1, 5 do
            local nome = sheet["cardDomain" .. i .. "Nome"]
            local tem = not vazio(nome)
            if tem then ativas = ativas + 1 end
            self["domBadge" .. i].visible = tem
            if tem then
                local tit = sheet["cardDomain" .. i .. "Titulo"]
                if vazio(tit) then tit = nomeCartaDominio(nome) end
                self["lblDomNome" .. i].text = tit
                self["lblDomNome" .. i].fontColor = pal.text
            else
                self["lblDomNome" .. i].text = "Espaço livre"
                self["lblDomNome" .. i].fontColor = pal.muted
            end
            local cat = sheet["cardDomain" .. i .. "Categoria"] or ""
            local tipo = sheet["cardDomain" .. i .. "Tipo"] or ""
            local t = maiusc(cat)
            if tipo ~= "" then
                if t ~= "" then t = t .. " · " end
                t = t .. maiusc(tipo)
            end
            self["lblDomTipo" .. i].text = t
            local dc = self["domCard" .. i]
            if tem then dc.strokeColor = pal.accent else dc.strokeColor = pal.border end
        end
        local livres = 5 - ativas
        self.lblMaoResumo.text = ativas .. " carta(s) ativa(s) · " .. livres .. " espaço(s) livre(s)"
        if livres > 0 then
            self.lblMaoLivres.text = livres .. " espaço(s) disponível(is). Use o cofre para organizar sua mão."
        else
            self.lblMaoLivres.text = "Mão completa (5 cartas). Use “Guardar ↓” para mover uma carta ao cofre."
        end
        invalidarGrade(self.pgCartas)
    end

    -- ---------------------------------------------------------------- banco de cartas
    -- Cada carta do banco (cardDataBase.xml) é uma tabela:
    --   {nome=, ilustracao= (arte), imagem= (carta inteira), texto=, [dominio=, nivel=, custo=, tipo=]}
    -- Também aceita o formato antigo (chave -> URL da carta inteira).
    local TABELA_CARTA = {
        cardAncestry = cartasAncestralidade, cardCommunity = cartasComunidade,
        cardTransformation = cartasTransformacao, cardClass1 = cartasSubclasse,
        cardClass2 = cartasSubclasse, cardClass3 = cartasSubclasse
    }

    local function tabelaDe(campo)
        if string.sub(campo, 1, 10) == "cardDomain" then return cartasDominio end
        return TABELA_CARTA[campo]
    end

    local function dadosCarta(campo, chave)
        local tabela = tabelaDe(campo)
        if tabela == nil then return nil end
        local d = tabela[chave or ""]
        if type(d) == "string" then return {imagem = d} end
        if type(d) == "table" then return d end
        return nil
    end

    local function arteDe(d)
        if d == nil then return "" end
        local usar = USAR_ILUSTRACAO and (sheet == nil or sheet.usarCartaInteira ~= true)
        if usar and d.ilustracao ~= nil and d.ilustracao ~= "" then return d.ilustracao end
        return d.imagem or ""
    end

    local function ehCustom(nome)
        return nome == VALOR_ANCESTRY_CUSTOM or nome == VALOR_TRANSFORMATION_CUSTOM
    end

    -- ---------------------------------------------------------------- idioma das cartas
    -- As chaves salvas na ficha são sempre as inglesas; o idioma só muda o que é exibido.
    local VALORES_ORIGEM = {
        cardAncestry = {valores = {"Mixed Ancestry", "Aetheris", "Clank", "Drakona", "Dwarf", "Earthkin", "Elf", "Emberkin", "Faerie", "Faun", "Firbolg", "Fungril", "Galapa", "Giant", "Gnome", "Goblin", "Halfling", "Human", "Inferis", "Katari", "Orc", "Ribbet", "Simiah", "Skykin", "Tidekin"}, combos = {{"cbAncestryNome", "— Selecionar —"}}},
        cardCommunity = {valores = {"Duneborne", "Freeborne", "Frostborne", "Hearthborne", "Highborne", "Loreborne", "Orderborne", "Reborne", "Ridgeborne", "Seaborne", "Slyborne", "Underborne", "Wanderborne", "Warborne", "Wildborne"}, combos = {{"cbCommunityNome", "— Selecionar —"}}},
        cardTransformation = {valores = {"Custom Transformation", "Demigod", "Ghost", "Reanimated", "Shapeshifter", "Vampire", "Werewolf"}, combos = {{"cbTransformationNome", "— Selecionar —"}, {"cbTransformationBar", "— Nenhuma —"}}}
    }
    local CAMPOS_CARTA = {"cardAncestry", "cardCommunity", "cardTransformation", "cardClass1", "cardClass2",
                          "cardClass3", "cardDomain1", "cardDomain2", "cardDomain3", "cardDomain4", "cardDomain5"}
    local CARTA_PT = {Foundation = "Fundação", Specialization = "Especialização", Mastery = "Maestria"}
    local TIPO_ORIGEM = {cardAncestry = "Ancestralidade", cardCommunity = "Comunidade",
                         cardTransformation = "Transformação"}

    local function emPT()
        return sheet ~= nil and sheet.idiomaCartas == "pt"
    end

    local function nomeBase(campo, chave)
        if string.sub(campo, 1, 10) == "cardDomain" then return nomeCartaDominio(chave) end
        if string.sub(campo, 1, 9) == "cardClass" then return (string.gsub(chave, "%s*%([FSM]%)$", "")) end
        return chave
    end

    local function tituloDe(campo, chave)
        chave = chave or ""
        if chave == "" then return "" end
        if emPT() then
            local d = dadosCarta(campo, chave)
            if d ~= nil and not vazio(d.nome_pt) then return d.nome_pt end
        end
        return nomeBase(campo, chave)
    end

    local function textoDe(d)
        if d == nil then return nil end
        if emPT() and not vazio(d.texto_pt) then return d.texto_pt end
        return d.texto
    end

    local function classeTxt(c)
        if emPT() and c ~= nil and classesPT[c] ~= nil then return classesPT[c] end
        return c
    end

    local function atualizarTitulo(campo)
        if sheet == nil then return end
        local t = tituloDe(campo, sheet[campo .. "Nome"])
        if (sheet[campo .. "Titulo"] or "") ~= t then sheet[campo .. "Titulo"] = t end
    end

    -- rótulos das listas de ancestralidade / comunidade / transformação
    local function rotularCombosOrigem()
        if sheet == nil then return end
        for campo, info in pairs(VALORES_ORIGEM) do
            for _, par in ipairs(info.combos) do
                local itens = {par[2]}
                local valores = {""}
                local lista = {}
                for i, v in ipairs(info.valores) do
                    table.insert(lista, {v = v, t = tituloDe(campo, v), custom = ehCustom(v), i = i})
                end
                table.sort(lista, function(a, b)
                    if a.custom ~= b.custom then return a.custom end
                    return a.t < b.t
                end)
                for _, x in ipairs(lista) do
                    table.insert(itens, x.t)
                    table.insert(valores, x.v)
                end
                local cb = self:findControlByName(par[1])
                if cb ~= nil then
                    cb.items = itens
                    cb.values = valores
                    local salvo = sheet[campo .. "Nome"]
                    if not vazio(salvo) then cb.value = salvo end
                end
            end
        end
    end

    -- ---------------------------------------------------------------- texto das cartas com negrito
    -- O texto fica salvo sem marcação; o negrito é aplicado só na exibição (richEdit + Talemark):
    --   • nome da habilidade no início do parágrafo ("Runic Lock:", "Tranca Rúnica:")
    --   • testes com dificuldade ("Spellcast Roll (15)", "teste de conjuração (13)")
    local OPCOES_TALEMARK = {parseCharActions = false, parseCharEmDashSpeech = false,
        parseCharQuotedSpeech = false, parseCommonMarkStrongEmphasis = true, parseHeadings = false,
        parseHorzLines = false, parseInitialCaps = false, parseOutOfChar = false, parseSmileys = false,
        parseURL = false, trimTexts = false}

    local function textoComNegrito(t)
        local linhas = {}
        for linha in string.gmatch((t or "") .. "\n", "([^\n]*)\n") do
            local pre, nome, resto = string.match(linha, "^([%-•%s]*)([^%.:%*%-•][^%.:%*]-):(.*)$")
            if nome ~= nil then
                local _, palavras = string.gsub(nome, "%S+", "")
                if palavras <= 6 then linha = pre .. "**" .. nome .. ":**" .. resto end
            end
            linha = string.gsub(linha, "(%a+ Roll %(%d+%))", "**%1**")
            linha = string.gsub(linha, "([Tt]este de [^%s%(%)%*]+ %(%d+%))", "**%1**")
            table.insert(linhas, linha)
        end
        return table.concat(linhas, "\n")
    end

    -- compara ignorando espaços e quebras (texto antigo "corrido" × texto novo em parágrafos)
    local function compactar(t)
        return (string.gsub(t or "", "%s+", ""))
    end

    -- divide uma linha já marcada com ** em trechos {t = texto, b = negrito}
    local function trechos(linha)
        local r, negrito, pos = {}, false, 1
        while true do
            local i = string.find(linha, "**", pos, true)
            if i == nil then
                table.insert(r, {t = string.sub(linha, pos), b = negrito})
                break
            end
            table.insert(r, {t = string.sub(linha, pos, i - 1), b = negrito})
            negrito = not negrito
            pos = i + 2
        end
        return r
    end

    local function dividir(t, sep)
        local r, pos = {}, 1
        while true do
            local i = string.find(t, sep, pos, true)
            if i == nil then
                table.insert(r, string.sub(t, pos))
                break
            end
            table.insert(r, string.sub(t, pos, i - 1))
            pos = i + string.len(sep)
        end
        return r
    end

    -- Escreve o texto direto no richEdit, trecho por trecho (sem Talemark: o Talemark cria um
    -- bloco novo e deixa um parágrafo vazio no começo). Parágrafos = linha em branco no texto.
    local function escreverRich(ctrl, texto, cor)
        ctrl.readOnly = false
        ctrl:beginEdit()
        ctrl:selectAll()
        ctrl:deleteSelection()
        local paras = dividir(string.gsub(texto, "\r", ""), "\n\n")
        local primeiro = true
        for _, para in ipairs(paras) do
            if para ~= "" then
                if not primeiro then ctrl:breakParagraph() end
                primeiro = false
                for li, linha in ipairs(dividir(para, "\n")) do
                    if li > 1 then ctrl:breakLine() end
                    for _, tr in ipairs(trechos(textoComNegrito(linha))) do
                        if tr.t ~= "" then
                            local a = ctrl:getSelectionPosInChars()
                            ctrl:insertText(tr.t)
                            local b = ctrl:getSelectionPosInChars()
                            ctrl:gotoPositionInChars(a)
                            ctrl:gotoPositionInChars(b, true)
                            if tr.b then ctrl:setSelectionFontStyle({"bold"}) else ctrl:setSelectionFontStyle({}) end
                            ctrl:setSelectionFontColor(cor)
                            ctrl:gotoPositionInChars(b)
                        end
                    end
                end
            end
        end
        -- respiro entre parágrafos (e nenhum espaço antes do primeiro)
        ctrl:selectAll()
        pcall(function()
            ctrl:setSelectionParaTopMargin(0)
            ctrl:setSelectionParaBottomMargin(6)
        end)
        ctrl:unselect()
        ctrl:endEdit()
        ctrl.readOnly = true
        ctrl:gotoStart()
    end

    -- reserva: se a escrita direta falhar (versão antiga do Firecast), usa o Talemark
    local function escreverRichTalemark(ctrl, texto, cor)
        local op = {}
        for k, v in pairs(OPCOES_TALEMARK) do op[k] = v end
        op.defaultTextStyle = {color = cor}
        ctrl.readOnly = false
        ctrl:beginEdit()
        ctrl:selectAll()
        ctrl:deleteSelection()
        ctrl:insertTalemark(textoComNegrito(texto), op)
        ctrl:endEdit()
        ctrl.readOnly = true
        ctrl:gotoStart()
    end

    local function preencherRich(ctrl, texto)
        if ctrl == nil then return end
        local pal = PAL[temaAtual] or PAL.vigilia
        local cor = pal.text
        texto = texto or ""
        if texto == "" then
            pcall(function()
                ctrl.readOnly = false
                ctrl:beginEdit()
                ctrl:selectAll()
                ctrl:deleteSelection()
                ctrl:endEdit()
                ctrl.readOnly = true
            end)
            return
        end
        local ok = pcall(escreverRich, ctrl, texto, cor)
        if not ok then
            pcall(function() ctrl:endEdit() end)
            pcall(escreverRichTalemark, ctrl, texto, cor)
        end
    end

    local function renderizarTexto(campo)
        if sheet == nil then return end
        local v = self:findControlByName(campo .. "TextoView")
        local e = self:findControlByName(campo .. "TextoEdit")
        if v == nil or e == nil then return end
        local t = sheet[campo .. "Texto"] or ""
        preencherRich(v, t)
        -- sem texto: já mostra o campo editável (com a dica)
        if t == "" then
            e.visible = true
            v.visible = false
        elseif not e:isFocused() then
            e.visible = false
            v.visible = true
        end
    end

    local function editarTexto(campo, editar)
        local v = self:findControlByName(campo .. "TextoView")
        local e = self:findControlByName(campo .. "TextoEdit")
        if v == nil or e == nil then return end
        if editar == nil then editar = not e.visible end
        if editar then
            v.visible = false
            e.visible = true
            pcall(function() e:setFocus() end)
        else
            e.visible = false
            v.visible = true
            renderizarTexto(campo)
        end
    end

    local function renderizarTodosTextos()
        for _, c in ipairs(CAMPOS_CARTA) do renderizarTexto(c) end
    end

    -- textos não editados pelo jogador passam para o formato novo (parágrafos) sem perder nada
    local function atualizarFormatoTextos()
        if sheet == nil then return end
        for _, c in ipairs(CAMPOS_CARTA) do
            local d = dadosCarta(c, sheet[c .. "Nome"])
            local atual = sheet[c .. "Texto"] or ""
            if d ~= nil and atual ~= "" then
                for _, novo in ipairs({d.texto or "", d.texto_pt or ""}) do
                    if novo ~= "" and atual ~= novo and compactar(atual) == compactar(novo) then
                        sheet[c .. "Texto"] = novo
                        break
                    end
                end
            end
        end
    end

    -- Consultar: em inglês mostra a carta inteira (imagem); em português monta a carta com o texto traduzido
    local function consultarCarta(campo, pop)
        if sheet == nil then return end
        local p = self:findControlByName(pop)
        if p == nil then return end
        local nome = sheet[campo .. "Nome"] or ""
        local d = dadosCarta(campo, nome)
        local composto = emPT() and d ~= nil and not ehCustom(nome) and not vazio(d.texto_pt)
        local img = self:findControlByName(pop .. "Img")
        local carta = self:findControlByName(pop .. "Carta")
        if img ~= nil then img.visible = not composto end
        if carta ~= nil then carta.visible = composto end
        if composto then
            local meta = TIPO_ORIGEM[campo] or ""
            if string.sub(campo, 1, 10) == "cardDomain" then
                meta = (d.dominio or "") .. " · Nível " .. tostring(d.nivel or "–") .. " · Recall " ..
                       tostring(d.custo or "–")
                if not vazio(d.tipo) then meta = meta .. " · " .. d.tipo end
            elseif string.sub(campo, 1, 9) == "cardClass" then
                meta = (classeTxt(d.classe) or "") .. " · " .. (CARTA_PT[d.carta or ""] or "")
            end
            self:findControlByName(pop .. "Titulo").text = tituloDe(campo, nome)
            self:findControlByName(pop .. "Meta").text = maiusc(meta)
            preencherRich(self:findControlByName(pop .. "Texto"), d.texto_pt)
        end
        p:show()
    end

    -- Imagens (derivadas do banco; roda também ao abrir a ficha, sem apagar nada do jogador)
    local function atualizarImagemCarta(campo)
        if sheet == nil then return end
        atualizarTitulo(campo)
        local nome = sheet[campo .. "Nome"] or ""
        if ehCustom(nome) then
            sheet[campo .. "URL"] = sheet[campo .. "CustomURL"] or ""
            sheet[campo .. "Arte"] = sheet[campo .. "CustomURL"] or ""
            return
        end
        if nome == "" then
            sheet[campo .. "URL"] = ""
            sheet[campo .. "Arte"] = ""
            return
        end
        local d = dadosCarta(campo, nome)
        if d ~= nil then
            sheet[campo .. "URL"] = d.imagem or ""
            sheet[campo .. "Arte"] = arteDe(d)
        end
        if campo == "cardClass1" and vazio(sheet.subclasse) then
            sheet.subclasse = (string.gsub(nome, "%s*%([FSM]%)$", ""))
        end
    end

    -- Texto, nível, custo e tipo: só quando o jogador escolhe a carta (não sobrescreve ao abrir)
    local function preencherCarta(campo)
        if sheet == nil then return end
        local d = dadosCarta(campo, sheet[campo .. "Nome"])
        if d == nil then return end
        local tx = textoDe(d)
        if tx ~= nil then sheet[campo .. "Texto"] = tx end
        if d.nivel ~= nil then sheet[campo .. "Nivel"] = d.nivel end
        if d.custo ~= nil then sheet[campo .. "Recall"] = d.custo end
        if d.tipo ~= nil then sheet[campo .. "Tipo"] = d.tipo end
    end

    local function sincronizarImagemCustom(campo)
        if sheet == nil then return end
        if ehCustom(sheet[campo .. "Nome"] or "") then
            sheet[campo .. "URL"] = sheet[campo .. "CustomURL"] or ""
            sheet[campo .. "Arte"] = sheet[campo .. "CustomURL"] or ""
        end
    end

    local function atualizarTodasImagens()
        if sheet == nil then return end
        for _, c in ipairs({"cardAncestry", "cardCommunity", "cardTransformation", "cardClass1", "cardClass2",
                            "cardClass3", "cardDomain1", "cardDomain2", "cardDomain3", "cardDomain4",
                            "cardDomain5"}) do
            atualizarImagemCarta(c)
        end
    end

    local function atualizarModoImagem(campo, valorCustom, nomeImgView, nomeImgEdit)
        if sheet == nil then return end
        local custom = ((sheet[campo .. "Nome"] or "") == valorCustom)
        local v = self:findControlByName(nomeImgView)
        local e = self:findControlByName(nomeImgEdit)
        if v then v.visible = not custom end
        if e then e.visible = custom end
    end

    -- Mantém a carta de domínio na proporção de uma carta física (altura = largura × 1,4).
    local function ajustarProporcaoCarta(slot)
        local card = self["domCard" .. slot]
        if card == nil then return end
        local w = card.width or 0
        if w < 50 then return end
        local h = math.floor(w * 1.4 + 0.5)
        local arte = self["domArt" .. slot]
        if arte ~= nil then arte.height = math.floor(h * 0.42) end
        local topo = self["domTopo" .. slot]
        if topo ~= nil then topo.width = w - 30 end
        if math.abs((card.height or 0) - h) > 1 then
            card.height = h
            invalidarGrade(card)
        end
    end

    local function filtrarCartasDomain(slot)
        if sheet == nil then return end
        local categoria = sheet["cardDomain" .. slot .. "Categoria"] or ""
        local combo = self["cbDomain" .. slot .. "Nome"]
        if combo == nil then return end
        local items = {"— Escolha a carta —"}
        local values = {""}
        local cards = domainCardsByCategory[categoria]
        if cards == nil then
            items = {"— Escolha o domínio —"}
        else
            for _, cardName in ipairs(cards) do
                local full = "[" .. categoria .. "] " .. cardName
                table.insert(items, tituloDe("cardDomain" .. slot, full))
                table.insert(values, full)
            end
        end
        local salvo = sheet["cardDomain" .. slot .. "Nome"]
        combo.items = items
        combo.values = values
        if salvo ~= nil and salvo ~= "" then combo.value = salvo end
    end

    local function limparCarta(campo)
        if sheet == nil then return end
        sheet[campo .. "Nome"] = ""
        sheet[campo .. "URL"] = ""
        sheet[campo .. "Arte"] = ""
        sheet[campo .. "CustomURL"] = ""
        sheet[campo .. "Texto"] = ""
        atualizarCartas()
    end

    -- ============================================================
    -- SUBCLASSE: classe → carta, com as regras de multiclasse (Livro Básico p. 110–111)
    -- Espaço 1: Fundação de qualquer classe.
    -- Espaço 2: Especialização da subclasse do espaço 1; com multiclasse no patamar 3,
    --           Fundação de outra classe.
    -- Espaço 3: Maestria da subclasse do espaço 1; com multiclasse no patamar 3, Especialização
    --           de uma das duas subclasses; com multiclasse no patamar 4, Fundação de outra classe.
    -- ============================================================
    local SUB_IDX = nil
    local atualizandoSub = false
    local ROTULO_CARTA = {F = "Fundação", S = "Especialização", M = "Maestria"}

    local function indiceSubclasses()
        if SUB_IDX ~= nil then return SUB_IDX end
        local porClasse, classes = {}, {}
        for chave, d in pairs(cartasSubclasse) do
            local nome, t = string.match(chave, "^(.-)%s*%(([FSM])%)$")
            if nome ~= nil and t == "F" and d.classe ~= nil and d.classe ~= "" then
                local c = porClasse[d.classe]
                if c == nil then
                    c = {}
                    porClasse[d.classe] = c
                    table.insert(classes, d.classe)
                end
                table.insert(c, nome)
            end
        end
        table.sort(classes)
        for _, c in pairs(porClasse) do table.sort(c) end
        SUB_IDX = {classes = classes, porClasse = porClasse}
        return SUB_IDX
    end

    local function classeDaCarta(chave)
        local d = cartasSubclasse[chave or ""]
        if d == nil or vazio(d.classe) then return nil end
        return d.classe
    end

    local function subDaCarta(chave)
        return string.match(chave or "", "^(.-)%s*%([FSM]%)$")
    end

    -- patamar em que a multiclasse foi marcada (3, 4 ou nil)
    local function multiclassePatamar()
        if sheet.multiClass1Part1 == true or sheet.multiClass1Part2 == true then return 3 end
        if sheet.multiClass2Part1 == true or sheet.multiClass2Part2 == true then return 4 end
        return nil
    end

    -- devolve: lista de classes permitidas, função classe → chaves de carta, rótulo do espaço
    local function regraSlot(n, mc, idx)
        local prim = classeDaCarta(sheet.cardClass1Nome)
        if prim == nil and not vazio(sheet.cardClass1Classe) then prim = sheet.cardClass1Classe end
        local subPrim = subDaCarta(sheet.cardClass1Nome)
        local function fundacoes(c)
            local r = {}
            for _, s in ipairs(idx.porClasse[c] or {}) do table.insert(r, s .. " (F)") end
            return r
        end
        if n == 1 then return idx.classes, fundacoes, "FUNDAÇÃO" end
        if (n == 2 and mc == 3) or (n == 3 and mc == 4) then
            local outras = {}
            for _, c in ipairs(idx.classes) do
                if c ~= prim then table.insert(outras, c) end
            end
            return outras, fundacoes, "FUNDAÇÃO · MULTICLASSE"
        end
        local cls = {}
        if prim ~= nil then cls = {prim} end
        if n == 3 and mc == 3 then
            local mcClasse = classeDaCarta(sheet.cardClass2Nome)
            local subMC = subDaCarta(sheet.cardClass2Nome)
            if mcClasse ~= nil and mcClasse ~= prim then table.insert(cls, mcClasse) end
            return cls, function(c)
                if c == prim and subPrim ~= nil then return {subPrim .. " (S)"} end
                if c == mcClasse and subMC ~= nil then return {subMC .. " (S)"} end
                return {}
            end, "ESPECIALIZAÇÃO"
        end
        local sufixo, rotulo = " (S)", "ESPECIALIZAÇÃO"
        if n == 3 then sufixo, rotulo = " (M)", "MAESTRIA" end
        return cls, function(_)
            if subPrim ~= nil then return {subPrim .. sufixo} end
            return {}
        end, rotulo
    end

    local function contem(lista, v)
        for _, x in ipairs(lista) do
            if x == v then return true end
        end
        return false
    end

    local function atualizarSubclasses()
        if sheet == nil or atualizandoSub then return end
        atualizandoSub = true
        local ok, err = pcall(function()
            local idx = indiceSubclasses()
            local mc = multiclassePatamar()
            for n = 1, 3 do
                local campo = "cardClass" .. n
                local classes, cartasDe, rotulo = regraSlot(n, mc, idx)
                self["lblEyebrowClass" .. n].text = rotulo
                local nome = sheet[campo .. "Nome"] or ""
                -- classe do espaço: salva, deduzida da carta (fichas antigas) ou única opção
                local cls = sheet[campo .. "Classe"]
                if nome == "" then
                    -- espaço vazio: a classe acompanha a regra atual
                    if vazio(cls) or not contem(classes, cls) then
                        cls = ""
                        if #classes == 1 then cls = classes[1] end
                    end
                elseif vazio(cls) then
                    cls = classeDaCarta(nome) or ""
                end
                if (sheet[campo .. "Classe"] or "") ~= cls then sheet[campo .. "Classe"] = cls end
                -- combo de classe
                local ci, cv = {"— Classe —"}, {""}
                local ordenadas = {}
                for _, c in ipairs(classes) do table.insert(ordenadas, c) end
                table.sort(ordenadas, function(a, b) return classeTxt(a) < classeTxt(b) end)
                for _, c in ipairs(ordenadas) do
                    table.insert(ci, classeTxt(c))
                    table.insert(cv, c)
                end
                if not vazio(cls) and not contem(classes, cls) then
                    table.insert(ci, classeTxt(cls) .. " ⚠")
                    table.insert(cv, cls)
                end
                local cbC = self["cbClass" .. n .. "Classe"]
                cbC.items = ci
                cbC.values = cv
                if not vazio(cls) then cbC.value = cls end
                -- combo de carta
                local ki, kv = {"— Selecionar —"}, {""}
                if vazio(cls) then
                    ki = {"— Escolha a classe —"}
                    if n > 1 and #classes == 0 then ki = {"— Escolha a Fundação primeiro —"} end
                else
                    for _, chave in ipairs(cartasDe(cls)) do
                        local _, t = string.match(chave, "^(.-)%s*%(([FSM])%)$")
                        table.insert(ki, tituloDe(campo, chave) .. " · " .. ROTULO_CARTA[t])
                        table.insert(kv, chave)
                    end
                end
                if nome ~= "" and not contem(kv, nome) then
                    local sub, t = string.match(nome, "^(.-)%s*%(([FSM])%)$")
                    if sub ~= nil then
                        table.insert(ki, tituloDe(campo, nome) .. " · " .. ROTULO_CARTA[t] .. " ⚠")
                    else
                        table.insert(ki, nome .. " ⚠")
                    end
                    table.insert(kv, nome)
                end
                local cbN = self["cbClass" .. n .. "Nome"]
                cbN.items = ki
                cbN.values = kv
                if nome ~= "" then cbN.value = nome end
            end
        end)
        atualizandoSub = false
        if not ok then pcall(print, "[Daggerheart] atualizarSubclasses: " .. tostring(err)) end
    end

    -- o jogador trocou a classe de um espaço: limpa a carta se ela era de outra classe
    local function trocarClasseSlot(n)
        if sheet == nil then return end
        local campo = "cardClass" .. n
        local nome = sheet[campo .. "Nome"] or ""
        if nome ~= "" and classeDaCarta(nome) ~= sheet[campo .. "Classe"] then
            limparCarta(campo)
        end
        if n == 1 and vazio(sheet.classe) and not vazio(sheet.cardClass1Classe) then
            sheet.classe = classeTxt(sheet.cardClass1Classe)
        end
        atualizarSubclasses()
    end

    -- troca o idioma: títulos, listas e textos que ainda não foram editados pelo jogador
    local function aplicarIdioma()
        if sheet == nil then return end
        local pt = emPT()
        for _, c in ipairs(CAMPOS_CARTA) do
            atualizarTitulo(c)
            local d = dadosCarta(c, sheet[c .. "Nome"])
            if d ~= nil then
                local atual = sheet[c .. "Texto"] or ""
                local outro = d.texto_pt
                if pt then outro = d.texto end
                local novo = textoDe(d)
                if novo ~= nil and atual ~= novo and (atual == "" or compactar(atual) == compactar(outro or "")
                        or compactar(atual) == compactar(novo)) then
                    sheet[c .. "Texto"] = novo
                end
            end
        end
        for i = 1, 5 do filtrarCartasDomain(i) end
        rotularCombosOrigem()
        atualizarSubclasses()
        atualizarCartas()
    end

    local function enviarCarta(campo)
        if sheet == nil then return end
        local url = sheet[campo .. "URL"]
        local nome = sheet[campo .. "Nome"]
        if vazio(nome) and vazio(url) then
            showMessage("Nenhuma carta vinculada neste espaço.")
            return
        end
        local m = mesa()
        if m == nil then return end
        local nick = (m.meuJogador and m.meuJogador.nick) or ""
        if emPT() and not vazio(sheet[campo .. "Arte"]) then url = sheet[campo .. "Arte"] end
        local msg = "[Carta] " .. nick .. "[§R][§K2] destacou a carta:\n****\n### [§K1][§B]" ..
                    tituloDe(campo, nome) .. "[§B]"
        if not vazio(url) then msg = msg .. "\n###### [§I" .. url .. "]" end
        local texto = sheet[campo .. "Texto"]
        if not vazio(texto) then msg = msg .. "\n" .. textoComNegrito(texto) end
        msg = msg .. "\n****"
        m.activeChat:enviarMensagem(msg)
    end

    local function guardarNoCofre(slot)
        if sheet == nil then return end
        local c = "cardDomain" .. slot
        if vazio(sheet[c .. "Nome"]) then
            showMessage("Este espaço já está livre.")
            return
        end
        local no = self.rclCofre:append()
        if no ~= nil then
            no.nome = tituloDe(c, sheet[c .. "Nome"])
            no.dominio = sheet[c .. "Categoria"] or ""
            no.nivel = sheet[c .. "Nivel"]
            no.recall = sheet[c .. "Recall"]
            no.registro = "No cofre"
            no.url = sheet[c .. "URL"]
            no.arte = sheet[c .. "Arte"]
            no.chave = sheet[c .. "Nome"]
            no.texto = sheet[c .. "Texto"]
            no.tipo = sheet[c .. "Tipo"]
        end
        sheet[c .. "Nome"] = ""
        sheet[c .. "URL"] = ""
        sheet[c .. "Arte"] = ""
        sheet[c .. "Texto"] = ""
        sheet[c .. "Nivel"] = ""
        sheet[c .. "Recall"] = ""
        atualizarCartas()
    end

    -- ---------------------------------------------------------------- rolagens
    local function ajustarEsperanca(delta)
        if delta > 0 then
            for i = 1, 6 do
                if sheet["hopeCheck" .. i] ~= true then
                    sheet["hopeCheck" .. i] = true
                    return true
                end
            end
        elseif delta < 0 then
            for i = 6, 1, -1 do
                if sheet["hopeCheck" .. i] == true then
                    sheet["hopeCheck" .. i] = false
                    return true
                end
            end
        end
        return false
    end

    -- aviso no título de Atributos quando os Dados de Dualidade não são 2d12
    local function atualizarDadosDualidade()
        if sheet == nil then return end
        local dH = tonumber(sheet.dadoEsperanca) or 12
        local dM = tonumber(sheet.dadoMedo) or 12
        if dH == 12 and dM == 12 then
            self.lblAtrSub.text = "Modificadores · role como Ação ou Reação"
        else
            self.lblAtrSub.text = "Dados: d" .. dH .. " Esperança · d" .. dM .. " Medo  (⚙ para mudar)"
        end
    end

    local function rolarDualidade(bonus, titulo, reacao)
        if sheet == nil then return end
        local m = mesa()
        if m == nil then return end
        local corE = corHex(sheet.corEsperanca, "#FFEA99")
        local corM = corHex(sheet.corMedo, "#B23EFF")
        local auto = (sheet.autoEsperanca ~= false)
        local total = tonumber(bonus) or 0
        local msg = "[§B][§K" .. corE .. "]ESPERANÇA[§K14] × [§K" .. corM .. "]MEDO[§B][§K14] — " .. titulo

        -- Experiências marcadas para uso
        local usadas = {}
        if sheet.experiencias ~= nil then
            local nos = NDB.getChildNodes(sheet.experiencias)
            for _, no in ipairs(nos) do
                if no.usar == true then
                    total = total + (tonumber(no.bonus) or 0)
                    msg = msg .. " + " .. (no.nome or "Experiência")
                    table.insert(usadas, no)
                end
            end
        end
        if auto and #usadas > 0 then
            for _ = 1, #usadas do
                if not ajustarEsperanca(-1) then
                    msg = msg .. " (sem Esperança suficiente!)"
                    break
                end
            end
        end
        -- Dados de Dualidade: d12 por padrão; efeitos podem mudar o dado de Esperança e/ou de Medo
        local dH = tonumber(sheet.dadoEsperanca) or 12
        local dM = tonumber(sheet.dadoMedo) or 12
        local expr = "2d" .. dH
        if dH ~= dM then
            expr = "1d" .. dH .. "+1d" .. dM
            msg = msg .. " [§K14](d" .. dH .. " Esperança · d" .. dM .. " Medo)"
        end
        if total > 0 then expr = expr .. "+" .. total elseif total < 0 then expr = expr .. total end
        local rolagem = Firecast.interpretarRolagem(expr)
        m.activeChat:rolarDados(rolagem, msg, function(rolado)
            -- 1º dado rolado = Esperança, 2º = Medo (vale para "2dX" e para "1dX+1dY")
            local ok, hope, fear = pcall(function()
                local vals = {}
                for _, op in ipairs(rolado.ops) do
                    if op.tipo == "dado" and type(op.resultados) == "table" then
                        for _, v in ipairs(op.resultados) do table.insert(vals, v) end
                    end
                end
                return vals[1], vals[2]
            end)
            if not ok or hope == nil or fear == nil then return end
            if reacao then
                -- Reaction roll (Livro Básico p. 99): não gera Esperança, Medo nem jogada do Mestre
                m.activeChat:enviarMensagem("[§B][§K14]Resultado: " .. rolado.resultado .. "[§B] (reação: não gera Esperança nem Medo)")
                return
            end
            if hope == fear then
                m.activeChat:enviarMensagem("[§B][§K0,1]Resultado: " .. rolado.resultado ..
                    " · SUCESSO CRÍTICO![§B][§K14,0] (Ganhe 1 Esperança e limpe 1 Estresse.)")
                if auto then ajustarEsperanca(1) end
            elseif hope > fear then
                m.activeChat:enviarMensagem("[§B][§K" .. corE .. "]Resultado: " .. rolado.resultado ..
                    " com Esperança[§B][§K14] (+1 Esperança)")
                if auto then ajustarEsperanca(1) end
            else
                m.activeChat:enviarMensagem("[§B][§K" .. corM .. "]Resultado: " .. rolado.resultado ..
                    " com Medo[§B][§K14] (O Mestre ganha 1 Medo)")
            end
        end)
        for _, no in ipairs(usadas) do no.usar = false end
    end

    local function rolarAtributo(k, reacao)
        if sheet == nil then return end
        if reacao then
            rolarDualidade(sheet["atr" .. k], "Reação de " .. (NOME_ATR[k] or k), true)
        else
            rolarDualidade(sheet["atr" .. k], "Ação de " .. (NOME_ATR[k] or k), false)
        end
    end

    local function rolarAtaque(pref)
        if sheet == nil then return end
        local trait = string.lower(string.gsub(sheet[pref .. "Trait"] or "", "%s", ""))
        local k = TRAIT_KEYS[trait]
        if k == nil then
            showMessage("Informe o atributo da arma (ex.: Força, Agilidade, Acuidade...).")
            return
        end
        rolarDualidade(sheet["atr" .. k],
            "Ataque com " .. (sheet[pref .. "Name"] or "arma") .. " (" .. NOME_ATR[k] .. ")")
    end

    local function rolarDano(pref)
        if sheet == nil then return end
        local dano = sheet[pref .. "Damage"]
        if vazio(dano) then
            showMessage("Informe o dano da arma (ex.: d8+2).")
            return
        end
        local prof = math.max(1, math.floor(tonumber(sheet.proficiencia) or 1))
        local expr = string.gsub(dano, "%s", "")
        expr = string.gsub(expr, "(%d*)[dD](%d+)", function(_, f) return prof .. "d" .. f end)
        local rolagem = Firecast.interpretarRolagem(expr)
        if not rolagem.possuiAlgumDado then
            showMessage("Não entendi a rolagem de dano: " .. dano)
            return
        end
        local m = mesa()
        if m == nil then return end
        m.activeChat:rolarDados(rolagem, "Dano " .. (sheet[pref .. "Type"] or "") .. " · " ..
            (sheet[pref .. "Name"] or "Arma"))
    end

    local function linha(rotulo, valor)
        if vazio(valor) then return "" end
        return "\n[§B]" .. rotulo .. ":[§B] " .. valor
    end

    local function enviarArma(pref)
        if sheet == nil then return end
        local m = mesa()
        if m == nil then return end
        local msg = "****\n### [§B]" .. (sheet[pref .. "Name"] or "Arma") .. "[§B]" ..
            linha("Atributo", sheet[pref .. "Trait"]) .. linha("Alcance", sheet[pref .. "Range"]) ..
            linha("Dano", sheet[pref .. "Damage"]) .. linha("Tipo", sheet[pref .. "Type"]) ..
            linha("Empunhadura", sheet[pref .. "Burden"]) .. linha("Característica", sheet[pref .. "Feature"]) ..
            "\n****"
        m.activeChat:enviarMensagem(msg)
    end

    local function enviarArmadura()
        if sheet == nil then return end
        local m = mesa()
        if m == nil then return end
        m.activeChat:enviarMensagem("****\n### [§B]" .. (sheet.armorName or "Armadura") .. "[§B]" ..
            linha("Limiares", sheet.armorThresholds) .. linha("Valor de armadura", sheet.armorScore) ..
            linha("Característica", sheet.armorFeature) .. "\n****")
    end

    local function enviarHabilidades()
        if sheet == nil then return end
        local m = mesa()
        if m == nil then return end
        local msg = "****\n### [§B]" .. (sheet.classFeatureNome or "Habilidade de classe") .. "[§B]"
        if not vazio(sheet.classFeature) then msg = msg .. "\n" .. sheet.classFeature end
        if not vazio(sheet.classFeature2Nome) or not vazio(sheet.classFeature2) then
            msg = msg .. "\n\n[§B]" .. (sheet.classFeature2Nome or "") .. "[§B]\n" .. (sheet.classFeature2 or "")
        end
        m.activeChat:enviarMensagem(msg .. "\n****")
    end

    -- ---------------------------------------------------------------- tema
    local function aplicarTema(nome)
        if nome == nil or PAL[nome] == nil then nome = "vigilia" end
        temaAtual = nome
        self:beginUpdate()
        aplicarTabelaTema(self, nome)
        atualizarAbas()
        atualizarPatamares()
        atualizarAtributos()
        atualizarCartas()
        atualizarConfig()
        self:endUpdate()
        renderizarTodosTextos()
    end

    -- ============================================================
    -- MIGRAÇÃO da ficha original (Beloved.daggerheart 2.x)
    -- Quase todos os campos têm o mesmo nome e são lidos direto. Só mudaram de formato:
    --   exp1..5 (Name/Bonus/Check)          → lista "experiencias" (nome, bonus)
    --   slot1..7 (item/itemquantity/diceroll)→ lista "itensRapidos" (nome, qtd, rolagem)
    --   invWeap1..2 (Name/Trait/...)         → lista "armasReserva"
    --   profCheck1..6                        → proficiencia (número)
    --   heritage, damageThresholds, anotacoes6..9 → acrescentados em "Outras notas" (anotacoes3)
    -- Nada é apagado: os campos antigos continuam salvos na ficha. Roda uma vez (sheet.migracaoV3).
    -- ============================================================
    local function listaVazia(campo)
        local no = sheet[campo]
        return no == nil or #NDB.getChildNodes(no) == 0
    end

    local function migrarFichaAntiga()
        if sheet == nil or sheet.migracaoV3 ~= nil then return end
        local ok, err = pcall(function()
            -- Experiências
            if listaVazia("experiencias") then
                for i = 1, 5 do
                    local nome = sheet["exp" .. i .. "Name"]
                    local bonus = sheet["exp" .. i .. "Bonus"]
                    if not vazio(nome) or not vazio(bonus) then
                        local no = self.rclExperiencias:append()
                        if no ~= nil then
                            no.nome = nome or ""
                            no.bonus = bonus or ""
                        end
                    end
                end
            end
            -- Inventário rápido
            if listaVazia("itensRapidos") then
                for i = 1, 7 do
                    local item = sheet["slot" .. i .. "item"]
                    local qtd = sheet["slot" .. i .. "itemquantity"]
                    local rol = sheet["slot" .. i .. "diceroll"]
                    if not vazio(item) or not vazio(rol) then
                        local no = self.rclItens:append()
                        if no ~= nil then
                            no.nome = item or ""
                            no.qtd = qtd or ""
                            no.rolagem = rol or ""
                        end
                    end
                end
            end
            -- Armas de inventário
            if listaVazia("armasReserva") then
                for i = 1, 2 do
                    local p = "invWeap" .. i
                    if not vazio(sheet[p .. "Name"]) then
                        local no = self.rclReserva:append()
                        if no ~= nil then
                            no.nome = sheet[p .. "Name"]
                            no.atributo = sheet[p .. "Trait"] or ""
                            no.alcance = sheet[p .. "Range"] or ""
                            local dano = sheet[p .. "Damage"] or ""
                            if not vazio(sheet[p .. "Type"]) then dano = dano .. " " .. sheet[p .. "Type"] end
                            no.dano = dano
                            no.empunhadura = sheet[p .. "Burden"] or ""
                            no.caracteristica = sheet[p .. "Feature"] or ""
                        end
                    end
                end
            end
            -- Proficiência
            if vazio(sheet.proficiencia) then
                local n = 0
                for i = 1, 6 do
                    if sheet["profCheck" .. i] == true then n = n + 1 end
                end
                if n > 0 then sheet.proficiencia = tostring(n) end
            end
            -- Texto das cartas já escolhidas (a ficha antiga não guardava o texto)
            for _, c in ipairs({"cardAncestry", "cardCommunity", "cardTransformation", "cardClass1", "cardClass2",
                                "cardClass3", "cardDomain1", "cardDomain2", "cardDomain3", "cardDomain4",
                                "cardDomain5"}) do
                if not vazio(sheet[c .. "Nome"]) and vazio(sheet[c .. "Texto"]) then preencherCarta(c) end
            end
            -- Campos sem equivalente: vão para "Outras notas"
            local extra = {}
            if not vazio(sheet.heritage) then table.insert(extra, "Ancestralidade / Comunidade: " .. sheet.heritage) end
            if not vazio(sheet.damageThresholds) then table.insert(extra, "Limiares: " .. sheet.damageThresholds) end
            for i = 6, 9 do
                if not vazio(sheet["anotacoes" .. i]) then table.insert(extra, sheet["anotacoes" .. i]) end
            end
            if #extra > 0 then
                local atual = sheet.anotacoes3 or ""
                if atual ~= "" then atual = atual .. "\n\n" end
                sheet.anotacoes3 = atual .. "— Trazido da ficha antiga —\n" .. table.concat(extra, "\n\n")
            end
        end)
        if ok then
            sheet.migracaoV3 = "3.1.2"
        else
            pcall(print, "[Daggerheart] migração: " .. tostring(err))
        end
    end

    local function aoCarregar()
        if sheet == nil then return end
        if sheet.autoEsperanca == nil then sheet.autoEsperanca = true end
        migrarFichaAntiga()
        atualizarFormatoTextos()
        for i = 1, 5 do filtrarCartasDomain(i) end
        rotularCombosOrigem()
        for _, c in ipairs(CAMPOS_CARTA) do atualizarTitulo(c) end
        atualizarSubclasses()
        atualizarDadosDualidade()
        atualizarModoImagem("cardAncestry", VALOR_ANCESTRY_CUSTOM, "imgAncestryView", "imgAncestryEdit")
        atualizarModoImagem("cardTransformation", VALOR_TRANSFORMATION_CUSTOM, "imgTransformationView",
            "imgTransformationEdit")
        aplicarTema(sheet.temaFicha or "vigilia")
        atualizarEsperanca()
        atualizarMaximos()
        atualizarOuro()
        atualizarTextos()
        atualizarCoresDados()
    end

    ]]></script>
    <rectangle strokeSize="0" color="#171923" align="client" name="fundo">
        <scrollBox align="client" name="sbMain" g-cnt-gutter="0" g-cnt-line-spacing="0">
            <rectangle strokeSize="0" color="#222533" g="col" g-width="12" g-auto-height="true" g-cnt-gutter="20" g-cnt-line-spacing="18" padding="{left=22,right=22,top=22,bottom=20}" name="t1">
                <layout g="col" g-width="12" height="22">
                    <image src="/images/vigilia/swords.png" style="proportional" width="20" height="20" hitTest="false" margins="{right=10,top=1,bottom=1}" align="left" name="t2"/>
                    <label text="DAGGERHEART" fontSize="17" fontColor="#F1EDF5" fontFamily="Bitter" textTrimming="none" vertTextAlign="center" fontStyle="bold" width="160" align="left" name="t3"/>
                    <layout align="client">
                        <rectangle strokeSize="0" color="#00000000" align="right" width="200" hitTest="true" cursor="handPoint" hint="Tema e cores dos dados">
                            <layout align="client" hitTest="false">
                                <layout align="client">
                                    <image src="/images/vigilia/settings-2.png" style="proportional" width="16" height="16" hitTest="false" name="icoConfig" margins="{left=10,top=3,bottom=3}" align="right"/>
                                    <layout align="client">
                                        <rectangle strokeSize="0" color="#B23EFF" name="dotFear" width="10" margins="{left=6,top=6,bottom=6}" cornerType="round" xradius="5" yradius="5" hitTest="false" align="right"/>
                                        <layout align="client">
                                            <rectangle strokeSize="0" color="#FFEA99" name="dotHope" width="10" margins="{left=8,top=6,bottom=6}" cornerType="round" xradius="5" yradius="5" hitTest="false" align="right"/>
                                            <label text="Esperança / Medo" fontSize="11" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" horzTextAlign="trailing" hitTest="false" align="client" name="t4"/>
                                        </layout>
                                    </layout>
                                </layout>
                            </layout>
                            <event name="onClick">self.popConfig:show("bottom", self.icoConfig)</event>
                        </rectangle>
                        <layout align="client"/>
                    </layout>
                </layout>
                <layout g="col" g-width="12" g-width-md="7" height="116" name="identidadeBox">
                    <rectangle strokeSize="1" color="#2B2D3D" name="avatarBox" align="left" width="116" strokeColor="#404254" cornerType="round" xradius="12" yradius="12" margins="{right=16}" padding="{left=4,right=4,top=4,bottom=4}">
                        <image align="client" field="avatar" editable="true" style="autoFit" hint="Clique para escolher o retrato do personagem">
                            <event name="OnStartDrag">drag:addData("imageURL", sheet.avatar)</event>
                        </image>
                    </rectangle>
                    <layout align="client">
                        <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=8,right=8,top=0,bottom=0}" height="44" align="top" name="t5">
                            <edit field="nome" fontSize="26" fontColor="#F1EDF5" fontFamily="Bitter" transparent="true" vertTextAlign="center" fontStyle="bold" textPrompt="Nome do Personagem" align="client" name="t6"/>
                        </rectangle>
                        <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=8,right=8,top=0,bottom=0}" height="26" align="top" margins="{top=8}" name="t7">
                            <edit field="pronouns" fontSize="13" fontColor="#BBB5CA" fontFamily="Inter" transparent="true" vertTextAlign="center" textPrompt="Pronomes" align="client" name="t8"/>
                        </rectangle>
                        <layout align="top" height="26" margins="{top=8}">
                            <label fontSize="13" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="character" vertTextAlign="center" align="left" width="130" hint="Ancestralidade (definida na aba Cartas)" field="cardAncestryTitulo" name="t9"/>
                            <label text="·" fontSize="13" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" align="left" width="14" horzTextAlign="center" name="t10"/>
                            <label fontSize="13" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="character" vertTextAlign="center" align="client" hint="Comunidade (definida na aba Cartas)" field="cardCommunityTitulo" name="t11"/>
                        </layout>
                    </layout>
                    <event name="onResize">if self.identidadeBox.width &lt; 430 then self.avatarBox.width = 84 else self.avatarBox.width = 116 end</event>
                </layout>
                <layout g="col" g-width="12" g-width-md="5" height="116">
                    <layout align="right" width="76" margins="{left=20}">
                        <rectangle strokeSize="1" color="#00000000" align="top" height="76" margins="{top=20}" strokeColor="#CEAF73" cornerType="round" xradius="12" yradius="12" name="t12">
                            <label text="NÍVEL" fontSize="10" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="14" horzTextAlign="center" margins="{top=8}" name="t13"/>
                            <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=2,right=2,top=0,bottom=0}" align="client" margins="{left=10,right=10,top=2,bottom=8}" name="t14">
