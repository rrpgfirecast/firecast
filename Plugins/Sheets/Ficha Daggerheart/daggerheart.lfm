                        <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=8,right=8,top=0,bottom=0}" align="client" margins="{top=4,right=16}" name="t24">
