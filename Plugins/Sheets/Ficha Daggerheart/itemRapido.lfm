<?xml version="1.0" encoding="UTF-8"?>
<form name="frmDHItemRapido" height="48" margins="{top=0,bottom=0}" theme="dark">
    <script><![CDATA[
    -- Formulário de item (recordList) — tema sincronizado com a ficha principal.
local PAL = {
    codice = {formTheme="light", bg="#F4EFE4", surface="#FFFCF5", field="#F4EFE4", text="#302936", muted="#726878", border="#D9CEBE", accent="#593B65", accentSoft="#EDE5EF", onAccent="#F4EFE4", gold="#96753E", hp="#AE525E", stress="#8B66B2", rCard=2, rChip=2, rMark=3, corner=true, selo=true, nome="Códice"},
    vigilia = {formTheme="dark", bg="#171923", surface="#222533", field="#2B2D3D", text="#F1EDF5", muted="#BBB5CA", border="#404254", accent="#C3A5EC", accentSoft="#2B2D3D", onAccent="#171923", gold="#CEAF73", hp="#E998A3", stress="#C3A5EC", rCard=12, rChip=12, rMark=6, corner=false, selo=false, nome="Vigília"},
}

    local TM = {
        "it1","color","border","it2","color","field","it2","strokeColor","border","it3","fontColor","text","it4","src","img:x","it5","color","accentSoft",
        "it5","xradius","rChip","it5","yradius","rChip","it6","fontColor","accent","it7","color","accentSoft","it7","xradius","rChip","it7","yradius","rChip",
        "it8","fontColor","accent","it9","color","field","it9","strokeColor","border","it10","fontColor","accent","it11","color","field","it11","strokeColor","border",
        "it12","fontColor","text",
    }


    local function resolverToken(nomeTema, pal, tok, prop)
        if string.sub(tok, 1, 4) == "img:" then
            local base = "images/"
            if prop == "src" then base = "/images/" end
            return base .. nomeTema .. "/" .. string.sub(tok, 5) .. ".png"
        end
        return pal[tok]
    end

    local function aplicarTabelaTema(form, nomeTema)
        local pal = PAL[nomeTema] or PAL.vigilia
        for i = 1, #TM, 3 do
            local c = form[TM[i]]
            if c ~= nil then
                local v = resolverToken(nomeTema, pal, TM[i + 2], TM[i + 1])
                if v ~= nil then
                    pcall(function() c[TM[i + 1]] = v end)
                end
            end
        end
        pcall(function() form.theme = pal.formTheme end)
        return pal
    end


    local observador = nil

    local function temaDaFicha()
        if sheet == nil then return "vigilia" end
        local raiz = NDB.getRoot(sheet)
        if raiz ~= nil and raiz.temaFicha ~= nil and PAL[raiz.temaFicha] ~= nil then
            return raiz.temaFicha
        end
        return "vigilia"
    end

    local function desligarTema()
        if observador ~= nil then
            observador.enabled = false
            observador = nil
        end
    end

    local function ligarTema()
        if sheet == nil then return end
        aplicarTabelaTema(self, temaDaFicha())
        desligarTema()
        local raiz = NDB.getRoot(sheet)
        if raiz ~= nil then
            observador = NDB.newObserver(raiz)
            if observador ~= nil then
                observador.onChanged = function(node, attribute, oldValue)
                    if attribute == "temaFicha" then
                        aplicarTabelaTema(self, temaDaFicha())
                    end
                end
            end
        end
    end

    local function vazio(v)
        return v == nil or v == ""
    end

    local function mesaDoItem()
        if sheet == nil then return nil end
        local m = Firecast.getMesaDe(NDB.getRoot(sheet))
        if m == nil then
            showMessage("Abra esta ficha dentro de uma mesa para usar o chat.")
        end
        return m
    end

    local function rolarItem()
        if sheet == nil then return end
        if vazio(sheet.rolagem) then
            showMessage("Informe a rolagem do item (ex.: 1d4+1).")
            return
        end
        local rolagem = Firecast.interpretarRolagem(sheet.rolagem)
        if not rolagem.possuiAlgumDado then
            showMessage("Não entendi a rolagem: " .. sheet.rolagem)
            return
        end
        local m = mesaDoItem()
        if m == nil then return end
        m.activeChat:rolarDados(rolagem, "Item: " .. (sheet.nome or ""))
    end

    local function enviarItem()
        if sheet == nil then return end
        local m = mesaDoItem()
        if m == nil then return end
        local nick = (m.meuJogador and m.meuJogador.nick) or ""
        local msg = "[Item] " .. nick .. "[§R][§K2] usou: [§K1][§B]" .. (sheet.nome or "item") .. "[§B]"
        if not vazio(sheet.qtd) then msg = msg .. " (" .. sheet.qtd .. ")" end
        m.activeChat:enviarMensagem(msg)
    end


    ]]></script>
    <rectangle strokeSize="0" color="#00000000" align="client">
        <rectangle strokeSize="0" color="#404254" align="bottom" height="1" name="it1"/>
        <layout align="client">
            <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=8,right=8,top=0,bottom=0}" width="70" margins="{right=8,top=8,bottom=8}" align="left" name="it2">
                <edit field="qtd" fontSize="14" fontColor="#F1EDF5" fontFamily="Inter" transparent="true" vertTextAlign="center" horzTextAlign="center" textPrompt="—" align="client" name="it3"/>
            </rectangle>
            <layout align="client">
                <rectangle strokeSize="0" color="#00000000" align="right" width="26" hitTest="true" cursor="handPoint" hint="Remover" margins="{left=6}">
                    <image src="/images/vigilia/x.png" style="proportional" width="14" height="14" hitTest="false" align="client" margins="{left=6,right=6,top=8,bottom=8}" name="it4"/>
                    <event name="onClick">Dialogs.confirmYesNo("Remover este registro?", function(ok) if ok then NDB.deleteNode(sheet) end end)</event>
                </rectangle>
                <layout align="client">
                    <rectangle strokeSize="0" color="#2B2D3D" height="30" cornerType="round" xradius="12" yradius="12" hitTest="true" cursor="handPoint" width="64" margins="{left=6,top=9,bottom=9}" align="right" name="it5">
                        <label text="Chat ↗" fontSize="12" fontColor="#C3A5EC" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="client" horzTextAlign="center" hitTest="false" name="it6"/>
                        <event name="onClick">enviarItem()</event>
                    </rectangle>
                    <layout align="client">
                        <rectangle strokeSize="0" color="#2B2D3D" height="30" cornerType="round" xradius="12" yradius="12" hitTest="true" cursor="handPoint" width="60" margins="{left=8,top=9,bottom=9}" align="right" name="it7">
                            <label text="Rolar" fontSize="12" fontColor="#C3A5EC" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="client" horzTextAlign="center" hitTest="false" name="it8"/>
                            <event name="onClick">rolarItem()</event>
                        </rectangle>
                        <layout align="client">
                            <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=8,right=8,top=0,bottom=0}" width="110" margins="{left=8,top=8,bottom=8}" align="right" name="it9">
                                <edit field="rolagem" fontSize="15" fontColor="#C3A5EC" fontFamily="Inter" transparent="true" vertTextAlign="center" textPrompt="1d4" align="client" name="it10"/>
                            </rectangle>
                            <rectangle strokeSize="1" color="#2B2D3D" strokeColor="#404254" sides="bottom" cornerType="round" xradius="3" yradius="3" padding="{left=8,right=8,top=0,bottom=0}" margins="{top=8,bottom=8}" align="client" name="it11">
                                <edit field="nome" fontSize="15" fontColor="#F1EDF5" fontFamily="Inter" transparent="true" vertTextAlign="center" textPrompt="Nome do item" align="client" name="it12"/>
                            </rectangle>
                        </layout>
                    </layout>
                </layout>
            </layout>
        </layout>
    </rectangle>
    <event name="onNodeReady">ligarTema()</event>
    <event name="onNodeUnready">desligarTema()</event>
</form>
