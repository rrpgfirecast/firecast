<?xml version="1.0" encoding="UTF-8"?>
<form name="frmDHSessao" height="196" margins="{top=0,bottom=0}" theme="dark">
    <script><![CDATA[
    -- Formulário de item (recordList) — tema sincronizado com a ficha principal.
local PAL = {
    codice = {formTheme="light", bg="#F4EFE4", surface="#FFFCF5", field="#F4EFE4", text="#302936", muted="#726878", border="#D9CEBE", accent="#593B65", accentSoft="#EDE5EF", onAccent="#F4EFE4", gold="#96753E", hp="#AE525E", stress="#8B66B2", rCard=2, rChip=2, rMark=3, corner=true, selo=true, nome="Códice"},
    vigilia = {formTheme="dark", bg="#171923", surface="#222533", field="#2B2D3D", text="#F1EDF5", muted="#BBB5CA", border="#404254", accent="#C3A5EC", accentSoft="#2B2D3D", onAccent="#171923", gold="#CEAF73", hp="#E998A3", stress="#C3A5EC", rCard=12, rChip=12, rMark=6, corner=false, selo=false, nome="Vigília"},
}

    local TM = {
        "it1","color","border","it2","src","img:x","it3","color","field","it3","strokeColor","border","it4","fontColor","muted","it5","fontColor","text",
        "it6","color","field","it6","strokeColor","border","it7","fontColor","muted","it8","fontColor","text","it9","color","field","it9","strokeColor","border",
        "it10","fontColor","muted","it11","fontColor","text","it12","color","field","it12","strokeColor","border","it13","fontColor","text",
    }


    local function resolverToken(nomeTema, pal, tok, prop)
        if string.sub(tok, 1, 4) == "img:" then
            local base = "images/"
            if prop == "src" then base = "/images/" end
            return base .. nomeTema .. "/" .. string.sub(tok, 5) .. ".png"
        end
        return pal[tok]
    end

    local function aplicarTabelaTema(form, nomeTema)
        local pal = PAL[nomeTema] or PAL.vigilia
        for i = 1, #TM, 3 do
            local c = form[TM[i]]
            if c ~= nil then
                local v = resolverToken(nomeTema, pal, TM[i + 2], TM[i + 1])
                if v ~= nil then
                    pcall(function() c[TM[i + 1]] = v end)
                end
            end
        end
        pcall(function() form.theme = pal.formTheme end)
        return pal
    end


    local observador = nil

    local function temaDaFicha()
        if sheet == nil then return "vigilia" end
        local raiz = NDB.getRoot(sheet)
        if raiz ~= nil and raiz.temaFicha ~= nil and PAL[raiz.temaFicha] ~= nil then
            return raiz.temaFicha
        end
        return "vigilia"
    end

    local function desligarTema()
        if observador ~= nil then
            observador.enabled = false
            observador = nil
        end
    end

    local function ligarTema()
        if sheet == nil then return end
        aplicarTabelaTema(self, temaDaFicha())
        desligarTema()
        local raiz = NDB.getRoot(sheet)
        if raiz ~= nil then
            observador = NDB.newObserver(raiz)
            if observador ~= nil then
                observador.onChanged = function(node, attribute, oldValue)
                    if attribute == "temaFicha" then
                        aplicarTabelaTema(self, temaDaFicha())
                    end
                end
            end
        end
    end

    local function vazio(v)
        return v == nil or v == ""
    end

    local function mesaDoItem()
        if sheet == nil then return nil end
        local m = Firecast.getMesaDe(NDB.getRoot(sheet))
        if m == nil then
            showMessage("Abra esta ficha dentro de uma mesa para usar o chat.")
        end
        return m
    end



    ]]></script>
    <rectangle strokeSize="0" color="#00000000" align="client" padding="{top=8,bottom=12}">
        <rectangle strokeSize="0" color="#404254" align="bottom" height="1" name="it1"/>
        <layout align="top" height="52">
            <rectangle strokeSize="0" color="#00000000" align="right" width="26" hitTest="true" cursor="handPoint" hint="Remover" margins="{left=6}">
                <image src="/images/vigilia/x.png" style="proportional" width="14" height="14" hitTest="false" align="client" margins="{left=6,right=6,top=8,bottom=8}" name="it2"/>
                <event name="onClick">Dialogs.confirmYesNo("Remover este registro?", function(ok) if ok then NDB.deleteNode(sheet) end end)</event>
            </rectangle>
            <rectangle strokeSize="1" color="#2B2D3D" height="52" strokeColor="#404254" sides="bottom" padding="{left=12,right=12,top=6,bottom=4}" align="left" width="90" margins="{right=12}" name="it3">
                <label text="SESSÃO" fontSize="10" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="16" name="it4"/>
                <edit field="numero" fontSize="14" fontColor="#F1EDF5" fontFamily="Inter" transparent="true" vertTextAlign="center" align="client" horzTextAlign="leading" name="it5"/>
            </rectangle>
            <rectangle strokeSize="1" color="#2B2D3D" height="52" strokeColor="#404254" sides="bottom" padding="{left=12,right=12,top=6,bottom=4}" align="left" width="130" margins="{right=12}" name="it6">
                <label text="DATA" fontSize="10" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="16" name="it7"/>
                <edit field="data" fontSize="14" fontColor="#F1EDF5" fontFamily="Inter" transparent="true" vertTextAlign="center" align="client" horzTextAlign="leading" name="it8"/>
            </rectangle>
            <rectangle strokeSize="1" color="#2B2D3D" height="52" strokeColor="#404254" sides="bottom" padding="{left=12,right=12,top=6,bottom=4}" align="client" name="it9">
                <label text="TÍTULO OU LUGAR" fontSize="10" fontColor="#BBB5CA" fontFamily="Inter" textTrimming="none" vertTextAlign="center" fontStyle="bold" align="top" height="16" name="it10"/>
                <edit field="titulo" fontSize="14" fontColor="#F1EDF5" fontFamily="Inter" transparent="true" vertTextAlign="center" align="client" horzTextAlign="leading" name="it11"/>
            </rectangle>
        </layout>
        <rectangle strokeSize="1" color="#2B2D3D" align="client" margins="{top=10}" strokeColor="#404254" sides="bottom" padding="{left=10,right=10,top=6,bottom=6}" name="it12">
            <textEditor align="client" field="resumo" transparent="true" fontSize="14" fontColor="#F1EDF5" fontFamily="Inter" wordWrap="true" name="it13"/>
        </rectangle>
    </rectangle>
    <event name="onNodeReady">ligarTema()</event>
    <event name="onNodeUnready">desligarTema()</event>
</form>
