        <event name="onChange"><![CDATA[
            for i=1,10 do
                local rect = self:findControlByName("rectTradeMeuSlot" .. tostring(i) .. "Border")
                if rect ~= nil then
                    local cor = tostring(sheet["TradeMeuSlot" .. tostring(i) .. "_corRank"] or "#D0D0D0")
                    rect.strokeColor = cor
                    pcall(function() rect:setStrokeColor(cor) end)
