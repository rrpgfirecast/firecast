    <dataLink fields="{'OuroPersonagem','PrataPersonagem','TradeHostId','TradeConvidadoId','FirebaseCharacterId'}">
        <event name="onChange"><![CDATA[
            CWNA_trocaAtualizarMoedasTopo(sheet)
            local souGuest = tostring(sheet.FirebaseCharacterId or "") ~= "" and tostring(sheet.FirebaseCharacterId or "") == tostring(sheet.TradeConvidadoId or "")
            local nomesHost = {"lblTradeSaldoHostTitulo","lblTradeSaldoHostOuroTxt","lblTradeSaldoHostOuro","lblTradeSaldoHostPrataTxt","lblTradeSaldoHostPrata"}
            local nomesGuest = {"lblTradeSaldoGuestTitulo","lblTradeSaldoGuestOuroTxt","lblTradeSaldoGuestOuro","lblTradeSaldoGuestPrataTxt","lblTradeSaldoGuestPrata"}
            for _, nome in ipairs(nomesHost) do
                local c = self:findControlByName(nome)
                if c ~= nil then c.visible = not souGuest end
            end
            for _, nome in ipairs(nomesGuest) do
                local c = self:findControlByName(nome)
                if c ~= nil then c.visible = souGuest end
            end
        ]]></event>
    </dataLink>
    <dataLink fields="{'TradeHostCheckCor','TradeConvidadoCheckCor'}">
        <event name="onChange"><![CDATA[
            local h = self:findControlByName("lblTradeHostCheck")
            local g = self:findControlByName("lblTradeConvidadoCheck")
            if h ~= nil then h.fontColor = tostring(sheet.TradeHostCheckCor or "#D84A4A") end
            if g ~= nil then g.fontColor = tostring(sheet.TradeConvidadoCheckCor or "#D84A4A") end
        ]]></event>
    </dataLink>

