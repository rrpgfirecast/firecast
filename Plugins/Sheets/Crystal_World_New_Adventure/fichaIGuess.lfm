    <label text="DETALHES DO ITEM" left="613" top="38" width="230" height="24" horzTextAlign="center" fontColor="white" fontStyle="bold"/>

    <rectangle left="623" top="82" width="218" height="138" color="#24272C" strokeColor="#50545E" strokeSize="1" xradius="6" yradius="6" cornerType="round"/>
    <image field="TempCompraLojaImagem" left="629" top="88" width="206" height="126" style="autoFit" animate="true" showProgress="false" hitTest="false"/>

    <rectangle left="623" top="228" width="218" height="94" color="#32353B" strokeColor="#50545E" strokeSize="1" xradius="6" yradius="6" cornerType="round"/>
    <textEditor name="lblCompraNomeLoja" field="TempCompraLojaNomeDisplay" left="627" top="234" width="198" height="48" fontColor="white" readOnly="true"/>
    <label field="TempCompraLojaRankDisplay" left="627" top="286" width="198" height="30" fontColor="#C8A000" fontStyle="bold" horzTextAlign="center" vertTextAlign="center"/>

    <rectangle left="623" top="330" width="218" height="98" color="#24272C" strokeColor="#50545E" strokeSize="1" xradius="6" yradius="6" cornerType="round"/>
