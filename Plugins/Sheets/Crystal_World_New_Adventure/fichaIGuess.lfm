	<imageCheckBox name="CURTO"
		left="577" top="985" width="28" height="55"
		checkedImage=""
		uncheckedImage="">

		<event name="onClick">

		local mesa = Firecast.getMesaDe(sheet);
		if not CWNA_gastarPPAtaque(sheet, "CustoPPAtaque1", "Ataque Curto Alcance", self) then
            return
        end;
        if not CWNA_consumirDurabilidadeArma(sheet, self) then return end;

		local acerto = tonumber(sheet.AcertoCurtoAlcanceTotal) or 0;
		local r1 = Firecast.interpretarRolagem("1d20+" .. acerto);

		if mesa then
			mesa.chat:rolarDados(r1, "Acerto Curto Alcance");
		end;

		if true then
			local danoBase = tonumber(sheet.DanoCurtoAlcanceTotal) or 0;

			local r2 = Firecast.interpretarRolagem(
				CWNA_formulaDanoComArma(sheet, sheet.DanoMonstro1, danoBase)
			);

			if mesa then
				mesa.chat:rolarDados(r2, "Dano Curto Alcance");
			end;
		end;

		</event>

	</imageCheckBox>

