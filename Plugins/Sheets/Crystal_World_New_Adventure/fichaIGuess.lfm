local function limparTextoInventario(valor)
    return string.lower(tostring(valor or "")):gsub("^%s*(.-)%s*$", "%1")
end

local function normalizarChaveCatalogoInventario(valor)
    local texto = limparTextoInventario(valor)
    texto = texto:gsub("ÃƒÆ’Ã‚Â¡", "a"):gsub("ÃƒÆ’Ã‚Â ", "a"):gsub("ÃƒÆ’Ã‚Â¢", "a"):gsub("ÃƒÆ’Ã‚Â£", "a")
    texto = texto:gsub("ÃƒÆ’Ã‚Â©", "e"):gsub("ÃƒÆ’Ã‚Âª", "e"):gsub("ÃƒÆ’Ã‚Â­", "i")
    texto = texto:gsub("ÃƒÆ’Ã‚Â³", "o"):gsub("ÃƒÆ’Ã‚Â´", "o"):gsub("ÃƒÆ’Ã‚Âµ", "o")
    texto = texto:gsub("ÃƒÆ’Ã‚Âº", "u"):gsub("ÃƒÆ’Ã‚Â§", "c")
    texto = texto:gsub("ÃƒÂ¡", "a"):gsub("ÃƒÂ ", "a"):gsub("ÃƒÂ£", "a"):gsub("ÃƒÂ¢", "a")
    texto = texto:gsub("ÃƒÂ©", "e"):gsub("ÃƒÂª", "e")
    texto = texto:gsub("ÃƒÂ­", "i")
    texto = texto:gsub("ÃƒÂ³", "o"):gsub("ÃƒÂ´", "o"):gsub("ÃƒÂµ", "o")
    texto = texto:gsub("ÃƒÂº", "u"):gsub("ÃƒÂ¼", "u")
    texto = texto:gsub("ÃƒÂ§", "c")
    return texto
end

local function textoPotionInventario(valor)
    local texto = normalizarChaveCatalogoInventario(valor)
    texto = texto:gsub("[_%-%:]+", " "):gsub("%s+", " "):gsub("^%s*(.-)%s*$", "%1")
    return texto
end

local function textoComecaComoPotionInventario(texto)
    texto = textoPotionInventario(texto)
    return texto:find("^potion") ~= nil
        or texto:find("^pocao") ~= nil
        or texto:find("^parcao") ~= nil
end

function CWNA_distanciaLuzItemInventario(item)
    if item ~= nil then
        for _, campo in ipairs({"raio", "luz", "raioLuz", "metrosLuz", "alcanceLuz", "lightIntense"}) do
            local valor = tonumber(item[campo])
            if valor ~= nil and valor > 0 then
                return valor
            end
        end
    end

    local partes = {}
    local function addParte(valor)
        local txt = tostring(valor or "")
        if txt ~= "" then table.insert(partes, txt) end
    end

    if item ~= nil then
        addParte(item.nomeItem)
        addParte(item.tipoItem)
        addParte(item.subtipoMaterial)
        addParte(item.descricaoLoja)
        addParte(item.imagemestilo2)
        addParte(item.ItemEquipadoLuz)
        addParte(item.ImagemLuz)
    end

    local texto = textoPotionInventario(table.concat(partes, " "))
    local raioTexto = texto:match("ilumina%s+(%d+)%s+metros") or texto:match("(%d+)%s+metros")
    if raioTexto ~= nil and tonumber(raioTexto) ~= nil and tonumber(raioTexto) > 0 then
        return tonumber(raioTexto)
    end
    if texto:find("lampiao", 1, true) ~= nil or texto:find("lampi", 1, true) ~= nil then return 18 end
    if texto:find("lamparina", 1, true) ~= nil then return 12 end
    if texto:find("tocha", 1, true) ~= nil or texto:find("torcha", 1, true) ~= nil then return 9 end
    return 0
end

local function slotDoItemInventario(item)
    if CWNA_distanciaLuzItemInventario(item) > 0 then return "Luz" end
    local nome = normalizarChaveCatalogoInventario(item and item.nomeItem)
    if nome:find("mochila", 1, true) ~= nil then return "Mochila" end
    return slotsPorTipoInventario[normalizarChaveCatalogoInventario(item and item.tipoItem)]
end

function CWNA_slotAcessorioInventario(slot)
    return tostring(slot or ""):match("^Acessorio%d+$") ~= nil
end

function CWNA_itemEhAcessorioInventario(item)
    local tipo = normalizarChaveCatalogoInventario(item and item.tipoItem)
    return tipo == "acessorio" or tipo == "acess?rio"
end

function CWNA_slotAceitaItemInventario(slot, item)
    if CWNA_slotAcessorioInventario(slot) then
        return CWNA_itemEhAcessorioInventario(item)
    end
    return slotDoItemInventario(item) == slot
end
local function tipoPotionDoItemInventario(item)
    local tipo = textoPotionInventario(item and item.tipoItem)
    local nome = textoPotionInventario(item and item.nomeItem)
    local texto = tipo .. " " .. nome
    if not textoComecaComoPotionInventario(tipo) and not textoComecaComoPotionInventario(nome) then return nil end
    if texto:find("pp", 1, true) ~= nil then return "PP" end
    if texto:find("hp", 1, true) ~= nil or texto:find("vida", 1, true) ~= nil or texto:find("cura", 1, true) ~= nil then return "HP" end
    return nil
end

local potionsTemporariasInventario = {
    ["potion forca menor"] = true,
    ["potion destreza menor"] = true,
    ["potion constituicao menor"] = true,
    ["potion inteligencia menor"] = true,
    ["potion sabedoria menor"] = true,
    ["potion carisma menor"] = true,
    ["potion dano menor"] = true,
    ["potion acerto menor"] = true,
    ["potion esquiva menor"] = true,
    ["potion ca menor"] = true,
    ["potion rd menor"] = true,
    ["potion hp menor"] = true,
    ["potion pp menor"] = true
}

local function itemEhPotionTemporariaInventario(item)
    if textoPotionInventario(item and item.tipoItem) == "potion especial" then return true end
    local nome = textoPotionInventario(item and item.nomeItem)
    return potionsTemporariasInventario[nome] == true
end

local function itemEhQualquerPotionInventario(item)
    return textoComecaComoPotionInventario(item and item.tipoItem)
        or textoComecaComoPotionInventario(item and item.nomeItem)
end

local function rotuloTipoItemInventario(item)
    local tipo = limparTextoInventario(item and item.tipoItem)

    if tipo == "" then
        return "outros"
    end

    return tipo
end

local function chaveNomeItemInventario(item)
    local nome = normalizarChaveCatalogoInventario(item and item.nomeItem)
    nome = nome:gsub("[_%-%:]+", " ")
    nome = nome:gsub("%s+", " ")

    return nome
end

local function visualDoItemInventario(item)
    local nome = chaveNomeItemInventario(item)
    local entrada = catalogoVisualEquipamentosInventario[nome]

    if entrada ~= nil then
        return entrada
    end

    local rankNoNome = nome:match("rank%s+(%a+)")

    if rankNoNome ~= nil then
        return catalogoVisualEquipamentosInventario["rank " .. rankNoNome]
    end

    return nil
end

local function imagemBaseBonecoInventario(slot)
    local parte = partesBonecoInventario[slot]

    if parte == nil then
        return nil
    end

    return "/Frames/equipes/" .. parte .. "_base.png"
end

local function imagemEquipamentoBonecoInventario(item, slot)
    local parte = partesBonecoInventario[slot]
    local entrada = visualDoItemInventario(item)

    if parte == nil or entrada == nil then
        return imagemBaseBonecoInventario(slot)
    end

    local nomeArquivo = nil

    if entrada.partes ~= nil then
        nomeArquivo = entrada.partes[slot]
    end

    if nomeArquivo == nil and entrada.rank ~= nil then
        nomeArquivo = parte .. "_" .. entrada.rank
    end

    if nomeArquivo == nil or entrada.rank == nil then
        return imagemBaseBonecoInventario(slot)
    end

    return "/Frames/equipes/" .. entrada.rank .. "/" .. nomeArquivo .. ".png"
end

function CWNA_uidSkin()
    return tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
end

local SKIN_RANK_C_TESTE_UID = "cwna_skin_rank_c_teste"
local SKIN_RANK_C_TESTE_NOME = "RANK C TESTE"
local SKIN_RANK_C_TESTE_IMAGEM = "https://blob.firecast.com.br/blobs/HIGCMCDM_4483065/Firefly_preciso_somente_da_capa_se_mechend.mp4"

function CWNA_recalcularVisualSkinInventario(ficha, controleOrigem)
    if atualizarVisualSkinInventario ~= nil then
        atualizarVisualSkinInventario(ficha, controleOrigem)
    end
end

local function CWNA_atualizarCardsSkinInventario(ficha)
    if ficha == nil or ficha.skins == nil then
        return
    end

    local marcador = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))

    for _, skin in ipairs(NDB.getChildNodes(ficha.skins)) do
        skin.atualizacaoSkin = marcador
    end
end

local function skinEquipadaInventario(ficha)
    if ficha == nil or ficha.skins == nil or ficha.SkinEquipadaUid == nil or ficha.SkinEquipadaUid == "" then
        return nil
    end

    for _, skin in ipairs(NDB.getChildNodes(ficha.skins)) do
        if tostring(skin.uidSkin or "") == tostring(ficha.SkinEquipadaUid or "") then
            return skin
        end
    end

    return nil
end

local skinsAutomaticasRankInventario = {
    {rank = "c", campo = "BonecoSkinRankC", imagem = "/Frames/Skins/rankc.jpg"},
    {rank = "b", campo = "BonecoSkinRankB", imagem = "/Frames/Skins/rankb.jpg"},
    {rank = "a", campo = "BonecoSkinRankA", imagem = "/Frames/Skins/ranka.jpg"},
    {rank = "s", campo = "BonecoSkinRankS", imagem = "/Frames/Skins/ranks.jpg"}
}

local function skinPorUidInventario(ficha, uid)
    if ficha == nil or ficha.skins == nil or uid == nil then
        return nil
    end

    for _, skin in ipairs(NDB.getChildNodes(ficha.skins)) do
        if tostring(skin.uidSkin or "") == tostring(uid or "") then
            return skin
        end
    end

    return nil
end

local function ehSkinRankCTesteInventario(skin)
    return skin ~= nil and (
        tostring(skin.uidSkin or "") == SKIN_RANK_C_TESTE_UID or
        string.upper(tostring(skin.nomeSkin or "")) == SKIN_RANK_C_TESTE_NOME
    )
end

local function garantirSkinRankCTesteInventario(ficha)
    if ficha == nil then
        return
    end

    if ficha.skins == nil then
        NDB.createChildNode(ficha, "skins")
    end

    local skin = skinPorUidInventario(ficha, SKIN_RANK_C_TESTE_UID)

    if skin == nil then
        for _, skinExistente in ipairs(NDB.getChildNodes(ficha.skins)) do
            if string.upper(tostring(skinExistente.nomeSkin or "")) == SKIN_RANK_C_TESTE_NOME then
                skin = skinExistente
                break
            end
        end
    end

    if skin == nil then
        skin = NDB.createChildNode(ficha.skins, "skin")
    end

    skin.uidSkin = SKIN_RANK_C_TESTE_UID
    skin.nomeSkin = SKIN_RANK_C_TESTE_NOME
    skin.imagemSkin = SKIN_RANK_C_TESTE_IMAGEM
    skin.liberada = "true"
end

local function removerSkinRankCTesteNaoDesbloqueadaInventario(ficha)
    if ficha == nil or ficha.skins == nil then
        return false
    end

    local removeu = false

    for _, skin in ipairs(NDB.getChildNodes(ficha.skins)) do
        if ehSkinRankCTesteInventario(skin) and tostring(skin.desbloqueioSetC or "") ~= "true" then
            if tostring(ficha.SkinEquipadaUid or "") == tostring(skin.uidSkin or "") then
                ficha.SkinEquipadaUid = ""
            end

            NDB.deleteNode(skin)
            removeu = true
        end
    end

    return removeu
end

local function corrigirSkinRankCTesteEquipadaAntigaInventario(ficha)
    if ficha == nil then
        return false
    end

    if tostring(ficha.SkinEquipadaUid or "") == SKIN_RANK_C_TESTE_UID and tostring(ficha.SkinRankCTesteEquipCorrigido or "") ~= "true" then
        ficha.SkinEquipadaUid = ""
        ficha.SkinRankCTesteEquipCorrigido = "true"
        return true
    end

    if tostring(ficha.SkinEquipadaUid or "") ~= SKIN_RANK_C_TESTE_UID then
        ficha.SkinRankCTesteEquipCorrigido = "true"
    end

    return false
end

local function desbloquearSkinRankCTesteInventario(ficha, controleOrigem)
    if ficha == nil then
        return false
    end

    if ficha.skins == nil then
        NDB.createChildNode(ficha, "skins")
    end

    local skin = skinPorUidInventario(ficha, SKIN_RANK_C_TESTE_UID)

    if skin == nil then
        for _, skinExistente in ipairs(NDB.getChildNodes(ficha.skins)) do
            if string.upper(tostring(skinExistente.nomeSkin or "")) == SKIN_RANK_C_TESTE_NOME then
                skin = skinExistente
                break
            end
        end
    end

    local desbloqueouAgora = skin == nil or tostring(skin.desbloqueioSetC or "") ~= "true"
    local limparEquipamentoAntigo = desbloqueouAgora and skin ~= nil and tostring(ficha.SkinEquipadaUid or "") == tostring(skin.uidSkin or "")

    if skin == nil then
        skin = NDB.createChildNode(ficha.skins, "skin")
    end

    skin.uidSkin = SKIN_RANK_C_TESTE_UID
    skin.nomeSkin = SKIN_RANK_C_TESTE_NOME
    skin.imagemSkin = SKIN_RANK_C_TESTE_IMAGEM
    skin.liberada = "true"
    skin.desbloqueioSetC = "true"

    if limparEquipamentoAntigo then
        ficha.SkinEquipadaUid = ""
    end

    if desbloqueouAgora then
        return true
    end

    return false
end

local function conjuntoRankCompletoInventario(dadosPorSlot, rank)
    local slotsSet = {"Capacete", "Peitoral", "Calca", "Bota"}

    for _, slot in ipairs(slotsSet) do
        local dados = dadosPorSlot and dadosPorSlot[slot] or nil
        local entrada = visualDoItemInventario(dados)

        if entrada == nil or tostring(entrada.rank or "") ~= tostring(rank or "") then
            return false
        end
    end

    return true
end

local function limparSkinsAutomaticasAntigasInventario(ficha)
    if ficha == nil or ficha.skins == nil then
        return false
    end

    local removeu = false

    for _, skin in ipairs(NDB.getChildNodes(ficha.skins)) do
        if tostring(skin.skinAutomatica or "") == "true" then
            if tostring(ficha.SkinEquipadaUid or "") == tostring(skin.uidSkin or "") then
                ficha.SkinEquipadaUid = ""
            end

            NDB.deleteNode(skin)
            removeu = true
        end
    end

    return removeu
end

local function skinRankAtivaInventario(dadosPorSlot)
    for _, skinAuto in ipairs(skinsAutomaticasRankInventario) do
        if conjuntoRankCompletoInventario(dadosPorSlot, skinAuto.rank) then
            return skinAuto
        end
    end

    return nil
end

local function limparCamposSkinRankInventario(ficha)
    if ficha == nil then
        return
    end

    ficha.BonecoSkinRankCTeste = ""

    for _, skinAuto in ipairs(skinsAutomaticasRankInventario) do
        ficha[skinAuto.campo] = ""
    end
end

local function fixNumeroInventario(v)
    if v == nil then return 0 end

    local s = tostring(v)
    s = s:gsub("%s+", "")
    s = s:gsub(",", ".")

    return tonumber(s) or 0
end

local function uidInventarioItem(item)
    if item == nil then
        return nil
    end

    if item.uidInventario == nil or item.uidInventario == "" then
        item.uidInventario = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    end

    return item.uidInventario
end

local function procurarItemInventarioPorUid(ficha, uid)
    if ficha == nil or uid == nil then
        return nil
    end

    local lista = ficha.magias2

    if lista == nil then
        return nil
    end

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        if item.uidInventario == uid then
            return item
        end
    end

    return nil
end

local function ehSlotVazioInventario(item)
    return item ~= nil and tostring(item.slotVazio or "") == "true"
end

local function contarItensReaisInventario(lista)
    local total = 0

    if lista == nil then
        return total
    end

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        if not ehSlotVazioInventario(item) then
            total = total + 1
        end
    end

    return total
end

local function contarNosInventario(lista)
    local total = 0

    if lista == nil then
        return total
    end

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        total = total + 1
    end

    return total
end

local function prepararSlotVazioInventario(slot, ordem)
    if slot == nil then
        return
    end

    slot.slotVazio = "true"
    slot.ordemInventario = ordem
    slot.uidInventario = "slot_" .. tostring(ordem)
    slot.nomeItem = ""
    slot.tipoItem = ""
    slot.RankItem = ""
    slot.imagemestilo2 = ""
    slot.equipadoEm = ""
    slot.quantidade = ""
    slot.quantidadeDisplay = ""
    slot.nivelUpgrade = ""
    slot.textoUpgrade = ""
    slot.usaQuantidade = ""
    slot.hp = 0
    slot.pp = 0
    slot.ca = 0
    slot.rd = 0
    slot.dano = 0
    slot.cura = 0
    slot.durabilidade = ""
    slot.durabilidadeMaxima = ""
    slot.durabilidadeDisplay = ""
    slot.durabilidadeBaseTempo = ""
    slot.durabilidadeDataBase = ""
    slot.origemLoja = ""
    slot.uidLojaOrigem = ""
    slot.precoLojaPrata = ""
    slot.descricaoLoja = ""
    slot.subtipoMaterial = ""
end


local camposForjaItem = {"nomeItem","tipoItem","subtipoMaterial","RankItem","imagemestilo2","quantidade","quantidadeDisplay","nivelUpgrade","textoUpgrade","usaQuantidade","hp","pp","ca","rd","dano","cura","durabilidade","durabilidadeMaxima","durabilidadeDisplay","durabilidadeBaseTempo","durabilidadeDataBase","origemLoja","uidLojaOrigem","precoLojaPrata","descricaoLoja"}

local function forjaCampo(slot, campo)
    return "ForjaSlot" .. tostring(slot) .. "_" .. tostring(campo)
end

local function forjaSlotTemItem(ficha, slot)
    return ficha ~= nil and tostring(ficha[forjaCampo(slot, "nomeItem")] or "") ~= ""
end

local function forjaLimparSlot(ficha, slot)
    if ficha == nil then return end
    for _, campo in ipairs(camposForjaItem) do ficha[forjaCampo(slot, campo)] = "" end
end

local function forjaNumero(valor, padrao)
    if valor == nil then return padrao or 0 end
    local texto = tostring(valor):gsub("%.", ""):gsub(",", ".")
    local numero = tonumber(texto)
    if numero == nil then return padrao or 0 end
    return numero
end
local function forjaItemEmpilhavelPorTipo(item)
    local tipo = limparTextoInventario(item and item.tipoItem)
    return tipo == "material" or tipo == "outros" or tipo == "potion hp" or tipo == "potion pp" or tipo:find("^potion") ~= nil or tipo == "minerio" or tipo == "minério"
end

local function forjaCopiarItemParaSlot(ficha, slot, item, quantidadeSlot)
    if ficha == nil or item == nil then return end
    for _, campo in ipairs(camposForjaItem) do ficha[forjaCampo(slot, campo)] = item[campo] or "" end

    if forjaItemEmpilhavelPorTipo(item) then
        local qtd = math.max(1, math.floor(forjaNumero(quantidadeSlot, 1)))
        ficha[forjaCampo(slot, "quantidade")] = qtd
        ficha[forjaCampo(slot, "quantidadeDisplay")] = tostring(qtd)
        ficha[forjaCampo(slot, "usaQuantidade")] = "true"
        ficha[forjaCampo(slot, "nivelUpgrade")] = ""
        ficha[forjaCampo(slot, "textoUpgrade")] = ""
        return
    end

    local nivel = tonumber(item.nivelUpgrade) or 0
    ficha[forjaCampo(slot, "nivelUpgrade")] = nivel
    ficha[forjaCampo(slot, "textoUpgrade")] = tostring(item.textoUpgrade or ("+" .. tostring(nivel)))
    if ficha[forjaCampo(slot, "textoUpgrade")] == "" then
        ficha[forjaCampo(slot, "textoUpgrade")] = "+" .. tostring(nivel)
    end
    ficha[forjaCampo(slot, "quantidade")] = ""
    ficha[forjaCampo(slot, "quantidadeDisplay")] = ficha[forjaCampo(slot, "textoUpgrade")]
    ficha[forjaCampo(slot, "usaQuantidade")] = "false"
end

local function forjaCopiarSlotParaItem(ficha, slot, item)
    if ficha == nil or item == nil then return end
    for _, campo in ipairs(camposForjaItem) do item[campo] = ficha[forjaCampo(slot, campo)] or "" end
    item.slotVazio = nil
    item.uidInventario = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    item.equipadoEm = ""
end

local function forjaItemEmpilhavel(item)
    return forjaItemEmpilhavelPorTipo(item)
end

local function forjaAtualizarQuantidadeInventario(item, quantidade)
    if item == nil then return end
    local qtd = math.floor(forjaNumero(quantidade, 0))
    if qtd <= 0 then
        prepararSlotVazioInventario(item, item.ordemInventario)
    else
        item.quantidade = qtd
        item.quantidadeDisplay = tostring(qtd)
        item.usaQuantidade = "true"
    end
end

local function forjaConsumirUmaUnidadeInventario(item)
    if item == nil then return end
    local atual = math.floor(forjaNumero(item.quantidade, 1))
    forjaAtualizarQuantidadeInventario(item, atual - 1)
end

local function forjaSlotsItemEmpilhavel(ficha, slot)
    return tostring(ficha and ficha[forjaCampo(slot, "usaQuantidade")] or "") == "true"
end

local function forjaMesmoItemEmpilhavel(slotItem, ficha, slotForja)
    if slotItem == nil or ficha == nil then return false end
    return not ehSlotVazioInventario(slotItem)
        and forjaItemEmpilhavel(slotItem)
        and tostring(slotItem.nomeItem or "") == tostring(ficha[forjaCampo(slotForja, "nomeItem")] or "")
        and limparTextoInventario(slotItem.tipoItem) == limparTextoInventario(ficha[forjaCampo(slotForja, "tipoItem")])
        and limparTextoInventario(slotItem.subtipoMaterial) == limparTextoInventario(ficha[forjaCampo(slotForja, "subtipoMaterial")])
        and string.upper(limparTextoInventario(slotItem.RankItem)) == string.upper(limparTextoInventario(ficha[forjaCampo(slotForja, "RankItem")]))
        and tostring(slotItem.imagemestilo2 or "") == tostring(ficha[forjaCampo(slotForja, "imagemestilo2")] or "")
end

local function forjaPrimeiroSlotVazioInventario(ficha)
    if ficha == nil or ficha.magias2 == nil then return nil end

    local melhor = nil
    local melhorOrdem = 999999
    for _, item in ipairs(NDB.getChildNodes(ficha.magias2)) do
        if ehSlotVazioInventario(item) then
            local ordem = tonumber(item.ordemInventario) or 999999
            if ordem < melhorOrdem then
                melhor = item
                melhorOrdem = ordem
            end
        end
    end

    return melhor
end
local function forjaEncontrarPilhaInventario(ficha, slotForja)
    if ficha == nil or ficha.magias2 == nil then return nil end
    for _, item in ipairs(NDB.getChildNodes(ficha.magias2)) do
        if forjaMesmoItemEmpilhavel(item, ficha, slotForja) then
            return item
        end
    end
    return nil
end
local function forjaEhCoracao(item)
    local nome = limparTextoInventario(item and item.nomeItem)
    return nome == "coração da forja" or nome == "coracao da forja"
end

local function forjaSlotsIguais(ficha, slotA, itemB)
    if ficha == nil or itemB == nil then return false end
    return tostring(ficha[forjaCampo(slotA, "nomeItem")] or "") == tostring(itemB.nomeItem or "")
        and limparTextoInventario(ficha[forjaCampo(slotA, "tipoItem")]) == limparTextoInventario(itemB.tipoItem)
        and limparTextoInventario(ficha[forjaCampo(slotA, "subtipoMaterial")]) == limparTextoInventario(itemB.subtipoMaterial)
        and string.upper(tostring(ficha[forjaCampo(slotA, "RankItem")] or "")) == string.upper(tostring(itemB.RankItem or ""))
        and tonumber(ficha[forjaCampo(slotA, "nivelUpgrade")] or 0) == (tonumber(itemB.nivelUpgrade) or 0)
end

local function forjaMostrarAviso(controle, texto)
    if CWNA_mostrarAvisoInventario ~= nil then
        CWNA_mostrarAvisoInventario(controle, texto)
    else
        showMessage(texto)
    end
end

function CWNA_receberItemForja(ficha, slotForja, uidInventario, controle)
    if ficha == nil or uidInventario == nil then return end
    local item = procurarItemInventarioPorUid(ficha, uidInventario)
    if item == nil or ehSlotVazioInventario(item) then return end

    if forjaSlotTemItem(ficha, slotForja) then
        forjaMostrarAviso(controle, "Este slot da Forja ja possui um item.")
        return
    end

    if slotForja == 3 then
        if not forjaEhCoracao(item) then
            forjaMostrarAviso(controle, "O terceiro slot aceita apenas Coração da Forja.")
            return
        end

        forjaCopiarItemParaSlot(ficha, slotForja, item, 1)
        forjaConsumirUmaUnidadeInventario(item)
        return
    else
        if forjaItemEmpilhavel(item) then
            forjaMostrarAviso(controle, "Apenas equipamentos podem ser aprimorados.")
            return
        end

        if slotForja == 2 then
            if not forjaSlotTemItem(ficha, 1) then
                forjaMostrarAviso(controle, "Coloque o item base no primeiro slot.")
                return
            end
            if not forjaSlotsIguais(ficha, 1, item) then
                forjaMostrarAviso(controle, "Equipamento diferente do item base")
                return
            end
        end
    end

    forjaCopiarItemParaSlot(ficha, slotForja, item)
    prepararSlotVazioInventario(item, item.ordemInventario)
end
function CWNA_devolverSlotForjaParaInventario(ficha, slotForja, itemDestino, controle)
    if ficha == nil or itemDestino == nil or not forjaSlotTemItem(ficha, slotForja) then return end

    if forjaSlotsItemEmpilhavel(ficha, slotForja) then
        local qtdSlot = math.max(1, math.floor(forjaNumero(ficha[forjaCampo(slotForja, "quantidade")], 1)))

        if forjaMesmoItemEmpilhavel(itemDestino, ficha, slotForja) then
            forjaAtualizarQuantidadeInventario(itemDestino, forjaNumero(itemDestino.quantidade, 0) + qtdSlot)
            forjaLimparSlot(ficha, slotForja)
            return
        end

        local pilha = forjaEncontrarPilhaInventario(ficha, slotForja)
        if pilha ~= nil then
            forjaAtualizarQuantidadeInventario(pilha, forjaNumero(pilha.quantidade, 0) + qtdSlot)
            forjaLimparSlot(ficha, slotForja)
            return
        end

        local destinoFinal = itemDestino
        if not ehSlotVazioInventario(destinoFinal) then
            destinoFinal = forjaPrimeiroSlotVazioInventario(ficha)
        end

        if destinoFinal == nil then
            forjaMostrarAviso(controle, "Limite maximo de 60 itens.")
            return
        end

        local ordem = destinoFinal.ordemInventario
        forjaCopiarSlotParaItem(ficha, slotForja, destinoFinal)
        destinoFinal.ordemInventario = ordem
        destinoFinal.quantidade = qtdSlot
        destinoFinal.quantidadeDisplay = tostring(qtdSlot)
        destinoFinal.usaQuantidade = "true"
        forjaLimparSlot(ficha, slotForja)
        return
    end

    if not ehSlotVazioInventario(itemDestino) then
        forjaMostrarAviso(controle, "Solte em um slot vazio do invent?rio.")
        return
    end

    local ordem = itemDestino.ordemInventario
    forjaCopiarSlotParaItem(ficha, slotForja, itemDestino)
    itemDestino.ordemInventario = ordem
    forjaLimparSlot(ficha, slotForja)
end
function CWNA_dragSlotForja(ficha, slotForja, drag)
    if ficha == nil or drag == nil or not forjaSlotTemItem(ficha, slotForja) then return end
    drag:addData("cwnaForjaSlot", tostring(slotForja))
    drag:addData("text", tostring(ficha[forjaCampo(slotForja, "nomeItem")] or "Item"))
    local imagem = tostring(ficha[forjaCampo(slotForja, "imagemestilo2")] or "")
    if imagem ~= "" then
        drag:addData("url", imagem)
        drag:addData("imageURL", imagem)
        drag:addData("image", imagem)
        drag:addData("text/uri-list", imagem)
    end
end

local function forjaIncrementoDanoRank(rank)
    local r = string.upper(tostring(rank or "E"))
    if r == "D" then return 1.5 end
    if r == "C" then return 2 end
    if r == "B" then return 2.5 end
    if r == "A" then return 3 end
    if r == "S" then return 4 end
    return 1
end

local function forjaIncrementoRdRank(rank)
    local r = string.upper(tostring(rank or "E"))
    if r == "D" then return 0.75 end
    if r == "C" then return 1 end
    if r == "B" then return 1.25 end
    if r == "A" then return 1.5 end
    if r == "S" then return 2 end
    return 0.5
end

local function forjaItemEhArmaPorTipo(tipo)
    return limparTextoInventario(tipo) == "arma"
end

local function forjaChanceNivel(nivelDestino)
    local chances = {95,90,80,70,60,50,40,30,20,10}
    return chances[nivelDestino] or 0
end

local function forjaFormatarNumero(valor)
    if math.floor(valor) == valor then return tostring(math.floor(valor)) end
    return tostring(valor):gsub("%.", ",")
end

local function forjaRdAprimorado(rdAtual, rank, nivelNovo)
    local base = forjaNumero(rdAtual, 0)
    local bonus = forjaIncrementoRdRank(rank)
    return forjaFormatarNumero(base + bonus)
end
local function forjaDanoAprimorado(danoAtual, rank, nivelNovo)
    local dano = tostring(danoAtual or "")
    local base = dano:gsub("%s*%+%s*[%d%,%.]+%s*$", "")
    if base == "" then return dano end
    local bonus = forjaIncrementoDanoRank(rank) * nivelNovo
    return base .. "+" .. forjaFormatarNumero(bonus)
end

local function codigoCorRankChatForja(rank)
    local r = string.upper(limparTextoInventario(rank))

    if r == "SS" then return "10" end
    if r == "E" then return "14" end
    if r == "D" then return "9" end
    if r == "C" then return "11" end
    if r == "B" then return "13" end
    if r == "A" then return "8" end
    if r == "S" then return "4" end

    return "1"
end
local function enviarMensagemForjaAprimorar(ficha, resultado, nomeItem, rankItem, nivelAtual, nivelDestino, imagem)
    local mesa = rrpg.getMesaDe(ficha) or Firecast.getMesaDe(ficha)
    local jogador = mesa and mesa.me or nil
    local chat = mesa and mesa.chat or nil

    if jogador == nil or chat == nil then return end

    local nomeJogador = "Jogador"
    pcall(function()
        nomeJogador = tostring(jogador.nick or jogador.nickname or jogador.nome or jogador.name or jogador.login or "Jogador")
    end)

    local marcadorCor = "[" .. string.char(194, 167) .. "K"
    local marcadorImagem = "[" .. string.char(194, 167) .. "I "
    local corItem = codigoCorRankChatForja(rankItem)
    local upgradeAtual = "+" .. tostring(tonumber(nivelAtual) or 0)
    local upgradeDestino = "+" .. tostring(tonumber(nivelDestino) or 0)
    local itemColorido = marcadorCor .. corItem .. "]" .. tostring(nomeItem or "Item") .. " " .. upgradeAtual
    local texto

    if resultado == "quebrou" then
        texto = "<" .. nomeJogador .. "> " .. marcadorCor .. "1]Quebrou: " .. itemColorido .. "\n" ..
                marcadorCor .. "1]ao tentar aprimora-lo para: " .. upgradeDestino
    else
        texto = "<" .. nomeJogador .. "> " .. marcadorCor .. "1]aprimorou com sucesso:\n" ..
                marcadorCor .. "1]o item: " .. itemColorido .. marcadorCor .. "1] para " .. upgradeDestino
    end

    imagem = tostring(imagem or "")
    if imagem ~= "" then
        texto = texto .. "\n" .. marcadorImagem .. imagem .. "]"
    end

    pcall(function()
        chat:enviarMensagem(texto)
    end)
end
function CWNA_trabalharForjaAprimorar(ficha, controle)
    if ficha == nil then return end
    if not forjaSlotTemItem(ficha, 1) or not forjaSlotTemItem(ficha, 2) then
        forjaMostrarAviso(controle, "Coloque dois equipamentos iguais para aprimorar.")
        return
    end

    local nivelAtual = tonumber(ficha[forjaCampo(1, "nivelUpgrade")] or 0) or 0
    local nivelDestino = nivelAtual + 1
    if nivelDestino > 10 then
        forjaMostrarAviso(controle, "Este equipamento ja esta no aprimoramento maximo.")
        return
    end

    local chance = forjaChanceNivel(nivelDestino)
    local rolagem = math.random(1, 100)
    local protegido = forjaSlotTemItem(ficha, 3) and forjaEhCoracao({nomeItem = ficha[forjaCampo(3, "nomeItem")]})
    local nomeItemMensagem = ficha[forjaCampo(1, "nomeItem")]
    local rankItemMensagem = ficha[forjaCampo(1, "RankItem")]
    local imagemItemMensagem = ficha[forjaCampo(1, "imagemestilo2")]

    if rolagem <= chance then
        ficha[forjaCampo(1, "nivelUpgrade")] = nivelDestino
        ficha[forjaCampo(1, "textoUpgrade")] = "+" .. tostring(nivelDestino)
        ficha[forjaCampo(1, "quantidadeDisplay")] = ficha[forjaCampo(1, "textoUpgrade")]
        local itemAprimoradoDurabilidade = {
            tipoItem = ficha[forjaCampo(1, "tipoItem")],
            RankItem = ficha[forjaCampo(1, "RankItem")]
        }
        if itemEhEquipamentoInventario(itemAprimoradoDurabilidade) then
            local pdMaxima = durabilidadeMaximaPorRankInventario(itemAprimoradoDurabilidade.RankItem)
            ficha[forjaCampo(1, "durabilidadeMaxima")] = pdMaxima
            ficha[forjaCampo(1, "durabilidade")] = pdMaxima
            ficha[forjaCampo(1, "durabilidadeDisplay")] = tostring(math.floor(pdMaxima))
            ficha[forjaCampo(1, "durabilidadeBaseTempo")] = pdMaxima
            ficha[forjaCampo(1, "durabilidadeDataBase")] = os.time()
        end
        if forjaItemEhArmaPorTipo(ficha[forjaCampo(1, "tipoItem")]) then
            ficha[forjaCampo(1, "dano")] = forjaDanoAprimorado(ficha[forjaCampo(1, "dano")], ficha[forjaCampo(1, "RankItem")], nivelDestino)
        else
            ficha[forjaCampo(1, "rd")] = forjaRdAprimorado(ficha[forjaCampo(1, "rd")], ficha[forjaCampo(1, "RankItem")], nivelDestino)
        end
        forjaLimparSlot(ficha, 2)
        if protegido then forjaLimparSlot(ficha, 3) end
        local xpGanho = 0
        if CWNA_adicionarXpFerreiro ~= nil then
            xpGanho = CWNA_adicionarXpFerreiro(ficha, nomeItemMensagem, rankItemMensagem, 1)
        end
        enviarMensagemForjaAprimorar(ficha, "sucesso", nomeItemMensagem, rankItemMensagem, nivelAtual, nivelDestino, imagemItemMensagem)
        forjaMostrarAviso(controle, "Aprimoramento bem-sucedido: " .. tostring(ficha[forjaCampo(1, "nomeItem")] or "Item") .. " +" .. tostring(nivelDestino) .. ". XP +" .. tostring(xpGanho))
    else
        if protegido then
            forjaLimparSlot(ficha, 3)
            forjaMostrarAviso(controle, "Aprimoramento falhou, mas o Coração da Forja protegeu os equipamentos.")
        else
            enviarMensagemForjaAprimorar(ficha, "quebrou", nomeItemMensagem, rankItemMensagem, nivelAtual, nivelDestino, imagemItemMensagem)
            forjaLimparSlot(ficha, 1)
            forjaLimparSlot(ficha, 2)
            forjaMostrarAviso(controle, "Aprimoramento falhou. Os equipamentos foram destru?dos.")
        end
    end
end

local function forjaForjarCampo(slot, campo)
    return "ForjaForjarSlot" .. tostring(slot) .. "_" .. tostring(campo)
end

local function forjaForjarSlotTemItem(ficha, slot)
    return ficha ~= nil and tostring(ficha[forjaForjarCampo(slot, "nomeItem")] or "") ~= ""
end

local function forjaForjarLimparSlot(ficha, slot)
    if ficha == nil then return end
    for _, campo in ipairs(camposForjaItem) do ficha[forjaForjarCampo(slot, campo)] = "" end
end

local function forjaForjarCopiarItemParaSlot(ficha, slot, item, quantidadeSlot)
    if ficha == nil or item == nil then return end
    for _, campo in ipairs(camposForjaItem) do ficha[forjaForjarCampo(slot, campo)] = item[campo] or "" end
    local qtd = math.max(1, math.floor(forjaNumero(quantidadeSlot, 1)))
    ficha[forjaForjarCampo(slot, "quantidade")] = qtd
    ficha[forjaForjarCampo(slot, "quantidadeDisplay")] = tostring(qtd)
    ficha[forjaForjarCampo(slot, "usaQuantidade")] = "true"
    ficha[forjaForjarCampo(slot, "nivelUpgrade")] = ""
    ficha[forjaForjarCampo(slot, "textoUpgrade")] = ""
end

local function forjaForjarCopiarSlotParaItem(ficha, slot, item)
    if ficha == nil or item == nil then return end
    for _, campo in ipairs(camposForjaItem) do item[campo] = ficha[forjaForjarCampo(slot, campo)] or "" end
    item.slotVazio = nil
    item.uidInventario = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    item.equipadoEm = ""
end

local tiposMoldeArmaForja = {
    espada = "Espada",
    machado = "Machado",
    martelo = "Martelo",
    maca = "Maca",
    ["ma?a"] = "Maca",
    lanca = "Lanca",
    ["lan?a"] = "Lanca",
    adaga = "Adaga",
    chicote = "Chicote",
    arremesso = "Arremesso",
    arco = "Arco",
    besta = "Besta",
    cajado = "Cajado",
    orbe = "Orbe",
    ["braco acoplado"] = "Braco Acoplado",
    ["braço acoplado"] = "Braco Acoplado"
}

local function forjaForjarInfoMolde(item)
    local nomeLimpo = limparTextoInventario(item and item.nomeItem)
    if nomeLimpo:sub(1, 9) ~= "molde de " then return nil end
    local normal = nomeLimpo:gsub("^molde de%s+", "")
    if normal == "capacete" then return {categoria = "armadura", tipo = "Capacete"} end
    if normal == "peitoral" or normal == "armadura" then return {categoria = "armadura", tipo = "Peitoral"} end
    if normal == "calca" or normal == "calça" then return {categoria = "armadura", tipo = "Calca"} end
    if normal == "bota" then return {categoria = "armadura", tipo = "Bota"} end
    if normal == "escudo" then return {categoria = "armadura", tipo = "Escudo"} end
    local tipoArma = tiposMoldeArmaForja[normal]
    if tipoArma ~= nil then return {categoria = "arma", tipo = tipoArma} end
    return nil
end

local function forjaForjarTipoMolde(item)
    local info = forjaForjarInfoMolde(item)
    return info and info.tipo or nil
end

local function forjaForjarEhMinerio(item)
    local tipo = limparTextoInventario(item and item.tipoItem)
    local subtipo = limparTextoInventario(item and item.subtipoMaterial)
    local nome = limparTextoInventario(item and item.nomeItem)
    return tipo == "minerio" or tipo == "minério" or subtipo == "minerios" or subtipo == "minérios" or nome:find("lingote", 1, true) ~= nil
end

local function forjaForjarEhComponenteFinal(item)
    local tipo = limparTextoInventario(item and item.tipoItem)
    local subtipo = limparTextoInventario(item and item.subtipoMaterial)
    local nome = limparTextoInventario(item and item.nomeItem)
    return tipo == "revestimento" or tipo == "couro" or tipo == "empunhadura" or subtipo == "revestimento" or subtipo == "couros" or nome:find("revestimento", 1, true) ~= nil or nome:find("couro", 1, true) ~= nil
end

local function forjaForjarEhEmpunhadura(item)
    local tipo = limparTextoInventario(item and item.tipoItem)
    local subtipo = limparTextoInventario(item and item.subtipoMaterial)
    local nome = limparTextoInventario(item and item.nomeItem)
    return tipo == "empunhadura" or subtipo == "empunhadura" or nome == "simples" or nome == "reforcada" or nome == "refor?ada" or nome == "carvalho" or nome == "nobre" or nome == "encantada" or nome:find("empunhadura", 1, true) ~= nil
end

local function forjaForjarRankSlot(ficha, slot)
    return string.upper(tostring(ficha and ficha[forjaForjarCampo(slot, "RankItem")] or ""))
end

function CWNA_receberItemForjaForjar(ficha, slotForja, uidInventario, controle)
    if ficha == nil or uidInventario == nil then return end
    local item = procurarItemInventarioPorUid(ficha, uidInventario)
    if item == nil or ehSlotVazioInventario(item) then return end
    if forjaForjarSlotTemItem(ficha, slotForja) then
        forjaMostrarAviso(controle, "Este slot de forja ja possui um item.")
        return
    end

    local rank = string.upper(tostring(item.RankItem or ""))
    if rank == "" then
        forjaMostrarAviso(controle, "O componente precisa ter rank.")
        return
    end

    if slotForja == 1 then
        if forjaForjarTipoMolde(item) == nil then
            forjaMostrarAviso(controle, "O primeiro slot aceita apenas molde de armadura.")
            return
        end
        forjaForjarCopiarItemParaSlot(ficha, slotForja, item, 1)
        ficha[forjaForjarCampo(slotForja, "durabilidadeMaxima")] = 10
        ficha[forjaForjarCampo(slotForja, "durabilidade")] = tonumber(item.durabilidade) or 10
        ficha[forjaForjarCampo(slotForja, "durabilidadeDisplay")] = tostring(ficha[forjaForjarCampo(slotForja, "durabilidade")])
        forjaConsumirUmaUnidadeInventario(item)
        return
    end

    if not forjaForjarSlotTemItem(ficha, 1) then
        forjaMostrarAviso(controle, "Coloque o molde no primeiro slot.")
        return
    end

    if rank ~= forjaForjarRankSlot(ficha, 1) then
        forjaMostrarAviso(controle, "O componente precisa ser do mesmo rank do molde.")
        return
    end

    if slotForja == 2 then
        if not forjaForjarEhMinerio(item) then
            forjaMostrarAviso(controle, "O segundo slot aceita apenas minerio.")
            return
        end
        local qtdAtual = math.floor(forjaNumero(item.quantidade, 1))
        if qtdAtual < 3 then
            forjaMostrarAviso(controle, "Sao necessarios 3 minerios do mesmo rank.")
            return
        end
        forjaForjarCopiarItemParaSlot(ficha, slotForja, item, 3)
        forjaAtualizarQuantidadeInventario(item, qtdAtual - 3)
        return
    end

    local infoMolde = forjaForjarInfoMolde({nomeItem = ficha[forjaForjarCampo(1, "nomeItem")]})
    if infoMolde ~= nil and infoMolde.categoria == "arma" then
        if not forjaForjarEhEmpunhadura(item) then
            forjaMostrarAviso(controle, "O terceiro slot aceita empunhadura para armas.")
            return
        end
    else
        if not forjaForjarEhComponenteFinal(item) or forjaForjarEhEmpunhadura(item) then
            forjaMostrarAviso(controle, "O terceiro slot aceita revestimento ou couro para armaduras.")
            return
        end
    end
    forjaForjarCopiarItemParaSlot(ficha, slotForja, item, 1)
    forjaConsumirUmaUnidadeInventario(item)
end

function CWNA_dragSlotForjaForjar(ficha, slotForja, drag)
    if ficha == nil or drag == nil or not forjaForjarSlotTemItem(ficha, slotForja) then return end
    drag:addData("cwnaForjaForjarSlot", tostring(slotForja))
    drag:addData("text", tostring(ficha[forjaForjarCampo(slotForja, "nomeItem")] or "Item"))
    local imagem = tostring(ficha[forjaForjarCampo(slotForja, "imagemestilo2")] or "")
    if imagem ~= "" then
        drag:addData("url", imagem)
        drag:addData("imageURL", imagem)
        drag:addData("image", imagem)
        drag:addData("text/uri-list", imagem)
    end
end

function CWNA_devolverSlotForjaForjarParaInventario(ficha, slotForja, itemDestino, controle)
    if ficha == nil or not forjaForjarSlotTemItem(ficha, slotForja) then return end
    local qtdSlot = math.max(1, math.floor(forjaNumero(ficha[forjaForjarCampo(slotForja, "quantidade")], 1)))
    if slotForja ~= 1 then
        for _, item in ipairs(NDB.getChildNodes(ficha.magias2)) do
            if not ehSlotVazioInventario(item) and forjaItemEmpilhavel(item) and tostring(item.nomeItem or "") == tostring(ficha[forjaForjarCampo(slotForja, "nomeItem")] or "") and string.upper(tostring(item.RankItem or "")) == string.upper(tostring(ficha[forjaForjarCampo(slotForja, "RankItem")] or "")) then
                forjaAtualizarQuantidadeInventario(item, forjaNumero(item.quantidade, 0) + qtdSlot)
                forjaForjarLimparSlot(ficha, slotForja)
                return
            end
        end
    end
    if itemDestino == nil or not ehSlotVazioInventario(itemDestino) then itemDestino = forjaPrimeiroSlotVazioInventario(ficha) end
    if itemDestino == nil then forjaMostrarAviso(controle, "Limite maximo de 60 itens."); return end
    local ordem = itemDestino.ordemInventario
    forjaForjarCopiarSlotParaItem(ficha, slotForja, itemDestino)
    itemDestino.ordemInventario = ordem
    if slotForja == 1 then
        itemDestino.quantidade = ""
        itemDestino.quantidadeDisplay = ""
        itemDestino.usaQuantidade = "false"
        itemDestino.durabilidadeMaxima = tonumber(itemDestino.durabilidadeMaxima) or 10
        itemDestino.durabilidade = tonumber(itemDestino.durabilidade) or qtdSlot
        itemDestino.durabilidadeDisplay = tostring(math.floor(tonumber(itemDestino.durabilidade) or qtdSlot))
    else
        itemDestino.quantidade = qtdSlot
        itemDestino.quantidadeDisplay = tostring(qtdSlot)
        itemDestino.usaQuantidade = "true"
    end
    forjaForjarLimparSlot(ficha, slotForja)
end

function CWNA_devolverSlotForjaForjarAuto(ficha, slotForja, controle)
    if ficha == nil or not forjaForjarSlotTemItem(ficha, slotForja) then return end
    local destino = forjaPrimeiroSlotVazioInventario(ficha)
    CWNA_devolverSlotForjaForjarParaInventario(ficha, slotForja, destino, controle)
end

local function forjaForjarCriarEquipamentoDestino(ficha, receita, rank, destino, nivelForjado)
    local ordem = destino.ordemInventario
    destino.nomeItem = receita.nomeItem or "Item Forjado"
    destino.tipoItem = receita.tipoItem or "Peitoral"
    destino.subtipoMaterial = "OUTROS"
    destino.RankItem = rank
    destino.imagemestilo2 = receita.imagemestilo2 or ""
    destino.precoLojaPrata = receita.precoPrata or 0
    destino.descricaoLoja = receita.descricaoItem or ""
    destino.hp = 0
    destino.pp = 0
    destino.ca = 0
    destino.rd = receita.rd or 0
    destino.dano = receita.dano or 0
    destino.cura = 0
    destino.nivelUpgrade = tonumber(nivelForjado) or 0
    destino.textoUpgrade = "+" .. tostring(tonumber(nivelForjado) or 0)
    destino.quantidade = ""
    destino.quantidadeDisplay = destino.textoUpgrade
    destino.usaQuantidade = "false"
    destino.origemLoja = "true"
    destino.uidLojaOrigem = "forja_" .. tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    destino.slotVazio = nil
    destino.uidInventario = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    destino.equipadoEm = ""
    destino.ordemInventario = ordem
    garantirDurabilidadeItemInventario(destino)
end


local function forjaCdPorRank(rank)
    local r = string.upper(tostring(rank or "E"))
    if r == "D" then return 13 end
    if r == "C" then return 16 end
    if r == "B" then return 19 end
    if r == "A" then return 22 end
    if r == "S" then return 25 end
    return 10
end

local function forjaBonusMoldePorRank(rank)
    local r = string.upper(tostring(rank or "E"))
    if r == "D" then return 1 end
    if r == "C" then return 2 end
    if r == "B" then return 3 end
    if r == "A" then return 4 end
    if r == "S" then return 5 end
    return 0
end

local function forjaXpFerreiroPorRank(rank)
    local r = string.upper(tostring(rank or "E"))
    if r == "D" then return 20 end
    if r == "C" then return 35 end
    if r == "B" then return 55 end
    if r == "A" then return 80 end
    if r == "S" then return 120 end
    return 10
end

local function forjaNivelPorXp(xp)
    xp = tonumber(xp) or 0
    if xp >= 2000 then return 5 end
    if xp >= 1000 then return 4 end
    if xp >= 450 then return 3 end
    if xp >= 150 then return 2 end
    return 1
end

local function forjaXpInicioNivel(nivel)
    if nivel >= 5 then return 2000 end
    if nivel == 4 then return 1000 end
    if nivel == 3 then return 450 end
    if nivel == 2 then return 150 end
    return 0
end

local function forjaXpProximoNivel(nivel)
    if nivel >= 5 then return 2000 end
    if nivel == 4 then return 2000 end
    if nivel == 3 then return 1000 end
    if nivel == 2 then return 450 end
    return 150
end

local function forjaXpMetaNivel(nivel)
    nivel = tonumber(nivel) or 1
    if nivel >= 5 then return 0 end
    if nivel == 4 then return 2000 end
    if nivel == 3 then return 1000 end
    if nivel == 2 then return 450 end
    return 150
end

local function forjaRankPermitidoPorNivel(nivel, rank)
    local ordem = {E=1, D=2, C=3, B=4, A=5, S=5}
    return (ordem[string.upper(tostring(rank or "E"))] or 1) <= math.max(1, math.min(5, tonumber(nivel) or 1))
end

local function forjaMigrarXpFerreiroSePreciso(ficha)
    if ficha == nil or tostring(ficha.FerreiroXpPorNivel or "") == "true" then return end

    local xpAntigo = math.max(0, math.floor(tonumber(ficha.FerreiroXP) or 0))
    local nivelSalvo = math.floor(tonumber(ficha.FerreiroNivel) or 0)
    local nivel = nivelSalvo >= 1 and nivelSalvo or forjaNivelPorXp(xpAntigo)
    nivel = math.max(1, math.min(5, nivel))

    local inicioNivel = forjaXpInicioNivel(nivel)
    if xpAntigo >= inicioNivel then
        ficha.FerreiroXP = math.max(0, xpAntigo - inicioNivel)
    else
        ficha.FerreiroXP = xpAntigo
    end

    ficha.FerreiroNivel = nivel
    ficha.FerreiroXpPorNivel = "true"
end

local function forjaAtualizarXpFerreiro(ficha)
    if ficha == nil then return end
    forjaMigrarXpFerreiroSePreciso(ficha)

    local xp = math.max(0, math.floor(tonumber(ficha.FerreiroXP) or 0))
    local nivel = math.max(1, math.min(5, math.floor(tonumber(ficha.FerreiroNivel) or 1)))
    local meta = forjaXpMetaNivel(nivel)
    if nivel < 5 and meta > 0 and xp >= meta then
        nivel = nivel + 1
        xp = 0
    end

    ficha.FerreiroXP = xp
    ficha.FerreiroNivel = nivel
    local rankNivel = nivel >= 5 and 5 or math.max(0, math.min(5, nivel - 1))
    local letrasRank = {[0]="E", [1]="D", [2]="C", [3]="B", [4]="A", [5]="S"}
    ficha.FerreiroRankLetra = letrasRank[rankNivel] or "E"

    if nivel >= 5 then
        ficha.FerreiroXPBarra = 1
        ficha.FerreiroXPBarraMax = 1
        ficha.FerreiroXPTexto = "MAX"
    else
        ficha.FerreiroXPBarra = xp
        ficha.FerreiroXPBarraMax = math.max(1, meta)
        ficha.FerreiroXPTexto = tostring(xp) .. "/" .. tostring(meta)
    end
end

function CWNA_atualizarXpFerreiro(ficha)
    forjaAtualizarXpFerreiro(ficha)
end

local function forjaChaveRepeticao(nomeItem, rank)
    local base = limparTextoInventario(tostring(nomeItem or "item") .. "_" .. tostring(rank or "E"))
    base = base:gsub("[^%w_]", "_")
    return "FerreiroCriou_" .. base
end

local function forjaAdicionarXpFerreiro(ficha, nomeItem, rank, multiplicadorResultado)
    if ficha == nil then return 0 end
    local chave = forjaChaveRepeticao(nomeItem, rank)
    local totalCriado = (tonumber(ficha[chave]) or 0) + 1
    ficha[chave] = totalCriado
    local xpBase = forjaXpFerreiroPorRank(rank)
    local multiplicadorRepeticao = 1
    if totalCriado > 20 then multiplicadorRepeticao = 0.25 elseif totalCriado > 10 then multiplicadorRepeticao = 0.5 end
    local ganho = math.floor((xpBase * multiplicadorRepeticao * (tonumber(multiplicadorResultado) or 1)) + 0.5)
    forjaAtualizarXpFerreiro(ficha)
    ficha.FerreiroXP = (tonumber(ficha.FerreiroXP) or 0) + ganho
    forjaAtualizarXpFerreiro(ficha)
    return ganho
end

function CWNA_adicionarXpFerreiro(ficha, nomeItem, rank, multiplicadorResultado)
    return forjaAdicionarXpFerreiro(ficha, nomeItem, rank, multiplicadorResultado)
end

local function forjaAdicionarXpFerreiroFalha(ficha, rank)
    if ficha == nil then return 0 end
    local ganho = math.floor((forjaXpFerreiroPorRank(rank) * 0.2) + 0.5)
    forjaAtualizarXpFerreiro(ficha)
    ficha.FerreiroXP = (tonumber(ficha.FerreiroXP) or 0) + ganho
    forjaAtualizarXpFerreiro(ficha)
    return ganho
end

local function enviarMensagemForjaForjar(ficha, resultado, nomeItem, rankItem, imagem, grauSucesso, xpGanho)
    local mesa = rrpg.getMesaDe(ficha) or Firecast.getMesaDe(ficha)
    local jogador = mesa and mesa.me or nil
    local chat = mesa and mesa.chat or nil
    if jogador == nil or chat == nil then return end
    local nomeJogador = "Jogador"
    pcall(function()
        nomeJogador = tostring(jogador.nick or jogador.nickname or jogador.nome or jogador.name or jogador.login or "Jogador")
    end)
    local marcadorCor = "[" .. string.char(194, 167) .. "K"
    local marcadorImagem = "[" .. string.char(194, 167) .. "I "
    local corItem = codigoCorRankChatForja(rankItem)
    local titulo = resultado == "falha" and "Falhou ao forjar:" or "Forjou com sucesso:"
    local texto = "<" .. nomeJogador .. "> " .. marcadorCor .. "1]" .. titulo .. "\n" ..
                 marcadorCor .. corItem .. "]" .. tostring(nomeItem or "Item") .. marcadorCor .. "1] +0"
    imagem = tostring(imagem or "")
    if imagem ~= "" then texto = texto .. "\n" .. marcadorImagem .. imagem .. "]" end
    local linhaXp = "XP total ganha: " .. tostring(tonumber(xpGanho) or 0)
    if resultado ~= "falha" then
        if grauSucesso == 10 then
            linhaXp = "Sucesso por +10 - " .. linhaXp
        elseif grauSucesso == 5 then
            linhaXp = "Sucesso por +5 - " .. linhaXp
        end
    end
    texto = texto .. "\n" .. marcadorCor .. "1]" .. linhaXp
    pcall(function() chat:enviarMensagem(texto) end)
end
function CWNA_trabalharForjaForjar(ficha, controle)
    if ficha == nil then return end
    if not forjaForjarSlotTemItem(ficha, 1) or not forjaForjarSlotTemItem(ficha, 2) or not forjaForjarSlotTemItem(ficha, 3) then
        forjaMostrarAviso(controle, "Coloque molde, 3 minerios e revestimento/couro para forjar.")
        return
    end

    local rank = forjaForjarRankSlot(ficha, 1)
    if rank == "" or rank ~= forjaForjarRankSlot(ficha, 2) or rank ~= forjaForjarRankSlot(ficha, 3) then
        forjaMostrarAviso(controle, "Todos os componentes precisam ser do mesmo rank.")
        return
    end

    forjaAtualizarXpFerreiro(ficha)
    local nivelFerreiro = tonumber(ficha.FerreiroNivel) or forjaNivelPorXp(ficha.FerreiroXP)
    if not forjaRankPermitidoPorNivel(nivelFerreiro, rank) then
        forjaMostrarAviso(controle, "Seu Ferreiro ainda nao consegue criar itens Rank " .. tostring(rank) .. ".")
        return
    end

    local infoMolde = forjaForjarInfoMolde({nomeItem = ficha[forjaForjarCampo(1, "nomeItem")]})
    if infoMolde == nil then
        forjaMostrarAviso(controle, "Molde invalido.")
        return
    end

    local receita = nil
    if infoMolde.categoria == "arma" then
        if CWNA_Materiais ~= nil and CWNA_Materiais.getReceitaForjaArma ~= nil then
            receita = CWNA_Materiais.getReceitaForjaArma(rank, infoMolde.tipo)
        end
    else
        if CWNA_Materiais ~= nil and CWNA_Materiais.getReceitaForjaArmadura ~= nil then
            receita = CWNA_Materiais.getReceitaForjaArmadura(rank, infoMolde.tipo)
        end
    end
    if receita == nil then
        forjaMostrarAviso(controle, "Ainda nao existe receita cadastrada para este molde/rank.")
        return
    end

    local cd = forjaCdPorRank(rank)
    local dado = math.random(1, 20)
    local bonusMolde = forjaBonusMoldePorRank(rank)
    local total = dado + bonusMolde + nivelFerreiro
    local sucesso = total >= cd
    local grauSucesso = 0
    local multiplicadorXp = 1
    if sucesso and total >= cd + 10 then
        grauSucesso = 10
        multiplicadorXp = 2
    elseif sucesso and total >= cd + 5 then
        grauSucesso = 5
        multiplicadorXp = 1.5
    end

    local destino = nil
    if sucesso then
        destino = forjaPrimeiroSlotVazioInventario(ficha)
        if destino == nil then
            forjaMostrarAviso(controle, "Limite maximo de 60 itens.")
            return
        end
    end

    local pdMolde = math.max(0, math.floor(forjaNumero(ficha[forjaForjarCampo(1, "durabilidade")], 10)) - 1)
    if sucesso then
        forjaForjarCriarEquipamentoDestino(ficha, receita, rank, destino, 0)
        local xpGanho = forjaAdicionarXpFerreiro(ficha, receita.nomeItem, rank, multiplicadorXp)
        if pdMolde <= 0 then
            forjaForjarLimparSlot(ficha, 1)
            forjaMostrarAviso(controle, "Forja: " .. tostring(dado) .. "+" .. tostring(bonusMolde) .. "+" .. tostring(nivelFerreiro) .. " = " .. tostring(total) .. " contra CD " .. tostring(cd) .. ". Item forjado +0. O molde quebrou. XP +" .. tostring(xpGanho))
        else
            ficha[forjaForjarCampo(1, "durabilidade")] = pdMolde
            ficha[forjaForjarCampo(1, "durabilidadeMaxima")] = 10
            ficha[forjaForjarCampo(1, "durabilidadeDisplay")] = tostring(pdMolde)
            ficha[forjaForjarCampo(1, "quantidadeDisplay")] = tostring(pdMolde)
            forjaMostrarAviso(controle, "Forja: " .. tostring(dado) .. "+" .. tostring(bonusMolde) .. "+" .. tostring(nivelFerreiro) .. " = " .. tostring(total) .. " contra CD " .. tostring(cd) .. ". Item forjado: " .. tostring(receita.nomeItem or "Item") .. " +0. XP +" .. tostring(xpGanho))
        end
        enviarMensagemForjaForjar(ficha, "sucesso", receita.nomeItem, rank, receita.imagemestilo2, grauSucesso, xpGanho)
    else
        local xpGanho = forjaAdicionarXpFerreiroFalha(ficha, rank)
        if pdMolde <= 0 then
            forjaForjarLimparSlot(ficha, 1)
            forjaMostrarAviso(controle, "Forja falhou: " .. tostring(dado) .. "+" .. tostring(bonusMolde) .. "+" .. tostring(nivelFerreiro) .. " = " .. tostring(total) .. " contra CD " .. tostring(cd) .. ". O molde quebrou. XP +" .. tostring(xpGanho))
        else
            ficha[forjaForjarCampo(1, "durabilidade")] = pdMolde
            ficha[forjaForjarCampo(1, "durabilidadeMaxima")] = 10
            ficha[forjaForjarCampo(1, "durabilidadeDisplay")] = tostring(pdMolde)
            ficha[forjaForjarCampo(1, "quantidadeDisplay")] = tostring(pdMolde)
            forjaMostrarAviso(controle, "Forja falhou: " .. tostring(dado) .. "+" .. tostring(bonusMolde) .. "+" .. tostring(nivelFerreiro) .. " = " .. tostring(total) .. " contra CD " .. tostring(cd) .. ". XP +" .. tostring(xpGanho))
        end
        enviarMensagemForjaForjar(ficha, "falha", receita.nomeItem, rank, receita.imagemestilo2, 0, xpGanho)
    end

    forjaForjarLimparSlot(ficha, 2)
    forjaForjarLimparSlot(ficha, 3)
end
local function forjaRepararCampo(slot, campo)
    return "ForjaRepararSlot" .. tostring(slot) .. "_" .. tostring(campo)
end

local function forjaRepararSlotTemItem(ficha, slot)
    return ficha ~= nil and tostring(ficha[forjaRepararCampo(slot, "nomeItem")] or "") ~= ""
end

local function forjaRepararLimparSlot(ficha, slot)
    if ficha == nil then return end
    for _, campo in ipairs(camposForjaItem) do ficha[forjaRepararCampo(slot, campo)] = "" end
end

local function forjaRepararCopiarItemParaSlot(ficha, slot, item, quantidadeSlot)
    if ficha == nil or item == nil then return end
    for _, campo in ipairs(camposForjaItem) do ficha[forjaRepararCampo(slot, campo)] = item[campo] or "" end
    if forjaItemEmpilhavelPorTipo(item) then
        local qtd = math.max(1, math.floor(forjaNumero(quantidadeSlot, 1)))
        ficha[forjaRepararCampo(slot, "quantidade")] = qtd
        ficha[forjaRepararCampo(slot, "quantidadeDisplay")] = tostring(qtd)
        ficha[forjaRepararCampo(slot, "usaQuantidade")] = "true"
    else
        garantirDurabilidadeItemInventario({tipoItem=ficha[forjaRepararCampo(slot,"tipoItem")], RankItem=ficha[forjaRepararCampo(slot,"RankItem")], durabilidade=ficha[forjaRepararCampo(slot,"durabilidade")], durabilidadeMaxima=ficha[forjaRepararCampo(slot,"durabilidadeMaxima")], durabilidadeDisplay=ficha[forjaRepararCampo(slot,"durabilidadeDisplay")]})
        local nivel = tonumber(item.nivelUpgrade) or 0
        ficha[forjaRepararCampo(slot, "nivelUpgrade")] = nivel
        ficha[forjaRepararCampo(slot, "textoUpgrade")] = tostring(item.textoUpgrade or ("+" .. tostring(nivel)))
        ficha[forjaRepararCampo(slot, "quantidade")] = ""
        ficha[forjaRepararCampo(slot, "quantidadeDisplay")] = ficha[forjaRepararCampo(slot, "textoUpgrade")]
        ficha[forjaRepararCampo(slot, "usaQuantidade")] = "false"
    end
end

local function forjaRepararCopiarSlotParaItem(ficha, slot, item)
    if ficha == nil or item == nil then return end
    for _, campo in ipairs(camposForjaItem) do item[campo] = ficha[forjaRepararCampo(slot, campo)] or "" end
    item.slotVazio = nil
    item.uidInventario = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    item.equipadoEm = ""
end

local function forjaItemEhMinerioReparo(item)
    local tipo = limparTextoInventario(item and item.tipoItem)
    local subtipo = limparTextoInventario(item and item.subtipoMaterial)
    local nome = limparTextoInventario(item and item.nomeItem)
    return tipo == "minerio" or tipo == "minério" or subtipo == "minérios" or subtipo == "minerios" or nome:find("lingote", 1, true) ~= nil
end

function CWNA_receberItemForjaReparar(ficha, slotForja, uidInventario, controle)
    if ficha == nil or uidInventario == nil then return end
    local item = procurarItemInventarioPorUid(ficha, uidInventario)
    if item == nil or ehSlotVazioInventario(item) then return end
    if forjaRepararSlotTemItem(ficha, slotForja) then
        forjaMostrarAviso(controle, "Este slot de reparo ja possui um item.")
        return
    end

    if slotForja == 1 then
        if forjaItemEmpilhavel(item) or not itemEhEquipamentoInventario(item) then
            forjaMostrarAviso(controle, "O primeiro slot aceita apenas equipamentos.")
            return
        end
        garantirDurabilidadeItemInventario(item)
        forjaRepararCopiarItemParaSlot(ficha, slotForja, item)
        prepararSlotVazioInventario(item, item.ordemInventario)
        return
    end

    if not forjaRepararSlotTemItem(ficha, 1) then
        forjaMostrarAviso(controle, "Coloque o equipamento no primeiro slot.")
        return
    end
    if not forjaItemEhMinerioReparo(item) then
        forjaMostrarAviso(controle, "O segundo slot aceita apenas minerio.")
        return
    end
    if string.upper(tostring(item.RankItem or "")) ~= string.upper(tostring(ficha[forjaRepararCampo(1, "RankItem")] or "")) then
        forjaMostrarAviso(controle, "Minerio de rank diferente da receita do equipamento.")
        return
    end

    forjaRepararCopiarItemParaSlot(ficha, slotForja, item, 1)
    forjaConsumirUmaUnidadeInventario(item)
end

function CWNA_dragSlotForjaReparar(ficha, slotForja, drag)
    if ficha == nil or drag == nil or not forjaRepararSlotTemItem(ficha, slotForja) then return end
    drag:addData("cwnaForjaRepararSlot", tostring(slotForja))
    drag:addData("text", tostring(ficha[forjaRepararCampo(slotForja, "nomeItem")] or "Item"))
    local imagem = tostring(ficha[forjaRepararCampo(slotForja, "imagemestilo2")] or "")
    if imagem ~= "" then
        drag:addData("url", imagem)
        drag:addData("imageURL", imagem)
        drag:addData("image", imagem)
        drag:addData("text/uri-list", imagem)
    end
end

function CWNA_devolverSlotForjaRepararParaInventario(ficha, slotForja, itemDestino, controle)
    if ficha == nil or itemDestino == nil or not forjaRepararSlotTemItem(ficha, slotForja) then return end
    if tostring(ficha[forjaRepararCampo(slotForja, "usaQuantidade")] or "") == "true" then
        local qtdSlot = math.max(1, math.floor(forjaNumero(ficha[forjaRepararCampo(slotForja, "quantidade")], 1)))
        for _, item in ipairs(NDB.getChildNodes(ficha.magias2)) do
            if not ehSlotVazioInventario(item) and forjaItemEmpilhavel(item) and tostring(item.nomeItem or "") == tostring(ficha[forjaRepararCampo(slotForja, "nomeItem")] or "") and string.upper(tostring(item.RankItem or "")) == string.upper(tostring(ficha[forjaRepararCampo(slotForja, "RankItem")] or "")) then
                forjaAtualizarQuantidadeInventario(item, forjaNumero(item.quantidade, 0) + qtdSlot)
                forjaRepararLimparSlot(ficha, slotForja)
                return
            end
        end
        if not ehSlotVazioInventario(itemDestino) then itemDestino = forjaPrimeiroSlotVazioInventario(ficha) end
        if itemDestino == nil then forjaMostrarAviso(controle, "Limite maximo de 60 itens."); return end
        local ordem = itemDestino.ordemInventario
        forjaRepararCopiarSlotParaItem(ficha, slotForja, itemDestino)
        itemDestino.ordemInventario = ordem
        itemDestino.quantidade = qtdSlot
        itemDestino.quantidadeDisplay = tostring(qtdSlot)
        itemDestino.usaQuantidade = "true"
        forjaRepararLimparSlot(ficha, slotForja)
        return
    end

    if not ehSlotVazioInventario(itemDestino) then
        forjaMostrarAviso(controle, "Solte em um slot vazio do inventario.")
        return
    end
    local ordem = itemDestino.ordemInventario
    forjaRepararCopiarSlotParaItem(ficha, slotForja, itemDestino)
    itemDestino.ordemInventario = ordem
    forjaRepararLimparSlot(ficha, slotForja)
end

function CWNA_trabalharForjaReparar(ficha, controle)
    if ficha == nil then return end
    if not forjaRepararSlotTemItem(ficha, 1) or not forjaRepararSlotTemItem(ficha, 2) then
        forjaMostrarAviso(controle, "Coloque o equipamento e o minerio para reparar.")
        return
    end

    local maxPd = tonumber(ficha[forjaRepararCampo(1, "durabilidadeMaxima")]) or durabilidadeMaximaPorRankInventario(ficha[forjaRepararCampo(1, "RankItem")])
    local pdAtual = tonumber(ficha[forjaRepararCampo(1, "durabilidade")])
    if pdAtual == nil then pdAtual = maxPd end

    if pdAtual >= maxPd then
        ficha[forjaRepararCampo(1, "durabilidadeMaxima")] = maxPd
        ficha[forjaRepararCampo(1, "durabilidade")] = maxPd
        ficha[forjaRepararCampo(1, "durabilidadeDisplay")] = tostring(math.floor(maxPd))
        forjaMostrarAviso(controle, "Esse item ja esta com durabilidade 100%")
        return
    end

    ficha[forjaRepararCampo(1, "durabilidadeMaxima")] = maxPd
    ficha[forjaRepararCampo(1, "durabilidade")] = maxPd
    ficha[forjaRepararCampo(1, "durabilidadeDisplay")] = tostring(math.floor(maxPd))
    ficha[forjaRepararCampo(1, "durabilidadeBaseTempo")] = maxPd
    ficha[forjaRepararCampo(1, "durabilidadeDataBase")] = ""
    forjaRepararLimparSlot(ficha, 2)
    forjaMostrarAviso(controle, "Equipamento reparado.")
end
function CWNA_inicializarSlotsInventario(ficha, listaControle)
    if ficha == nil then
        return
    end

    local lista = ficha.magias2

    if lista == nil and listaControle ~= nil then
        lista = listaControle.node
    end

    if lista == nil then
        lista = NDB.createChildNode(ficha, "magias2")
    end

    if lista == nil then
        return
    end

    local totalNos = contarNosInventario(lista)

    if totalNos >= 60 then
        CWNA_garantirSlotsInventario(ficha, listaControle)
        ficha.SlotsInventarioCriados = "true"
        return
    end

    if ficha.SlotsInventarioCriados == "true" then
        return
    end

    local usados = {}

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        local ordem = tonumber(item.ordemInventario)

        if ordem ~= nil and ordem >= 1 and ordem <= 60 then
            usados[ordem] = true
        end
    end

    for i = 1, 60 do
        if totalNos >= 60 then
            break
        end

        if usados[i] ~= true then
            local slot = nil

            if listaControle ~= nil and listaControle.append ~= nil then
                slot = listaControle:append()
            end

            if slot == nil then
                slot = NDB.createChildNode(lista, "item")
            end

            if slot ~= nil then
                prepararSlotVazioInventario(slot, i)
                usados[i] = true
                totalNos = totalNos + 1
            end
        end
    end

    ficha.SlotsInventarioCriados = "true"
end

function CWNA_garantirSlotsInventario(ficha, listaControle)
    if ficha == nil and listaControle == nil then
        return
    end

    local lista = ficha and ficha.magias2 or nil

    if lista == nil and listaControle ~= nil then
        lista = listaControle.node
    end

    if lista == nil then
        return
    end

    local totalNos = 0
    local slotsVazios = {}

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        totalNos = totalNos + 1

        if ehSlotVazioInventario(item) then
            table.insert(slotsVazios, item)
        end
    end

    if totalNos > 60 then
        table.sort(slotsVazios, function(a, b)
            local ordemA = tonumber(a.ordemInventario) or 999999
            local ordemB = tonumber(b.ordemInventario) or 999999

            if ordemA ~= ordemB then
                return ordemA > ordemB
            end

            return tostring(a.uidInventario or "") > tostring(b.uidInventario or "")
        end)

        for _, slot in ipairs(slotsVazios) do
            if totalNos <= 60 then
                break
            end

            NDB.deleteNode(slot)
            totalNos = totalNos - 1
        end
    end

    local usados = {}
    local livres = {}

    for i = 1, 60 do
        livres[i] = true
    end

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        if item.uidInventario == nil or item.uidInventario == "" then
            item.uidInventario = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
        end

        local ordem = tonumber(item.ordemInventario)

        if ordem ~= nil and ordem >= 1 and ordem <= 60 and usados[ordem] == nil then
            usados[ordem] = item
            livres[ordem] = nil
        end
    end

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        local ordem = tonumber(item.ordemInventario)

        if ordem == nil or ordem < 1 or ordem > 60 or usados[ordem] ~= item then
            for i = 1, 60 do
                if livres[i] then
                    item.ordemInventario = i
                    usados[i] = item
                    livres[i] = nil
                    break
                end
            end
        end
    end

    for i = 1, 60 do
        if usados[i] == nil then
            if totalNos >= 60 then
                return
            end

            local slot = nil

            if listaControle ~= nil and listaControle.append ~= nil then
                slot = listaControle:append()
            end

            if slot == nil then
                return
            end

            slot.slotVazio = "true"
            slot.ordemInventario = i
            slot.uidInventario = "slot_" .. tostring(i)
            slot.nomeItem = ""
            slot.tipoItem = ""
            slot.RankItem = ""
            slot.imagemestilo2 = ""
            slot.equipadoEm = ""
            slot.quantidade = ""
            usados[i] = slot
            totalNos = totalNos + 1
        end
    end
end

function CWNA_repopularSlotsInventario(ficha, listaControle)
    if ficha == nil and listaControle == nil then
        return
    end

    local lista = ficha and ficha.magias2 or nil

    if lista == nil and listaControle ~= nil then
        lista = listaControle.node
    end

    if lista == nil then
        return
    end

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        if ehSlotVazioInventario(item) then
            NDB.deleteNode(item)
        end
    end

    CWNA_garantirSlotsInventario(ficha, listaControle)

    if listaControle ~= nil and listaControle.sort ~= nil then
        listaControle:sort()
    end
end

local function procurarPrimeiroSlotVazioInventario(lista)
    if lista == nil then
        return nil
    end

    local melhor = nil
    local melhorOrdem = 999999

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        if ehSlotVazioInventario(item) then
            local ordem = tonumber(item.ordemInventario) or 999999

            if ordem < melhorOrdem then
                melhor = item
                melhorOrdem = ordem
            end
        end
    end

    return melhor
end

local function contarSlotsVaziosInventario(lista)
    local total = 0
    if lista == nil then return total end

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        if ehSlotVazioInventario(item) then
            total = total + 1
        end
    end

    return total
end

local function procurarSlotsVaziosInventario(lista, quantidade, slotPreferido)
    local slots = {}
    if lista == nil then return slots end

    if slotPreferido ~= nil and ehSlotVazioInventario(slotPreferido) then
        table.insert(slots, slotPreferido)
    end

    local candidatos = {}
    for _, item in ipairs(NDB.getChildNodes(lista)) do
        if ehSlotVazioInventario(item) and item ~= slotPreferido then
            table.insert(candidatos, item)
        end
    end

    table.sort(candidatos, function(a, b)
        return (tonumber(a.ordemInventario) or 999999) < (tonumber(b.ordemInventario) or 999999)
    end)

    for _, item in ipairs(candidatos) do
        if #slots >= quantidade then break end
        table.insert(slots, item)
    end

    return slots
end
local function procurarItemLojaPorUid(ficha, uid)
    if ficha == nil or ficha.lojaItens == nil or uid == nil then
        return nil
    end

    for _, item in ipairs(NDB.getChildNodes(ficha.lojaItens)) do
        if tostring(item.uidLoja or "") == tostring(uid or "") then
            return item
        end
    end

    return nil
end

local function valorRankLoja(rank)
    local r = string.upper(limparTextoInventario(rank))

    if r == "SS" then return 7 end
    if r == "S" then return 6 end
    if r == "A" then return 5 end
    if r == "B" then return 4 end
    if r == "C" then return 3 end
    if r == "D" then return 2 end
    if r == "E" then return 1 end

    return 0
end

local function corRankLoja(rank)
    local r = string.upper(limparTextoInventario(rank))

    if r == "SS" then return "#FFD700" end
    if r == "S" then return "#FF4D4D" end
    if r == "A" then return "#FF9F1C" end
    if r == "B" then return "#B15CFF" end
    if r == "C" then return "#4DA3FF" end
    if r == "D" then return "#5DD46F" end
    if r == "E" then return "#BFC3C7" end

    return "#FFFFFF"
end

local function codigoCorRankChatLoja(rank)
    local r = string.upper(limparTextoInventario(rank))

    if r == "SS" then return "10" end
    if r == "E" then return "14" end
    if r == "D" then return "9" end
    if r == "C" then return "11" end
    if r == "B" then return "13" end
    if r == "A" then return "8" end
    if r == "S" then return "4" end

    return "1"
end

function CWNA_textoOrdemLoja(valor)
    local texto = limparTextoInventario(valor)

    if normalizarChaveCatalogoInventario ~= nil then
        texto = normalizarChaveCatalogoInventario(texto)
    end

    local acentos = {
        {"\195\161", "a"}, {"\195\160", "a"}, {"\195\162", "a"}, {"\195\163", "a"},
        {"\195\129", "a"}, {"\195\128", "a"}, {"\195\130", "a"}, {"\195\131", "a"},
        {"\195\169", "e"}, {"\195\170", "e"}, {"\195\137", "e"}, {"\195\138", "e"},
        {"\195\173", "i"}, {"\195\141", "i"},
        {"\195\179", "o"}, {"\195\180", "o"}, {"\195\181", "o"},
        {"\195\147", "o"}, {"\195\148", "o"}, {"\195\149", "o"},
        {"\195\186", "u"}, {"\195\188", "u"}, {"\195\154", "u"}, {"\195\156", "u"},
        {"\195\167", "c"}, {"\195\135", "c"},
        {"\195\131\194\161", "a"}, {"\195\131\194\160", "a"}, {"\195\131\194\162", "a"}, {"\195\131\194\163", "a"},
        {"\195\131\194\169", "e"}, {"\195\131\194\170", "e"}, {"\195\131\194\173", "i"},
        {"\195\131\194\179", "o"}, {"\195\131\194\180", "o"}, {"\195\131\194\181", "o"},
        {"\195\131\194\186", "u"}, {"\195\131\194\188", "u"}, {"\195\131\194\167", "c"}
    }

    for _, par in ipairs(acentos) do
        texto = texto:gsub(par[1], par[2])
    end

    return texto
end
function CWNA_ehTipoPotionLoja(tipo, nome)
    local t = CWNA_textoOrdemLoja(tipo)
    local n = CWNA_textoOrdemLoja(nome)

    return t == "potion hp" or t == "potion pp" or t:find("^potion") ~= nil or t:find("^pocao") ~= nil or n:find("^potion") ~= nil or n:find("^pocao") ~= nil
end

function CWNA_subtipoMaterialLoja(item)
    local subtipo = CWNA_textoOrdemLoja(item and item.subtipoMaterial)
    local tipo = CWNA_textoOrdemLoja(item and item.tipoItem)

    if subtipo ~= "" then
        return subtipo
    end

    if tipo == "minerio" then
        return "minerios"
    end

    if tipo == "outros" or tipo == "material" then
        return "outros"
    end

    return ""
end

function CWNA_ordemSubtipoLoja(item)
    local subtipo = CWNA_subtipoMaterialLoja(item)
    local tipo = CWNA_textoOrdemLoja(item and item.tipoItem)

    if subtipo == "minerios" or subtipo == "minerio" or subtipo == "metal" or subtipo == "metais" or tipo == "minerio" then return 1 end
    if subtipo == "couros" or subtipo == "couro" then return 2 end
    if subtipo == "madeira" or subtipo == "madeiras" then return 3 end
    if subtipo == "ervas" or subtipo == "erva" then return 4 end
    if subtipo == "cristais" or subtipo == "cristal" then return 5 end
    if subtipo == "frascos" or subtipo == "frasco" then return 6 end
    if subtipo == "ferramentas" or subtipo == "ferramenta" then return 7 end
    if subtipo == "receitas" or subtipo == "receita" then return 8 end
    if subtipo == "outros" then return 9 end

    return 10
end

function CWNA_ordemTipoLoja(tipo)
    local t = CWNA_textoOrdemLoja(tipo)

    if t == "arma" then return 1 end
    if t == "escudo" then return 2 end
    if t == "capacete" then return 3 end
    if t == "peitoral" or t == "armadura" then return 4 end
    if t == "calca" then return 5 end
    if t == "bota" then return 6 end
    if CWNA_ehTipoPotionLoja(t, "") then return 7 end
    if t == "material" or t == "minerio" then return 8 end
    if t == "luz" then return 9 end

    return 10
end

function CWNA_ordemTipoItemLoja(item)
    local tipo = CWNA_textoOrdemLoja(item and item.tipoItem)
    local subtipo = CWNA_subtipoMaterialLoja(item)

    if tipo == "luz" or subtipo == "luz" then return 9 end
    if CWNA_ehTipoPotionLoja(item and item.tipoItem, item and item.nomeItem) then return 7 end
    if tipo == "material" or tipo == "minerio" then return 8 end

    return CWNA_ordemTipoLoja(tipo)
end

function CWNA_grupoOrdenacaoTipoLoja(tipo)
    return CWNA_ordemTipoLoja(tipo)
end
local function ehMaterialLoja(item)
    local t = limparTextoInventario(item and item.tipoItem)

    return t == "material" or t == "minério" or t == "minerio" or t == "outros"
end

local function itemLojaPassaFiltro(ficha, item)
    if ficha == nil or item == nil then
        return false
    end

    local filtroTipo = string.upper(tostring((CWNA_lojaFiltroTipoLocal ~= nil and CWNA_lojaFiltroTipoLocal(ficha)) or ficha.LojaFiltroTipo or "TODOS"))
    local filtroRank = string.upper(tostring((CWNA_lojaFiltroRankLocal ~= nil and CWNA_lojaFiltroRankLocal(ficha)) or ficha.LojaFiltroRank or "TODOS"))
    local tipo = limparTextoInventario(item.tipoItem)
    local rank = string.upper(tostring(item.RankItem or ""))

    if filtroRank ~= "TODOS" and rank ~= filtroRank then
        return false
    end

    if filtroTipo == "TODOS" or filtroTipo == "RANK" then
        return true
    end

    if filtroTipo == "ACESSORIO" or filtroTipo == "ACESS?RIO" then
        return tipo == "acessorio" or tipo == "acess?rio"
    end

    if filtroTipo == "ARMA" then
        return tipo == "arma"
    end

    if filtroTipo == "ESCUDO" or filtroTipo == "ESCUDOS" then
        return tipo == "escudo"
    end

    if filtroTipo == "CAPACETE" then
        return tipo == "capacete"
    end

    if filtroTipo == "PEITORAL" then
        return tipo == "peitoral" or tipo == "armadura"
    end

    if filtroTipo == "CALCA" or filtroTipo == "CAL?A" then
        return tipo == "calca" or tipo == "calça"
    end

    if filtroTipo == "BOTA" then
        return tipo == "bota"
    end

    if filtroTipo == "POTIONS" then
        return tipo == "potion hp" or tipo == "potion pp" or tipo:find("^potion") ~= nil
    end

    if filtroTipo == "MATERIAL" then
        return ehMaterialLoja(item)
    end

    return true
end

local function itensFiltradosLoja(ficha)
    local itens = {}

    if ficha == nil or ficha.lojaItens == nil then
        return itens
    end

    for _, item in ipairs(NDB.getChildNodes(ficha.lojaItens)) do
        if itemLojaPassaFiltro(ficha, item) then
            table.insert(itens, item)
        end
    end

    table.sort(itens, function(a, b)
        local tipoA = CWNA_ordemTipoItemLoja(a)
        local tipoB = CWNA_ordemTipoItemLoja(b)
        local rankA = valorRankLoja(a.RankItem)
        local rankB = valorRankLoja(b.RankItem)

        if tipoA ~= tipoB then
            return tipoA < tipoB
        end

        if tipoA == 8 then
            local subtipoA = CWNA_ordemSubtipoLoja(a)
            local subtipoB = CWNA_ordemSubtipoLoja(b)

            if subtipoA ~= subtipoB then
                return subtipoA < subtipoB
            end
        end

        if rankA ~= rankB then
            return rankA > rankB
        end

        local ordemA = tonumber(a.ordemLoja) or 999999
        local ordemB = tonumber(b.ordemLoja) or 999999

        if ordemA ~= ordemB then
            return ordemA < ordemB
        end

        return tostring(a.uidLoja or "") < tostring(b.uidLoja or "")
    end)

    return itens
end
local function CWNA_atualizarCardsLoja(ficha)
    if ficha == nil or ficha.lojaItens == nil then
        return
    end

    CWNA_recriarPaginaLoja(ficha)
end

CWNA_LOJA_UI_ESTADO = CWNA_LOJA_UI_ESTADO or {}

function CWNA_chaveLojaLocal(ficha)
    if ficha == nil then return "sem_ficha" end
    local ok, handle = pcall(function() return NDB.getNodeHandle(ficha) end)
    if ok and handle ~= nil then return tostring(handle) end
    return tostring(ficha)
end

function CWNA_estadoLojaLocal(ficha)
    local chave = CWNA_chaveLojaLocal(ficha)
    local estado = CWNA_LOJA_UI_ESTADO[chave]
    if estado == nil then
        estado = {aberta = false, destravada = false, filtroTipo = "TODOS", filtroRank = "TODOS"}
        CWNA_LOJA_UI_ESTADO[chave] = estado
    end
    return estado
end

function CWNA_setLojaAbertaLocal(ficha, valor)
    local estado = CWNA_estadoLojaLocal(ficha)
    estado.aberta = valor == true
    if not estado.aberta then estado.destravada = false end
end

function CWNA_setLojaDestravadaLocal(ficha, valor)
    local estado = CWNA_estadoLojaLocal(ficha)
    estado.destravada = valor == true
end

function CWNA_lojaAbertaLocal(ficha)
    return CWNA_estadoLojaLocal(ficha).aberta == true
end

function CWNA_lojaEditorLocalAberto(ficha)
    return CWNA_estadoLojaLocal(ficha).destravada == true
end

function CWNA_lojaFiltroTipoLocal(ficha)
    return CWNA_estadoLojaLocal(ficha).filtroTipo or "TODOS"
end

function CWNA_lojaFiltroRankLocal(ficha)
    return CWNA_estadoLojaLocal(ficha).filtroRank or "TODOS"
end

local function CWNA_garantirOrdemLoja(ficha)
    if ficha == nil or ficha.lojaItens == nil then
        return
    end

    local itens = {}

    for _, item in ipairs(NDB.getChildNodes(ficha.lojaItens)) do
        table.insert(itens, item)
    end

    table.sort(itens, function(a, b)
        local ordemA = tonumber(a.ordemLoja) or 999999
        local ordemB = tonumber(b.ordemLoja) or 999999

        if ordemA ~= ordemB then
            return ordemA < ordemB
        end

        return tostring(a.uidLoja or "") < tostring(b.uidLoja or "")
    end)

    for i, item in ipairs(itens) do
        item.ordemLoja = i
    end
end

local camposPaginaLoja = {
    "uidLoja",
    "ordemLoja",
    "LojaDestravadaPagina",
    "nomeItem",
    "tipoItem",
    "subtipoMaterial",
    "RankItem",
    "imagemestilo2",
    "precoPrata",
    "quantidade",
    "descricaoItem",
    "hp",
    "pp",
    "ca",
    "rd",
    "dano",
    "cura",
    "raio"
}

local LOJA_ITENS_POR_PAGINA = 24

local function CWNA_listaPaginaLoja(ficha, buffer)
    if ficha == nil then
        return nil
    end

    local campo = buffer == "B" and "lojaItensPaginaB" or "lojaItensPaginaA"

    if ficha[campo] == nil then
        NDB.createChildNode(ficha, campo)
    end

    return ficha[campo]
end

local function CWNA_preencherBufferPaginaLoja(ficha, buffer, itens, inicio, porPagina)
    local listaPagina = CWNA_listaPaginaLoja(ficha, buffer)

    if listaPagina == nil then
        return
    end

    local clones = NDB.getChildNodes(listaPagina)

    for posPagina = 1, porPagina do
        local clone = clones[posPagina]

        if clone == nil then
            clone = NDB.createChildNode(listaPagina, "itemLojaPagina")
            clones[posPagina] = clone
        end

        if clone.LojaCardVisivel ~= "false" then
            clone.LojaCardVisivel = "false"
        end
    end

    for posPagina = 1, porPagina do
        local item = itens[inicio + posPagina - 1]
        local clone = clones[posPagina]

        if item ~= nil then
            for _, campo in ipairs(camposPaginaLoja) do
                local valor = item[campo] or ""
                if clone[campo] ~= valor then
                    clone[campo] = valor
                end
            end
        else
            for _, campo in ipairs(camposPaginaLoja) do
                if clone[campo] ~= "" then
                    clone[campo] = ""
                end
            end
        end

        local destravadaPagina = (CWNA_lojaEditorLocalAberto ~= nil and CWNA_lojaEditorLocalAberto(ficha)) and "true" or "false"
        if clone.LojaDestravadaPagina ~= destravadaPagina then
            clone.LojaDestravadaPagina = destravadaPagina
        end

        if item ~= nil and clone.LojaCardVisivel ~= "true" then
            clone.LojaCardVisivel = "true"
        end
    end
end

function CWNA_recriarPaginaLoja(ficha)
    if ficha == nil then
        return
    end

    if ficha.lojaItens == nil then
        NDB.createChildNode(ficha, "lojaItens")
    end

    local itens = itensFiltradosLoja(ficha)

    local porPagina = LOJA_ITENS_POR_PAGINA
    ficha.LojaItensPorPagina = porPagina
    local pagina = tonumber(ficha.LojaPaginaAtual) or 1
    local maxPagina = math.max(1, math.ceil(#itens / porPagina))

    if pagina > maxPagina then pagina = maxPagina end
    if pagina < 1 then pagina = 1 end

    ficha.LojaPaginaAtual = pagina
    ficha.LojaPaginaTexto = tostring(pagina) .. "/" .. tostring(maxPagina)

    local inicio = ((pagina - 1) * porPagina) + 1
    local bufferAtual = tostring(ficha.LojaPaginaBufferAtivo or "")
    local bufferDestino = bufferAtual == "A" and "B" or "A"

    CWNA_preencherBufferPaginaLoja(ficha, bufferDestino, itens, inicio, porPagina)
    ficha.LojaPaginaBufferAtivo = bufferDestino
end

local function CWNA_ordemInsercaoLoja(ficha)
    if ficha == nil or ficha.lojaItens == nil then
        return 1
    end

    CWNA_garantirOrdemLoja(ficha)

    local total = 0
    for _, _ in ipairs(NDB.getChildNodes(ficha.lojaItens)) do
        total = total + 1
    end

    local porPagina = LOJA_ITENS_POR_PAGINA
    ficha.LojaItensPorPagina = porPagina
    local pagina = tonumber(ficha.LojaPaginaAtual) or 1
    local inicio = ((pagina - 1) * porPagina) + 1
    local fim = pagina * porPagina

    if total < inicio then
        return total + 1
    end

    local ocupadosNaPagina = math.max(0, math.min(total, fim) - inicio + 1)

    if ocupadosNaPagina < porPagina then
        return inicio + ocupadosNaPagina
    end

    return total + 1
end

local function CWNA_totalItensLoja(ficha)
    return #itensFiltradosLoja(ficha)
end

function CWNA_mudarPaginaLoja(ficha, delta)
    if ficha == nil then
        return
    end

    ficha.LojaPaginaAtual = (tonumber(ficha.LojaPaginaAtual) or 1) + (tonumber(delta) or 0)
    CWNA_recriarPaginaLoja(ficha)
end

function CWNA_definirFiltroLoja(ficha, tipoFiltro, valor)
    if ficha == nil then
        return
    end

    local estado = CWNA_estadoLojaLocal(ficha)
    if tipoFiltro == "rank" then
        estado.filtroRank = string.upper(tostring(valor or "TODOS"))
    else
        estado.filtroTipo = string.upper(tostring(valor or "TODOS"))
    end

    ficha.TempCompraLojaUid = ""
    ficha.TempCompraLojaNome = ""
    ficha.TempCompraLojaNomeDisplay = "NOME:"
    ficha.TempCompraLojaRank = ""
    ficha.TempCompraLojaRankDisplay = "RANK:"
    ficha.TempCompraLojaImagem = ""
    ficha.TempCompraLojaDescricao = ""
    ficha.TempCompraLojaAtributos = ""
    ficha.TempCompraLojaPreco = ""
    ficha.TempCompraLojaPrecoDisplay = "💰 PREÇO:"
    ficha.TempCompraLojaDisponivelDisplay = "DISPONÍVEL:"
    ficha.TempCompraLojaCorRank = "#FFFFFF"
    ficha.TempCompraLojaConfirmTexto = ""
    ficha.TempCompraLojaQuantidade = 1
    ficha.TempCompraLojaPermiteQuantidade = "false"
    ficha.TempCompraLojaSlotDestinoUid = ""

    ficha.LojaPaginaAtual = 1
    CWNA_mudarPaginaLoja(ficha, 0)
end

function CWNA_atualizarFiltroLojaVisual(controle)
    if controle == nil or controle.sheet == nil then
        return
    end

    local raiz = controle

    while raiz ~= nil do
        if raiz.name == "frameLojaInventario" or raiz.name == "frameEditorLoja" then
            break
        end

        raiz = raiz.parent
    end

    if raiz == nil then
        raiz = controle
    end

    if raiz ~= nil and raiz.visible == false then
        return
    end

    local tipoAtual = string.upper(tostring((CWNA_lojaFiltroTipoLocal ~= nil and CWNA_lojaFiltroTipoLocal(controle.sheet)) or controle.sheet.LojaFiltroTipo or "TODOS"))
    local sufixo = ""

    if raiz.name == "frameEditorLoja" then
        sufixo = "Editor"
    end

    local filtros = {
        {nome = "rectFiltroLojaTodos", valor = "TODOS"},
        {nome = "rectFiltroLojaArmas", valor = "ARMA"},
        {nome = "rectFiltroLojaEscudos", valor = "ESCUDO"},
        {nome = "rectFiltroLojaCapacete", valor = "CAPACETE"},
        {nome = "rectFiltroLojaPeitoral", valor = "PEITORAL"},
        {nome = "rectFiltroLojaCalca", valor = "CALCA"},
        {nome = "rectFiltroLojaBota", valor = "BOTA"},
        {nome = "rectFiltroLojaPotion", valor = "POTIONS"},
        {nome = "rectFiltroLojaMaterial", valor = "MATERIAL"}
    }

    for _, filtro in ipairs(filtros) do
        local rect = raiz:findControlByName(filtro.nome .. sufixo)

        if rect ~= nil then
            local selecionado = tipoAtual == filtro.valor
            rect.strokeColor = selecionado and "#FF8C00" or "#00000000"
            rect.strokeSize = selecionado and 2 or 0
        end
    end

    local rectRank = raiz:findControlByName("rectFiltroLojaRank" .. sufixo)

    if rectRank ~= nil then
        local rankAtual = string.upper(tostring((CWNA_lojaFiltroRankLocal ~= nil and CWNA_lojaFiltroRankLocal(controle.sheet)) or controle.sheet.LojaFiltroRank or "TODOS"))
        local rankSelecionado = rankAtual ~= "" and rankAtual ~= "TODOS"
        rectRank.strokeColor = rankSelecionado and "#FF8C00" or "#00000000"
        rectRank.strokeSize = rankSelecionado and 2 or 0
    end
end

local camposJsonLoja = {"uidLoja","ordemLoja","nomeItem","tipoItem","subtipoMaterial","RankItem","imagemestilo2","precoPrata","quantidade","quantidadeDisplay","nivelUpgrade","textoUpgrade","usaQuantidade","estoqueInfinito","estoqueDisponivel","descricaoItem","hp","pp","ca","rd","dano","cura","raio","durabilidade","durabilidadeMaxima"}

local function CWNA_campoNumericoJsonLoja(campo)
    return campo == "ordemLoja" or campo == "precoPrata" or campo == "quantidade" or campo == "hp" or campo == "pp" or campo == "ca" or campo == "rd" or campo == "cura" or campo == "raio" or campo == "durabilidade" or campo == "durabilidadeMaxima"
end

local function CWNA_numeroLoja(valor, padrao)
    if valor == nil then return padrao or 0 end
    local texto = tostring(valor)
    texto = texto:gsub("%s+", "")
    texto = texto:gsub(",", ".")
    return tonumber(texto) or padrao or 0
end

local function CWNA_jsonValorLoja(valor)
    valor = tostring(valor or "")
    valor = valor:gsub("\\", "\\\\")
    valor = valor:gsub('"', '\\"')
    valor = valor:gsub("\r", " ")
    valor = valor:gsub("\n", " ")
    return '"' .. valor .. '"'
end

local function CWNA_exportarLojaJsonTexto(ficha)
    if ficha == nil or ficha.lojaItens == nil then return "{\n  \"items\": []\n}" end
    CWNA_garantirOrdemLoja(ficha)

    local saida = {"{", "  \"items\": ["}
    local itens = NDB.getChildNodes(ficha.lojaItens)

    for i, item in ipairs(itens) do
        table.insert(saida, "    {")

        for c, campo in ipairs(camposJsonLoja) do
            local valor = item[campo]
            local linha = "      " .. CWNA_jsonValorLoja(campo) .. ": "

            if campo == "estoqueInfinito" then
                local v = tostring(valor or "true")
                linha = linha .. ((v == "false" or v == "0") and "false" or "true")
            elseif CWNA_campoNumericoJsonLoja(campo) then
                linha = linha .. tostring(CWNA_numeroLoja(valor, 0))
            else
                linha = linha .. CWNA_jsonValorLoja(valor)
            end

            if c < #camposJsonLoja then linha = linha .. "," end
            table.insert(saida, linha)
        end

        table.insert(saida, i < #itens and "    }," or "    }")
    end

    table.insert(saida, "  ]")
    table.insert(saida, "}")
    return table.concat(saida, "\n")
end
function CWNA_importarLojaJsonTexto(ficha, texto, controleOrigem)
    if ficha == nil then return false end
    texto = tostring(texto or "")

    local itensImportados = {}

    local function lerCampo(bloco, campo)
        local valor = bloco:match('"' .. campo .. '"%s*:%s*"(.-)"')
        if valor == nil then
            valor = bloco:match('"' .. campo .. '"%s*:%s*(true)') or bloco:match('"' .. campo .. '"%s*:%s*(false)') or bloco:match('"' .. campo .. '"%s*:%s*([%-]?%d+%.?%d*)')
        else
            valor = tostring(valor):gsub('\\"', '"'):gsub('\\n', '\n'):gsub('\\r', '\r'):gsub('\\\\', '\\')
        end
        return valor
    end

    local function adicionarBloco(bloco)
        if bloco == nil or bloco:find('"nomeItem"') == nil then return end
        local dados = {}

        for _, campo in ipairs(camposJsonLoja) do
            local valor = lerCampo(bloco, campo)
            if valor ~= nil then
                if CWNA_campoNumericoJsonLoja(campo) then
                    dados[campo] = CWNA_numeroLoja(valor, 0)
                else
                    dados[campo] = valor
                end
            end
        end

        if tostring(dados.nomeItem or "") ~= "" then table.insert(itensImportados, dados) end
    end

    local function blocosArrayItems(json)
        local blocos = {}
        local inicioItems = json:find('"items"%s*:%s*%[')
        if inicioItems == nil then return blocos end

        local inicioArray = json:find('%[', inicioItems)
        if inicioArray == nil then return blocos end

        local profundidade = 0
        local inicioObjeto = nil
        local emString = false
        local escape = false

        for i = inicioArray + 1, #json do
            local ch = json:sub(i, i)

            if emString then
                if escape then
                    escape = false
                elseif ch == '\\' then
                    escape = true
                elseif ch == '"' then
                    emString = false
                end
            else
                if ch == '"' then
                    emString = true
                elseif ch == '{' then
                    if profundidade == 0 then inicioObjeto = i end
                    profundidade = profundidade + 1
                elseif ch == '}' then
                    profundidade = profundidade - 1
                    if profundidade == 0 and inicioObjeto ~= nil then
                        table.insert(blocos, json:sub(inicioObjeto, i))
                        inicioObjeto = nil
                    end
                elseif ch == ']' and profundidade == 0 then
                    break
                end
            end
        end

        return blocos
    end

    for _, bloco in ipairs(blocosArrayItems(texto)) do
        adicionarBloco(bloco)
    end

    if #itensImportados == 0 then
        for bloco in texto:gmatch('"item%d+"%s*:%s*(%b{})') do
            adicionarBloco(bloco)
        end
    end

    if #itensImportados == 0 then
        CWNA_mostrarAvisoInventario(controleOrigem, "Nenhum item foi encontrado nesse JSON da loja.")
        return false
    end

    if ficha.lojaItens == nil then NDB.createChildNode(ficha, "lojaItens") end
    for _, item in ipairs(NDB.getChildNodes(ficha.lojaItens)) do NDB.deleteNode(item) end

    for i, dados in ipairs(itensImportados) do
        local item = NDB.createChildNode(ficha.lojaItens, "itemLoja")
        item.uidLoja = tostring(dados.uidLoja or "") ~= "" and dados.uidLoja or (tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999)) .. "_" .. tostring(i))
        item.ordemLoja = CWNA_numeroLoja(dados.ordemLoja, i)

        for _, campo in ipairs(camposJsonLoja) do
            if campo ~= "uidLoja" and campo ~= "ordemLoja" and dados[campo] ~= nil then item[campo] = dados[campo] end
        end
    end

    ficha.LojaPaginaAtual = 1
    CWNA_recriarPaginaLoja(ficha)
    CWNA_mostrarAvisoInventario(controleOrigem, "Loja importada: " .. tostring(#itensImportados) .. " itens.")
    return true
end
local function CWNA_lerArquivoTextoLoja(caminho)
    local arq = io.open(caminho, "r")
    if arq == nil then return nil end
    local conteudo = arq:read("*a")
    arq:close()
    return conteudo
end

local function CWNA_salvarArquivoTextoLoja(caminho, conteudo)
    local arq = io.open(caminho, "w")
    if arq == nil then return false end
    arq:write(conteudo or "")
    arq:close()
    return true
end

local function CWNA_streamParaTextoLoja(stream)
    if stream == nil then return nil end

    local ok, texto = pcall(function()
        stream.position = 0
        return stream:readBinary("s")
    end)

    if ok and texto ~= nil and tostring(texto) ~= "" then
        return tostring(texto)
    end

    local ok2, bytes = pcall(function()
        stream.position = 0
        local dados = {}
        local lidos = stream:read(dados, stream.size or stream.remainingBytes or 0)
        local partes = {}
        for i = 1, lidos do partes[i] = string.char(dados[i] or 0) end
        return table.concat(partes)
    end)

    if ok2 then return bytes end
    return nil
end

local function CWNA_textoParaStreamLoja(texto)
    local utils = require("utils.lua")
    local stream = utils.newMemoryStream()
    texto = tostring(texto or "")

    local bytes = {}
    for i = 1, #texto do
        bytes[i] = string.byte(texto, i)
    end

    if #bytes > 0 then
        stream:write(bytes, #bytes)
    end

    stream.position = 0
    return stream
end
function CWNA_importarLojaJson(ficha, controleOrigem)
    Dialogs.openFile("Importar loja JSON", "application/json,.json", false,
        function(arquivos)
            local arquivo = arquivos and arquivos[1] or nil
            if arquivo == nil or arquivo.stream == nil then
                CWNA_mostrarAvisoInventario(controleOrigem, "Nenhum arquivo JSON foi selecionado.")
                return
            end

            local texto = CWNA_streamParaTextoLoja(arquivo.stream)
            if texto == nil or texto == "" then
                CWNA_mostrarAvisoInventario(controleOrigem, "Nao foi possivel ler o arquivo JSON da loja.")
                return
            end

            CWNA_importarLojaJsonTexto(ficha, texto, controleOrigem)
        end,
        function()
        end)
end

local function CWNA_nomeExportacaoLoja(ficha)
    if ficha == nil then return "loja_crystal_world.json" end

    local indice = tonumber(ficha.LojaExportIndice) or 0
    local nome = "loja_crystal_world.json"

    if indice > 0 then
        nome = "loja_crystal_world(" .. tostring(indice) .. ").json"
    end

    ficha.LojaExportIndice = indice + 1
    return nome
end

function CWNA_exportarLojaJson(ficha, controleOrigem)
    local texto = CWNA_exportarLojaJsonTexto(ficha)
    if texto == nil or tostring(texto) == "" then
        CWNA_mostrarAvisoInventario(controleOrigem, "Nao ha dados da loja para exportar.")
        return
    end
    local stream = CWNA_textoParaStreamLoja(texto)
    local nomeArquivo = CWNA_nomeExportacaoLoja(ficha)

    Dialogs.saveFile("Exportar loja JSON", stream, nomeArquivo, "application/json",
        function()
            CWNA_mostrarAvisoInventario(controleOrigem, "Loja exportada com sucesso.")
        end,
        function()
        end)
end
local function enviarMensagemLoja(ficha, acao, item, valor, quantidade)
    local mesa = rrpg.getMesaDe(ficha) or Firecast.getMesaDe(ficha)
    local jogador = mesa and mesa.me or nil
    local chat = mesa and mesa.chat or nil

    if jogador == nil or chat == nil or item == nil then
        return
    end

    local nomeJogador = "Jogador"
    pcall(function()
        nomeJogador = tostring(jogador.nick or jogador.nickname or jogador.nome or jogador.name or jogador.login or "Jogador")
    end)

    local nomeItem = tostring(item.nomeItem or "Item")
    local tipoMsgLoja = limparTextoInventario(item and item.tipoItem)
    local usaQuantidadeMsgLoja = tipoMsgLoja == "material" or tipoMsgLoja == "outros" or tipoMsgLoja == "potion hp" or tipoMsgLoja == "potion pp" or tipoMsgLoja:find("^potion") ~= nil or tipoMsgLoja == "minerio" or tipoMsgLoja == "minério"

    if not usaQuantidadeMsgLoja then
        local textoUpgrade = tostring(item.textoUpgrade or "")

        if textoUpgrade == "" then
            textoUpgrade = "+" .. tostring(tonumber(item.nivelUpgrade) or 0)
        end

        nomeItem = nomeItem .. " " .. textoUpgrade
    end

    local cor = codigoCorRankChatLoja(item.RankItem)
    local qtd = math.max(1, math.floor(CWNA_numeroLoja(quantidade, 1)))
    local marcadorCor = "[" .. string.char(194, 167) .. "K"
    local marcadorImagem = "[" .. string.char(194, 167) .. "I "
    local imagem = tostring(item.imagemestilo2 or "")
    local texto = "<" .. nomeJogador .. "> " .. marcadorCor .. "1]" .. tostring(acao or "") .. ":\n" ..
                 tostring(qtd) .. "x " .. marcadorCor .. cor .. "]" .. nomeItem .. marcadorCor .. "1]"

    if imagem ~= "" then
        texto = texto .. "\n" .. marcadorImagem .. imagem .. "]"
    end

    if valor ~= nil then
        texto = texto .. "\npor " .. tostring(valor) .. " prata"
    end

    pcall(function()
        chat:enviarMensagem(texto)
    end)
end

local function tipoLojaEmpilhavel(item)
    local tipo = limparTextoInventario(item and item.tipoItem)
    return tipo == "material" or tipo == "outros" or tipo == "potion hp" or tipo == "potion pp" or tipo:find("^potion") ~= nil or tipo == "minério" or tipo == "minerio"
end
local function copiarItemLojaParaInventario(origem, destino)
    if origem == nil or destino == nil then
        return
    end

    destino.slotVazio = nil
    destino.uidInventario = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    destino.nomeItem = origem.nomeItem or ""
    destino.tipoItem = origem.tipoItem or ""
    destino.subtipoMaterial = origem.subtipoMaterial or ""
    destino.RankItem = origem.RankItem or "E"
    destino.imagemestilo2 = origem.imagemestilo2 or ""
    if tipoLojaEmpilhavel(origem) then
        destino.usaQuantidade = "true"
        destino.nivelUpgrade = ""
        destino.textoUpgrade = ""
        destino.quantidade = origem.quantidade or 1
        destino.quantidadeDisplay = tostring(destino.quantidade or 1)
    else
        destino.usaQuantidade = "false"
        destino.nivelUpgrade = tonumber(origem.nivelUpgrade) or 0
        destino.textoUpgrade = tostring(origem.textoUpgrade or "+0")
        destino.quantidade = ""
        destino.quantidadeDisplay = destino.textoUpgrade
    end
    destino.hp = origem.hp or 0
    destino.pp = origem.pp or 0
    destino.ca = origem.ca or 0
    destino.rd = origem.rd or 0
    destino.dano = origem.dano or ""
    destino.cura = origem.cura or 0
    destino.raio = origem.raio or origem.raioLuz or origem.luz or 0
    if itemEhEquipamentoInventario(destino) then
        local pdOrigem = tonumber(origem.durabilidade)
        local maxOrigem = tonumber(origem.durabilidadeMaxima)
        if pdOrigem ~= nil and pdOrigem <= 0 then pdOrigem = nil end
        if maxOrigem ~= nil and maxOrigem <= 0 then maxOrigem = nil end
        local maxPd = maxOrigem or pdOrigem or durabilidadeMaximaPorRankInventario(destino.RankItem)
        destino.durabilidadeMaxima = maxPd
        destino.durabilidade = pdOrigem or maxPd
        destino.durabilidadeBaseTempo = destino.durabilidade
        destino.durabilidadeDataBase = ""
        garantirDurabilidadeItemInventario(destino)
    else
        destino.durabilidade = ""
        destino.durabilidadeMaxima = ""
        destino.durabilidadeDisplay = ""
        destino.durabilidadeBaseTempo = ""
        destino.durabilidadeDataBase = ""
    end
    destino.equipadoEm = ""
    destino.origemLoja = "true"
    destino.uidLojaOrigem = origem.uidLoja or ""
    destino.precoLojaPrata = CWNA_numeroLoja(origem.precoPrata, 0)
    destino.descricaoLoja = origem.descricaoItem or ""
    destino.LivroReceitasAlquimistaLista = origem.LivroReceitasAlquimistaLista or ""
    destino.LivroReceitasAlquimistaQtd = origem.LivroReceitasAlquimistaQtd or ""
    destino.LivroReceitasAlquimistaRank = origem.LivroReceitasAlquimistaRank or ""
    local nomeLivroAlquimista = limparTextoInventario(destino.nomeItem)
    if nomeLivroAlquimista:find("livro de receitas", 1, true) ~= nil and nomeLivroAlquimista:find("alquimista", 1, true) ~= nil then
        destino.LivroReceitasAlquimistaLista = tostring(destino.LivroReceitasAlquimistaLista or "")
        destino.LivroReceitasAlquimistaQtd = tostring(destino.LivroReceitasAlquimistaQtd or "0")
        destino.LivroReceitasAlquimistaRank = tostring(destino.LivroReceitasAlquimistaRank or "E")
        if destino.LivroReceitasAlquimistaRank == "" then destino.LivroReceitasAlquimistaRank = "E" end
        destino.RankItem = destino.LivroReceitasAlquimistaRank
    end
end

local function prataAtualLoja(ficha)
    return CWNA_numeroLoja(ficha and ficha.PrataPersonagem, 0)
end

local function itemLojaEmpilhavel(item)
    return tipoLojaEmpilhavel(item)
end

local function itemInventarioBateComLoja(item, loja)
    if item == nil or loja == nil or not itemLojaEmpilhavel(loja) then
        return false
    end

    return tostring(item.origemLoja or "") == "true"
        and tostring(item.nomeItem or "") == tostring(loja.nomeItem or "")
        and limparTextoInventario(item.tipoItem) == limparTextoInventario(loja.tipoItem)
        and limparTextoInventario(item.subtipoMaterial) == limparTextoInventario(loja.subtipoMaterial)
        and string.upper(limparTextoInventario(item.RankItem)) == string.upper(limparTextoInventario(loja.RankItem))
        and tostring(item.imagemestilo2 or "") == tostring(loja.imagemestilo2 or "")
        and CWNA_numeroLoja(item.precoLojaPrata, 0) == CWNA_numeroLoja(loja.precoPrata, 0)
        and CWNA_numeroLoja(item.hp, 0) == CWNA_numeroLoja(loja.hp, 0)
        and CWNA_numeroLoja(item.pp, 0) == CWNA_numeroLoja(loja.pp, 0)
        and CWNA_numeroLoja(item.ca, 0) == CWNA_numeroLoja(loja.ca, 0)
        and CWNA_numeroLoja(item.rd, 0) == CWNA_numeroLoja(loja.rd, 0)
        and tostring(item.dano or "") == tostring(loja.dano or "")
        and CWNA_numeroLoja(item.cura, 0) == CWNA_numeroLoja(loja.cura, 0)
end

local function itemTemOrigemVendaLoja(item)
    if item == nil then return false end
    if tostring(item.origemLoja or "") == "true" then return true end
    if tostring(item.uidLojaOrigem or "") ~= "" then return true end
    if CWNA_numeroLoja(item.precoLojaPrata, 0) > 0 then return true end
    return tostring(item.nomeItem or "") ~= ""
end
local function itemInventarioBateComLojaParaVenda(ficha, item)
    if ficha == nil or item == nil or not itemTemOrigemVendaLoja(item) then
        return false
    end

    -- A venda usa os dados salvos no item comprado. O cadastro da loja pode mudar,
    -- o item pode ser aprimorado/reparado, e mesmo assim ele nao deve virar item comum.
    return true
end
local function valorVendaUnitarioLoja(item)
    local precoBase = CWNA_numeroLoja(item and item.precoLojaPrata, 0)
    local nivel = math.max(0, math.floor(CWNA_numeroLoja(item and item.nivelUpgrade, 0)))
    local multiplicador = 1

    if nivel > 0 then
        multiplicador = 2 ^ nivel
    end

    return math.max(0, math.floor((precoBase * multiplicador) / 2))
end
local function removerMarcaLojaInvalida(item)
    -- Mantem a origem da loja. Antes esta rotina apagava origemLoja/uid/preco
    -- quando a comparacao com o cadastro atual da loja falhava, fazendo itens
    -- comprados virarem comuns depois de upgrades, reparos ou edicao da loja.
end
local function procurarItemEmpilhavelDaLoja(ficha, itemLoja)
    if ficha == nil or ficha.magias2 == nil then
        return nil
    end

    for _, item in ipairs(NDB.getChildNodes(ficha.magias2)) do
        if itemInventarioBateComLoja(item, itemLoja) then
            return item
        end
    end

    return nil
end

local function procurarFrameAcimaLoja(controle, nomeFrame)
    local ctrl = controle

    while ctrl ~= nil do
        if ctrl.findControlByName ~= nil then
            local frame = ctrl:findControlByName(nomeFrame)
            if frame ~= nil then
                return frame
            end
        end

        ctrl = ctrl.parent
    end

    return nil
end

function CWNA_atualizarConfirmacaoCompraLoja(ficha)
    if ficha == nil then return end

    local qtd = math.max(1, math.floor(CWNA_numeroLoja(ficha.TempCompraLojaQuantidade, 1)))
    ficha.TempCompraLojaQuantidade = qtd
    local precoPrimeiro = CWNA_numeroLoja(ficha.TempCompraLojaPreco, 0)
    local precoBase = CWNA_numeroLoja(ficha.TempCompraLojaPrecoBase, precoPrimeiro)
    ficha.TempCompraLojaConfirmTexto = "por " .. tostring(precoPrimeiro + (precoBase * math.max(0, qtd - 1))) .. " prata?"
end
function CWNA_confirmarCompraItemLoja(ficha, controleOrigem)
    if ficha == nil then
        return
    end

    local itemLoja = procurarItemLojaPorUid(ficha, ficha.TempCompraLojaUid)

    if itemLoja == nil then
        CWNA_mostrarAvisoInventario(controleOrigem, "Item da loja nao encontrado.")
        return
    end

    local itemEmpilhavelCompra = itemLojaEmpilhavel(itemLoja)
    local qtdCompra = math.max(1, math.floor(CWNA_numeroLoja(ficha.TempCompraLojaQuantidade, 1)))
    local qtdBase = math.max(1, math.floor(CWNA_numeroLoja(itemLoja.quantidade, 1)))
    ficha.TempCompraLojaQuantidade = qtdCompra

    local qtdTotal = qtdCompra * qtdBase
    local precoUnitarioCompra = CWNA_numeroLoja(itemLoja.precoPrata, 0)
    local precoNegociadoCompra, usouNegociacaoCompra = precoUnitarioCompra, false
    if CWNA_precoCompraMercador ~= nil then
        precoNegociadoCompra, usouNegociacaoCompra = CWNA_precoCompraMercador(ficha, itemLoja, precoUnitarioCompra)
    end
    local custo = precoUnitarioCompra * qtdCompra
    if usouNegociacaoCompra then
        custo = precoNegociadoCompra + (precoUnitarioCompra * math.max(0, qtdCompra - 1))
    end

    if prataAtualLoja(ficha) < custo then
        CWNA_mostrarAvisoInventario(controleOrigem, "Prata insuficiente.")
        return
    end

    if tostring(itemLoja.nomeItem or ""):lower():find("receita", 1, true) ~= nil and CWNA_registrarReceitaAlquimistaComprada ~= nil then
        local registrada, nova, motivo = CWNA_registrarReceitaAlquimistaComprada(ficha, itemLoja, controleOrigem)
        if registrada then
            if motivo == "sem_livro" then
                return
            end
            if not nova then
                CWNA_mostrarAvisoInventario(controleOrigem, "Esta receita ja esta no Livro de receitas ALQUIMISTA.")
                return
            end
            ficha.PrataPersonagem = prataAtualLoja(ficha) - custo
            enviarMensagemLoja(ficha, "comprou", itemLoja, custo, 1)
            if usouNegociacaoCompra and CWNA_consumirNegociacaoMercador ~= nil then CWNA_consumirNegociacaoMercador(ficha, "COMPRA", itemLoja.RankItem, controleOrigem) end
            ficha.TempCompraLojaSlotDestinoUid = ""
            return
        end
    end

    if ficha.magias2 == nil then
        NDB.createChildNode(ficha, "magias2")
    end

    CWNA_inicializarSlotsInventario(ficha, nil)

    local lista = ficha.magias2
    local slotDestino = nil
    local uidSlotDestino = tostring(ficha.TempCompraLojaSlotDestinoUid or "")

    if uidSlotDestino ~= "" then
        local candidato = procurarItemInventarioPorUid(ficha, uidSlotDestino)

        if candidato ~= nil and ehSlotVazioInventario(candidato) then
            slotDestino = candidato
        else
            ficha.TempCompraLojaSlotDestinoUid = ""
            uidSlotDestino = ""
        end
    end

    if itemEmpilhavelCompra then
        local itemExistente = procurarItemEmpilhavelDaLoja(ficha, itemLoja)

        if itemExistente ~= nil then
            ficha.PrataPersonagem = prataAtualLoja(ficha) - custo
            itemExistente.quantidade = CWNA_numeroLoja(itemExistente.quantidade, 0) + qtdTotal
            itemExistente.quantidadeDisplay = tostring(itemExistente.quantidade)
            enviarMensagemLoja(ficha, "comprou", itemLoja, custo, qtdTotal)
            if usouNegociacaoCompra and CWNA_consumirNegociacaoMercador ~= nil then CWNA_consumirNegociacaoMercador(ficha, "COMPRA", itemLoja.RankItem, controleOrigem) end
            recalcularDefesa(ficha)
            return
        end

        local slot = slotDestino or procurarPrimeiroSlotVazioInventario(lista)

        if slot == nil then
            CWNA_mostrarAvisoInventario(controleOrigem, "Limite maximo de 60 itens.")
            return
        end

        ficha.PrataPersonagem = prataAtualLoja(ficha) - custo
        copiarItemLojaParaInventario(itemLoja, slot)
        slot.quantidade = qtdTotal
        slot.quantidadeDisplay = tostring(qtdTotal)
        enviarMensagemLoja(ficha, "comprou", itemLoja, custo, qtdTotal)
        if usouNegociacaoCompra and CWNA_consumirNegociacaoMercador ~= nil then CWNA_consumirNegociacaoMercador(ficha, "COMPRA", itemLoja.RankItem, controleOrigem) end
        ficha.TempCompraLojaSlotDestinoUid = ""
        recalcularDefesa(ficha)
        return
    end

    local slotsEquipamento = procurarSlotsVaziosInventario(lista, qtdCompra, slotDestino)

    if #slotsEquipamento < qtdCompra then
        CWNA_mostrarAvisoInventario(controleOrigem, "Espaco insuficiente no inventario. Slots livres: " .. tostring(#slotsEquipamento) .. ".")
        return
    end

    ficha.PrataPersonagem = prataAtualLoja(ficha) - custo

    for _, slot in ipairs(slotsEquipamento) do
        copiarItemLojaParaInventario(itemLoja, slot)
        slot.quantidade = ""
        slot.nivelUpgrade = tonumber(slot.nivelUpgrade) or 0
        slot.textoUpgrade = tostring(slot.textoUpgrade or "+0")
        if slot.textoUpgrade == "" then slot.textoUpgrade = "+0" end
        slot.quantidadeDisplay = slot.textoUpgrade
    end

    enviarMensagemLoja(ficha, "comprou", itemLoja, custo, qtdCompra)
    if usouNegociacaoCompra and CWNA_consumirNegociacaoMercador ~= nil then CWNA_consumirNegociacaoMercador(ficha, "COMPRA", itemLoja.RankItem, controleOrigem) end
    ficha.TempCompraLojaSlotDestinoUid = ""
    recalcularDefesa(ficha)
end
function CWNA_comprarItemLoja(itemLoja, controleOrigem, slotDestinoInventario)
    if itemLoja == nil then
        return
    end

    local ficha = NDB.getRoot(itemLoja)

    if ficha == nil then
        showMessage("Ficha não encontrada para comprar o item.")
        return
    end

    local uid = tostring(itemLoja.uidLoja or "")
    local qtdAtual = math.max(1, math.floor(CWNA_numeroLoja(ficha.TempCompraLojaQuantidade, 1)))

    if tostring(ficha.TempCompraLojaUid or "") ~= uid then
        qtdAtual = 1
    end

    ficha.TempCompraLojaUid = uid
    ficha.TempCompraLojaNome = itemLoja.nomeItem or ""
    ficha.TempCompraLojaNomeDisplay = "NOME: " .. tostring(itemLoja.nomeItem or "")
    ficha.TempCompraLojaRank = itemLoja.RankItem or ""
    ficha.TempCompraLojaRankDisplay = "RANK: " .. tostring(itemLoja.RankItem or "")
    ficha.TempCompraLojaImagem = itemLoja.imagemestilo2 or ""
    ficha.TempCompraLojaDescricao = itemLoja.descricaoItem or ""
    local precoBaseDetalheCompra = CWNA_numeroLoja(itemLoja.precoPrata, 0)
    local precoDetalheCompra = precoBaseDetalheCompra
    if CWNA_precoCompraMercador ~= nil then
        precoDetalheCompra = CWNA_precoCompraMercador(ficha, itemLoja, precoBaseDetalheCompra)
    end
    ficha.TempCompraLojaPreco = precoDetalheCompra
    ficha.TempCompraLojaPrecoBase = precoBaseDetalheCompra
    ficha.TempCompraLojaPrecoDisplay = "💰 PREÇO: " .. tostring(precoDetalheCompra)
    ficha.TempCompraLojaCorRank = corRankLoja(itemLoja.RankItem)
    ficha.TempCompraLojaConfirmTexto = "por " .. tostring(precoDetalheCompra + (precoBaseDetalheCompra * math.max(0, qtdAtual - 1))) .. " prata?"
    ficha.TempCompraLojaQuantidade = qtdAtual
    ficha.TempCompraLojaPermiteQuantidade = "true"
    ficha.TempCompraLojaSlotDestinoUid = ""

    if slotDestinoInventario ~= nil then
        ficha.TempCompraLojaSlotDestinoUid = tostring(slotDestinoInventario.uidInventario or "")
    end

    local frame = procurarFrameAcimaLoja(controleOrigem, "frameConfirmarCompraLoja")

    if frame ~= nil then
        frame.visible = true
        pcall(function() frame:bringToFront() end)
        return
    end

    CWNA_confirmarCompraItemLoja(ficha, controleOrigem)
end

function CWNA_comprarItemLojaPorUid(ficha, uid, controleOrigem, slotDestinoInventario)
    local itemLoja = procurarItemLojaPorUid(ficha, uid)
    CWNA_comprarItemLoja(itemLoja, controleOrigem, slotDestinoInventario)
end

function CWNA_carregarDetalheCompraLoja(itemLoja)
    if itemLoja == nil then
        return
    end

    local ficha = NDB.getRoot(itemLoja)

    if ficha == nil then
        return
    end

    local uid = tostring(itemLoja.uidLoja or "")
    if tostring(ficha.TempCompraLojaUid or "") == uid then
        ficha.TempCompraLojaUid = ""
        ficha.TempCompraLojaNome = ""
        ficha.TempCompraLojaNomeDisplay = "NOME:"
        ficha.TempCompraLojaRank = ""
        ficha.TempCompraLojaRankDisplay = "RANK:"
        ficha.TempCompraLojaImagem = ""
        ficha.TempCompraLojaDescricao = ""
        ficha.TempCompraLojaAtributos = ""
        ficha.TempCompraLojaDisponivelDisplay = "DISPONÍVEL:"
        ficha.TempCompraLojaPreco = ""
        ficha.TempCompraLojaPrecoDisplay = "💰 PREÇO:"
        ficha.TempCompraLojaCorRank = "#FFFFFF"
        ficha.TempCompraLojaConfirmTexto = ""
        ficha.TempCompraLojaQuantidade = 1
        ficha.TempCompraLojaPermiteQuantidade = "false"
        return
    end

    local atributos = {}
    local function addAtributo(nome, valor)
        local texto = tostring(valor or "")
        if texto ~= "" then
            local numero = tonumber(texto)
            if numero ~= nil then
                if numero ~= 0 then table.insert(atributos, nome .. " +" .. tostring(numero)) end
            else
                table.insert(atributos, nome .. ":" .. texto)
            end
        end
    end

    addAtributo("HP", itemLoja.hp)
    addAtributo("PP", itemLoja.pp)
    addAtributo("CA", itemLoja.ca)
    addAtributo("RD", itemLoja.rd)
    addAtributo("Dano", itemLoja.dano)
    addAtributo("CURA", itemLoja.cura)
    addAtributo("RAIO", itemLoja.raio or itemLoja.raioLuz or itemLoja.luz or itemLoja.metrosLuz or itemLoja.alcanceLuz or itemLoja.lightIntense)
    if itemEhEquipamentoInventario(itemLoja) then
        addAtributo("PD", tonumber(itemLoja.durabilidade) or tonumber(itemLoja.durabilidadeMaxima) or durabilidadeMaximaPorRankInventario(itemLoja.RankItem))
    end

    ficha.TempCompraLojaUid = uid
    ficha.TempCompraLojaNome = itemLoja.nomeItem or ""
    ficha.TempCompraLojaNomeDisplay = "NOME: " .. tostring(itemLoja.nomeItem or "")
    ficha.TempCompraLojaRank = itemLoja.RankItem or ""
    ficha.TempCompraLojaImagem = itemLoja.imagemestilo2 or ""
    ficha.TempCompraLojaDescricao = itemLoja.descricaoItem or ""
    local textoAtributos = table.concat(atributos, "  ")
    ficha.TempCompraLojaAtributos = textoAtributos == "" and "ATRIBUTOS:" or ("ATRIBUTOS: " .. textoAtributos)
    local disponivel = itemLoja.estoqueDisponivel or itemLoja.estoque or itemLoja.quantidadeDisponivel or itemLoja.disponivel or ""
    if tostring(itemLoja.estoqueInfinito or "") == "true" or tostring(disponivel or "") == "" then
        disponivel = "∞"
    end
    ficha.TempCompraLojaDisponivelDisplay = "DISPON?VEL: " .. tostring(disponivel)
    ficha.TempCompraLojaRankDisplay = "RANK: " .. tostring(itemLoja.RankItem or "")
    ficha.TempCompraLojaPreco = CWNA_numeroLoja(itemLoja.precoPrata, 0)
    ficha.TempCompraLojaPrecoDisplay = "💰 PREÇO: " .. tostring(CWNA_numeroLoja(itemLoja.precoPrata, 0))
    ficha.TempCompraLojaCorRank = corRankLoja(itemLoja.RankItem)
    ficha.TempCompraLojaConfirmTexto = "por " .. tostring(CWNA_numeroLoja(itemLoja.precoPrata, 0)) .. " prata?"
    ficha.TempCompraLojaQuantidade = 1
    ficha.TempCompraLojaPermiteQuantidade = "true"
end

local function CWNA_senhaLojaEnterPressionado(codigo, tecla)
    return codigo == 13
        or tecla == 13
        or tostring(codigo or "") == "13"
        or string.lower(tostring(tecla or "")) == "enter"
        or string.lower(tostring(tecla or "")) == "return"
end

function CWNA_confirmarSenhaLoja(controle)
    if controle == nil then return end

    local edt = controle:findControlByName("edtSenhaLoja")
    local senha = edt and edt.text or ""

    if senha ~= "151289" then
        showMessage("Senha incorreta!")
        return
    end

    if edt ~= nil then edt.text = "" end
    local senhaFrame = controle:findControlByName("frameSenhaLoja")
    if senhaFrame ~= nil then senhaFrame.visible = false end

    local ficha = controle.sheet
    if ficha == nil then return end

    ficha.TempCompraLojaUid = ""
    ficha.TempCompraLojaNome = ""
    ficha.TempCompraLojaNomeDisplay = "NOME:"
    ficha.TempCompraLojaRank = ""
    ficha.TempCompraLojaRankDisplay = "RANK:"
    ficha.TempCompraLojaImagem = ""
    ficha.TempCompraLojaDescricao = ""
    ficha.TempCompraLojaAtributos = ""
    ficha.TempCompraLojaDisponivelDisplay = "DISPONÍVEL:"
    ficha.TempCompraLojaPreco = ""
    ficha.TempCompraLojaPrecoDisplay = "💰 PREÇO:"
        ficha.TempCompraLojaCorRank = "#FFFFFF"
        ficha.TempCompraLojaConfirmTexto = ""
        ficha.TempCompraLojaQuantidade = 1
        ficha.TempCompraLojaPermiteQuantidade = "false"
        CWNA_setLojaDestravadaLocal(ficha, true)
    CWNA_atualizarCardsLoja(ficha)
    local painel = controle:findControlByName("frameEditorLoja")
    if painel ~= nil then
        painel.visible = true
        pcall(function() painel:bringToFront() end)
    end
end

function CWNA_limparEditorLoja(ficha)
    if ficha == nil then
        return
    end

    ficha.TempLojaUid = ""
    ficha.TempLojaNome = ""
    ficha.TempLojaTipo = "Material"
    ficha.TempLojaSubtipoMaterial = "OUTROS"
    ficha.TempLojaRaio = 0
    ficha.TempLojaRank = "E"
    ficha.TempLojaImagem = "Frames/fundo_branco.png"
    ficha.TempLojaPrecoPrata = 0
    ficha.TempLojaQuantidade = 1
    ficha.TempLojaDescricao = ""
    ficha.TempLojaHP = 0
    ficha.TempLojaPP = 0
    ficha.TempLojaCA = 0
    ficha.TempLojaRD = 0
    ficha.TempLojaDano = ""
    ficha.TempLojaCura = 0
    ficha.TempLojaDurabilidade = ""
end

local function CWNA_normalizarSubtipoEditorLoja(subtipo, tipoItem)
    local subtipoOriginal = tostring(subtipo or ""):gsub("^%s*(.-)%s*$", "%1")
    local subtipoLimpo = limparTextoInventario(subtipoOriginal)
    local tipoLimpo = limparTextoInventario(tipoItem)

    if subtipoLimpo == "" then
        subtipoLimpo = tipoLimpo
    end

    if subtipoLimpo == "minerio" or subtipoLimpo == "minério" or subtipoLimpo == "minerios" or subtipoLimpo == "minérios" or subtipoLimpo == "metal" or subtipoLimpo == "metais" then
        return "MINERIOS"
    end

    if subtipoLimpo == "couro" or subtipoLimpo == "couros" then
        return "COUROS"
    end

    if subtipoLimpo == "erva" or subtipoLimpo == "ervas" then
        return "ERVAS"
    end

    if subtipoLimpo == "madeira" or subtipoLimpo == "madeiras" then
        return "MADEIRA"
    end

    if subtipoLimpo == "cristal" or subtipoLimpo == "cristais" then
        return "CRISTAIS"
    end

    if subtipoLimpo == "ferramenta" or subtipoLimpo == "ferramentas" then
        return "FERRAMENTAS"
    end

    if subtipoLimpo == "frasco" or subtipoLimpo == "frascos" then
        return "FRASCOS"
    end

    if subtipoLimpo == "receita" or subtipoLimpo == "receitas" then
        return "RECEITAS"
    end

    if subtipoLimpo == "" or subtipoLimpo == "outros" or subtipoLimpo == "material" then
        return "OUTROS"
    end

    return string.upper(subtipoOriginal)
end

function CWNA_carregarItemLojaNoEditor(itemLoja)
    if itemLoja == nil then
        return
    end

    local ficha = NDB.getRoot(itemLoja)

    if ficha == nil then
        return
    end

    ficha.TempCompraLojaUid = ""
    ficha.TempCompraLojaNome = ""
    ficha.TempCompraLojaNomeDisplay = "NOME:"
    ficha.TempCompraLojaRank = ""
    ficha.TempCompraLojaRankDisplay = "RANK:"
    ficha.TempCompraLojaImagem = ""
    ficha.TempCompraLojaDescricao = ""
    ficha.TempCompraLojaAtributos = ""
    ficha.TempCompraLojaDisponivelDisplay = "DISPONÍVEL:"
    ficha.TempCompraLojaPreco = ""
    ficha.TempCompraLojaPrecoDisplay = "💰 PREÇO:"
    ficha.TempCompraLojaCorRank = "#FFFFFF"
    ficha.TempCompraLojaConfirmTexto = ""
    ficha.TempCompraLojaQuantidade = 1
    ficha.TempCompraLojaPermiteQuantidade = "false"
    ficha.TempLojaUid = tostring(itemLoja.uidLoja or "")
    ficha.TempLojaNome = itemLoja.nomeItem or ""
    ficha.TempLojaTipo = itemLoja.tipoItem or "Material"
    ficha.TempLojaSubtipoMaterial = CWNA_normalizarSubtipoEditorLoja(itemLoja.subtipoMaterial, itemLoja.tipoItem)
    ficha.TempLojaRank = itemLoja.RankItem or "E"
    ficha.TempLojaImagem = itemLoja.imagemestilo2 or ""
    ficha.TempLojaPrecoPrata = itemLoja.precoPrata or 0
    ficha.TempLojaQuantidade = itemLoja.quantidade or 1
    ficha.TempLojaDescricao = itemLoja.descricaoItem or ""
    ficha.TempLojaHP = itemLoja.hp or 0
    ficha.TempLojaPP = itemLoja.pp or 0
    ficha.TempLojaCA = itemLoja.ca or 0
    ficha.TempLojaRD = itemLoja.rd or 0
    ficha.TempLojaDano = itemLoja.dano or ""
    ficha.TempLojaCura = itemLoja.cura or 0
    ficha.TempLojaRaio = itemLoja.raio or itemLoja.raioLuz or itemLoja.luz or 0
    ficha.TempLojaDurabilidade = itemLoja.durabilidade or itemLoja.durabilidadeMaxima or ""
end

function CWNA_salvarItemLoja(ficha)
    if ficha == nil then
        return
    end

    local nome = tostring(ficha.TempLojaNome or "")

    if nome == "" then
        showMessage("Preencha o nome do item da loja.")
        return
    end

    if ficha.lojaItens == nil then
        NDB.createChildNode(ficha, "lojaItens")
    end

    local item = procurarItemLojaPorUid(ficha, ficha.TempLojaUid)

    if item == nil then
        local novaOrdem = CWNA_ordemInsercaoLoja(ficha)

        for _, itemExistente in ipairs(NDB.getChildNodes(ficha.lojaItens)) do
            local ordemExistente = CWNA_numeroLoja(itemExistente.ordemLoja, 0)
            if ordemExistente >= novaOrdem then
                itemExistente.ordemLoja = ordemExistente + 1
            end
        end

        item = NDB.createChildNode(ficha.lojaItens, "itemLoja")
        item.uidLoja = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
        item.ordemLoja = novaOrdem
    end

    item.nomeItem = ficha.TempLojaNome
    item.tipoItem = ficha.TempLojaTipo
    item.subtipoMaterial = ficha.TempLojaSubtipoMaterial
    item.RankItem = ficha.TempLojaRank
    item.imagemestilo2 = ficha.TempLojaImagem
    item.precoPrata = CWNA_numeroLoja(ficha.TempLojaPrecoPrata, 0)
    item.quantidade = CWNA_numeroLoja(ficha.TempLojaQuantidade, 1)
    item.descricaoItem = ficha.TempLojaDescricao or ""
    item.hp = CWNA_numeroLoja(ficha.TempLojaHP, 0)
    item.pp = CWNA_numeroLoja(ficha.TempLojaPP, 0)
    item.ca = CWNA_numeroLoja(ficha.TempLojaCA, 0)
    item.rd = CWNA_numeroLoja(ficha.TempLojaRD, 0)
    item.dano = tostring(ficha.TempLojaDano or "")
    item.cura = CWNA_numeroLoja(ficha.TempLojaCura, 0)
    item.raio = CWNA_numeroLoja(ficha.TempLojaRaio, 0)

    local pdLojaTexto = tostring(ficha.TempLojaDurabilidade or ""):gsub("^%s*(.-)%s*$", "%1")
    if pdLojaTexto == "" then
        item.durabilidade = ""
        item.durabilidadeMaxima = ""
    else
        local pdLoja = CWNA_numeroLoja(pdLojaTexto, 0)
        if pdLoja <= 0 then
            item.durabilidade = ""
            item.durabilidadeMaxima = ""
        else
            item.durabilidade = pdLoja
            item.durabilidadeMaxima = pdLoja
        end
    end
    CWNA_limparEditorLoja(ficha)
    CWNA_mudarPaginaLoja(ficha, 0)
end

function CWNA_excluirItemLoja(itemLoja)
    if itemLoja == nil then
        return
    end

    local ficha = NDB.getRoot(itemLoja)

    if ficha ~= nil and tostring(ficha.TempLojaUid or "") == tostring(itemLoja.uidLoja or "") then
        CWNA_limparEditorLoja(ficha)
    end

    local itemReal = procurarItemLojaPorUid(ficha, itemLoja.uidLoja)

    if itemReal ~= nil then
        NDB.deleteNode(itemReal)
    else
        NDB.deleteNode(itemLoja)
    end

    if ficha ~= nil then
        CWNA_garantirOrdemLoja(ficha)
        CWNA_mudarPaginaLoja(ficha, 0)
    end
end

function CWNA_abrirDetalheItemLojaComprado(item, controle)
    if item == nil or not itemTemOrigemVendaLoja(item) then
        return false
    end

    local ficha = NDB.getRoot(item)

    if ficha == nil then
        return true
    end

    ficha.TempConfirmVendaLivroReceitasOk = ""
    ficha.TempDetalheItemHandle = NDB.getNodeHandle(item)
    ficha.TempDetalheItemUid = uidInventarioItem(item)
    ficha.TempDetalheNome = item.nomeItem or ""
    ficha.TempDetalheRank = item.RankItem or ""
    ficha.TempDetalheRankTexto = "RANK: " .. tostring(item.RankItem or "")
    ficha.TempDetalheCorRank = corRankLoja(item.RankItem)
    ficha.TempDetalheImagem = item.imagemestilo2 or ""
    ficha.TempDetalheDescricao = item.descricaoLoja or ""
    ficha.TempDetalheTipo = item.tipoItem or ""
    local nomeLivroReceitas = limparTextoInventario(item.nomeItem)
    ficha.TempDetalheEhLivroReceitas = nomeLivroReceitas:find("livro de receitas", 1, true) ~= nil and "true" or "false"
    local atributosDetalhe = {}
    local function addAtributoDetalhe(nome, valor)
        local texto = tostring(valor or "")
        if texto == "" then return end

        local numero = tonumber(texto)
        if numero ~= nil then
            if numero ~= 0 then
                table.insert(atributosDetalhe, nome .. " +" .. tostring(numero))
            end
        else
            table.insert(atributosDetalhe, nome .. ":" .. texto)
        end
    end
    addAtributoDetalhe("HP", item.hp)
    addAtributoDetalhe("PP", item.pp)
    addAtributoDetalhe("CA", item.ca)
    addAtributoDetalhe("RD", item.rd)
    addAtributoDetalhe("DANO", item.dano)
    addAtributoDetalhe("CURA", item.cura)
    addAtributoDetalhe("RAIO", item.raio or item.raioLuz or item.luz or item.metrosLuz or item.alcanceLuz or item.lightIntense)
    if itemEhEquipamentoInventario(item) then
        addAtributoDetalhe("PD", tonumber(item.durabilidade) or tonumber(item.durabilidadeMaxima) or durabilidadeMaximaPorRankInventario(item.RankItem))
    end
    ficha.TempDetalheAtributos = table.concat(atributosDetalhe, "  ")
    ficha.TempDetalheQuantidadeMax = forjaNumero(item.quantidade, 1)
    ficha.TempDetalheQuantidadeVenda = 1
    local vendaBaseDetalhe = valorVendaUnitarioLoja(item)
    local vendaDetalhe = vendaBaseDetalhe
    if CWNA_precoVendaMercador ~= nil then
        vendaDetalhe = CWNA_precoVendaMercador(ficha, item, vendaBaseDetalhe)
    end
    ficha.TempDetalhePrecoVendaUnitario = vendaDetalhe
    ficha.TempDetalhePrecoVendaBase = vendaBaseDetalhe
    ficha.TempDetalhePrecoVenda = ficha.TempDetalhePrecoVendaUnitario

    local ctrl = controle

    while ctrl ~= nil do
        if ctrl.findControlByName ~= nil then
            local frame = ctrl:findControlByName("frameDetalheItemLoja")
            if frame ~= nil then
                frame.visible = true
                pcall(function() frame:bringToFront() end)
                return true
            end
        end

        ctrl = ctrl.parent
    end

    return true
end

local function procurarItemDetalheLoja(ficha)
    if ficha == nil then
        return nil
    end

    if ficha.TempDetalheItemHandle ~= nil then
        local ok, item = pcall(function() return NDB.openNode(ficha.TempDetalheItemHandle) end)

        if ok and item ~= nil then
            return item
        end
    end

    return procurarItemInventarioPorUid(ficha, ficha.TempDetalheItemUid)
end

local function fecharDetalheItemLoja(controle)
    local ctrl = controle

    while ctrl ~= nil do
        if ctrl.findControlByName ~= nil then
            local frame = ctrl:findControlByName("frameDetalheItemLoja")
            if frame ~= nil then
                frame.visible = false
                return
            end
        end

        ctrl = ctrl.parent
    end
end

function CWNA_venderItemLojaCompradoPorHandle(ficha, controle)
    if ficha == nil then
        return
    end

    local item = procurarItemDetalheLoja(ficha)

    if item == nil or tostring(item.nomeItem or "") == "" then
        ficha.TempConfirmVendaLivroReceitasOk = ""
        showMessage("Item não encontrado no inventário.")
        return
    end

    if not itemInventarioBateComLojaParaVenda(ficha, item) then
        removerMarcaLojaInvalida(item)
        CWNA_mostrarAvisoInventario(controle, "Este item nao pode ser vendido.")
        fecharDetalheItemLoja(controle)
        return
    end

    local itemEmpilhavelVenda = itemLojaEmpilhavel(item)
    local qtdDisponivel = 1

    if itemEmpilhavelVenda then
        qtdDisponivel = CWNA_numeroLoja(item.quantidade, 0)
        if qtdDisponivel <= 0 then
            prepararSlotVazioInventario(item, item.ordemInventario)
            ficha.TempDetalheItemHandle = nil
            ficha.TempDetalheItemUid = ""
            ficha.TempDetalheConfirmVendaTexto = ""
            ficha.TempDetalheCorRank = "#FFFFFF"
            ficha.TempConfirmVendaLivroReceitasOk = ""
            CWNA_mostrarAvisoInventario(controle, "Este item nao tem quantidade disponivel.")
            fecharDetalheItemLoja(controle)
            return
        end
    end

    local qtdVenda = 1
    local valorBaseUnitario = valorVendaUnitarioLoja(item)
    local valorUnitario = valorBaseUnitario
    local usouNegociacaoVenda = false
    if CWNA_precoVendaMercador ~= nil then
        valorUnitario, usouNegociacaoVenda = CWNA_precoVendaMercador(ficha, item, valorBaseUnitario)
    end

    if itemEmpilhavelVenda then
        qtdVenda = math.floor(CWNA_numeroLoja(ficha.TempDetalheQuantidadeVenda, 1))
        if qtdVenda < 1 then qtdVenda = 1 end
        if qtdVenda > qtdDisponivel then qtdVenda = qtdDisponivel end
    end
    local valor = valorUnitario + (valorBaseUnitario * math.max(0, qtdVenda - 1))
    if valor <= 0 then
        ficha.TempDetalheConfirmVendaTexto = "remover este item?"
    else
        ficha.TempDetalheConfirmVendaTexto = "por " .. tostring(valor) .. " prata?"
    end

    local ctrl = controle
    while ctrl ~= nil do
        if ctrl.findControlByName ~= nil then
            local frame = ctrl:findControlByName("frameConfirmarVendaLoja")
            if frame ~= nil then
                frame.visible = true
                pcall(function() frame:bringToFront() end)
                return
            end
        end

        ctrl = ctrl.parent
    end
end

function CWNA_itemEhLivroReceitasVenda(item)
    return limparTextoInventario(item and item.nomeItem):find("livro de receitas", 1, true) ~= nil
end

function CWNA_mostrarAlertaVendaLivroReceitas(controle)
    Dialogs.confirmYesNo(
        "ATENCAO: Voce deseja mesmo vender esse livro de receitas? Todas as suas receitas serao perdidas.",
        function(confirmado)
            local ficha = nil
            pcall(function() ficha = controle.sheet end)
            if ficha == nil and controle ~= nil then
                local ctrl = controle
                while ctrl ~= nil and ficha == nil do
                    pcall(function() ficha = ctrl.sheet end)
                    ctrl = ctrl.parent
                end
            end

            if not confirmado then
                if ficha ~= nil then ficha.TempConfirmVendaLivroReceitasOk = "" end
                return
            end

            if ficha ~= nil then
                ficha.TempConfirmVendaLivroReceitasOk = "true"
                CWNA_confirmarVendaItemLojaComprado(ficha, controle)
            end
        end
    )
    return true
end

function CWNA_confirmarVendaItemLojaComprado(ficha, controle)
    if ficha == nil then
        return
    end

    local item = procurarItemDetalheLoja(ficha)

    if item == nil or tostring(item.nomeItem or "") == "" then
        ficha.TempConfirmVendaLivroReceitasOk = ""
        showMessage("Item não encontrado no inventário.")
        return
    end

    if not itemInventarioBateComLojaParaVenda(ficha, item) then
        removerMarcaLojaInvalida(item)
        ficha.TempDetalheItemHandle = nil
        ficha.TempDetalheItemUid = ""
        ficha.TempDetalheConfirmVendaTexto = ""
        ficha.TempDetalheCorRank = "#FFFFFF"
        CWNA_mostrarAvisoInventario(controle, "Este item nao pode ser vendido.")
        ficha.TempConfirmVendaLivroReceitasOk = ""
        fecharDetalheItemLoja(controle)
        return
    end

    if CWNA_itemEhLivroReceitasVenda(item) and tostring(ficha.TempConfirmVendaLivroReceitasOk or "") ~= "true" then
        if not CWNA_mostrarAlertaVendaLivroReceitas(controle) then
            showMessage("ATENCAO: Voce deseja mesmo vender esse livro de receitas? Todas as suas receitas serao perdidas.")
        end
        return
    end

    ficha.TempConfirmVendaLivroReceitasOk = ""
    local nomeLivroReceitasVendido = limparTextoInventario(item.nomeItem)
    local itemEmpilhavelVenda = itemLojaEmpilhavel(item)
    local qtdDisponivel = 1

    if itemEmpilhavelVenda then
        qtdDisponivel = CWNA_numeroLoja(item.quantidade, 0)
        if qtdDisponivel <= 0 then
            prepararSlotVazioInventario(item, item.ordemInventario)
            ficha.TempDetalheItemHandle = nil
            ficha.TempDetalheItemUid = ""
            ficha.TempDetalheConfirmVendaTexto = ""
            ficha.TempDetalheCorRank = "#FFFFFF"
            ficha.TempConfirmVendaLivroReceitasOk = ""
            CWNA_mostrarAvisoInventario(controle, "Este item nao tem quantidade disponivel.")
            fecharDetalheItemLoja(controle)
            return
        end
    end

    local qtdVenda = 1
    local valorBaseUnitario = valorVendaUnitarioLoja(item)
    local valorUnitario = valorBaseUnitario
    local usouNegociacaoVenda = false
    if CWNA_precoVendaMercador ~= nil then
        valorUnitario, usouNegociacaoVenda = CWNA_precoVendaMercador(ficha, item, valorBaseUnitario)
    end

    if itemEmpilhavelVenda then
        qtdVenda = math.floor(CWNA_numeroLoja(ficha.TempDetalheQuantidadeVenda, 1))
        if qtdVenda < 1 then qtdVenda = 1 end
        if qtdVenda > qtdDisponivel then qtdVenda = qtdDisponivel end
    end
    local valor = valorUnitario + (valorBaseUnitario * math.max(0, qtdVenda - 1))
    ficha.PrataPersonagem = prataAtualLoja(ficha) + valor
    if valor > 0 then
        enviarMensagemLoja(ficha, "vendeu", item, valor, qtdVenda)
    else
        CWNA_mostrarAvisoInventario(controle, "Item removido do invent?rio.", 5000)
    end
    if usouNegociacaoVenda and CWNA_consumirNegociacaoMercador ~= nil then CWNA_consumirNegociacaoMercador(ficha, "VENDA", item.RankItem, controle) end

    if itemEmpilhavelVenda and qtdDisponivel > qtdVenda then
        item.quantidade = qtdDisponivel - qtdVenda
    else
        item.slotVazio = "true"
        item.uidInventario = "slot_" .. tostring(item.ordemInventario or "")
        item.nomeItem = ""
        item.tipoItem = ""
        item.subtipoMaterial = ""
        item.RankItem = ""
        item.imagemestilo2 = ""
        item.equipadoEm = ""
        item.quantidade = ""
        item.quantidadeDisplay = ""
        item.nivelUpgrade = ""
        item.textoUpgrade = ""
        item.usaQuantidade = ""
        item.hp = 0
        item.pp = 0
        item.ca = 0
        item.rd = 0
        item.dano = 0
        item.cura = 0
        item.origemLoja = ""
        item.uidLojaOrigem = ""
        item.precoLojaPrata = ""
        item.descricaoLoja = ""
    end

    if nomeLivroReceitasVendido:find("livro de receitas", 1, true) ~= nil and nomeLivroReceitasVendido:find("alquimista", 1, true) ~= nil then
        ficha.LivroReceitasAlquimistaLista = ""
        ficha.LivroAlqReceitaSelecionada = ""
        ficha.LivroAlqPaginaDupla = 1
    end
    ficha.TempDetalheItemHandle = nil
    ficha.TempDetalheItemUid = ""
    ficha.TempDetalheConfirmVendaTexto = ""
    ficha.TempDetalheCorRank = "#FFFFFF"
    fecharDetalheItemLoja(controle)
end

local limparSlotInventario

local function campoSlotEspecialInventario(slot, campo)
    return "SlotEspecial" .. tostring(slot or "") .. "_" .. tostring(campo or "")
end

local function dadosDoItemInventario(item)
    if item == nil or ehSlotVazioInventario(item) then
        return nil
    end

    local dados = {}

    for _, campo in ipairs(camposDadosItemInventario) do
        dados[campo] = item[campo]
    end

    if dados.uidInventario == nil or dados.uidInventario == "" then
        dados.uidInventario = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    end

    return dados
end

local function slotEspecialTemItemInventario(ficha, slot)
    if ficha == nil or slot == nil then
        return false
    end

    return tostring(ficha[campoSlotEspecialInventario(slot, "tipoItem")] or "") ~= ""
end

local function dadosDoSlotEspecialInventario(ficha, slot)
    if not slotEspecialTemItemInventario(ficha, slot) then
        return nil
    end

    local dados = {}

    for _, campo in ipairs(camposDadosItemInventario) do
        dados[campo] = ficha[campoSlotEspecialInventario(slot, campo)]
    end

    return dados
end

function atualizarVisualSkinInventario(ficha, controleOrigem)
    if ficha == nil then
        return
    end

    local slotsSet = {"Capacete", "Peitoral", "Calca", "Bota"}
    local slotsDesbloqueioSkin = {"Capacete", "Peitoral", "Calca", "Bota", "Arma"}
    local skinEquipada = skinEquipadaInventario(ficha)
    local dadosPorSlot = {}

    for _, slot in ipairs(slotsDesbloqueioSkin) do
        dadosPorSlot[slot] = dadosDoSlotEspecialInventario(ficha, slot)
    end

    if limparSkinsAutomaticasAntigasInventario(ficha) then
        CWNA_atualizarCardsSkinInventario(ficha)
    end

    local atualizouCardsSkin = false

    if conjuntoRankCompletoComArmaInventario(dadosPorSlot, "c") then
        atualizouCardsSkin = desbloquearSkinRankCTesteInventario(ficha, controleOrigem) or atualizouCardsSkin
    else
        atualizouCardsSkin = removerSkinRankCTesteNaoDesbloqueadaInventario(ficha) or atualizouCardsSkin
    end

    corrigirSkinRankCTesteEquipadaAntigaInventario(ficha)
    skinEquipada = skinEquipadaInventario(ficha)

    if atualizouCardsSkin then
        CWNA_atualizarCardsSkinInventario(ficha)
    end

    limparCamposSkinRankInventario(ficha)

    if skinEquipada ~= nil and tostring(skinEquipada.imagemSkin or "") ~= "" then
        if ehSkinRankCTesteInventario(skinEquipada) then
            ficha.BonecoSkinEspecial = ""
            ficha.BonecoSkinRankCTeste = skinEquipada.imagemSkin
        else
            ficha.BonecoSkinEspecial = skinEquipada.imagemSkin
        end

        for _, slot in ipairs(slotsSet) do
            ficha["Boneco" .. slot] = ""
        end
    else
        local skinRank = skinRankAtivaInventario(dadosPorSlot)
        ficha.BonecoSkinEspecial = ""

        if skinRank ~= nil then
            ficha[skinRank.campo] = skinRank.imagem

            for _, slot in ipairs(slotsSet) do
                ficha["Boneco" .. slot] = ""
            end
        else
            for _, slot in ipairs(slotsSet) do
                local dados = dadosPorSlot[slot]

                if dados ~= nil then
                    ficha["Boneco" .. slot] = imagemEquipamentoBonecoInventario(dados, slot)
                else
                    ficha["Boneco" .. slot] = imagemBaseBonecoInventario(slot)
                end
            end
        end
    end
end

function CWNA_alternarLiberacaoSkin(skin)
    if skin == nil then
        return
    end

    if tostring(skin.liberada or "") == "true" then
        skin.liberada = "false"
    else
        skin.liberada = "true"
    end

    local ficha = NDB.getRoot(skin)

    if ficha ~= nil and ficha.SkinEquipadaUid == skin.uidSkin and tostring(skin.liberada or "") ~= "true" then
        ficha.SkinEquipadaUid = ""
        CWNA_recalcularVisualSkinInventario(ficha)
        CWNA_atualizarCardsSkinInventario(ficha)
        recalcularDefesa(ficha)
    end
end

function CWNA_equiparOuDesequiparSkin(skin)
    if skin == nil or tostring(skin.liberada or "") ~= "true" then
        return
    end

    local ficha = NDB.getRoot(skin)

    if ficha == nil then
        return
    end

    if tostring(ficha.SkinEquipadaUid or "") == tostring(skin.uidSkin or "") then
        ficha.SkinEquipadaUid = ""
    else
        ficha.SkinEquipadaUid = skin.uidSkin
    end

    CWNA_recalcularVisualSkinInventario(ficha)
    CWNA_atualizarCardsSkinInventario(ficha)
    recalcularDefesa(ficha)
end

function CWNA_limparEditorSkin(ficha)
    if ficha == nil then
        return
    end

    ficha.TempEditSkinUid = ""
    ficha.TempNomeSkin = ""
    ficha.TempImagemSkin = ""
    ficha.TempSkinForca = ""
    ficha.TempSkinDestreza = ""
    ficha.TempSkinConstituicao = ""
    ficha.TempSkinInteligencia = ""
    ficha.TempSkinSabedoria = ""
    ficha.TempSkinCarisma = ""
    ficha.TempSkinCA = ""
    ficha.TempSkinRD = ""
    ficha.TempSkinHP = ""
    ficha.TempSkinPP = ""
end

function CWNA_carregarSkinNoEditor(skin)
    if skin == nil then
        return
    end

    local ficha = NDB.getRoot(skin)

    if ficha == nil then
        return
    end

    ficha.TempEditSkinUid = tostring(skin.uidSkin or "")
    ficha.TempNomeSkin = skin.nomeSkin or ""
    ficha.TempImagemSkin = skin.imagemSkin or ""
    ficha.TempSkinForca = skin.bonusForca or ""
    ficha.TempSkinDestreza = skin.bonusDestreza or ""
    ficha.TempSkinConstituicao = skin.bonusConstituicao or ""
    ficha.TempSkinInteligencia = skin.bonusInteligencia or ""
    ficha.TempSkinSabedoria = skin.bonusSabedoria or ""
    ficha.TempSkinCarisma = skin.bonusCarisma or ""
    ficha.TempSkinCA = skin.bonusCA or ""
    ficha.TempSkinRD = skin.bonusRD or ""
    ficha.TempSkinHP = skin.bonusHP or ""
    ficha.TempSkinPP = skin.bonusPP or ""
end

function CWNA_excluirSkin(skin)
    if skin == nil then
        return
    end

    local ficha = NDB.getRoot(skin)
    local uid = tostring(skin.uidSkin or "")

    if ficha ~= nil and tostring(ficha.SkinEquipadaUid or "") == uid then
        ficha.SkinEquipadaUid = ""
    end

    if ficha ~= nil and tostring(ficha.TempEditSkinUid or "") == uid then
        CWNA_limparEditorSkin(ficha)
    end

    NDB.deleteNode(skin)

    if ficha ~= nil then
        CWNA_recalcularVisualSkinInventario(ficha)
        CWNA_atualizarCardsSkinInventario(ficha)
        recalcularDefesa(ficha)
    end
end

function CWNA_fecharFramePorNome(controle, nomeFrame)
    local ctrl = controle

    while ctrl ~= nil do
        if ctrl.name == nomeFrame then
            ctrl.visible = false
            return
        end

        if ctrl.findControlByName ~= nil then
            local frame = ctrl:findControlByName(nomeFrame)

            if frame ~= nil then
                frame.visible = false
                return
            end
        end

        ctrl = ctrl.parent
    end
end

local function aplicarDadosNoItemInventario(item, dados, ordem)
    if item == nil then
        return
    end

    if dados == nil then
        prepararSlotVazioInventario(item, ordem or item.ordemInventario)
        return
    end

    item.slotVazio = nil
    item.ordemInventario = ordem or item.ordemInventario
    item.equipadoEm = ""

    for _, campo in ipairs(camposDadosItemInventario) do
        item[campo] = dados[campo] or ""
    end

    if item.uidInventario == nil or item.uidInventario == "" then
        item.uidInventario = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    end
end

function CWNA_trocaItemEmpilhavelLocal(item)
    local tipo = string.lower(tostring(item and item.tipoItem or ""))
    local usa = string.lower(tostring(item and item.usaQuantidade or ""))
    if usa == "true" or usa == "sim" then return true end
    if tipo == "material" or tipo == "outros" or tipo == "minerio" or tipo == "minério" then return true end
    if tipo == "pocao" or tipo == "poção" or tipo:match("^potion") ~= nil or tipo:match("^pocao") ~= nil or tipo:match("^poção") ~= nil then return true end
    if tipo == "consumivel" or tipo == "consumível" or tipo:match("^consum") ~= nil then return true end
    return false
end

function CWNA_trocaItensEmpilhamLocal(a, b)
    if not CWNA_trocaItemEmpilhavelLocal(a) or not CWNA_trocaItemEmpilhavelLocal(b) then return false end
    local nomeA = string.lower(tostring(a.nomeItem or "")):gsub("^%s*(.-)%s*$", "%1")
    local nomeB = string.lower(tostring(b.nomeItem or "")):gsub("^%s*(.-)%s*$", "%1")
    local rankA = string.upper(tostring(a.RankItem or "")):gsub("^%s*(.-)%s*$", "%1")
    local rankB = string.upper(tostring(b.RankItem or "")):gsub("^%s*(.-)%s*$", "%1")
    local tipoA = string.lower(tostring(a.tipoItem or "")):gsub("^%s*(.-)%s*$", "%1")
    local tipoB = string.lower(tostring(b.tipoItem or "")):gsub("^%s*(.-)%s*$", "%1")
    return nomeA ~= "" and nomeA == nomeB and rankA == rankB and tipoA == tipoB
end

function CWNA_trocaProcurarEmpilhavelLocal(ficha, itemBase)
    if ficha == nil or ficha.magias2 == nil then return nil end
    for _, item in ipairs(NDB.getChildNodes(ficha.magias2)) do
        if not ehSlotVazioInventario(item) and CWNA_trocaItensEmpilhamLocal(item, itemBase) then
            return item
        end
    end
    return nil
end

function CWNA_trocaQuantidadeOfertaSlot(ficha, slot)
    local qtd = CWNA_trocaNumero(ficha and ficha[CWNA_trocaCampoSlot(slot, "quantidadeDisplay")] or "", 1)
    return math.max(1, math.floor(qtd))
end

function CWNA_trocaRemoverOfertaLocal(ficha)
    if ficha == nil or ficha.magias2 == nil then return end
    for i = 1, 10 do
        local uid = tostring(ficha[CWNA_trocaCampoSlot(i, "uidInventario")] or "")
        if uid ~= "" then
            local item = procurarItemInventarioPorUid(ficha, uid)
            if item ~= nil and not ehSlotVazioInventario(item) then
                local qtd = CWNA_trocaQuantidadeOfertaSlot(ficha, i)
                if CWNA_trocaItemEmpilhavelLocal(item) then
                    local atual = math.max(0, math.floor(CWNA_trocaNumero(item.quantidade, 0)))
                    local restante = atual - qtd
                    if restante > 0 then
                        item.quantidade = restante
                        item.quantidadeDisplay = tostring(restante)
                    else
                        prepararSlotVazioInventario(item, item.ordemInventario)
                    end
                else
                    prepararSlotVazioInventario(item, item.ordemInventario)
                end
            end
        end
    end
end

function CWNA_trocaAdicionarRecebidoLocal(ficha, itemRecebido)
    if ficha == nil or itemRecebido == nil then return false end
    local origemRecebida = itemRecebido.itemSnapshot or itemRecebido.item or itemRecebido
    if origemRecebida == nil then return false end
    if ficha.magias2 == nil then NDB.createChildNode(ficha, "magias2") end
    CWNA_inicializarSlotsInventario(ficha, nil)
    local lista = ficha.magias2
    if lista == nil then return false end

    local dados = {}
    for _, campo in ipairs(camposDadosItemInventario) do
        dados[campo] = origemRecebida[campo]
    end

    dados.nomeItem = dados.nomeItem or origemRecebida.nome or origemRecebida.name or origemRecebida.Nome or "Material"
    dados.tipoItem = dados.tipoItem or origemRecebida.tipo or origemRecebida.categoria or origemRecebida.tipoMaterial or ""
    dados.subtipoMaterial = dados.subtipoMaterial or origemRecebida.subtipo or origemRecebida.tipoMaterial or ""
    dados.RankItem = dados.RankItem or origemRecebida.rankItem or origemRecebida.rank or origemRecebida.Rank or "E"
    dados.imagemestilo2 = dados.imagemestilo2 or origemRecebida.imagemUrl or origemRecebida.imageUrl or origemRecebida.imagem or ""

    local tipoNormalizado = limparTextoInventario(dados.tipoItem)
    if tipoNormalizado == "material" or tipoNormalizado == "outros" or tipoNormalizado == "minerio" or tipoNormalizado == "minério" or tipoNormalizado == "couro" or tipoNormalizado == "madeira" or tipoNormalizado == "erva" or tipoNormalizado == "cristal" or tipoNormalizado == "frasco" then
        dados.usaQuantidade = "true"
    end

    local qtd = math.max(1, math.floor(CWNA_trocaNumero(itemRecebido.quantity or origemRecebida.quantidade, 1)))
    if CWNA_trocaItemEmpilhavelLocal(dados) then
        local existente = CWNA_trocaProcurarEmpilhavelLocal(ficha, dados)
        if existente ~= nil then
            local novaQtd = math.max(0, math.floor(CWNA_trocaNumero(existente.quantidade, 0))) + qtd
            existente.quantidade = novaQtd
            existente.quantidadeDisplay = tostring(novaQtd)
            return true
        end
        dados.uidInventario = tostring(os.time()) .. "_trade_" .. tostring(math.random(100000, 999999))
        dados.quantidade = qtd
        dados.quantidadeDisplay = tostring(qtd)
        dados.nivelUpgrade = ""
        dados.textoUpgrade = ""
    else
        dados.quantidade = ""
        dados.quantidadeDisplay = tostring(dados.textoUpgrade or dados.quantidadeDisplay or "+0")
        dados.uidInventario = tostring(os.time()) .. "_trade_" .. tostring(math.random(100000, 999999))
    end

    local slot = procurarPrimeiroSlotVazioInventario(lista)
    if slot == nil then return false end
    aplicarDadosNoItemInventario(slot, dados, slot.ordemInventario)
    return true
end

function CWNA_trocaAplicarMoedasConclusaoLocal(ficha)
    if ficha == nil then return end
    local lado = CWNA_trocaMeuLado(ficha)
    local hostOuro = CWNA_trocaNumero(ficha.TradeHostOuro, 0)
    local hostPrata = CWNA_trocaNumero(ficha.TradeHostPrata, 0)
    local guestOuro = CWNA_trocaNumero(ficha.TradeConvidadoOuro, 0)
    local guestPrata = CWNA_trocaNumero(ficha.TradeConvidadoPrata, 0)
    if lado == "guest" then
        ficha.OuroPersonagem = math.max(0, CWNA_trocaNumero(ficha.OuroPersonagem, 0) - guestOuro + hostOuro)
        ficha.PrataPersonagem = math.max(0, CWNA_trocaNumero(ficha.PrataPersonagem, 0) - guestPrata + hostPrata)
    else
        ficha.OuroPersonagem = math.max(0, CWNA_trocaNumero(ficha.OuroPersonagem, 0) - hostOuro + guestOuro)
        ficha.PrataPersonagem = math.max(0, CWNA_trocaNumero(ficha.PrataPersonagem, 0) - hostPrata + guestPrata)
    end
    CWNA_trocaAtualizarMoedasTopo(ficha, lado)
end

function CWNA_trocaAplicarConclusaoLocal(ficha, resposta, controle)
    if ficha == nil then return end
    local tradeIdConclusao = tostring((resposta and resposta.tradeId) or ficha.TradeIdAtual or "")
    if tradeIdConclusao ~= "" and tostring(ficha.TradeConclusaoAplicadaId or "") == tradeIdConclusao then
        ficha.TradeStatusAtual = "troca ja aplicada nesta ficha"
        return
    end
    local lado = CWNA_trocaMeuLado(ficha)
    local recebidos = lado == "guest" and (resposta and resposta.hostItems or {}) or (resposta and resposta.guestItems or {})

    CWNA_trocaRemoverOfertaLocal(ficha)
    local falhouEspaco = false
    if type(recebidos) == "table" then
        for _, item in ipairs(recebidos) do
            if not CWNA_trocaAdicionarRecebidoLocal(ficha, item) then
                falhouEspaco = true
            end
        end
    end

    CWNA_trocaAplicarMoedasConclusaoLocal(ficha)
    CWNA_trocaLimparTodosSlotsLocais(ficha)
    for i = 1, 10 do CWNA_trocaLimparOutroSlotLocal(ficha, i) end
    ficha.TradeHostConfirmado = "false"
    ficha.TradeConvidadoConfirmado = "false"
    ficha.TradeHostConcluirSolicitado = "false"
    ficha.TradeConvidadoConcluirSolicitado = "false"
    ficha.TradeConcluindo = "false"
    if tradeIdConclusao ~= "" then ficha.TradeConclusaoAplicadaId = tradeIdConclusao end
    ficha.TradeIdAtual = ""
    ficha.TradeCodigoAtual = ""
    ficha.TradeCodigoEntrada = ""
    CWNA_trocaAtualizarChecks(ficha)
    recalcularDefesa(ficha)

    if CWNA_FirebaseTrocas ~= nil then
        CWNA_FirebaseTrocas.syncInventory(ficha, function(okSync, respostaSync)
            if okSync then
                ficha.TradeStatusAtual = falhouEspaco and "troca concluida; sem espaco para todos os itens" or "troca concluida e inventario sincronizado"
            else
                ficha.TradeStatusAtual = "troca concluida; erro ao sincronizar inventario: " .. tostring(respostaSync and respostaSync.error or "falha")
            end
        end)
    end

    if falhouEspaco then
        CWNA_trocaAviso(controle, "Troca concluida, mas faltou espaco para algum item recebido.")
    end
end
function CWNA_corRankSlotEquipadoInventario(rank)
    if CWNA_trocaCorRank ~= nil then
        return CWNA_trocaCorRank(rank)
    end
    local r = tostring(rank or ""):upper():gsub("^%s*(.-)%s*$", "%1")
    if r == "SS" then return "#FFD700" end
    if r == "S" then return "#FF4D4D" end
    if r == "A" then return "#FF9F1C" end
    if r == "B" then return "#B15CFF" end
    if r == "C" then return "#4DA3FF" end
    if r == "D" then return "#5DD46F" end
    if r == "E" then return "#BFC3C7" end
    return "#4A4032"
end
function CWNA_corRankAcessorioInventario(rank)
    local r = tostring(rank or ""):upper():gsub("^%s*(.-)%s*$", "%1")
    if r == "SS" then return "#FFE600" end
    if r == "S" then return "#FF1F1F" end
    if r == "A" then return "#FFB000" end
    if r == "B" then return "#C63BFF" end
    if r == "C" then return "#00A6FF" end
    if r == "D" then return "#00E05A" end
    if r == "E" then return "#FFFFFF" end
    return CWNA_corRankSlotEquipadoInventario(rank)
end
local function textoUpgradeEquipadoInventario(dados)
    if dados == nil then
        return ""
    end

    local texto = tostring(dados.textoUpgrade or "")
    if texto == "" then
        texto = "+" .. tostring(tonumber(dados.nivelUpgrade) or 0)
    end

    return texto
end

local function atualizarVisualSlotEspecialInventario(ficha, slot, controleOrigem)
    if ficha == nil or slot == nil then
        return
    end

    local dados = dadosDoSlotEspecialInventario(ficha, slot)

    if dados == nil then
        limparSlotInventario(ficha, slot)
        atualizarVisualSkinInventario(ficha, controleOrigem)
        return
    end

    ficha["Imagem" .. slot] = dados.imagemestilo2 or imagensPadraoInventario[slot]
    ficha["ItemEquipado" .. slot] = dados.nomeItem or ""
    ficha["ItemEquipadoHandle" .. slot] = nil
    ficha["ItemEquipadoUid" .. slot] = dados.uidInventario
    if CWNA_slotAcessorioInventario(slot) then
        ficha["ItemEquipadoCorRank" .. slot] = CWNA_corRankAcessorioInventario(dados.RankItem)
    else
        ficha["ItemEquipadoCorRank" .. slot] = CWNA_corRankSlotEquipadoInventario(dados.RankItem)
    end
    garantirDurabilidadeItemInventario(dados)
    ficha["ItemEquipadoUpgrade" .. slot] = textoUpgradeEquipadoInventario(dados)
    ficha["ItemEquipadoDurabilidade" .. slot] = tostring(dados.durabilidadeDisplay or dados.durabilidade or "")

    if partesBonecoInventario[slot] ~= nil then
        ficha["Boneco" .. slot] = imagemEquipamentoBonecoInventario(dados, slot)
    end

    for _, atributo in ipairs(atributosInventario) do
        local valorAtributo = dados[atributo.campoItem]
        if atributo.campoItem == "rd" and (slot == "Capacete" or slot == "Peitoral" or slot == "Escudo" or slot == "Bota" or slot == "Calca") then
            local pdAtual = tonumber(dados.durabilidade)
            if pdAtual ~= nil and pdAtual <= 0 then
                valorAtributo = 0
            end
        end
        ficha[atributo.prefixoSlot .. slot] = fixNumeroInventario(valorAtributo)
    end

    atualizarVisualSkinInventario(ficha, controleOrigem)
end

function conjuntoRankCompletoComArmaInventario(dadosPorSlot, rank)
    if not conjuntoRankCompletoInventario(dadosPorSlot, rank) then
        return false
    end

    local dadosArma = dadosPorSlot and dadosPorSlot.Arma or nil
    local entradaArma = visualDoItemInventario(dadosArma)

    return entradaArma ~= nil and tostring(entradaArma.rank or "") == tostring(rank or "")
end

function CWNA_textoBuscaTokenLuz(valor)
    local texto = normalizarChaveCatalogoInventario(valor)
    texto = texto:gsub("[_%-%:]+", " "):gsub("%s+", " "):gsub("^%s*(.-)%s*$", "%1")
    return texto
end

function CWNA_coletarAlvosTokenLuz(ficha)
    local alvos = {nomes = {}, nomesVistos = {}, personagens = {}, jogadores = {}, usuarios = {}}
    local function addNome(valor)
        local txt = CWNA_textoBuscaTokenLuz(valor)
        if txt ~= "" and not alvos.nomesVistos[txt] then
            alvos.nomesVistos[txt] = true
            table.insert(alvos.nomes, txt)
        end
    end
    local function addNumero(lista, valor)
        local n = tonumber(valor)
        if n ~= nil and n ~= 0 then lista[n] = true end
    end
    local function addTexto(lista, valor)
        local txt = tostring(valor or "")
        if txt ~= "" and txt ~= "nil" then lista[txt] = true end
    end

    addNome(ficha and ficha.NomePersonagem)

    local personagem = nil
    pcall(function()
        if rrpg ~= nil and rrpg.getPersonagemDe ~= nil then personagem = rrpg.getPersonagemDe(ficha) end
        if personagem == nil and Firecast ~= nil and Firecast.getPersonagemDe ~= nil then personagem = Firecast.getPersonagemDe(ficha) end
    end)
    if personagem ~= nil then
        addNumero(alvos.personagens, personagem.objectID)
        addNumero(alvos.personagens, personagem.id)
        addNumero(alvos.personagens, personagem.codigoInterno)
        addNome(personagem.nome)
        addNome(personagem.name)
    end

    local mesa = nil
    pcall(function() mesa = (rrpg and rrpg.getMesaDe and rrpg.getMesaDe(ficha)) or (Firecast and Firecast.getMesaDe and Firecast.getMesaDe(ficha)) end)
    local jogador = mesa and mesa.me or nil
    if jogador ~= nil then
        addNumero(alvos.jogadores, jogador.objectID)
        addNumero(alvos.jogadores, jogador.id)
        addNumero(alvos.jogadores, jogador.codigoInterno)
        addNumero(alvos.personagens, jogador.personagemPrincipal)
        addTexto(alvos.usuarios, jogador.login)
        addTexto(alvos.usuarios, jogador.id)
        addTexto(alvos.usuarios, jogador.objectID)
        addNome(jogador.nick)
        addNome(jogador.nickname)
        addNome(jogador.nome)
        addNome(jogador.name)
        addNome(jogador.login)
    end
    return alvos
end

function CWNA_tokenCombinaLuz(token, alvos, cena)
    local ownerChar = nil
    local ownerUser = nil
    pcall(function() ownerChar = token and token.ownerCharacter end)
    pcall(function() ownerUser = token and token.ownerUserID end)

    if ownerChar ~= nil and alvos ~= nil and alvos.personagens ~= nil and alvos.personagens[tonumber(ownerChar) or -1] then
        return true
    end

    if ownerUser ~= nil and alvos ~= nil and alvos.usuarios ~= nil and alvos.usuarios[tostring(ownerUser)] then
        return true
    end

    if cena ~= nil and alvos ~= nil and alvos.usuarios ~= nil then
        local userCena = nil
        pcall(function() userCena = cena.currentUserID end)
        if ownerUser ~= nil and userCena ~= nil and tostring(ownerUser) == tostring(userCena) then
            return true
        end
    end

    local nomeToken = CWNA_textoBuscaTokenLuz(token and token.name)
    if nomeToken == "" then return false end
    for _, nome in ipairs((alvos and alvos.nomes) or {}) do
        if nome ~= "" and (nomeToken:find(nome, 1, true) ~= nil or nome:find(nomeToken, 1, true) ~= nil) then
            return true
        end
    end
    return false
end

function CWNA_lerLuzIntensaNativaToken(token)
    local valor = nil
    pcall(function()
        if token ~= nil and token.handle ~= nil and _obj_getProp ~= nil then
            valor = tonumber(_obj_getProp(token.handle, "LightIntenseRange"))
        end
    end)
    if valor == nil then
        pcall(function() valor = tonumber(token and token.lightIntenseRange) end)
    end
    return valor
end

function CWNA_aplicarLuzTokenGrid(token, metros)
    local ok = false
    local antes = CWNA_lerLuzIntensaNativaToken(token)
    pcall(function() token:beginUpdate() end)
    local sucesso = pcall(function()
        token.lightIntenseRange = metros
        token.lightWeakRange = metros
        token.lightAngle = 360
        if metros > 0 then
            token.visionHaveVision = true
        end
        ok = true
    end)
    pcall(function() token:endUpdate() end)
    local depois = CWNA_lerLuzIntensaNativaToken(token)
    return sucesso and ok, antes, depois
end

function CWNA_aplicarLuzNosTokensGrid(ficha, metros)
    metros = tonumber(metros) or 0
    local alvos = CWNA_coletarAlvosTokenLuz(ficha)
    if alvos == nil or (#alvos.nomes == 0 and next(alvos.personagens) == nil and next(alvos.usuarios) == nil) then return 0, "sem_nome" end

    local okScene, SceneLib = pcall(function() return require("scene.lua") end)
    if not okScene or SceneLib == nil or SceneLib.getLoadedScenes == nil then return 0, "sem_scene" end

    local total = 0
    local tokensVistos = 0
    local okLista, cenas = pcall(function() return SceneLib.getLoadedScenes() end)
    if not okLista or cenas == nil then return 0, "sem_cenas" end

    local leituraToken = nil
    for _, cena in ipairs(cenas) do
        local itens = nil
        pcall(function() itens = cena.items end)
        if itens ~= nil then
            local transacao = nil
            pcall(function()
                if cena.newTransaction ~= nil then
                    transacao = cena:newTransaction()
                    cena:pushTransaction(transacao)
                end
            end)

            local qtd = 0
            pcall(function() qtd = tonumber(itens.count) or 0 end)
            if qtd <= 0 then pcall(function() qtd = #itens end) end
            for i = 1, qtd do
                local token = nil
                pcall(function()
                    if itens.get ~= nil then
                        token = itens:get(i)
                    else
                        token = itens[i]
                    end
                end)
                if token ~= nil and token.isType ~= nil then
                    local ehToken = false
                    pcall(function() ehToken = token:isType("token") end)
                    if ehToken then
                        tokensVistos = tokensVistos + 1
                        if CWNA_tokenCombinaLuz(token, alvos, cena) then
                            local okToken, antes, depois = CWNA_aplicarLuzTokenGrid(token, metros)
                            leituraToken = tostring(antes or "?") .. "->" .. tostring(depois or "?")
                            if okToken then total = total + 1 end
                        end
                    end
                end
            end

            pcall(function()
                if transacao ~= nil then
                    cena:popTransaction()
                    transacao:commit()
                end
            end)
            pcall(function() cena:sendDelayedUpdates() end)
        end
    end

    if total == 0 and tokensVistos > 0 then return 0, "sem_token_compativel" end
    return total, tostring(leituraToken or "ok")
end

function CWNA_atualizarLuzEquipamentoInventario(ficha, controleOrigem)
    if ficha == nil then return end
    local dados = dadosDoSlotEspecialInventario(ficha, "Luz")
    if dados == nil then
        dados = {
            nomeItem = ficha.ItemEquipadoLuz,
            tipoItem = "",
            imagemestilo2 = ficha.ImagemLuz,
            ItemEquipadoLuz = ficha.ItemEquipadoLuz,
            ImagemLuz = ficha.ImagemLuz
        }
    else
        dados.ItemEquipadoLuz = ficha.ItemEquipadoLuz
        dados.ImagemLuz = ficha.ImagemLuz
    end

    local metros = CWNA_distanciaLuzItemInventario(dados)
    local nomeLuz = tostring((dados and dados.nomeItem) or ficha.ItemEquipadoLuz or "")
    local chaveEnvio = tostring(metros) .. "|" .. nomeLuz
    ficha.ItemEquipadoLuzMetros = metros > 0 and (tostring(metros) .. "m") or ""
    ficha.TokenLuzMetros = metros
    ficha.TokenLuzItem = metros > 0 and nomeLuz or ""

    local agoraSolicitacao = os.time()
    local ultimaHora = tonumber(ficha.TokenLuzUltimaSolicitacaoHora) or 0
    if tostring(ficha.TokenLuzUltimaSolicitacao or "") == chaveEnvio and (agoraSolicitacao - ultimaHora) < 3 then
        return
    end
    ficha.TokenLuzUltimaSolicitacao = chaveEnvio
    ficha.TokenLuzUltimaSolicitacaoHora = agoraSolicitacao

    ficha.TokenLuzUltimoRetorno = "Solicitando alteracao de luz a central: " .. tostring(metros) .. "m"
    if CWNA_AutomacaoCliente ~= nil and CWNA_AutomacaoCliente.solicitarLuzToken ~= nil then
        CWNA_AutomacaoCliente.solicitarLuzToken(ficha, metros, nomeLuz)
    end
end
local function aplicarDadosNoSlotEspecialInventario(ficha, slot, dados, controleOrigem)
    if ficha == nil or slot == nil then
        return
    end

    for _, campo in ipairs(camposDadosItemInventario) do
        ficha[campoSlotEspecialInventario(slot, campo)] = dados and (dados[campo] or "") or ""
    end

    atualizarVisualSlotEspecialInventario(ficha, slot, controleOrigem)
    if slot == "Luz" and CWNA_atualizarLuzEquipamentoInventario ~= nil then CWNA_atualizarLuzEquipamentoInventario(ficha, controleOrigem) end
end

function limparSlotInventario(ficha, slot)
    if ficha == nil or slot == nil then
        return
    end

    ficha["Imagem" .. slot] = imagensPadraoInventario[slot] or ""
    ficha["ItemEquipadoCorRank" .. slot] = "#4A4032"
    ficha["ItemEquipado" .. slot] = ""
    ficha["ItemEquipadoHandle" .. slot] = nil
    ficha["ItemEquipadoUid" .. slot] = nil
    ficha["ItemEquipadoUpgrade" .. slot] = ""
    ficha["ItemEquipadoDurabilidade" .. slot] = ""

    for _, campo in ipairs(camposDadosItemInventario) do
        ficha[campoSlotEspecialInventario(slot, campo)] = ""
    end

    if partesBonecoInventario[slot] ~= nil then
        ficha["Boneco" .. slot] = imagemBaseBonecoInventario(slot)
    end

    for _, atributo in ipairs(atributosInventario) do
        ficha[atributo.prefixoSlot .. slot] = 0
    end

    atualizarVisualSkinInventario(ficha)
end

local function desmarcarItemAnteriorInventario(itemAtual, slot)
    local lista = NDB.getParent(itemAtual)

    if lista == nil then
        return
    end

    local handleAtual = NDB.getNodeHandle(itemAtual)

    for _, item in ipairs(NDB.getChildNodes(lista)) do
        if NDB.getNodeHandle(item) ~= handleAtual and item.equipadoEm == slot then
            item.equipadoEm = ""
        end
    end
end

function CWNA_desequiparSlotInventario(ficha, slot)
    if ficha == nil or slot == nil or slot == "" then
        return
    end

    local handle = ficha["ItemEquipadoHandle" .. slot]

    if handle ~= nil then
        local ok, item = pcall(function() return NDB.openNode(handle) end)

        if ok and item ~= nil then
            item.equipadoEm = ""
        end
    end

    limparSlotInventario(ficha, slot)
        if slot == "Luz" and CWNA_atualizarLuzEquipamentoInventario ~= nil then CWNA_atualizarLuzEquipamentoInventario(ficha, nil) end
    recalcularDefesa(ficha)
end

function CWNA_equiparItemInventario(ficha, item, slotAlvo, controleOrigem)
    if ficha == nil or item == nil then
        return
    end

    local slotItem = slotDoItemInventario(item)
    if slotAlvo ~= nil and CWNA_slotAcessorioInventario(slotAlvo) and CWNA_itemEhAcessorioInventario(item) then
        slotItem = slotAlvo
    end

    if slotItem == nil then
        showMessage("Este item nao pode ser equipado.")
        return
    end

    if slotAlvo ~= nil and slotItem ~= slotAlvo then
        return
    end

    local dadosOrigem = dadosDoItemInventario(item)

    if dadosOrigem == nil then
        return
    end

    local ordemOrigem = item.ordemInventario
    local dadosEspecial = dadosDoSlotEspecialInventario(ficha, slotItem)

    if slotItem == "Luz" then
        local handleAntigo = ficha.ItemEquipadoHandleLuz or ficha.SlotEspecialLuz_uidInventario
        if handleAntigo ~= nil and tostring(handleAntigo or "") ~= "" then
            pcall(function()
                local antigo = NDB.openNode(handleAntigo)
                if antigo ~= nil then antigo.equipadoEm = "" end
            end)
        end
        item.equipadoEm = "Luz"
    end

    garantirDurabilidadeItemInventario(dadosOrigem)
    if itemEhEquipamentoInventario(dadosOrigem) and not itemEhArmaInventario(dadosOrigem) and CWNA_timestampDurabilidadeInventario(dadosOrigem.durabilidadeDataBase) == nil then
        CWNA_fixarDurabilidadeAtualInventario(dadosOrigem, dadosOrigem.durabilidade)
    end
    aplicarDadosNoSlotEspecialInventario(ficha, slotItem, dadosOrigem, controleOrigem)
    aplicarDadosNoItemInventario(item, dadosEspecial, ordemOrigem)
    recalcularDefesa(ficha)
end

local function CWNA_aplicarDurabilidadeNoSlotEspecial(ficha, slot, item)
    if ficha == nil or slot == nil or item == nil then return end
    local atual, maximo = garantirDurabilidadeItemInventario(item)
    ficha[campoSlotEspecialInventario(slot, "durabilidade")] = atual
    ficha[campoSlotEspecialInventario(slot, "durabilidadeMaxima")] = maximo
    ficha[campoSlotEspecialInventario(slot, "durabilidadeDisplay")] = tostring(math.floor(atual))
    ficha[campoSlotEspecialInventario(slot, "durabilidadeBaseTempo")] = item.durabilidadeBaseTempo
    ficha[campoSlotEspecialInventario(slot, "durabilidadeDataBase")] = item.durabilidadeDataBase
    ficha["ItemEquipadoDurabilidade" .. slot] = tostring(math.floor(atual))
end

function CWNA_atualizarDurabilidadeTempoRealItens(ficha)
    if ficha == nil then return end

    local lista = ficha.magias2
    if lista ~= nil then
        for _, item in ipairs(NDB.getChildNodes(lista)) do
            if item ~= nil and tostring(item.slotVazio or "") ~= "true" and itemEhEquipamentoInventario(item) then
                garantirDurabilidadeItemInventario(item)

                local slot = tostring(item.equipadoEm or "")
                if slot ~= "" then
                    CWNA_aplicarDurabilidadeNoSlotEspecial(ficha, slot, item)
                end
            end
        end
    end

    for _, slot in ipairs({"Arma", "Capacete", "Peitoral", "Escudo", "Bota", "Calca"}) do
        if slotEspecialTemItemInventario(ficha, slot) then
            local uid = tostring(ficha["ItemEquipadoUid" .. slot] or ficha[campoSlotEspecialInventario(slot, "uidInventario")] or "")
            local item = procurarItemInventarioPorUid(ficha, uid)
            if item ~= nil then
                CWNA_aplicarDurabilidadeNoSlotEspecial(ficha, slot, item)
            else
                local dados = dadosDoSlotEspecialInventario(ficha, slot)
                garantirDurabilidadeItemInventario(dados)
                ficha[campoSlotEspecialInventario(slot, "durabilidade")] = dados.durabilidade
                ficha[campoSlotEspecialInventario(slot, "durabilidadeMaxima")] = dados.durabilidadeMaxima
                ficha[campoSlotEspecialInventario(slot, "durabilidadeDisplay")] = dados.durabilidadeDisplay
                ficha[campoSlotEspecialInventario(slot, "durabilidadeBaseTempo")] = dados.durabilidadeBaseTempo
                ficha[campoSlotEspecialInventario(slot, "durabilidadeDataBase")] = dados.durabilidadeDataBase
                ficha["ItemEquipadoDurabilidade" .. slot] = tostring(dados.durabilidadeDisplay or "")
            end
        end
    end

    recalcularDefesa(ficha)
end

local CWNA_timersDurabilidadeInventario = {}

function CWNA_iniciarAtualizadorDurabilidadeItens(ficha)
    if ficha == nil then return end
    local chave = tostring(ficha)
    if CWNA_timersDurabilidadeInventario[chave] then return end
    CWNA_timersDurabilidadeInventario[chave] = true

    local function atualizar()
        if ficha == nil then
            CWNA_timersDurabilidadeInventario[chave] = nil
            return
        end

        CWNA_atualizarDurabilidadeTempoRealItens(ficha)
        setTimeout(atualizar, 3600000)
    end

    setTimeout(atualizar, 1000)
end
function CWNA_sincronizarSlotsEspeciaisInventario(ficha)
    if ficha == nil then
        return
    end

    for slot, _ in pairs(imagensPadraoInventario) do
        if slotDoItemInventario({tipoItem = slot}) ~= nil or CWNA_slotAcessorioInventario(slot) then
            atualizarVisualSlotEspecialInventario(ficha, slot)
        end
    end

    recalcularDefesa(ficha)
end

function CWNA_soltarSlotEspecialNoInventario(ficha, itemAlvo, slotOrigem, controleOrigem)
    if ficha == nil or itemAlvo == nil or slotOrigem == nil then
        return
    end

    local dadosEspecial = dadosDoSlotEspecialInventario(ficha, slotOrigem)

    if dadosEspecial == nil then
        return
    end

    local dadosAlvo = dadosDoItemInventario(itemAlvo)
    local ordemAlvo = itemAlvo.ordemInventario

    if dadosAlvo ~= nil and not CWNA_slotAceitaItemInventario(slotOrigem, dadosAlvo) then
        CWNA_mostrarAvisoInventario(controleOrigem, "O item destino nao pode ser equipado aqui")
        return
    end

    aplicarDadosNoItemInventario(itemAlvo, dadosEspecial, ordemAlvo)
    aplicarDadosNoSlotEspecialInventario(ficha, slotOrigem, dadosAlvo, controleOrigem)
    recalcularDefesa(ficha)
end

function CWNA_dropItemInventario(ficha, slotAlvo, uid, controleOrigem)
    if uid == nil then
        return
    end

    local item = procurarItemInventarioPorUid(ficha, uid)

    if item ~= nil then
        CWNA_equiparItemInventario(ficha, item, slotAlvo, controleOrigem)
    end
end

function CWNA_atualizarEfeitosPotionServidor(ficha, controleOrigem)
    if ficha == nil or CWNA_FirebaseTrocas == nil or CWNA_FirebaseTrocas.getActivePotionEffects == nil then return end
    CWNA_FirebaseTrocas.getActivePotionEffects(ficha, function(ok, resposta)
        if ok then
            recalcularDefesa(ficha)
        elseif controleOrigem ~= nil then
            CWNA_mostrarAvisoInventario(controleOrigem, "Nao foi possivel consultar efeitos temporarios.", 5000)
        end
    end)
end

function CWNA_iniciarAtualizadorEfeitosPotion(ficha)
    if ficha == nil then return end
    ficha.PotionEfeitosTimerAtivo = "false"
end

local function dadosFrascoVazioPorRankInventario(rank)
    local r = string.upper(tostring(rank or "E")):gsub("^%s*(.-)%s*$", "%1")
    if r == "" then r = "E" end
    local mat = nil
    pcall(function()
        mat = BancoItens and BancoItens.materiais and BancoItens.materiais.frascos and BancoItens.materiais.frascos[r]
    end)
    mat = mat or {}
    return {
        nomeItem = tostring(mat.nome or "Frasco Vazio"),
        tipoItem = "Material",
        subtipoMaterial = "FRASCOS",
        RankItem = r,
        imagemestilo2 = tostring(mat.imagemUrl or mat.imagemestilo2 or ""),
        precoLojaPrata = tonumber(mat.precoPrata) or 0,
        descricaoLoja = tostring(mat.descricao or "Frasco vazio recuperado ao consumir uma potion."),
        quantidade = 1,
        quantidadeDisplay = "1",
        usaQuantidade = "true",
        origemLoja = "true"
    }
end

local function itemMesmoFrascoVazioInventario(item, dados)
    if item == nil or dados == nil or ehSlotVazioInventario(item) then return false end
    return limparTextoInventario(item.nomeItem) == limparTextoInventario(dados.nomeItem)
        and limparTextoInventario(item.tipoItem) == limparTextoInventario(dados.tipoItem)
        and limparTextoInventario(item.subtipoMaterial) == limparTextoInventario(dados.subtipoMaterial)
        and string.upper(limparTextoInventario(item.RankItem)) == string.upper(limparTextoInventario(dados.RankItem))
end

local function devolverFrascoVazioPotionInventario(ficha, rank, controleOrigem)
    if ficha == nil or ficha.magias2 == nil then return false end
    local dados = dadosFrascoVazioPorRankInventario(rank)
    for _, item in ipairs(NDB.getChildNodes(ficha.magias2)) do
        if itemMesmoFrascoVazioInventario(item, dados) then
            item.slotVazio = "false"
            item.quantidade = fixNumeroInventario(item.quantidade) + 1
            item.quantidadeDisplay = tostring(item.quantidade)
            item.usaQuantidade = "true"
            return true
        end
    end

    local destino = procurarPrimeiroSlotVazioInventario(ficha.magias2)
    if destino == nil then
        CWNA_mostrarAvisoInventario(controleOrigem, "Potion consumida, mas o inventario esta cheio para receber o frasco vazio.", 8000)
        return false
    end

    prepararSlotVazioInventario(destino, destino.ordemInventario)
    destino.slotVazio = "false"
    destino.uidInventario = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    destino.nomeItem = dados.nomeItem
    destino.tipoItem = dados.tipoItem
    destino.subtipoMaterial = dados.subtipoMaterial
    destino.RankItem = dados.RankItem
    destino.imagemestilo2 = dados.imagemestilo2
    destino.quantidade = 1
    destino.quantidadeDisplay = "1"
    destino.usaQuantidade = "true"
    destino.origemLoja = dados.origemLoja
    destino.precoLojaPrata = dados.precoLojaPrata
    destino.descricaoLoja = dados.descricaoLoja
    destino.equipadoEm = ""
    destino.hp = 0
    destino.pp = 0
    destino.ca = 0
    destino.rd = 0
    destino.dano = ""
    destino.cura = 0
    destino.durabilidade = ""
    destino.durabilidadeMaxima = ""
    destino.durabilidadeDisplay = ""
    destino.durabilidadeBaseTempo = ""
    destino.durabilidadeDataBase = ""
    return true
end
local function consumirPotionTemporariaLocal(item)
    local quantidade = fixNumeroInventario(item and item.quantidade)
    if quantidade <= 0 then return false end
    local rankPotionConsumida = item.RankItem
    item.quantidade = quantidade - 1
    if fixNumeroInventario(item.quantidade) <= 0 then
        local okLimpeza = pcall(function()
            CWNA_removerItemInventarioSeQuantidadeZero(item)
        end)
        if not okLimpeza then
            pcall(function()
                prepararSlotVazioInventario(item, item.ordemInventario)
            end)
        end
    end
    return true
end

local function usarPotionTemporariaInventario(ficha, item, controleOrigem)
    if ficha == nil or item == nil then return false end
    if CWNA_FirebaseTrocas == nil or CWNA_FirebaseTrocas.useTimedPotion == nil then
        CWNA_mostrarAvisoInventario(controleOrigem, "Servidor de efeitos temporarios indisponivel.", 7000)
        return true
    end
    if fixNumeroInventario(item.quantidade) <= 0 then
        CWNA_mostrarAvisoInventario(controleOrigem, "Este item nao tem quantidade disponivel.")
        return true
    end

    CWNA_FirebaseTrocas.useTimedPotion(ficha, item, function(ok, resposta)
        if not ok then
            CWNA_mostrarAvisoInventario(controleOrigem, tostring(resposta and resposta.error or "Nao foi possivel usar esta potion."), 8000)
            return
        end

        local rankPotionConsumida = item.RankItem
        if not consumirPotionTemporariaLocal(item) then
            CWNA_mostrarAvisoInventario(controleOrigem, "Este item nao tem quantidade disponivel.")
            return
        end
        recalcularDefesa(ficha)
        local texto = tostring(item.nomeItem or "Potion temporaria") .. " ativada por " .. tostring(resposta.durationMinutes or 0) .. " minutos."
        CWNA_mostrarAvisoInventario(controleOrigem, texto, 8000)
    end)

    return true
end

function CWNA_usarPotionArrastadaNoBoneco(ficha, uid, controleOrigem)
    if ficha == nil or uid == nil then
        return
    end

    local item = procurarItemInventarioPorUid(ficha, uid)

    if item == nil then
        return
    end

    if itemEhPotionTemporariaInventario(item) then
        usarPotionTemporariaInventario(ficha, item, controleOrigem)
        return
    end

    local tipoPotion = tipoPotionDoItemInventario(item)

    if tipoPotion == nil then
        CWNA_mostrarAvisoInventario(controleOrigem, "Esta potion nao possui uso cadastrado.")
        return
    end

    local mesa = rrpg.getMesaDe(ficha)
    local jogador = mesa and mesa.me or nil
    local chat = mesa and mesa.chat or nil

    if jogador == nil or chat == nil then
        showMessage("Jogador ou chat nao disponivel.")
        return
    end

    local indexBarra = nil
    local valorBase = 0
    local prefixo = nil

    if tipoPotion == "HP" then
        indexBarra = 1
        valorBase = fixNumeroInventario(item.cura)
        prefixo = "HP"
    elseif tipoPotion == "PP" then
        indexBarra = 2
        valorBase = fixNumeroInventario(item.pp)
        prefixo = "PP"
    else
        return
    end

    local atual, maximo = jogador:getBarValue(indexBarra)

    if atual == nil or maximo == nil then
        showMessage("Barra nao disponivel ou invisivel.")
        return
    end

    if atual >= maximo then
        if prefixo == "HP" then
            CWNA_mostrarAvisoInventario(controleOrigem, "Seu HP esta cheio")
        else
            CWNA_mostrarAvisoInventario(controleOrigem, "Seu PP esta cheio")
        end

        return
    end

    local curaReal = math.min(valorBase, maximo - atual)

    if curaReal <= 0 then
        return
    end

    local quantidade = fixNumeroInventario(item.quantidade)

    if quantidade <= 0 then
        CWNA_mostrarAvisoInventario(controleOrigem, "Este item nao tem quantidade disponivel.")
        return
    end

    local nomeJogador = "Jogador"
    pcall(function()
        nomeJogador = tostring(jogador.nick or jogador.nickname or jogador.nome or jogador.name or jogador.login or "Jogador")
    end)

    local nomePotion = tostring(item.nomeItem or item.tipoItem or ("Potion " .. prefixo))
    if nomePotion == nil or nomePotion == "" then
        nomePotion = "Potion " .. prefixo
    end

    local okCura = pcall(function()
        chat:enviarMensagem("/" .. prefixo .. " +" .. curaReal)
    end)

    if not okCura then
        CWNA_mostrarAvisoInventario(controleOrigem, "Nao foi possivel usar esta potion.")
        return
    end

    pcall(function()
        local marcadorCor = "[" .. string.char(194, 167) .. "K"
        local corItem = codigoCorRankChatLoja(item.RankItem)
        chat:enviarMensagem("<" .. nomeJogador .. "> " .. marcadorCor .. "1]utilizou 1x " .. marcadorCor .. corItem .. "]" .. nomePotion .. marcadorCor .. "1] e restaurou " .. tostring(curaReal) .. " de " .. prefixo)
    end)

    local rankPotionConsumida = item.RankItem
    item.quantidade = quantidade - 1
    if fixNumeroInventario(item.quantidade) <= 0 then
        local okLimpeza = pcall(function()
            CWNA_removerItemInventarioSeQuantidadeZero(item)
        end)

        if not okLimpeza then
            pcall(function()
                prepararSlotVazioInventario(item, item.ordemInventario)
            end)
        end
    end
end

function CWNA_registrarDropPotionBoneco(drop, drag, ficha, controleOrigem)
    if drop == nil or drag == nil or ficha == nil then
        return
    end

    local uid = nil
    local ok = pcall(function()
        uid = drag:getData("cwnaInventarioUid")
    end)

    if not ok or uid == nil then
        return
    end

    local item = procurarItemInventarioPorUid(ficha, uid)

    if item == nil or not itemEhQualquerPotionInventario(item) then
        return
    end

    drop:addAction("cwnaInventarioUid", function(uidDrop)
        CWNA_usarPotionArrastadaNoBoneco(ficha, uidDrop, controleOrigem)
    end)
end

function CWNA_mostrarAvisoInventario(controle, texto, duracao, corTexto, textoColorido)
    local ctrl = controle
    local raiz = controle
    local aviso = nil
    local label = nil

    while raiz ~= nil and raiz.parent ~= nil do
        raiz = raiz.parent
    end

    if raiz ~= nil and raiz.findControlByName ~= nil then
        aviso = raiz:findControlByName("avisoGlobalInventario")
        label = raiz:findControlByName("lblAvisoGlobalInventario")
    end

    while ctrl ~= nil and aviso == nil do
        if ctrl.findControlByName ~= nil then
            aviso = ctrl:findControlByName("avisoLojaInterno")
            label = ctrl:findControlByName("lblAvisoLojaInterno")

            if aviso == nil then
                aviso = ctrl:findControlByName("avisoSlotErradoInventario")
                label = ctrl:findControlByName("lblAvisoSlotErradoInventario")
            end
        end

        ctrl = ctrl.parent
    end

    if aviso == nil then
        return
    end

    if label ~= nil then
        label.text = texto or "Slot errado, confira o tipo do item"
        label.fontColor = corTexto or "#FFFFFF"
    end

    aviso.visible = true
    pcall(function() aviso:bringToFront() end)
    setTimeout(function()
        if aviso ~= nil then
            pcall(function() aviso:bringToFront() end)
        end
    end, 1)

    setTimeout(function()
        if aviso ~= nil then
            aviso.visible = false
        end
    end, duracao or 2600)
end

local function CWNA_marcarDropInvalidoVisual(controle, event)
    if event ~= nil then
        pcall(function() event.cursor = "noDrop" end)
        pcall(function() event.Cursor = "noDrop" end)
    end

    if controle ~= nil then
        pcall(function() controle.cursor = "noDrop" end)
        setTimeout(function()
            if controle ~= nil then
                pcall(function() controle.cursor = "default" end)
            end
        end, 50)
    end
end

function CWNA_removerItemInventarioSeQuantidadeZero(item)
    if item == nil or ehSlotVazioInventario(item) then
        return false
    end

    local textoQtd = tostring(item.quantidade or "")
    if textoQtd == "" then
        return false
    end

    if fixNumeroInventario(textoQtd) > 0 then
        return false
    end

    local ficha = NDB.getRoot(item)
    local ordem = tonumber(item.ordemInventario) or item.ordemInventario

    if ficha ~= nil and item.equipadoEm ~= nil and item.equipadoEm ~= "" then
        CWNA_desequiparSlotInventario(ficha, item.equipadoEm)
    end

    prepararSlotVazioInventario(item, ordem)
    return true
end

function CWNA_trocarOuMoverAcessorioInventario(ficha, slotOrigem, slotDestino, controleOrigem)
    if ficha == nil or slotOrigem == nil or slotDestino == nil then return end
    if not CWNA_slotAcessorioInventario(slotOrigem) or not CWNA_slotAcessorioInventario(slotDestino) then return end
    if slotOrigem == slotDestino then return end

    local dadosOrigem = dadosDoSlotEspecialInventario(ficha, slotOrigem)
    if dadosOrigem == nil then return end

    local dadosDestino = dadosDoSlotEspecialInventario(ficha, slotDestino)
    aplicarDadosNoSlotEspecialInventario(ficha, slotDestino, dadosOrigem, controleOrigem)
    aplicarDadosNoSlotEspecialInventario(ficha, slotOrigem, dadosDestino, controleOrigem)
    recalcularDefesa(ficha)
end
function CWNA_registrarDropSlotInventario(drop, drag, ficha, slotAlvo, controleOrigem, event)
    if drop == nil or drag == nil or ficha == nil or slotAlvo == nil then
        return
    end

    local infoEspecial = nil
    local okEspecial = pcall(function()
        infoEspecial = drag:getData("cwnaSlotEspecial")
    end)

    if okEspecial and infoEspecial ~= nil then
        local dadosEspecial = dadosDoSlotEspecialInventario(ficha, infoEspecial.slot)

        if dadosEspecial == nil then
            return
        end

        if infoEspecial.slot == slotAlvo then
            drop:addAction("cwnaSlotEspecial", function()
            end)
            return
        end

        if CWNA_slotAcessorioInventario(infoEspecial.slot) and CWNA_slotAcessorioInventario(slotAlvo) then
            drop:addAction("cwnaSlotEspecial", function()
                CWNA_trocarOuMoverAcessorioInventario(ficha, infoEspecial.slot, slotAlvo, controleOrigem)
            end)
            return
        end

        CWNA_marcarDropInvalidoVisual(controleOrigem, event)
        drop:addAction("cwnaSlotEspecial", function()
            CWNA_mostrarAvisoInventario(controleOrigem, "Slot errado, confira o tipo do item")
        end)
        return
    end

    local uidLoja = nil
    local okLoja = pcall(function()
        uidLoja = drag:getData("cwnaLojaUid")
    end)

    if okLoja and uidLoja ~= nil then
        local itemLoja = procurarItemLojaPorUid(ficha, uidLoja)

        if itemLoja == nil then
            return
        end

        if not CWNA_slotAceitaItemInventario(slotAlvo, itemLoja) then
            CWNA_marcarDropInvalidoVisual(controleOrigem, event)
            drop:addAction("cwnaLojaUid", function()
                CWNA_mostrarAvisoInventario(controleOrigem, "Slot errado, confira o tipo do item")
            end)
            return
        end

        drop:addAction("cwnaLojaUid", function(uidDrop)
            CWNA_comprarItemLojaPorUid(ficha, uidDrop, controleOrigem)
        end)
        return
    end

    local uid = nil
    local tipoDragOrigem = "cwnaInventarioUid"
    local ok = pcall(function()
        uid = drag:getData("cwnaInventarioUid")
    end)

    if (not ok or uid == nil) then
        local info = nil
        ok = pcall(function()
            info = drag:getData("cwnaSlotEquipado")
        end)

        if ok and info ~= nil then
            uid = info.uid
            tipoDragOrigem = "cwnaSlotEquipado"
        end
    end

    if not ok or uid == nil then
        return
    end

    local item = procurarItemInventarioPorUid(ficha, uid)

    if item == nil then
        return
    end

    if not CWNA_slotAceitaItemInventario(slotAlvo, item) then
        CWNA_marcarDropInvalidoVisual(controleOrigem, event)
        drop:addAction(tipoDragOrigem, function()
            CWNA_mostrarAvisoInventario(controleOrigem, "Slot errado, confira o tipo do item")
        end)
        return
    end

    drop:addAction(tipoDragOrigem, function(uidDrop)
        CWNA_dropItemInventario(ficha, slotAlvo, uidDrop or uid, controleOrigem)
    end)
end

function CWNA_dragSlotInventario(ficha, slot, drag)
    if ficha == nil or slot == nil or drag == nil then
        return
    end

    local dados = dadosDoSlotEspecialInventario(ficha, slot)

    if dados ~= nil then
        drag:addData("cwnaSlotEspecial", {slot = slot})
        drag:addData("text", dados.nomeItem or "Item equipado")

        if dados.imagemestilo2 ~= nil and dados.imagemestilo2 ~= "" then
            drag:addData("url", dados.imagemestilo2)
            drag:addData("imageURL", dados.imagemestilo2)
            drag:addData("image", dados.imagemestilo2)
            drag:addData("text/uri-list", dados.imagemestilo2)
        end
    end
end


--------------------------------------------------
-- RANK / CLASSE
--------------------------------------------------

local RankDB = {
    ["E"]  = {hp = 6,  pp = 2,  atributos = 7},
    ["D"]  = {hp = 10, pp = 4,  atributos = 9},
    ["C"]  = {hp = 14, pp = 6,  atributos = 11},
    ["B"]  = {hp = 20, pp = 8,  atributos = 13},
    ["A"]  = {hp = 24, pp = 10, atributos = 15},
    ["S"]  = {hp = 30, pp = 15, atributos = 17},
    ["SS"] = {hp = 38, pp = 18, atributos = 25}
}

local ClassHP = {
    ["COLOSSO"] = 8,
    ["MONGE"] = 5,
    ["ESTANDARTE"] = 7,
    ["CAMPEÃO"] = 6,
    ["CAMPEÃO"] = 6,
    ["DANÇARINO"] = 5,
    ["DANÇARINO"] = 5,
    ["SENTINELA"] = 4,
    ["LÂMINAS"] = 4,
    ["LÂMINAS"] = 4,
    ["ESTRATEGISTA"] = 3,
    ["FORJADO"] = 6,
    ["ASSASSINO"] = 4,
    ["ELEMENTARISTA"] = 4,
    ["ORÁCULO"] = 3,
    ["ORÁCULO"] = 3
}

local function classeNormalizada(nomeClasse)
    if nomeClasse == "CAMPEAO" then
        return "CAMPEÃO"
    end

    if nomeClasse == "LAMINAS" then
        return "LÂMINAS"
    end

    if nomeClasse == "ORACULO" then
        return "ORÁCULO"
    end

    if nomeClasse == "DANCARINO" then
        return "DANÇARINO"
    end

    return nomeClasse
end


--------------------------------------------------
-- XP / LEVEL
--------------------------------------------------

local function xpNecessarioParaNivel(nivel)
    local xp = 0
    for i = 2, nivel do
        xp = xp + (i * 5)
    end
    return xp
end

local function calcularNivel(xp)
    local nivel = 1
    for i = 2, 20 do
        if xp >= xpNecessarioParaNivel(i) then
            nivel = i
        else
            break
        end
    end
    return nivel
end

function atualizarNivel(sheet)
    if not sheet then return end

    sheet.NivelPersonagem = calcularNivel(n(sheet.XP))

    atualizarBarraXP(sheet)

    recalcularDefesa(sheet)
end

function atualizarBarraXP(sheet)
    if not sheet then return end

    local xpTotal = n(sheet.XP)
    local nivel = calcularNivel(xpTotal)
    local xpInicioNivel = xpNecessarioParaNivel(nivel)
    local xpProximoNivel = xpNecessarioParaNivel(nivel + 1)

    if nivel >= 20 then
        xpInicioNivel = xpTotal
        xpProximoNivel = xpTotal
    end

    local xpNoNivel = math.max(0, xpTotal - xpInicioNivel)
    local xpNecessarioNoNivel = math.max(1, xpProximoNivel - xpInicioNivel)

    sheet.XPBarra = xpNoNivel
    sheet.XPBarraMax = xpNecessarioNoNivel
    sheet.XPTexto = xpNoNivel .. "/" .. xpNecessarioNoNivel
end


function onClasseOuRankChange(sheet)
    recalcularDefesa(sheet)
end


--------------------------------------------------
-- PER?CIAS
--------------------------------------------------

PERICIAS_FORCA = {
    "BracoDeFerro","Correr","DanoCurtoAlcance","DanoLongoAlcance",
    "EmpurrarObstaculo","Escalar"
}

PERICIAS_DES = {
    "AcertoDistancia","AcertoCurtoAlcance","DesarmarArmadilha",
    "Esquivar","Furtividade","Iniciativa","MontariaDirecao","Roubo"
}

PERICIAS_INT = {
    "AcertoMagico","IdentificarCriatura","Investigacao","LerManuscrito",
    "Medicina","PrepararEstrategia","Profissao","ResistenciaMental"
}

PERICIAS_SAB = {
    "DetectarMagia","DanoMagico","Historia","Natureza",
    "PerceberMentira","Percepcao","Religiao","Sobrevivencia"
}

PERICIAS_CAR = {
    "Atuar","Discurso","Intimidar","Mentir","Seducao"
}

PERICIAS_CON = {
    "ResistenciaCansaco","ResistirVeneno","SegurarFolego","SuporteFrioCalor"
}


--------------------------------------------------
-- FUN??ES BASE
--------------------------------------------------

local function custoPericia(nivel)
    return (nivel * (nivel + 1)) / 2
end

local function gastoTotal(sheet, lista)
    local total = 0
    for _, nome in ipairs(lista) do
        total = total + custoPericia(n(sheet[nome .. "1"]))
    end
    return total
end

local function modDisponivel(sheet, baseMod, lista)
    return n(baseMod) - gastoTotal(sheet, lista)
end

function onHBChange()
    recalcularDefesa(self.sheet)
end
--------------------------------------------------
-- DEFESA PRINCIPAL
--------------------------------------------------

function recalcularDefesa(sheet)
    if not sheet then return end

    local ca, rd, hp, pp, dano, cura = 0, 0, 0, 0, 0, 0

    for _, slot in ipairs(slots) do
        ca = ca + n(sheet["Ca" .. slot])
        rd = rd + n(sheet["Rd" .. slot])
        hp = hp + n(sheet["Hp" .. slot])
        pp = pp + n(sheet["Pp" .. slot])
        dano = dano + n(sheet["Dano" .. slot])
        cura = cura + n(sheet["Cura" .. slot])
    end

    local function calcularProf(level)
    if level >= 17 then return 6 end
    if level >= 11 then return 5 end
    if level >= 7 then return 4 end
    if level >= 5 then return 3 end
    return 2
    end

    local level = n(sheet.NivelPersonagem)
    local prof = calcularProf(level)
    sheet.Prof = prof
    local skinEquipada = skinEquipadaInventario(sheet)

    local bonusAcertoCurto = 0
    local bonusAcertoLongo = 0
    local bonusAcertoMagico = 0
    bonusResistenciaMental = 0

    local function temHB(hb)
        return sheet.HB1 == hb
            or sheet.HB2 == hb
            or sheet.HB3 == hb
            or sheet.HB4 == hb
    end

    if temHB("GOLPE_PESADO") then
        bonusAcertoCurto = bonusAcertoCurto - 1
        bonusAcertoLongo = bonusAcertoLongo - 1
        bonusAcertoMagico = bonusAcertoMagico - 1
    end
    if temHB("PELE_MISTICA") then
    bonusResistenciaMental = bonusResistenciaMental + 1
    end

    --------------------------------------------------
    -- ATRIBUTOS
    --------------------------------------------------

    sheet.ForcaTotal = n(sheet.ForcaValor) + n(sheet.ForcaAdd) + n(skinEquipada and skinEquipada.bonusForca) + n(sheet.PotionBonusForca)
    sheet.ForcaMod = sheet.ForcaTotal * 2

    sheet.DestrezaTotal = n(sheet.DestrezaValor) + n(sheet.DestrezaAdd) + n(skinEquipada and skinEquipada.bonusDestreza) + n(sheet.PotionBonusDestreza)
    sheet.DestrezaMod = sheet.DestrezaTotal * 2

    sheet.ConstituicaoTotal = n(sheet.ConstituicaoValor) + n(sheet.ConstituicaoAdd) + n(skinEquipada and skinEquipada.bonusConstituicao) + n(sheet.PotionBonusConstituicao)
    sheet.ConstituicaoMod = sheet.ConstituicaoTotal * 2

    sheet.InteligenciaTotal = n(sheet.InteligenciaValor) + n(sheet.InteligenciaAdd) + n(skinEquipada and skinEquipada.bonusInteligencia) + n(sheet.PotionBonusInteligencia)
    sheet.InteligenciaMod = sheet.InteligenciaTotal * 2

    sheet.SabedoriaTotal = n(sheet.SabedoriaValor) + n(sheet.SabedoriaAdd) + n(skinEquipada and skinEquipada.bonusSabedoria) + n(sheet.PotionBonusSabedoria)
    sheet.SabedoriaMod = sheet.SabedoriaTotal * 2

    sheet.CarismaTotal = n(sheet.CarismaValor) + n(sheet.CarismaAdd) + n(skinEquipada and skinEquipada.bonusCarisma) + n(sheet.PotionBonusCarisma)
    sheet.CarismaMod = sheet.CarismaTotal * 2

    --------------------------------------------------
    -- MODS US?VEIS
    --------------------------------------------------

    sheet.ForcaModUsavel = modDisponivel(sheet, sheet.ForcaMod, PERICIAS_FORCA)
    sheet.DestrezaModUsavel = modDisponivel(sheet, sheet.DestrezaMod, PERICIAS_DES)
    sheet.InteligenciaModUsavel = modDisponivel(sheet, sheet.InteligenciaMod, PERICIAS_INT)
    sheet.SabedoriaModUsavel = modDisponivel(sheet, sheet.SabedoriaMod, PERICIAS_SAB)
    sheet.CarismaModUsavel = modDisponivel(sheet, sheet.CarismaMod, PERICIAS_CAR)
    sheet.ConstituicaoModUsavel = modDisponivel(sheet, sheet.ConstituicaoMod, PERICIAS_CON)

    --------------------------------------------------
    -- PER?CIAS
    --------------------------------------------------

    local pericias = {
    "BracoDeFerro","Correr","DanoCurtoAlcance","DanoLongoAlcance",
    "EmpurrarObstaculo","Escalar","AcertoDistancia","AcertoCurtoAlcance",
    "DesarmarArmadilha","Esquivar","Furtividade","Iniciativa",
    "MontariaDirecao","Roubo","AcertoMagico","IdentificarCriatura",
    "Investigacao","LerManuscrito","Medicina","PrepararEstrategia",
    "Profissao","ResistenciaMental","DetectarMagia","DanoMagico",
    "Historia","Natureza","PerceberMentira","Percepcao",
    "Religiao","Sobrevivencia","Atuar","Discurso",
    "Intimidar","Mentir","Seducao","ResistenciaCansaco",
    "ResistirVeneno","SegurarFolego","SuporteFrioCalor"
}

for _, nome in ipairs(pericias) do
    local total = n(sheet[nome .. "1"]) + n(sheet[nome .. "2"]) + n(sheet["PotionBonus" .. nome])

    local ativo = sheet[nome .. "_ativo"]
    if ativo == 1 or ativo == true or ativo == "true" then
        total = total + prof
    end

    -- b?nus por HB
    if nome == "AcertoCurtoAlcance" then
        total = total + bonusAcertoCurto

    elseif nome == "AcertoDistancia" then
        total = total + bonusAcertoLongo

    elseif nome == "AcertoMagico" then
        total = total + bonusAcertoMagico

    elseif nome == "ResistenciaMental" then
        total = total + bonusResistenciaMental
    end

    -- penalidade por exaustão
    total = total + n(sheet.Exaustao)

    -- salva resultado final
    sheet[nome .. "Total"] = total
end

    --------------------------------------------------
    -- ATRIBUTO PRINCIPAL
    --------------------------------------------------

    local atributoPrincipal = sheet.AtributoPrincipal
    local valorPrincipal = 0

    if atributoPrincipal == "FOR" then
        valorPrincipal = n(sheet.ForcaTotal)
    elseif atributoPrincipal == "DES" then
        valorPrincipal = n(sheet.DestrezaTotal)
    elseif atributoPrincipal == "CON" then
        valorPrincipal = n(sheet.ConstituicaoTotal)
    elseif atributoPrincipal == "INT" then
        valorPrincipal = n(sheet.InteligenciaTotal)
    elseif atributoPrincipal == "SAB" then
        valorPrincipal = n(sheet.SabedoriaTotal)
    elseif atributoPrincipal == "CAR" then
        valorPrincipal = n(sheet.CarismaTotal)
    end

    --------------------------------------------------
    -- BASES
    --------------------------------------------------

    local rank = RankDB and RankDB[sheet.Rank] or {hp = 0, pp = 0, atributos = 0}
    local classe = classeNormalizada(sheet.Classe)
    local classBonus = ClassHP and ClassHP[classe] or 0
    local AtributosRank = rank.atributos
    local AtributosNivel = 0

    if level >= 4 then AtributosNivel = AtributosNivel + 3 end
    if level >= 7 then AtributosNivel = AtributosNivel + 3 end
    if level >= 9 then AtributosNivel = AtributosNivel + 3 end
    if level >= 11 then AtributosNivel = AtributosNivel + 3 end
    if level >= 14 then AtributosNivel = AtributosNivel + 3 end
    if level >= 16 then AtributosNivel = AtributosNivel + 3 end
    local bonusPP = 0
    local bonusRD = 0
    local BonusAtributo = 0

    local function temHB(hb)
        return sheet.HB1 == hb
            or sheet.HB2 == hb
            or sheet.HB3 == hb
            or sheet.HB4 == hb
    end

    local bonusHP = 0
    local bonusCA = 0
    

    if temHB("ROBUSTO") then
        bonusHP = bonusHP + (level * 3)
    end
        if temHB("RECUPERACAO_ARCANA") then
        bonusPP = bonusPP + math.min(level, 10)
    end
    
    if temHB("OSSOS_DENSOS") then
        bonusRD = bonusRD + 3
    end

    if temHB("PELE_ENDURECIDA") then
        bonusCA = bonusCA + 1
    end

    if temHB("APRIMORAMENTO_DE_ATRIBUTO") then
        BonusAtributo = BonusAtributo + 3
    end

    

    --------------------------------------------------
    -- RESULTADOS FINAIS
    --------------------------------------------------

    sheet.CaPersonagem = ca + math.floor(valorPrincipal / 2) + 8 + bonusCA + n(skinEquipada and skinEquipada.bonusCA) + n(sheet.PotionBonusCA)
    sheet.RdPersonagem = rd + bonusRD + n(skinEquipada and skinEquipada.bonusRD) + n(sheet.PotionBonusRD)

    sheet.HpPersonagem =
        hp +
        rank.hp +
        (classBonus * level) +
        sheet.ConstituicaoTotal +
        bonusHP +
        n(skinEquipada and skinEquipada.bonusHP) +
        n(sheet.PotionBonusHP)

    sheet.PpPersonagem =
        pp +
        rank.pp +
        (level * 2) +
        bonusPP +
        n(skinEquipada and skinEquipada.bonusPP) +
        n(sheet.PotionBonusPP)

    local gastoAtributos =
    n(sheet.ForcaValor) +
    n(sheet.DestrezaValor) +
    n(sheet.ConstituicaoValor) +
    n(sheet.InteligenciaValor) +
    n(sheet.SabedoriaValor) +
    n(sheet.CarismaValor)

    sheet.PontosRestantes =
    (AtributosRank + AtributosNivel + BonusAtributo)
    - gastoAtributos

    sheet.DanoPersonagem = dano + n(sheet.PotionBonusDano)
    sheet.CuraPersonagem = cura
end


--------------------------------------------------
-- INIT
--------------------------------------------------

function onInit()
    if self and self.sheet then
        recalcularDefesa(self.sheet)
    end
end

]]></script>

<event name="onChange"><![CDATA[
    recalcularDefesa(self.sheet)
]]></event>

</dataLink>





