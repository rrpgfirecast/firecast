    S = 80,
    SS = 80
}

local function durabilidadeMaximaPorRankInventario(rank)
    local r = string.upper(tostring(rank or "E"))
    return durabilidadePorRankInventario[r] or 20
end

local function itemEhArmaInventario(item)
    local tipo = string.lower(tostring(item and item.tipoItem or "")):gsub("^%s*(.-)%s*$", "%1")
    return tipo == "arma"
end

local function itemEhEquipamentoInventario(item)
    local tipo = string.lower(tostring(item and item.tipoItem or "")):gsub("^%s*(.-)%s*$", "%1")
    return tipo == "capacete" or tipo == "peitoral" or tipo == "escudo" or tipo == "bota" or tipo == "calca" or tipo == "calça" or tipo == "arma"
end

local CWNA_SEGUNDOS_POR_PD_INVENTARIO = 12 * 60 * 60

local function CWNA_timestampDurabilidadeInventario(valor)
    local numero = tonumber(valor)
    if numero ~= nil and numero > 100000 then return numero end

    local a, m, d = tostring(valor or ""):match("^(%d+)%-(%d+)%-(%d+)$")
    if a ~= nil then
        return os.time({year=tonumber(a), month=tonumber(m), day=tonumber(d), hour=0, min=0, sec=0})
    end

    return nil
end

local function CWNA_calcularDurabilidadeItemInventario(item)
    if item == nil or not itemEhEquipamentoInventario(item) then return 0, 0 end

    local maximo = tonumber(item.durabilidadeMaxima) or durabilidadeMaximaPorRankInventario(item.RankItem)
    local base = tonumber(item.durabilidadeBaseTempo) or tonumber(item.durabilidade) or maximo
    local dataBase = CWNA_timestampDurabilidadeInventario(item.durabilidadeDataBase)

    if maximo <= 0 then maximo = durabilidadeMaximaPorRankInventario(item.RankItem) end
    if base > maximo then base = maximo end
    if base < 0 then base = 0 end

    local atual = base
    if dataBase ~= nil and not itemEhArmaInventario(item) then
        local agora = os.time()
        local pontosPerdidos = math.floor(math.max(0, agora - dataBase) / CWNA_SEGUNDOS_POR_PD_INVENTARIO)
        atual = math.max(0, math.min(maximo, base - pontosPerdidos))
    end

    item.durabilidadeMaxima = maximo
    item.durabilidade = atual
    item.durabilidadeDisplay = tostring(math.floor(atual))
    item.durabilidadeBaseTempo = base
    item.durabilidadeDataBase = dataBase or ""
    return atual, maximo
end

local function CWNA_fixarDurabilidadeAtualInventario(item, valor)
    if item == nil then return end
    local maximo = tonumber(item.durabilidadeMaxima) or durabilidadeMaximaPorRankInventario(item.RankItem)
    local atual = tonumber(valor) or tonumber(item.durabilidade) or maximo
    if atual > maximo then atual = maximo end
    if atual < 0 then atual = 0 end
    item.durabilidadeMaxima = maximo
    item.durabilidade = atual
    item.durabilidadeDisplay = tostring(math.floor(atual))
    item.durabilidadeBaseTempo = atual
    item.durabilidadeDataBase = os.time()
end

local function garantirDurabilidadeItemInventario(item)
    if item == nil or not itemEhEquipamentoInventario(item) then
        if item ~= nil then
            item.durabilidade = ""
            item.durabilidadeMaxima = ""
            item.durabilidadeDisplay = ""
            item.durabilidadeBaseTempo = ""
            item.durabilidadeDataBase = ""
        end
        return 0, 0
    end

    return CWNA_calcularDurabilidadeItemInventario(item)
end

local function itemEquipamentoQuebradoInventario(item)
    if item == nil or not itemEhEquipamentoInventario(item) then return false end
    local atual = garantirDurabilidadeItemInventario(item)
    return (tonumber(atual) or 0) <= 0
end
