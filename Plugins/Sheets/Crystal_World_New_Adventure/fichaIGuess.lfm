<button text="+" top="520" left="20" width="22" height="22" name="labDesc">

    <event name="onClick">
        local frame=self:findControlByName("popAtributos");
        if frame then frame.visible=not frame.visible; if frame.visible then 
        frame.left=15; frame.top=510; end;
        else showMessage("Ops, bug... Nao encontrei o frame"); end;
    </event>

</button>







</tab>

<tab title="         INVENTÁRIO        .">

    <layout align="client">

        <!-- TAMPA DA JANELA -->
        <image left="20" top="32" width="490" height="542"
               url="Frames/tampa_jhanela.jpg"
               style="stretch"
               animate="true"
               showProgress="false"/>

        <!-- SKIN EQUIPADA -->
        <image field="BonecoSkinEspecial" left="20" top="32" width="490" height="542"
               style="stretch"
               animate="true"
               showProgress="false"
               hitTest="false"/>

        <!-- SKIN ESPECIAL RANK C TESTE - ajuste left/top/width/height aqui.
             O frame corta 4px da direita sem redimensionar a imagem interna. -->
        <frame name="frameBonecoSkinRankCTeste" left="146" top="75" width="246" height="442">
            <image field="BonecoSkinRankCTeste" left="0" top="0" width="250" height="442"
                   style="stretch"
                   animate="true"
                   showProgress="false"
                   hitTest="false"/>
        </frame>

        <!-- SKINS AUTOMATICAS DE RANK -->
        <image field="BonecoSkinRankE" left="20" top="32" width="490" height="542" style="stretch" animate="true" showProgress="false" hitTest="false"/>
        <image field="BonecoSkinRankD" left="20" top="32" width="490" height="542" style="stretch" animate="true" showProgress="false" hitTest="false"/>
        <image field="BonecoSkinRankC" left="19.5" top="32" width="490" height="542" style="stretch" animate="true" showProgress="false" hitTest="false"/>
        <image field="BonecoSkinRankB" left="19" top="36" width="490" height="542" style="stretch" animate="true" showProgress="false" hitTest="false"/>
        <image field="BonecoSkinRankA" left="20" top="32" width="490" height="542" style="stretch" animate="true" showProgress="false" hitTest="false"/>
        <image field="BonecoSkinRankS" left="20" top="32" width="490" height="542" style="stretch" animate="true" showProgress="false" hitTest="false"/>

        <!-- FUNDO -->
        <image align="client" style="stretch" url="Frames/inventario.png" animate="true"/>

        <!-- STATUS -->
        <label field="CaPersonagem" left="792" top="482" width="30"
               fontColor="white" fontStyle="bold" horzTextAlign="center"/>
        <dataLink field="CaPersonagem" defaultValue="0"/>

        <label field="RdPersonagem" left="792" top="524" width="30"
               fontColor="white" fontStyle="bold" horzTextAlign="center"/>
        <dataLink field="RdPersonagem" defaultValue="0"/>

        <!-- BONECO EQUIPADO -->
        <dataLink field="BonecoPeitoral" defaultValue="/Frames/equipes/peitoral_base.png"/>
        <dataLink field="BonecoCapacete" defaultValue="/Frames/equipes/capacete_base.png"/>
        <dataLink field="BonecoBota" defaultValue="/Frames/equipes/bota_base.png"/>
        <dataLink field="BonecoCalca" defaultValue="/Frames/equipes/calca_base.png"/>
