    <dataLink fields="{'LivroReceitasAlquimistaLista','LivroAlqPaginaDupla','LivroAlqReceitaSelecionada','LivroAlqImagemCompendio'}"><event name="onChange"><![CDATA[
        if CWNA_atualizarLivroReceitasAlquimista ~= nil then CWNA_atualizarLivroReceitasAlquimista(sheet) end
        local paginaIndice = tostring(sheet.LivroAlqPaginaDupla or sheet.LivroAlqPagina or 1) == "1"
        for i = 1, 12 do
            local botao = self:findControlByName("LivroAlqBtnItem" .. tostring(i))
            if botao ~= nil then
                botao.visible = paginaIndice and tostring(sheet["LivroAlqItemChave" .. tostring(i)] or "") ~= ""
                botao.enabled = botao.visible
            end
        end
    ]]></event></dataLink>
