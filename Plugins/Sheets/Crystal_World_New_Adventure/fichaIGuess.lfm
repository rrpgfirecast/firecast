    <button name="btnTradeConfirmar" text="CONFIRMAR" left="302" top="532" width="120" height="30"><event name="onClick"><![CDATA[ CWNA_trocaConfirmar(sheet, self) ]]></event></button>
    <button name="btnTradeConcluir" text="CONCLUIR" left="436" top="532" width="120" height="30" enabled="false"><event name="onClick"><![CDATA[ CWNA_trocaConcluir(sheet, self) ]]></event></button>
    <dataLink fields="{'TradeHostConfirmado','TradeConvidadoConfirmado','TradeHostConcluirSolicitado','TradeConvidadoConcluirSolicitado','TradeConcluindo','TradeHostId','TradeConvidadoId','FirebaseCharacterId'}">
        <event name="onChange"><![CDATA[
            local btnConfirmar = self:findControlByName("btnTradeConfirmar")
            local btnConcluir = self:findControlByName("btnTradeConcluir")
            local confirmado = CWNA_trocaMeuLadoConfirmado(sheet)
            if btnConfirmar ~= nil then
                btnConfirmar.text = confirmado and "NÃO CONFIRMAR" or "CONFIRMAR"
                pcall(function() btnConfirmar:setText(confirmado and "NÃO CONFIRMAR" or "CONFIRMAR") end)
            end
            local ambos = tostring(sheet.TradeHostConfirmado or "false") == "true" and tostring(sheet.TradeConvidadoConfirmado or "false") == "true"
            local aguardandoConcluir = CWNA_trocaMeuLadoConcluirSolicitado(sheet) or tostring(sheet.TradeConcluindo or "false") == "true"
            if btnConcluir ~= nil then
                btnConcluir.enabled = ambos and not aguardandoConcluir
                btnConcluir.text = aguardandoConcluir and "AGUARDANDO" or "CONCLUIR"
                pcall(function() btnConcluir:setEnabled(ambos and not aguardandoConcluir) end)
                pcall(function() btnConcluir:setText(aguardandoConcluir and "AGUARDANDO" or "CONCLUIR") end)
            end
        ]]></event>
    </dataLink>
    <rectangle left="70" top="500" width="718" height="24" color="#1F2125" strokeColor="#3A3D44" strokeSize="1" xradius="4" yradius="4" cornerType="round" hitTest="false"/>
    <label field="TradeStatusAtual" left="78" top="504" width="702" height="18" fontColor="#FFFFFF" fontSize="11" fontStyle="bold" horzTextAlign="center"/>
    <frame name="frameTrocaQuantidade" left="304" top="206" width="250" height="152" visible="false">
        <rectangle align="client" color="#2B2D31F4" strokeColor="#9A6A2A" strokeSize="2" xradius="8" yradius="8" cornerType="round" hitTest="true"/>
        <rectangle left="8" top="8" width="234" height="28" color="#1F2125" strokeColor="#3A3D44" strokeSize="1" xradius="4" yradius="4" cornerType="round" hitTest="false"/>
        <label text="QUANTIDADE" left="16" top="12" width="218" height="22" fontColor="#F4C56A" fontStyle="bold" horzTextAlign="center"/>
        <label field="TempTrocaQuantidadeNome" left="16" top="38" width="218" height="24" fontColor="#FFFFFF" fontStyle="bold" horzTextAlign="center"/>
        <label text="QTD" left="50" top="74" width="38" height="22" fontColor="#FFFFFF" fontStyle="bold"/>
        <edit field="TempTrocaQuantidadeValor" left="92" top="70" width="64" height="26" type="number" fontColor="#FFFFFF" horzTextAlign="center">
            <event name="onChange"><![CDATA[
                local qtd = math.floor(tonumber(sheet.TempTrocaQuantidadeValor) or 1)
                local max = math.max(1, math.floor(tonumber(sheet.TempTrocaQuantidadeMax) or 1))
                if qtd < 1 then qtd = 1 end
                if qtd > max then qtd = max end
                sheet.TempTrocaQuantidadeValor = tostring(qtd)
            ]]></event>
        </edit>
        <label text="/" left="162" top="74" width="10" height="22" fontColor="#FFFFFF" horzTextAlign="center"/>
