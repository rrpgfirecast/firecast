<script><![CDATA[

--------------------------------------------------
-- UTILS
--------------------------------------------------

local slots = {"Capacete", "Peitoral", "Escudo", "Bota", "Calca", "Arma", "Acessorio1", "Acessorio2", "Acessorio3", "Acessorio4", "Acessorio5"}

local function n(v)
    if v == nil then return 0 end
    local s = tostring(v):gsub(",", ".")
    return tonumber(s) or 0
end

function CWNA_mostrarAvisoPerfil(controle, texto, duracao)
    local ctrl = controle
    local aviso = nil
    local label = nil

    while ctrl ~= nil and aviso == nil do
        if ctrl.findControlByName ~= nil then
            aviso = ctrl:findControlByName("avisoPerfilFicha")
            label = ctrl:findControlByName("lblAvisoPerfilFicha")
        end

        ctrl = ctrl.parent
    end

    if aviso == nil then
        showMessage(texto or "")
        return
    end

    if label ~= nil then
        label.text = texto or ""
    end

    aviso.visible = true
    pcall(function() aviso:bringToFront() end)
    setTimeout(function()
        if aviso ~= nil then
            pcall(function() aviso:bringToFront() end)
        end
    end, 1)

    setTimeout(function()
        if aviso ~= nil then
            aviso.visible = false
        end
    end, duracao or 2600)
end

local function CWNA_gastarPPAtaque(sheet, campoCustoPP, nomeAtaque, controleOrigem)
    local custo = math.max(0, n(sheet[campoCustoPP]))

    if custo <= 0 then
        return true
    end

    local mesa = Firecast.getMesaDe(sheet)

    if mesa == nil then
        return false
    end

    local jogador = mesa.me
    local chat = mesa.activeChat or mesa.chat

    if jogador == nil or chat == nil then
        CWNA_mostrarAvisoPerfil(controleOrigem, "Jogador ou chat nao disponivel.")
        return false
    end

    local ppAtual = nil
    pcall(function()
        ppAtual = jogador:getBarValue(2)
    end)

    if ppAtual == nil then
        CWNA_mostrarAvisoPerfil(controleOrigem, "Barra de PP nao disponivel.")
        return false
    end

    if ppAtual < custo then
        CWNA_mostrarAvisoPerfil(controleOrigem, "PP insuficiente para usar " .. nomeAtaque .. ".")
        return false
    end

    pcall(function()
        chat:enviarMensagem("/PP -" .. custo)
    end)

    return true
end

local function CWNA_danoArmaEquipadaFormula(ficha)
    if ficha == nil then return "" end
    return tostring(ficha["SlotEspecialArma_dano"] or ficha.DanoArma or "")
end

local function CWNA_consumirDurabilidadeArma(ficha, controleOrigem)
    if ficha == nil then return true end
    local uid = tostring(ficha.ItemEquipadoUidArma or ficha.SlotEspecialArma_uidInventario or "")
    local item = procurarItemInventarioPorUid and procurarItemInventarioPorUid(ficha, uid) or nil
    local atual = tonumber(ficha.SlotEspecialArma_durabilidade)
    local maximo = tonumber(ficha.SlotEspecialArma_durabilidadeMaxima)

    if item ~= nil then
        atual = tonumber(item.durabilidade) or atual
        maximo = tonumber(item.durabilidadeMaxima) or maximo
    end

    if atual == nil then return true end
    if atual <= 0 then
        if CWNA_mostrarAvisoPerfil ~= nil then
            CWNA_mostrarAvisoPerfil(controleOrigem, "Arma quebrada. Repare antes de atacar.")
        elseif CWNA_mostrarAvisoInventario ~= nil then
            CWNA_mostrarAvisoInventario(controleOrigem, "Arma quebrada. Repare antes de atacar.")
        else
            showMessage("Arma quebrada. Repare antes de atacar.")
        end
        return false
    end

    atual = math.max(0, atual - 1)
    ficha.SlotEspecialArma_durabilidade = atual
    ficha.SlotEspecialArma_durabilidadeDisplay = tostring(math.floor(atual))
    ficha.SlotEspecialArma_durabilidadeBaseTempo = atual
    ficha.SlotEspecialArma_durabilidadeDataBase = os.time()
    ficha.ItemEquipadoDurabilidadeArma = tostring(math.floor(atual))

    if item ~= nil then
        item.durabilidade = atual
        item.durabilidadeMaxima = maximo or item.durabilidadeMaxima
        item.durabilidadeDisplay = tostring(math.floor(atual))
        item.durabilidadeBaseTempo = atual
        item.durabilidadeDataBase = os.time()
    end

    if atual <= 0 then
        if CWNA_mostrarAvisoPerfil ~= nil then
            CWNA_mostrarAvisoPerfil(controleOrigem, "Sua arma chegou a 0 de durabilidade.")
        end
    end

    return true
end

local function CWNA_formulaDanoComArma(ficha, danoMonstro, danoBase)
    local danoArma = CWNA_danoArmaEquipadaFormula(ficha)
    danoArma = tostring(danoArma or ""):gsub("^%s*(.-)%s*$", "%1")
    if danoArma == "" then danoArma = "0" end

    local danoExtra = tostring(danoMonstro or "")
    danoExtra = danoExtra:gsub("^%s*(.-)%s*$", "%1")
    if danoExtra == "" then danoExtra = "0" end

    return danoArma .. "+" .. danoExtra .. "+" .. tostring(danoBase or 0)
end
