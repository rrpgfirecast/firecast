    <dataLink field="LojaFiltroTipo" defaultValue="TODOS">
        <event name="onChange"><![CDATA[
            local frame = self:findControlByName("frameLojaInventario")
            if frame ~= nil and frame.visible == false then return end
            CWNA_atualizarFiltroLojaVisual(self)
        ]]></event>
    </dataLink>

    <rectangle name="rectFiltroLojaRank" left="546" top="30" width="60" height="36" color="#00000000" strokeColor="#00000000" strokeSize="0" xradius="9" yradius="9" cornerType="round">
        <comboBox field="LojaFiltroRank" align="client"
                  items="{'TODOS','E','D','C','B','A','S','SS'}"
                  values="{'TODOS','E','D','C','B','A','S','SS'}"
                  fontColor="white"
                  horzTextAlign="center"/>
    </rectangle>

    <dataLink field="LojaFiltroRank" defaultValue="TODOS">
        <event name="onChange"><![CDATA[
            local frame = self:findControlByName("frameLojaInventario")
            if frame ~= nil and frame.visible == false then return end
            CWNA_definirFiltroLoja(sheet, "rank", sheet.LojaFiltroRank)
        ]]></event>
    </dataLink>

    <frame name="frameLojaPaginaA" left="22" top="79" width="620" height="464" visible="false">
        <recordList name="rclLojaItensA"
                    field="lojaItensPaginaA"
                    templateForm="templateLojaItem"
                    layout="horizontalTiles"
                    align="client"
                    margins="{left=0,right=0,top=0,bottom=0}"/>
    </frame>

    <frame name="frameLojaPaginaB" left="22" top="79" width="620" height="464" visible="false">
        <recordList name="rclLojaItensB"
                    field="lojaItensPaginaB"
                    templateForm="templateLojaItem"
                    layout="horizontalTiles"
                    align="client"
                    margins="{left=0,right=0,top=0,bottom=0}"/>
    </frame>

    <dataLink field="LojaPaginaBufferAtivo" defaultValue="A">
        <event name="onChange"><![CDATA[
            local frameA = self:findControlByName("frameLojaPaginaA")
            local frameB = self:findControlByName("frameLojaPaginaB")
            local ativo = tostring(sheet.LojaPaginaBufferAtivo or "A")

            if frameA ~= nil then frameA.visible = ativo == "A" end
            if frameB ~= nil then frameB.visible = ativo == "B" end
        ]]></event>
    </dataLink>

    <button text="&lt;" left="253" top="528" width="28" height="22">
        <event name="onClick"><![CDATA[
            CWNA_mudarPaginaLoja(sheet, -1)
        ]]></event>
    </button>
    <label field="LojaPaginaTexto" left="286" top="530" width="54" height="18" fontColor="white" fontStyle="bold" horzTextAlign="center"/>
    <image left="555" top="528" width="24" height="24" url="Frames/Download.png" style="stretch" hitTest="false"/>
    <button name="btnImportarLojaPrincipal" text="" left="555" top="528" width="24" height="24" opacity="0">
        <event name="onClick"><![CDATA[
            CWNA_importarLojaJson(sheet, self)
        ]]></event>
    </button>
    <image left="583" top="528" width="24" height="24" url="Frames/upload.png" style="stretch" hitTest="false"/>
    <button name="btnExportarLojaPrincipal" text="" left="583" top="528" width="24" height="24" opacity="0">
        <event name="onClick"><![CDATA[
            CWNA_exportarLojaJson(sheet, self)
        ]]></event>
    </button>
    <button text="&gt;" left="345" top="528" width="28" height="22">
        <event name="onClick"><![CDATA[
            CWNA_mudarPaginaLoja(sheet, 1)
        ]]></event>
    </button>

    <rectangle left="613" top="30" width="238" height="527" color="#2B2D31" strokeColor="#9A6A2A" strokeSize="2" xradius="8" yradius="8" cornerType="round"/>
