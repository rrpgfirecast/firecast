<?xml version="1.0" encoding="UTF-8"?>

<form formType="sheetTemplate" dataType="Alem_do_veu_Hiperion" title="Crystal_world_2.0" name="frmOurFichaCrystalWorld">

<event name="onNodeReady"><![CDATA[
    CWNA_inicializarSlotsInventario(sheet)
    CWNA_sincronizarSlotsEspeciaisInventario(sheet)
    CWNA_atualizarDurabilidadeTempoRealItens(sheet)
    CWNA_iniciarAtualizadorDurabilidadeItens(sheet)
    CWNA_verificarAtualizacaoFicha(sheet, true, false)
    CWNA_atualizarFrameProfissao(sheet)
    CWNA_atualizarBotoesProfissaoInventario(self)
    CWNA_atualizarXpColetor(sheet)
    CWNA_atualizarXpMercador(sheet)
    CWNA_atualizarXpAlquimista(sheet)
    CWNA_trocaInicializarFicha(sheet)
    CWNA_registrarFichaAbertaNoBanco(sheet)
]]></event>


<script><![CDATA[
contador = 0
CWNA_VERSAO_ATUAL = "2.1.1"
CWNA_URL_ATUALIZACAO = "https://github.com/rrpgfirecast/firecast/blob/master/Plugins/Sheets/Crystal_World_New_Adventure/output/Crystal_World_New_Adventure.rpk?raw=true"
CWNA_URL_CHANGELOG = "https://github.com/rrpgfirecast/firecast/blob/master/Plugins/Sheets/Crystal_World_New_Adventure/README.md"
CWNA_ID_PLUGIN_ATUALIZACAO = "Alem_do_veu_Hiperion"
CWNA_Materiais = require("Materiais.lua")
CWNA_Coletor = require("Coletor.lua")
CWNA_Mercador = require("Mercador.lua")
CWNA_Alquimista = require("Alquimista.lua")
CWNA_HB = require("HB.lua")
CWNA_FirebaseTrocas = require("FirebaseTrocas.lua")
CWNA_AutomacaoCliente = require("CWNA_AutomacaoCliente.lua")
CWNA_REGISTRO_ABERTURA_FICHA = CWNA_REGISTRO_ABERTURA_FICHA or {}
function CWNA_trocaAviso(controle, texto)
    if CWNA_mostrarAvisoInventario ~= nil then
        CWNA_mostrarAvisoInventario(controle, texto)
    else
        showMessage(texto)
    end
end

function CWNA_trocaMensagemErro(erro)
    local msg = tostring(erro or "falha")
    local lower = string.lower(msg)
    if lower:find("troca nao encontrada", 1, true) ~= nil
        or lower:find("troca não encontrada", 1, true) ~= nil
        or lower:find("bad request", 1, true) ~= nil then
        return "Sala de troca expirada. Crie uma nova sala."
    end
    return msg
end

function CWNA_trocaFindControl(controle, nome)
    local ctrl = controle
    while ctrl ~= nil do
        if ctrl.findControlByName ~= nil then
            local achado = ctrl:findControlByName(nome)
            if achado ~= nil then return achado end
        end
        ctrl = ctrl.parent
    end
    return nil
end

function CWNA_trocaTrim(valor)
    return tostring(valor or ""):gsub("^%s*(.-)%s*$", "%1")
end

function CWNA_trocaNovoTokenOperacao()
    return tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
end

function CWNA_trocaIniciarOperacao(ficha, controle, chave, mensagem)
    if ficha == nil then return nil end
    if tostring(ficha.TradeOperacaoAtiva or "false") == "true" then
        CWNA_trocaAviso(controle, "Aguarde a operação atual da troca terminar.")
        return nil
    end
    local token = CWNA_trocaNovoTokenOperacao()
    ficha.TradeOperacaoAtiva = "true"
    ficha.TradeOperacaoChave = tostring(chave or "troca")
    ficha.TradeOperacaoToken = token
    if mensagem ~= nil and tostring(mensagem) ~= "" then ficha.TradeStatusAtual = tostring(mensagem) end
    return token
end

function CWNA_trocaFinalizarOperacao(ficha, token)
    if ficha == nil then return end
    if token == nil or tostring(ficha.TradeOperacaoToken or "") == tostring(token or "") then
        ficha.TradeOperacaoAtiva = "false"
        ficha.TradeOperacaoChave = ""
        ficha.TradeOperacaoToken = ""
    end
end

function CWNA_trocaOperacaoAtual(ficha, token)
    return ficha ~= nil and tostring(ficha.TradeOperacaoToken or "") == tostring(token or "")
end

function CWNA_trocaErroEhSalaExpirada(erro)
    local lower = tostring(erro or ""):lower()
    return lower:find("expirada", 1, true) ~= nil
        or lower:find("nao encontrada", 1, true) ~= nil
        or lower:find("não encontrada", 1, true) ~= nil
        or lower:find("codigo de troca nao encontrado", 1, true) ~= nil
        or lower:find("código de troca não encontrado", 1, true) ~= nil
        or lower:find("bad request", 1, true) ~= nil
end

function CWNA_trocaTemSalaAtiva(ficha)
    if ficha == nil then return false end
    local tradeId = CWNA_trocaTrim(ficha.TradeIdAtual)
    if tradeId == "" then return false end
    if CWNA_trocaTrim(ficha.TradeConclusaoAplicadaId) == tradeId then return false end
    local status = CWNA_trocaTrim(ficha.TradeStatusAtual):lower()
    if status == "completed" or status == "cancelled" or status == "troca cancelada" then return false end
    if CWNA_trocaErroEhSalaExpirada(status) then return false end
    return true
end

function CWNA_trocaLimparSalaLocal(ficha, manterCodigoEntrada)
    if ficha == nil then return end
    ficha.TradeAutoSyncAtivo = "false"
    ficha.TradeConclusaoAplicadaId = ""
    ficha.TradeIdAtual = ""
    ficha.TradeCodigoAtual = ""
    if manterCodigoEntrada ~= true then ficha.TradeCodigoEntrada = "" end
    ficha.TradeOuroOferta = "0"
    ficha.TradePrataOferta = "0"
    ficha.TradeHostOuro = "0"
    ficha.TradeHostPrata = "0"
    ficha.TradeConvidadoOuro = "0"
    ficha.TradeConvidadoPrata = "0"
    ficha.TradeOutroOuro = "0"
    ficha.TradeOutroPrata = "0"
    ficha.TradeHostNome = CWNA_FirebaseTrocas ~= nil and CWNA_FirebaseTrocas.characterName(ficha) or ""
    ficha.TradeConvidadoNome = ""
    ficha.TradeHostId = ""
    ficha.TradeConvidadoId = ""
    ficha.TradeHostConfirmado = "false"
    ficha.TradeConvidadoConfirmado = "false"
    ficha.TradeHostConcluirSolicitado = "false"
    ficha.TradeConvidadoConcluirSolicitado = "false"
    ficha.TradeConcluindo = "false"
    CWNA_trocaLimparTodosSlotsLocais(ficha)
    for i = 1, 10 do CWNA_trocaLimparOutroSlotLocal(ficha, i) end
    CWNA_trocaAtualizarChecks(ficha)
end
function CWNA_trocaInicializarFicha(ficha)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    CWNA_FirebaseTrocas.ensureCharacterId(ficha)
    ficha.FirebaseFunctionsUrl = CWNA_FirebaseTrocas.DEFAULT_FUNCTIONS_URL or tostring(ficha.FirebaseFunctionsUrl or "")
    local nome = CWNA_FirebaseTrocas.characterName(ficha)
    ficha.FirebasePlayerName = CWNA_FirebaseTrocas.playerName(ficha)
    ficha.TradeMeuNome = nome
    ficha.TradeOuroAtual = tostring(ficha.OuroPersonagem or 0)
    ficha.TradePrataAtual = tostring(ficha.PrataPersonagem or 0)
    if tostring(ficha.TradeOuroOferta or "") == "" then ficha.TradeOuroOferta = "0" end
    if tostring(ficha.TradePrataOferta or "") == "" then ficha.TradePrataOferta = "0" end
end

function CWNA_registrarFichaAbertaNoBanco(ficha)
    if ficha == nil or CWNA_FirebaseTrocas == nil or CWNA_FirebaseTrocas.registerCharacterOpen == nil then return end
    if CWNA_REGISTRO_ABERTURA_FICHA[ficha] == true then return end
    CWNA_REGISTRO_ABERTURA_FICHA[ficha] = true

    CWNA_trocaInicializarFicha(ficha)
    CWNA_FirebaseTrocas.registerCharacterOpen(ficha, function(ok, resposta)
        if ok then
            ficha.FirebaseRegistroAberturaStatus = "ok"
            ficha.FirebaseUltimoRegistroAbertura = os.date("%d/%m/%Y %H:%M:%S")
        else
            ficha.FirebaseRegistroAberturaStatus = "erro: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
        end
    end)
end

function CWNA_trocaAtualizarOfertaOutro(ficha)
    if ficha == nil then return end
    local meuId = tostring(ficha.FirebaseCharacterId or "")
    local souConvidado = meuId ~= "" and meuId == tostring(ficha.TradeConvidadoId or "")
    if souConvidado then
        ficha.TradeOutroOuro = tostring(ficha.TradeHostOuro or 0)
        ficha.TradeOutroPrata = tostring(ficha.TradeHostPrata or 0)
    else
        ficha.TradeOutroOuro = tostring(ficha.TradeConvidadoOuro or 0)
        ficha.TradeOutroPrata = tostring(ficha.TradeConvidadoPrata or 0)
    end
end
function CWNA_trocaMeuLado(ficha)
    if ficha == nil then return "host" end
    local meuId = tostring(ficha.FirebaseCharacterId or "")
    if meuId ~= "" and meuId == tostring(ficha.TradeConvidadoId or "") then return "guest" end
    return "host"
end

function CWNA_trocaMeuLadoConfirmado(ficha)
    local lado = CWNA_trocaMeuLado(ficha)
    if lado == "guest" then return tostring(ficha.TradeConvidadoConfirmado or "false") == "true" end
    return tostring(ficha.TradeHostConfirmado or "false") == "true"
end


function CWNA_trocaMeuLadoConcluirSolicitado(ficha)
    local lado = CWNA_trocaMeuLado(ficha)
    if lado == "guest" then return tostring(ficha.TradeConvidadoConcluirSolicitado or "false") == "true" end
    return tostring(ficha.TradeHostConcluirSolicitado or "false") == "true"
end
function CWNA_trocaPodeEditarMinhaOferta(ficha, controle)
    if ficha == nil then return false end
    if CWNA_trocaMeuLadoConfirmado(ficha) then
        CWNA_trocaAviso(controle, "Sua oferta esta confirmada. Clique em NÃO CONFIRMAR para alterar.")
        ficha.TradeStatusAtual = "oferta confirmada; alteracoes bloqueadas"
        return false
    end
    if tostring(ficha.TradeHostConfirmado or "false") == "true" or tostring(ficha.TradeConvidadoConfirmado or "false") == "true" then
        CWNA_trocaAviso(controle, "Existe uma oferta confirmada. Aguarde desconfirmar para alterar.")
        ficha.TradeStatusAtual = "alteracoes bloqueadas por confirmacao"
        return false
    end
    return true
end
function CWNA_trocaAplicarResposta(ficha, resposta)
    if ficha == nil or resposta == nil then return end
    if resposta.tradeId ~= nil and resposta.tradeId ~= "" then ficha.TradeIdAtual = resposta.tradeId end
    if resposta.code ~= nil and resposta.code ~= "" then ficha.TradeCodigoAtual = resposta.code end
    if resposta.status ~= nil and resposta.status ~= "" then ficha.TradeStatusAtual = resposta.status end
    if resposta.hostName ~= nil then ficha.TradeHostNome = resposta.hostName end
    if resposta.guestName ~= nil then ficha.TradeConvidadoNome = resposta.guestName end
    if resposta.hostCharacterId ~= nil then ficha.TradeHostId = resposta.hostCharacterId end
    if resposta.guestCharacterId ~= nil then ficha.TradeConvidadoId = resposta.guestCharacterId end
    if resposta.hostGold ~= nil then ficha.TradeHostOuro = tostring(resposta.hostGold or 0) end
    if resposta.hostSilver ~= nil then ficha.TradeHostPrata = tostring(resposta.hostSilver or 0) end
    if resposta.guestGold ~= nil then ficha.TradeConvidadoOuro = tostring(resposta.guestGold or 0) end
    if resposta.guestSilver ~= nil then ficha.TradeConvidadoPrata = tostring(resposta.guestSilver or 0) end
    if resposta.hostConfirmed ~= nil then ficha.TradeHostConfirmado = resposta.hostConfirmed and "true" or "false" end
    if resposta.guestConfirmed ~= nil then ficha.TradeConvidadoConfirmado = resposta.guestConfirmed and "true" or "false" end
    if resposta.hostCompleteRequested ~= nil then ficha.TradeHostConcluirSolicitado = resposta.hostCompleteRequested and "true" or "false" end
    if resposta.guestCompleteRequested ~= nil then ficha.TradeConvidadoConcluirSolicitado = resposta.guestCompleteRequested and "true" or "false" end
    CWNA_trocaAtualizarChecks(ficha)
    CWNA_trocaAtualizarOfertaOutro(ficha)
    CWNA_trocaAtualizarSlotsOutro(ficha, resposta)
    CWNA_trocaAtualizarSlotsMeus(ficha, resposta)
end

function CWNA_trocaSincronizarInventario(ficha, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    CWNA_trocaInicializarFicha(ficha)
    ficha.TradeStatusAtual = "sincronizando inventario..."
    CWNA_FirebaseTrocas.syncInventory(ficha, function(ok, resposta)
        if ok then
            ficha.TradeStatusAtual = "inventario sincronizado: " .. tostring(resposta.totalItems or 0) .. " itens"
        else
            ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
            CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
        end
    end)
end

function CWNA_trocaCriar(ficha, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    CWNA_trocaInicializarFicha(ficha)
    if CWNA_trocaTrim(ficha.TradeCodigoEntrada) ~= "" and CWNA_trocaTrim(ficha.TradeIdAtual) == "" then
        CWNA_trocaAviso(controle, "Voce digitou um codigo. Clique em ENTRAR para usar essa sala, ou limpe o codigo para criar outra.")
        return
    end
    if CWNA_trocaTemSalaAtiva(ficha) then
        local tokenVerificar = CWNA_trocaIniciarOperacao(ficha, controle, "verificar", "verificando sala atual...")
        if tokenVerificar == nil then return end
        CWNA_FirebaseTrocas.getTrade(ficha, function(ok, resposta)
            if not CWNA_trocaOperacaoAtual(ficha, tokenVerificar) then return end
            if ok and resposta ~= nil and tostring(resposta.status or "") ~= "completed" and tostring(resposta.status or "") ~= "cancelled" then
                ficha.TradeStatusAtual = "sala atual ainda esta ativa"
                CWNA_trocaAviso(controle, "Voce ja esta em uma sala ativa. Feche/cancele ela antes de criar outra.")
                CWNA_trocaFinalizarOperacao(ficha, tokenVerificar)
                return
            end
            if not ok and not CWNA_trocaErroEhSalaExpirada(resposta and resposta.error or "") then
                ficha.TradeStatusAtual = "erro ao verificar sala atual: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
                CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
                CWNA_trocaFinalizarOperacao(ficha, tokenVerificar)
                return
            end
            CWNA_trocaLimparSalaLocal(ficha, false)
            ficha.TradeStatusAtual = "sala expirada limpa; criando nova troca..."
            CWNA_trocaFinalizarOperacao(ficha, tokenVerificar)
            CWNA_trocaCriar(ficha, controle)
        end)
        return
    end
    local tokenOperacao = CWNA_trocaIniciarOperacao(ficha, controle, "criar", "sincronizando usuario...")
    if tokenOperacao == nil then return end
    CWNA_trocaPararAutoSync(ficha)
    CWNA_trocaLimparTodosSlotsLocais(ficha)
    for i = 1, 10 do CWNA_trocaLimparOutroSlotLocal(ficha, i) end
    ficha.TradeConclusaoAplicadaId = ""
    ficha.TradeIdAtual = ""
    ficha.TradeCodigoAtual = ""
    ficha.TradeOuroOferta = "0"
    ficha.TradePrataOferta = "0"
    ficha.TradeHostNome = CWNA_FirebaseTrocas.characterName(ficha)
    ficha.TradeConvidadoNome = ""
    ficha.TradeHostConfirmado = "false"
    ficha.TradeConvidadoConfirmado = "false"
    ficha.TradeHostConcluirSolicitado = "false"
    ficha.TradeConvidadoConcluirSolicitado = "false"
    ficha.TradeConcluindo = "false"
    CWNA_trocaAtualizarChecks(ficha)
    CWNA_FirebaseTrocas.syncInventory(ficha, function(okSync, respostaSync)
        if not CWNA_trocaOperacaoAtual(ficha, tokenOperacao) then return end
        if not okSync then
            ficha.TradeStatusAtual = "erro: " .. tostring(respostaSync and respostaSync.error or "falha")
            CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
            CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
            return
        end
        ficha.TradeStatusAtual = "criando troca..."
        CWNA_FirebaseTrocas.createTrade(ficha, function(ok, resposta)
            if not CWNA_trocaOperacaoAtual(ficha, tokenOperacao) then return end
            if ok then
                CWNA_trocaAplicarResposta(ficha, resposta)
                CWNA_trocaAtualizarMoedasTopo(ficha, "host")
                ficha.TradeCodigoEntrada = ficha.TradeCodigoAtual
                ficha.TradeStatusAtual = "troca criada"
                CWNA_trocaIniciarAutoSync(ficha, controle)
            else
                ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
                CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
            end
            CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
        end)
    end)
end
function CWNA_trocaEntrar(ficha, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    CWNA_trocaInicializarFicha(ficha)
    local codigo = CWNA_trocaTrim(ficha.TradeCodigoEntrada or ficha.TradeCodigoAtual or "")
    if codigo == "" then CWNA_trocaAviso(controle, "Digite o ID da sala antes de entrar."); return end
    local codigoAtual = CWNA_trocaTrim(ficha.TradeCodigoAtual)
    if CWNA_trocaTemSalaAtiva(ficha) then
        if codigoAtual ~= "" and codigoAtual == codigo then
            CWNA_trocaConsultar(ficha, controle)
        else
            CWNA_trocaAviso(controle, "Voce ja esta em uma sala de troca. Cancele/feche ela antes de entrar em outra.")
        end
        return
    end
    local tokenOperacao = CWNA_trocaIniciarOperacao(ficha, controle, "entrar", "sincronizando usuario...")
    if tokenOperacao == nil then return end
    CWNA_trocaPararAutoSync(ficha)
    CWNA_trocaLimparTodosSlotsLocais(ficha)
    for i = 1, 10 do CWNA_trocaLimparOutroSlotLocal(ficha, i) end
    ficha.TradeConclusaoAplicadaId = ""
    ficha.TradeIdAtual = ""
    ficha.TradeHostConcluirSolicitado = "false"
    ficha.TradeConvidadoConcluirSolicitado = "false"
    ficha.TradeConcluindo = "false"
    ficha.TradeCodigoAtual = codigo
    CWNA_FirebaseTrocas.syncInventory(ficha, function(okSync, respostaSync)
        if not CWNA_trocaOperacaoAtual(ficha, tokenOperacao) then return end
        if not okSync then
            ficha.TradeStatusAtual = "erro: " .. tostring(respostaSync and respostaSync.error or "falha")
            CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
            CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
            return
        end
        ficha.TradeStatusAtual = "entrando na troca..."
        CWNA_FirebaseTrocas.joinTrade(ficha, codigo, function(ok, resposta)
            if not CWNA_trocaOperacaoAtual(ficha, tokenOperacao) then return end
            if ok then
                CWNA_trocaAplicarResposta(ficha, resposta)
                CWNA_trocaAtualizarMoedasTopo(ficha, "guest")
                ficha.TradeStatusAtual = "conectado na troca"
                CWNA_trocaIniciarAutoSync(ficha, controle)
            else
                ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
                CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
                ficha.TradeIdAtual = ""
                ficha.TradeCodigoAtual = ""
            end
            CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
        end)
    end)
end
function CWNA_trocaPararAutoSync(ficha)
    if ficha == nil then return end
    ficha.TradeAutoSyncAtivo = "false"
end

function CWNA_trocaCancelarSalaAtual(ficha)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    local tradeId = tostring(ficha.TradeIdAtual or "")
    if tradeId == "" or tostring(ficha.TradeConclusaoAplicadaId or "") == tradeId then return end
    CWNA_FirebaseTrocas.cancelTrade(ficha, function(ok, resposta) end)
end

function CWNA_trocaAutoSyncTick(ficha, controle, token)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    if tostring(ficha.TradeAutoSyncAtivo or "false") ~= "true" then return end
    if tostring(ficha.TradeAutoSyncToken or "") ~= tostring(token or "") then return end
    if tostring(ficha.TradeIdAtual or "") == "" then return end

    CWNA_FirebaseTrocas.getTrade(ficha, function(ok, resposta)
        if tostring(ficha.TradeAutoSyncAtivo or "false") ~= "true" then return end
        if tostring(ficha.TradeAutoSyncToken or "") ~= tostring(token or "") then return end
        if ok then
            CWNA_trocaAplicarResposta(ficha, resposta)
            if tostring(resposta and resposta.status or "") == "completed" then
                CWNA_trocaAplicarConclusaoLocal(ficha, resposta, controle)
                return
            elseif tostring(resposta and resposta.status or "") == "cancelled" then
                ficha.TradeStatusAtual = "troca cancelada"
                CWNA_trocaPararAutoSync(ficha)
                return
            end
        end
        setTimeout(function()
            CWNA_trocaAutoSyncTick(ficha, controle, token)
        end, 3000)
    end)
end

function CWNA_trocaIniciarAutoSync(ficha, controle)
    if ficha == nil then return end
    if tostring(ficha.TradeIdAtual or "") == "" then return end
    local token = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    ficha.TradeAutoSyncToken = token
    ficha.TradeAutoSyncAtivo = "true"
    setTimeout(function()
        CWNA_trocaAutoSyncTick(ficha, controle, token)
    end, 1000)
end

function CWNA_trocaFecharFrame(ficha, controle)
    if ficha ~= nil and tostring(ficha.TradeOperacaoAtiva or "false") == "true" then
        CWNA_trocaAviso(controle, "Aguarde a operação atual da troca terminar.")
        return
    end
    CWNA_trocaPararAutoSync(ficha)
    CWNA_trocaCancelarSalaAtual(ficha)
    CWNA_trocaLimparSalaLocal(ficha, false)
    local frame = CWNA_trocaFindControl(controle, "frameTrocaInventario")
    if frame ~= nil then frame.visible = false end
end
function CWNA_trocaConsultar(ficha, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    CWNA_trocaInicializarFicha(ficha)
    ficha.TradeStatusAtual = "consultando troca..."
    CWNA_FirebaseTrocas.getTrade(ficha, function(ok, resposta)
        if ok then
            CWNA_trocaAplicarResposta(ficha, resposta)
            if tostring(resposta and resposta.status or "") == "completed" then
                CWNA_trocaAplicarConclusaoLocal(ficha, resposta, controle)
            else
                ficha.TradeStatusAtual = "troca atualizada"
            end
        else
            ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
            CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
        end
    end)
end

function CWNA_trocaCampoOutroSlot(slot, campo)
    return "TradeOutroSlot" .. tostring(slot) .. "_" .. campo
end

function CWNA_trocaLimparOutroSlotLocal(ficha, slot)
    if ficha == nil then return end
    ficha[CWNA_trocaCampoOutroSlot(slot, "nomeItem")] = ""
    ficha[CWNA_trocaCampoOutroSlot(slot, "imagemestilo2")] = ""
    ficha[CWNA_trocaCampoOutroSlot(slot, "textoUpgrade")] = ""
    ficha[CWNA_trocaCampoOutroSlot(slot, "quantidadeDisplay")] = ""
    ficha[CWNA_trocaCampoOutroSlot(slot, "durabilidadeDisplay")] = ""
end

function CWNA_trocaPreencherOutroSlotLocal(ficha, slot, item)
    if ficha == nil or item == nil then return end
    ficha[CWNA_trocaCampoOutroSlot(slot, "nomeItem")] = tostring(item.nomeItem or "")
    ficha[CWNA_trocaCampoOutroSlot(slot, "imagemestilo2")] = tostring(item.imagemestilo2 or "")
    ficha[CWNA_trocaCampoOutroSlot(slot, "textoUpgrade")] = tostring(item.textoUpgrade or "")
    local tipoItemTroca = tostring(item.tipoItem or ""):lower()
    local usaQtdTroca = tostring(item.usaQuantidade or ""):lower()
    local qtd = tostring(item.quantidade or item.quantity or "")
    if usaQtdTroca == "true" or usaQtdTroca == "sim" or tipoItemTroca == "material" or tipoItemTroca == "pocao" or tipoItemTroca == "poção" then
        ficha[CWNA_trocaCampoOutroSlot(slot, "quantidadeDisplay")] = qtd
    else
        ficha[CWNA_trocaCampoOutroSlot(slot, "quantidadeDisplay")] = qtd ~= "" and qtd ~= "1" and qtd or ""
    end
    local pdTroca = tostring(item.durabilidadeDisplay or item.durabilidade or "")
    if pdTroca:match("^%+") ~= nil then pdTroca = tostring(item.durabilidade or "") end
    if pdTroca:match("^%+") ~= nil then pdTroca = "" end
    ficha[CWNA_trocaCampoOutroSlot(slot, "durabilidadeDisplay")] = pdTroca
end

function CWNA_trocaAtualizarSlotsOutro(ficha, resposta)
    if ficha == nil then return end
    for i=1,10 do CWNA_trocaLimparOutroSlotLocal(ficha, i) end
    if resposta == nil then return end
    local meuId = tostring(ficha.FirebaseCharacterId or "")
    local souConvidado = meuId ~= "" and meuId == tostring(ficha.TradeConvidadoId or "")
    local itens = souConvidado and resposta.hostItems or resposta.guestItems
    if type(itens) ~= "table" then return end
    for i=1, math.min(10, #itens) do
        CWNA_trocaPreencherOutroSlotLocal(ficha, i, itens[i])
    end
end
function CWNA_trocaCampoSlot(slot, campo)
    return "TradeMeuSlot" .. tostring(slot) .. "_" .. campo
end

function CWNA_trocaCorRank(rank)
    local r = tostring(rank or ""):upper():gsub("^%s*(.-)%s*$", "%1")
    if r == "SS" then return "#FFD700" end
    if r == "S" then return "#FF4D4D" end
    if r == "A" then return "#FF9F1C" end
    if r == "B" then return "#B15CFF" end
    if r == "C" then return "#4DA3FF" end
    if r == "D" then return "#5DD46F" end
    if r == "E" then return "#BFC3C7" end
    return "#D0D0D0"
end
function CWNA_trocaNumero(valor, padrao)
    local texto = tostring(valor or ""):gsub("%s+", ""):gsub(",", ".")
    return tonumber(texto) or padrao or 0
end

function CWNA_trocaAtualizarChecks(ficha)
    if ficha == nil then return end
    ficha.TradeHostCheck = tostring(ficha.TradeHostConfirmado or "false") == "true" and "CONFIRMADO" or "N?O CONFIRMADO"
    ficha.TradeHostCheckCor = tostring(ficha.TradeHostConfirmado or "false") == "true" and "#35D06F" or "#D84A4A"
    ficha.TradeConvidadoCheck = tostring(ficha.TradeConvidadoConfirmado or "false") == "true" and "CONFIRMADO" or "N?O CONFIRMADO"
    ficha.TradeConvidadoCheckCor = tostring(ficha.TradeConvidadoConfirmado or "false") == "true" and "#35D06F" or "#D84A4A"
end

function CWNA_trocaAtualizarMoedasTopo(ficha, lado)
    if ficha == nil then return end
    ficha.TradeOuroAtual = tostring(ficha.OuroPersonagem or 0)
    ficha.TradePrataAtual = tostring(ficha.PrataPersonagem or 0)
end

function CWNA_trocaLimparSlotLocal(ficha, slot)
    if ficha == nil then return end
    ficha[CWNA_trocaCampoSlot(slot, "uidInventario")] = ""
    ficha[CWNA_trocaCampoSlot(slot, "nomeItem")] = ""
    ficha[CWNA_trocaCampoSlot(slot, "imagemestilo2")] = ""
    ficha[CWNA_trocaCampoSlot(slot, "textoUpgrade")] = ""
    ficha[CWNA_trocaCampoSlot(slot, "quantidadeDisplay")] = ""
    ficha[CWNA_trocaCampoSlot(slot, "durabilidadeDisplay")] = ""
    ficha[CWNA_trocaCampoSlot(slot, "RankItem")] = ""
    ficha[CWNA_trocaCampoSlot(slot, "corRank")] = "#D0D0D0"
end

function CWNA_trocaLimparTodosSlotsLocais(ficha)
    if ficha == nil then return end
    for i=1,10 do CWNA_trocaLimparSlotLocal(ficha, i) end
end

function CWNA_trocaPreencherSlotLocal(ficha, slot, uid, item, quantidade)
    if ficha == nil or item == nil then return end
    ficha[CWNA_trocaCampoSlot(slot, "uidInventario")] = tostring(uid or item.uidInventario or item.itemUid or "")
    ficha[CWNA_trocaCampoSlot(slot, "nomeItem")] = tostring(item.nomeItem or "")
    ficha[CWNA_trocaCampoSlot(slot, "imagemestilo2")] = tostring(item.imagemestilo2 or "")
    ficha[CWNA_trocaCampoSlot(slot, "textoUpgrade")] = tostring(item.textoUpgrade or "")
    local tipoItemTroca = tostring(item.tipoItem or ""):lower()
    local usaQtdTroca = tostring(item.usaQuantidade or ""):lower()
    local qtd = math.max(1, math.floor(CWNA_trocaNumero(quantidade or item.quantidade, 1)))
    if usaQtdTroca == "true" or usaQtdTroca == "sim" or tipoItemTroca == "material" or tipoItemTroca == "pocao" or tipoItemTroca == "poção" then
        ficha[CWNA_trocaCampoSlot(slot, "quantidadeDisplay")] = tostring(qtd)
    else
        ficha[CWNA_trocaCampoSlot(slot, "quantidadeDisplay")] = qtd > 1 and tostring(qtd) or ""
    end
    local pdTroca = tostring(item.durabilidadeDisplay or item.durabilidade or "")
    if pdTroca:match("^%+") ~= nil then pdTroca = tostring(item.durabilidade or "") end
    if pdTroca:match("^%+") ~= nil then pdTroca = "" end
    ficha[CWNA_trocaCampoSlot(slot, "durabilidadeDisplay")] = pdTroca
    ficha[CWNA_trocaCampoSlot(slot, "RankItem")] = tostring(item.RankItem or item.rank or item.Rank or "")
    ficha[CWNA_trocaCampoSlot(slot, "corRank")] = CWNA_trocaCorRank(item.RankItem or item.rank or item.Rank)
end

function CWNA_trocaAtualizarSlotsMeus(ficha, resposta)
    if ficha == nil or resposta == nil then return end
    local meuId = tostring(ficha.FirebaseCharacterId or "")
    local souConvidado = meuId ~= "" and meuId == tostring(ficha.TradeConvidadoId or "")
    local itens = souConvidado and resposta.guestItems or resposta.hostItems
    if type(itens) ~= "table" then return end
    for i=1,10 do CWNA_trocaLimparSlotLocal(ficha, i) end
    for i=1, math.min(10, #itens) do
        local oferta = itens[i] or {}
        local item = oferta.itemSnapshot or oferta.item or oferta
        CWNA_trocaPreencherSlotLocal(ficha, i, item.uidInventario or item.itemUid or oferta.itemUid, item, oferta.quantity or item.quantidade or 1)
    end
end

function CWNA_trocaEnviarItemComQuantidade(ficha, slot, uid, item, quantidade, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    if tostring(ficha.TradeIdAtual or "") == "" then CWNA_trocaAviso(controle, "Crie ou entre em uma sala antes."); return end
    if not CWNA_trocaPodeEditarMinhaOferta(ficha, controle) then return end
    uid = tostring(uid or "")
    local uidAtualSlot = tostring(ficha[CWNA_trocaCampoSlot(slot, "uidInventario")] or "")
    if uidAtualSlot ~= "" and uidAtualSlot ~= uid then
        CWNA_trocaAviso(controle, "Remova o item atual desse slot antes de colocar outro.")
        return
    end
    local tokenOperacao = CWNA_trocaIniciarOperacao(ficha, controle, "item", "enviando item para a oferta...")
    if tokenOperacao == nil then return end
    quantidade = math.max(1, math.floor(CWNA_trocaNumero(quantidade, 1)))
    local qtdMax = math.max(1, math.floor(CWNA_trocaNumero(item and item.quantidade, 1)))
    if quantidade > qtdMax then quantidade = qtdMax end

    local okChamada, erroChamada = pcall(function()
        CWNA_FirebaseTrocas.addItemToTrade(ficha, uid, quantidade, function(ok, resposta)
            if not CWNA_trocaOperacaoAtual(ficha, tokenOperacao) then return end
            if ok then
                CWNA_trocaPreencherSlotLocal(ficha, slot, uid, item, quantidade)
                ficha.TradeStatusAtual = "item adicionado na oferta"
                CWNA_FirebaseTrocas.getTrade(ficha, function(okGet, respostaGet)
                    if okGet then CWNA_trocaAplicarResposta(ficha, respostaGet) end
                end)
            else
                if tostring(ficha[CWNA_trocaCampoSlot(slot, "uidInventario")] or "") == uid then CWNA_trocaLimparSlotLocal(ficha, slot) end
                ficha.TradeStatusAtual = "erro ao enviar item: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
                CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
                CWNA_FirebaseTrocas.getTrade(ficha, function(okGet, respostaGet)
                    if okGet then CWNA_trocaAplicarResposta(ficha, respostaGet) end
                end)
            end
            CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
        end)
    end)
    if not okChamada then
        ficha.TradeStatusAtual = "erro ao enviar item: " .. CWNA_trocaMensagemErro(erroChamada)
        CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
        CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
    end
end

function CWNA_trocaAdicionarItem(ficha, slot, uid, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    if tostring(ficha.TradeOperacaoAtiva or "false") == "true" then CWNA_trocaAviso(controle, "Aguarde a operação atual da troca terminar."); return end
    if tostring(ficha.TradeIdAtual or "") == "" then CWNA_trocaAviso(controle, "Crie ou entre em uma sala antes."); return end
    if not CWNA_trocaPodeEditarMinhaOferta(ficha, controle) then return end
    uid = tostring(uid or "")
    local uidAtualSlot = tostring(ficha[CWNA_trocaCampoSlot(slot, "uidInventario")] or "")
    if uidAtualSlot ~= "" and uidAtualSlot ~= uid then
        CWNA_trocaAviso(controle, "Remova o item atual desse slot antes de colocar outro.")
        return
    end
    local item = CWNA_FirebaseTrocas.itemByUid(ficha, uid)
    if item == nil then CWNA_trocaAviso(controle, "Item nao encontrado no inventario."); return end
    for i=1,10 do
        if tostring(ficha[CWNA_trocaCampoSlot(i, "uidInventario")] or "") == uid and i ~= slot then
            CWNA_trocaAviso(controle, "Esse item ja esta na sua oferta.")
            return
        end
    end

    local qtdMax = math.max(1, math.floor(CWNA_trocaNumero(item.quantidade, 1)))
    if qtdMax > 1 then
        ficha.TempTrocaQuantidadeSlot = tostring(slot)
        ficha.TempTrocaQuantidadeUid = uid
        ficha.TempTrocaQuantidadeMax = tostring(qtdMax)
        ficha.TempTrocaQuantidadeValor = "1"
        ficha.TempTrocaQuantidadeNome = tostring(item.nomeItem or "Item")
        local frame = CWNA_trocaFindControl(controle, "frameTrocaQuantidade")
        if frame ~= nil then
            frame.visible = true
            ficha.TradeStatusAtual = "escolha a quantidade de " .. tostring(item.nomeItem or "Item")
            pcall(function() frame:bringToFront() end)
        else
            CWNA_trocaEnviarItemComQuantidade(ficha, slot, uid, item, 1, controle)
        end
    else
        CWNA_trocaEnviarItemComQuantidade(ficha, slot, uid, item, 1, controle)
    end
end

function CWNA_trocaConfirmarQuantidade(ficha, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    if tostring(ficha.TradeOperacaoAtiva or "false") == "true" then CWNA_trocaAviso(controle, "Aguarde a operação atual da troca terminar."); return end
    if not CWNA_trocaPodeEditarMinhaOferta(ficha, controle) then return end
    local slot = math.floor(CWNA_trocaNumero(ficha.TempTrocaQuantidadeSlot, 0))
    local uid = tostring(ficha.TempTrocaQuantidadeUid or "")
    local item = CWNA_FirebaseTrocas.itemByUid(ficha, uid)
    if slot <= 0 or uid == "" or item == nil then
        CWNA_trocaAviso(controle, "Item da troca nao encontrado.")
        return
    end
    local qtdMax = math.max(1, math.floor(CWNA_trocaNumero(ficha.TempTrocaQuantidadeMax, item.quantidade or 1)))
    local qtd = math.max(1, math.floor(CWNA_trocaNumero(ficha.TempTrocaQuantidadeValor, 1)))
    if qtd > qtdMax then qtd = qtdMax end
    local frame = CWNA_trocaFindControl(controle, "frameTrocaQuantidade")
    if frame ~= nil then frame.visible = false end
    CWNA_trocaEnviarItemComQuantidade(ficha, slot, uid, item, qtd, controle)
end

function CWNA_trocaCancelarQuantidade(controle)
    local frame = CWNA_trocaFindControl(controle, "frameTrocaQuantidade")
    if frame ~= nil then frame.visible = false end
end

function CWNA_trocaRemoverItem(ficha, slot, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    if not CWNA_trocaPodeEditarMinhaOferta(ficha, controle) then return end
    local uid = tostring(ficha[CWNA_trocaCampoSlot(slot, "uidInventario")] or "")
    if uid == "" or tostring(ficha.TradeIdAtual or "") == "" then return end
    local tokenOperacao = CWNA_trocaIniciarOperacao(ficha, controle, "remover", "removendo item da oferta...")
    if tokenOperacao == nil then return end
    local okChamada, erroChamada = pcall(function()
        CWNA_FirebaseTrocas.removeItemFromTrade(ficha, uid, function(ok, resposta)
            if not CWNA_trocaOperacaoAtual(ficha, tokenOperacao) then return end
            if ok then
                CWNA_trocaLimparSlotLocal(ficha, slot)
                ficha.TradeStatusAtual = "item removido da oferta"
                CWNA_FirebaseTrocas.getTrade(ficha, function(okGet, respostaGet)
                    if okGet then CWNA_trocaAplicarResposta(ficha, respostaGet) end
                end)
            else
                ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
                CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
            end
            CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
        end)
    end)
    if not okChamada then
        ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(erroChamada)
        CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
        CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
    end
end

function CWNA_trocaEnviarMoedas(ficha, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    if tostring(ficha.TradeIdAtual or "") == "" then CWNA_trocaAviso(controle, "Crie ou entre em uma sala antes."); return end
    if not CWNA_trocaPodeEditarMinhaOferta(ficha, controle) then return end
    ficha.TradeOuroOferta = tostring(math.max(0, math.floor(CWNA_trocaNumero(ficha.TradeOuroOferta, 0))))
    ficha.TradePrataOferta = tostring(math.max(0, math.floor(CWNA_trocaNumero(ficha.TradePrataOferta, 0))))
    local tokenOperacao = CWNA_trocaIniciarOperacao(ficha, controle, "moedas", "enviando moedas para a oferta...")
    if tokenOperacao == nil then return end
    local okChamada, erroChamada = pcall(function()
        CWNA_FirebaseTrocas.setTradeCurrency(ficha, function(ok, resposta)
            if not CWNA_trocaOperacaoAtual(ficha, tokenOperacao) then return end
            if ok then
                CWNA_trocaAplicarResposta(ficha, resposta)
                ficha.TradeStatusAtual = "moedas enviadas para oferta"
            else
                ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
                CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
            end
            CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
        end)
    end)
    if not okChamada then
        ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(erroChamada)
        CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
        CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
    end
end

function CWNA_trocaConfirmar(ficha, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    if tostring(ficha.TradeIdAtual or "") == "" then CWNA_trocaAviso(controle, "Crie ou entre em uma sala antes."); return end
    local tokenOperacao = CWNA_trocaIniciarOperacao(ficha, controle, "confirmar", "enviando confirmacao...")
    if tokenOperacao == nil then return end
    local novoEstado = not CWNA_trocaMeuLadoConfirmado(ficha)
    local okChamada, erroChamada = pcall(function()
        CWNA_FirebaseTrocas.confirmTrade(ficha, novoEstado, function(ok, resposta)
            if not CWNA_trocaOperacaoAtual(ficha, tokenOperacao) then return end
            if ok then
                CWNA_trocaAplicarResposta(ficha, resposta)
                ficha.TradeStatusAtual = novoEstado and "troca confirmada; oferta travada" or "confirmacao removida; oferta liberada"
                CWNA_FirebaseTrocas.getTrade(ficha, function(okGet, respostaGet)
                    if okGet then CWNA_trocaAplicarResposta(ficha, respostaGet) end
                end)
            else
                ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
                CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
            end
            CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
        end)
    end)
    if not okChamada then
        ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(erroChamada)
        CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
        CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
    end
end
function CWNA_trocaConcluir(ficha, controle)
    if ficha == nil or CWNA_FirebaseTrocas == nil then return end
    if tostring(ficha.TradeIdAtual or "") == "" then CWNA_trocaAviso(controle, "Crie ou entre em uma sala antes."); return end
    if tostring(ficha.TradeConcluindo or "false") == "true" then
        CWNA_trocaAviso(controle, "Conclusao ja enviada. Aguarde o outro lado.")
        return
    end
    if CWNA_trocaMeuLadoConcluirSolicitado(ficha) then
        CWNA_trocaAviso(controle, "Voce ja clicou em concluir. Aguarde o outro lado.")
        ficha.TradeStatusAtual = "aguardando o outro lado concluir"
        return
    end
    if tostring(ficha.TradeHostConfirmado or "false") ~= "true" or tostring(ficha.TradeConvidadoConfirmado or "false") ~= "true" then
        CWNA_trocaAviso(controle, "Host e convidado precisam confirmar antes de concluir.")
        ficha.TradeStatusAtual = "aguardando confirmacao dos dois lados"
        CWNA_FirebaseTrocas.getTrade(ficha, function(okGet, respostaGet)
            if okGet then CWNA_trocaAplicarResposta(ficha, respostaGet) end
        end)
        return
    end
    local tokenOperacao = CWNA_trocaIniciarOperacao(ficha, controle, "concluir", "enviando conclusao...")
    if tokenOperacao == nil then return end
    ficha.TradeConcluindo = "true"
    local okChamada, erroChamada = pcall(function()
        CWNA_FirebaseTrocas.completeTrade(ficha, function(ok, resposta)
            if not CWNA_trocaOperacaoAtual(ficha, tokenOperacao) then return end
            ficha.TradeConcluindo = "false"
            if ok then
                CWNA_trocaAplicarResposta(ficha, resposta)
                if resposta ~= nil and resposta.pendingCompletion == true then
                    ficha.TradeStatusAtual = "conclusao enviada; aguardando o outro lado concluir"
                    CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
                    return
                end
                if resposta ~= nil and resposta.alreadyCompleted == true then
                    ficha.TradeStatusAtual = "troca ja foi concluida; aguardando sincronizacao"
                    CWNA_FirebaseTrocas.getTrade(ficha, function(okGet, respostaGet)
                        if okGet and respostaGet ~= nil and respostaGet.status == "completed" then
                            CWNA_trocaAplicarConclusaoLocal(ficha, respostaGet, controle)
                        end
                    end)
                    CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
                    return
                end
                if resposta ~= nil and (resposta.completedNow == true or resposta.status == "completed") then
                    ficha.TradeStatusAtual = "troca concluida; atualizando inventario..."
                    CWNA_trocaAplicarConclusaoLocal(ficha, resposta, controle)
                else
                    ficha.TradeStatusAtual = "conclusao enviada; aguardando atualizacao"
                end
            else
                ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(resposta and resposta.error or "falha")
                CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
            end
            CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
        end)
    end)
    if not okChamada then
        ficha.TradeConcluindo = "false"
        ficha.TradeStatusAtual = "erro: " .. CWNA_trocaMensagemErro(erroChamada)
        CWNA_trocaAviso(controle, ficha.TradeStatusAtual)
        CWNA_trocaFinalizarOperacao(ficha, tokenOperacao)
    end
end
function CWNA_abrirFrameTrocaInventario(controle)
    if controle == nil then return end
    local frame = controle:findControlByName("frameTrocaInventario")
    CWNA_fecharFramesProfissaoInventario(controle)
    local loja = controle:findControlByName("frameLojaInventario")
    if loja ~= nil then loja.visible = false end
    if controle.sheet ~= nil then
        CWNA_setLojaAbertaLocal(controle.sheet, false)
        CWNA_setLojaDestravadaLocal(controle.sheet, false)
        CWNA_trocaInicializarFicha(controle.sheet)
        CWNA_trocaAtualizarMoedasTopo(controle.sheet, "host")
        CWNA_FirebaseTrocas.syncInventory(controle.sheet, function(ok, resposta)
            if ok then
                controle.sheet.TradeStatusAtual = "invent?rio sincronizado com sucesso!"
            else
                controle.sheet.TradeStatusAtual = "erro: " .. tostring(resposta and resposta.error or "falha")
            end
        end)
    end
    if frame ~= nil then
        frame.visible = not frame.visible
        if frame.visible then
            pcall(function() frame:bringToFront() end)
            CWNA_trocaIniciarAutoSync(controle.sheet, controle)
        else
            CWNA_trocaFecharFrame(controle.sheet, controle)
        end
    end
end

function CWNA_atualizarFrameProfissao(ficha)
    if ficha == nil then return end

    local profissao = tostring(ficha.ProfissaoEscolhida or "-")

    if CWNA_Materiais ~= nil and CWNA_Materiais.getFrameProfissao ~= nil then
        ficha.ProfissaoFrameUrl = CWNA_Materiais.getFrameProfissao(profissao)
    elseif profissao == "FERREIRO" then
        ficha.ProfissaoFrameUrl = "Frames/ferreiro.jpg"
    else
        ficha.ProfissaoFrameUrl = "Frames/geral.png"
    end
end
local function CWNA_procurarControleProfissaoInventario(controle, nome)
    local atual = controle

    while atual ~= nil do
        if atual.findControlByName ~= nil then
            local encontrado = atual:findControlByName(nome)
            if encontrado ~= nil then return encontrado end
        end

        atual = atual.parent
    end

    return nil
end

function CWNA_atualizarBotoesProfissaoInventario(controle)
    if controle == nil then return end

    local ficha = controle.sheet or sheet
    local profissao = tostring(ficha and ficha.ProfissaoEscolhida or "-")
    local regras = {
        btnForjaInventario = profissao == "FERREIRO",
        btnCarpintariaInventario = profissao == "CARPINTEIRO",
        btnColetarInventario = profissao == "COLETOR",
        btnMercadorInventario = profissao == "MERCADOR",
        btnAlquimistaInventario = profissao == "ALQUIMISTA"
    }

    for nome, visivel in pairs(regras) do
        local botao = CWNA_procurarControleProfissaoInventario(controle, nome)
        if botao ~= nil then
            botao.visible = visivel
            botao.enabled = visivel
        end
    end
end

function CWNA_fecharFramesProfissaoInventario(controle)
    if controle == nil then return end

    local frames = {"frameForjaInventario", "frameCarpintariaInventario", "frameColetarInventario", "frameMercadorInventario", "frameAlquimistaInventario"}

    for _, nome in ipairs(frames) do
        local frame = CWNA_procurarControleProfissaoInventario(controle, nome)
        if frame ~= nil then frame.visible = false end
    end
end

function CWNA_atualizarModoForjaInventario(controle)
    if controle == nil then return end
    local ficha = controle.sheet or sheet
    local modo = tostring(ficha and ficha.ForjaModo or "APRIMORAR")
    if ficha ~= nil and modo == "" then
        modo = "APRIMORAR"
        ficha.ForjaModo = modo
    end

    local controlesAprimorar = {
        "slotForjaAprimorar1", "slotForjaAprimorar2", "slotForjaAprimorar3",
        "bgForjaSlot1", "bgForjaSlot2", "bgForjaSlot3",
        "imgForjaSlot1", "imgForjaSlot2", "imgForjaSlot3",
        "lblForjaSlot1Upgrade", "lblForjaSlot1UpgradeStrokeL", "lblForjaSlot1UpgradeStrokeR", "lblForjaSlot1UpgradeStrokeT", "lblForjaSlot1UpgradeStrokeB", "lblForjaSlot2Upgrade", "lblForjaSlot2UpgradeStrokeL", "lblForjaSlot2UpgradeStrokeR", "lblForjaSlot2UpgradeStrokeT", "lblForjaSlot2UpgradeStrokeB", "lblForjaSlot1Tipo", "lblForjaSlot2Tipo", "lblForjaSlot3Tipo", "btnTrabalharForjaAprimorar"
    }

    local controlesReparar = {
        "slotForjaReparar1", "slotForjaReparar2",
        "bgForjaRepararSlot1", "bgForjaRepararSlot2",
        "imgForjaRepararSlot1", "imgForjaRepararSlot2",
        "lblForjaRepararSlot1Tipo", "lblForjaRepararSlot2Tipo",
        "lblForjaRepararPD", "lblForjaRepararPDStrokeL", "lblForjaRepararPDStrokeR", "lblForjaRepararPDStrokeT", "lblForjaRepararPDStrokeB",
        "btnTrabalharForjaReparar"
    }
    local controlesForjar = {
        "slotForjaForjar1", "slotForjaForjar2", "slotForjaForjar3",
        "bgForjaForjarSlot1", "bgForjaForjarSlot2", "bgForjaForjarSlot3",
        "imgForjaForjarSlot1", "imgForjaForjarSlot2", "imgForjaForjarSlot3",
        "lblForjaForjarSlot1Tipo", "lblForjaForjarSlot2Tipo", "lblForjaForjarSlot3Tipo",
        "lblForjaForjarSlot1Qtd", "lblForjaForjarSlot1QtdStrokeL", "lblForjaForjarSlot1QtdStrokeR", "lblForjaForjarSlot1QtdStrokeT", "lblForjaForjarSlot1QtdStrokeB",
        "lblForjaForjarSlot2Qtd", "lblForjaForjarSlot2QtdStrokeL", "lblForjaForjarSlot2QtdStrokeR", "lblForjaForjarSlot2QtdStrokeT", "lblForjaForjarSlot2QtdStrokeB",
        "lblForjaForjarSlot3Qtd", "lblForjaForjarSlot3QtdStrokeL", "lblForjaForjarSlot3QtdStrokeR", "lblForjaForjarSlot3QtdStrokeT", "lblForjaForjarSlot3QtdStrokeB",
        "btnTrabalharForjaForjar"
    }

    for _, nome in ipairs(controlesAprimorar) do
        local ctrl = CWNA_procurarControleProfissaoInventario(controle, nome)
        if ctrl ~= nil then ctrl.visible = modo == "APRIMORAR" end
    end

    for _, nome in ipairs(controlesReparar) do
        local ctrl = CWNA_procurarControleProfissaoInventario(controle, nome)
        if ctrl ~= nil then ctrl.visible = modo == "REPARAR" end
    end
    for _, nome in ipairs(controlesForjar) do
        local ctrl = CWNA_procurarControleProfissaoInventario(controle, nome)
        if ctrl ~= nil then ctrl.visible = modo == "FORJAR" end
    end
    local botoesModo = {
        {nome = "rectModoForjaForjar", modo = "FORJAR"},
        {nome = "rectModoForjaAprimorar", modo = "APRIMORAR"},
        {nome = "rectModoForjaReparar", modo = "REPARAR"}
    }

    for _, botao in ipairs(botoesModo) do
        local rect = CWNA_procurarControleProfissaoInventario(controle, botao.nome)
        if rect ~= nil then
            local selecionado = modo == botao.modo
            rect.strokeColor = selecionado and "#FF8C00" or "#00000000"
            rect.strokeSize = selecionado and 2 or 0
        end
    end
end

function CWNA_selecionarModoForja(controle, modo)
    local ficha = controle and controle.sheet or sheet
    if ficha ~= nil then ficha.ForjaModo = modo end
    CWNA_atualizarModoForjaInventario(controle)
end
function CWNA_abrirFrameProfissaoInventario(controle, nomeFrame)
    if controle == nil then return end

    local frame = CWNA_procurarControleProfissaoInventario(controle, nomeFrame)
    if frame == nil then return end

    local abrir = not frame.visible
    CWNA_fecharFramesProfissaoInventario(controle)
    frame.visible = abrir

    if abrir then
        local loja = CWNA_procurarControleProfissaoInventario(controle, "frameLojaInventario")
        if loja ~= nil then loja.visible = false end
        if controle.sheet ~= nil then
            CWNA_setLojaAbertaLocal(controle.sheet, false)
            CWNA_setLojaDestravadaLocal(controle.sheet, false)
        end
        if nomeFrame == "frameForjaInventario" then if CWNA_atualizarXpFerreiro ~= nil then CWNA_atualizarXpFerreiro(controle.sheet) end; CWNA_atualizarModoForjaInventario(controle) end
        if nomeFrame == "frameColetarInventario" and CWNA_atualizarXpColetor ~= nil then CWNA_atualizarXpColetor(controle.sheet) end
        if nomeFrame == "frameMercadorInventario" then if CWNA_atualizarXpMercador ~= nil then CWNA_atualizarXpMercador(controle.sheet) end; if CWNA_validarNegociacaoMercador ~= nil then CWNA_validarNegociacaoMercador(controle.sheet) end end
        if nomeFrame == "frameAlquimistaInventario" and CWNA_atualizarXpAlquimista ~= nil then CWNA_atualizarXpAlquimista(controle.sheet) end
        pcall(function() frame:bringToFront() end)
        setTimeout(function()
            if frame ~= nil and frame.visible then
                pcall(function() frame:bringToFront() end)
            end
        end, 1)
    end
end
local function CWNA_isNewVersion(installed, downloaded)
    local installedVersion = {}
    local installedIndex = 0

    for i in string.gmatch(tostring(installed or "0"), "[^%.]+") do
        installedIndex = installedIndex + 1
        installedVersion[installedIndex] = i
    end

    local downloadedVersion = {}
    local downloadedIndex = 0

    for i in string.gmatch(tostring(downloaded or "0"), "[^%.]+") do
        downloadedIndex = downloadedIndex + 1
        downloadedVersion[downloadedIndex] = i
    end

    for i=1, math.min(installedIndex, downloadedIndex), 1 do
        local installedPart = tonumber(installedVersion[i]) or 0
        local downloadedPart = tonumber(downloadedVersion[i]) or 0

        if installedPart > downloadedPart then
            return false
        elseif installedPart < downloadedPart then
            return true
        end
    end

    return downloadedIndex > installedIndex
end
function CWNA_atualizarVersaoInstalada(ficha)
    local versao = CWNA_VERSAO_ATUAL
    local installed = Firecast.Plugins.getInstalledPlugins()

    for i=1, #installed, 1 do
        if installed[i].moduleId == CWNA_ID_PLUGIN_ATUALIZACAO then
            versao = installed[i].version or versao
            break
        end
    end

    ficha.versionInstalled = "SUA VERSAO: " .. tostring(versao)
    return versao
end

function CWNA_verificarAtualizacaoFicha(ficha, perguntar, avisarSemAtualizacao)
    local versaoInstalada = CWNA_atualizarVersaoInstalada(ficha)
    ficha.versionDownloaded = "VERSAO ATUAL: verificando..."

    Internet.download(
        CWNA_URL_ATUALIZACAO,
        function(stream, contentType)
            local info = nil

            if stream ~= nil then
                info = Firecast.Plugins.getRPKDetails(stream)
            end

            if info == nil then
                ficha.versionDownloaded = "VERSAO ATUAL: indisponivel"
                if avisarSemAtualizacao then
                    CWNA_mostrarAvisoPerfil(self, "Nao foi possivel verificar a atualizacao.", 9000)
                end
                return
            end

            local versaoDisponivel = tostring(info.version)
            local instalada = versaoInstalada
            local installed = Firecast.Plugins.getInstalledPlugins()

            for i=1, #installed, 1 do
                if installed[i].moduleId == info.moduleId then
                    instalada = installed[i].version or instalada
                    break
                end
            end

            if CWNA_isNewVersion(instalada, versaoDisponivel) then
                ficha.versionInstalled = "SUA VERSAO: " .. tostring(instalada)
                ficha.versionDownloaded = "VERSAO ATUAL: " .. versaoDisponivel

                if perguntar then
                    Dialogs.confirmYesNo(
                        "Sua ficha esta desatualizada, deseja baixar a nova versao?",
                        function(confirmado)
                            if confirmado then
                                GUI.openInBrowser(CWNA_URL_ATUALIZACAO)
                            end
                        end
                    )
                end
            else
                ficha.versionInstalled = "SUA VERSAO: " .. tostring(instalada)
                ficha.versionDownloaded = "VERSAO ATUAL: " .. tostring(instalada)

                if avisarSemAtualizacao then
                    CWNA_mostrarAvisoPerfil(self, "Voce ja tem instalada a versao mais recente!")
                end
            end
        end,
        function(errorMsg)
            ficha.versionDownloaded = "VERSAO ATUAL: indisponivel"
            if avisarSemAtualizacao then
                CWNA_mostrarAvisoPerfil(self, "Erro ao verificar atualizacao.", 9000)
            end
        end,
        nil,
        "checkForModification"
    )
end
local function compareMagia(nodeA, nodeB)

    if (nodeA.elemMagia == nodeB.elemMagia) then

        if (nodeA.lvlMagia or 0) > (nodeB.lvlMagia or 0) then
            return 1
        elseif (nodeA.lvlMagia or 0) < (nodeB.lvlMagia or 0) then
            return -1
        else
            return Utils.compareStringPtBr(nodeA.nomeMagia, nodeB.nomeMagia)
        end

    end

    local ordem = {
        Water = 1,
        Air = 2,
        Fire = 3,
        Earth = 4,
        Void = 5,
        Universal = 6
    }

    local a = ordem[nodeA.elemMagia] or 999
    local b = ordem[nodeB.elemMagia] or 999

    if a < b then return -1 end
    if a > b then return 1 end

    return 0
end
]]></script>

