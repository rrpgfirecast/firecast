			<imageCheckBox name="mcapbloodPool_41" left="35" top="187" width="25" height="25" checked="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="mcapbloodPool_42" left="61" top="187" width="25" height="25" checked="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="mcapbloodPool_43" left="87" top="187" width="25" height="25" checked="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="mcapbloodPool_44" left="113" top="187" width="25" height="25" checked="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="mcapbloodPool_45" left="139" top="187" width="25" height="25" checked="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="mcapbloodPool_46" left="165" top="187" width="25" height="25" checked="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="mcapbloodPool_47" left="191" top="187" width="25" height="25" checked="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="mcapbloodPool_48" left="217" top="187" width="25" height="25" checked="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="mcapbloodPool_49" left="243" top="187" width="25" height="25" checked="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
			<imageCheckBox name="mcapbloodPool_50" left="269" top="187" width="25" height="25" checked="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" opacity="0.30" visible="false"/>
		</layout>

		<!--
			HEALTH is positional now (SPEC T96): row N is the Nth damage box, `health_1`..`_10`.
			The old semantic names (bruised/hurt/injured/...) are gone - they could not express a
			track where the label repeats (four "Bruised" rows at 10 levels), so they are declared
			orphans in SPEC I3 and a sheet saved before this loses its health marks. Requested.

			The labels carry NO text= here: renderHealthTrack() on the root form writes them from
			HEALTH_LEVELS, already translated, and hides the rows past the chosen length. The
			`dyn` name prefix is what keeps the WoD20.6 language traversal off them - it snapshots
			authored English once, and would restore a stale label after a length change (V31).

			Each row is a named layout so the renderer can hide label and mark box together; the
			mark itself is a four-symbol box, see the HealthRow template (SPEC T116).

			height=306 is the TEN-row case on purpose (SPEC V49): the renderer shrinks the box to
			fit the chosen track length, so the file always declares the tallest it can ever be
			and the box-overlap check (V40), which reads this file and not the running sheet,
			keeps measuring the worst case.

			Title is 205 wide, not 280, to leave room for the level combo. That is under the 80%
			the gate treats as a full-width section title, so V27 still holds for this box.
			245px per row because "Wounded (-2)" is "Ferido Gravemente (-2)" in pt (V38 / B17).
		-->
		<layout name="dynHealth_box" left="1015" top="541" width="330" height="325">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<!-- How long the track is moved to the storyteller's box in the 82nd round (SPEC I35,
			     V234): it was never the player's call, and it was the last thing on this sheet
			     held by two widgets on one field. The title spans the whole box now that it no
			     longer shares the row with a combo, so horzTextAlign centres it on the BOX. -->
			<label left="20" top="15" width="290" height="20" text="HEALTH" horzTextAlign="center" anchors="left top right"/>

			<layout name="dynHealth_row1" left="42" top="47" width="246" height="20"><HealthRow num="1"/></layout>
			<layout name="dynHealth_row2" left="42" top="74" width="246" height="20"><HealthRow num="2"/></layout>
			<layout name="dynHealth_row3" left="42" top="101" width="246" height="20"><HealthRow num="3"/></layout>
			<layout name="dynHealth_row4" left="42" top="128" width="246" height="20"><HealthRow num="4"/></layout>
			<layout name="dynHealth_row5" left="42" top="155" width="246" height="20"><HealthRow num="5"/></layout>
			<layout name="dynHealth_row6" left="42" top="182" width="246" height="20"><HealthRow num="6"/></layout>
			<layout name="dynHealth_row7" left="42" top="209" width="246" height="20"><HealthRow num="7"/></layout>
			<layout name="dynHealth_row8" left="42" top="236" width="246" height="20"><HealthRow num="8"/></layout>
			<layout name="dynHealth_row9" left="42" top="263" width="246" height="20"><HealthRow num="9"/></layout>
			<layout name="dynHealth_row10" left="42" top="290" width="246" height="20"><HealthRow num="10"/></layout>
		</layout>

		<!--
			SPEC I176a, T1110 - the Main tab's own tooltip, the twin of WoD20.2's noteTip attribute
			for attribute. Its NAMES are its own: the tabs are <import>ed into ONE form, and every
			named control of every tab is a field of that one root object (SPEC R176) - a second
			noteTip here would overwrite the first. LAST child of the scrollBox, so it paints over
			every box in CONTENT coordinates; the era's box colour at 80%, no outline, no title (SPEC
			V501a, V510a, I177a, I178c).
		-->
		<layout name="specTip" left="0" top="0" width="300" height="60" visible="false" onMouseEnter="noteTipHold(self);" onMouseLeave="noteTipHide(self);">
			<rectangle align="contents" color="black" opacity="0.80" strokeColor="#00000000" hitTest="false"/>
			<label name="dynSpecTip" left="5" top="5" width="276" height="20" fontSize="12" wordWrap="false" autoSize="true" textTrimming="none" onResize="noteTipFit(self, 'specTip', 'dynSpecTip');"/>
		</layout>
	</scrollBox>

	<!--
		The health labels are written by Lua, so they need re-rendering whenever the track length
		or the language changes. Two independent entry points on purpose (SPEC V19 / V33): the
		dataLink covers later edits, onNodeReady covers the sheet simply being opened.
	-->
	<dataLink fields="{'healthLevels', 'language', 'sheetTheme'}" onChange="renderHealthTrack(self, 'dynHealth_'); renderRoadPair(self);"/>

	<!-- The experience box is worked out, not stored (SPEC I11): it follows the one saved
	     number, and every dot on this tab redraws it through the guard. -->
	<dataLink field="xpTotal" onChange="renderXPBoxes(self);"/>

	<!-- A gift writes the stamps, and the ! of its trait stars (SPEC V512, V527c). Watching them
	     covers the grant that happened on ANOTHER client at the table: the field arrives over
	     the NDB, and the ! repaints here too.

	     `xpFree` carries no widget by design - it is Lua-owned, the declared exception to
	     V8 (SPEC I3, B25). -->
	<dataLink field="xpFree" onChange="specBangPaint(self);"/>

	<event name="onShow">
		wodTrace("WoD20.1.onShow");
		renderXPBoxes(self);
		-- Both events, like renderXPBoxes (SPEC V429b, I146g, T962): onNodeReady alone leaves the
		-- ! unpainted whenever the sheet is not bound yet, and showing the tab again is what
		-- catches a speciality undone from the Experience log (SPEC V527c).
		specBangPaint(self);
	</event>

	<event name="onNodeReady">
		renderHealthTrack(self, 'dynHealth_');
		renderRoadPair(self);
		renderXPBoxes(self);
		specBangPaint(self);
	</event>
</form>
