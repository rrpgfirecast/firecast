		<!-- ITEMS / GEAR / EQUIPMENT / TRANSPORTATION / OTHER moved to the Inventory tab
		     (WoD20.8.lfm) with their field names untouched - SPEC T77 / V35. -->

		<!--
			HEALTH and VIRTUES here are MIRRORS, not copies (SPEC T100 / V36): the widgets carry
			the same `field=` as the ones on the Main tab, and the NDB is the single source of
			truth, so editing either side updates both with no Lua involved. SPEC V1 normally
			forbids two input widgets on one field - these are the declared exception, listed
			under ESPELHOS in SPEC I3.

			5th round (SPEC T111): the right column now reads COMBAT TRAITS then HEALTH, and
			VIRTUES left it to sit beside ARMOR. Only left/top/width moved - the three blocks keep
			their file order because the Lua finds widgets by name (dynHealth3_N, ro_<field>_N),
			never by position.
		-->
		<!-- height=325 is the ten-row case; the renderer shrinks it to the chosen track length
		     (SPEC V49), so the file declares the tallest this box can ever be.
		     top=356 opens this box on the same line as ARMOR and VIRTUES - the second row of the
		     tab starts 5 under the first one, which now closes at 351 (SPEC V418c, V298). -->
		<layout name="dynHealth3_box" left="970" top="356" width="320" height="325">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<!-- The track length lives on the storyteller's tab since the 82nd round (SPEC I35,
			     V234). The title spans the box now, so it is centred on the box - and stretches with
			     it, since a vampire's box is as wide as COMBAT TRAITS above it (SPEC I204g). -->
			<label left="20" top="15" width="280" height="20" text="HEALTH" horzTextAlign="center" anchors="left top right"/>

			<layout name="dynHealth3_row1" left="37" top="47" width="246" height="20"><HealthRowMirror num="1"/></layout>
			<layout name="dynHealth3_row2" left="37" top="74" width="246" height="20"><HealthRowMirror num="2"/></layout>
			<layout name="dynHealth3_row3" left="37" top="101" width="246" height="20"><HealthRowMirror num="3"/></layout>
			<layout name="dynHealth3_row4" left="37" top="128" width="246" height="20"><HealthRowMirror num="4"/></layout>
			<layout name="dynHealth3_row5" left="37" top="155" width="246" height="20"><HealthRowMirror num="5"/></layout>
			<layout name="dynHealth3_row6" left="37" top="182" width="246" height="20"><HealthRowMirror num="6"/></layout>
			<layout name="dynHealth3_row7" left="37" top="209" width="246" height="20"><HealthRowMirror num="7"/></layout>
			<layout name="dynHealth3_row8" left="37" top="236" width="246" height="20"><HealthRowMirror num="8"/></layout>
			<layout name="dynHealth3_row9" left="37" top="263" width="246" height="20"><HealthRowMirror num="9"/></layout>
			<layout name="dynHealth3_row10" left="37" top="290" width="246" height="20"><HealthRowMirror num="10"/></layout>
		</layout>

		<!--
			VIRTUES and WILLPOWER are one column between the protection box and HEALTH, and the
			17th batch took ten off their width so the ARMOR picker could have it (SPEC I161a,
			I161b, user 2026-09-07): 325 -> 315, left 640 -> 650, and the band still closes on
			1290 because the ten went straight into the box on their left.

			Their content is CENTRED on the box now, which is the ask in the user's own words.
			The content is the 250px template both boxes carry, so the rows open at 32 and close
			33 short of the right edge: 315 - 250 is 65 and a pixel does not split. That one is
			the closest 315 allows, and it is why V470(a) charges a difference of at most 1 and
			not an equality - 314 would have been exact, and the user chose 10px over 11.
		-->
		<layout name="boxVirtues3" left="650" top="356" width="315" height="126">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="20" top="15" width="275" height="20" text="VIRTUES" horzTextAlign="center"/>

			<layout left="32" top="36" width="250" height="25" >
				<VirtueMirror field="conscience" nome="Conscience"/>
			</layout>
			<layout left="32" top="61" width="250" height="25" >
				<VirtueMirror field="selfControl" nome="Self-Control"/>
			</layout>
			<layout left="32" top="86" width="250" height="25" >
				<VirtueMirror field="courage" nome="Courage"/>
			</layout>
		</layout>

		<!--
			Combat-relevant traits, DISPLAY ONLY (SPEC T101). These dots carry no `field=` at all,
			so they own nothing and cannot be a second owner of anything (SPEC I3 lists them under
			SO-LEITURA, deliberately outside the mirror list). renderCombatTraits() reads the real
			fields and pushes `checked` into them; `autoChange="false"` is what stops a click from
			toggling one - it is an ImageCheckBox property, not the greying-out `enabled=false`,
			so these read as normal dots (sdk/rrpgGUI.lua:776-777,786).

			Attributes show five dots with the first always lit, matching the Attribute template
			where dot 1 is a fixed image and only `_2`..`_5` are real fields.

			NINE for a vampire since the 47th batch (SPEC I190, Q109.8): dots 6..9 and the faded
			twins rocap_*_4..9 are authored hidden, and renderGameMode on the root widens this box
			(VAMP_GEOM) - the title, the line and the rows carry anchors="left top right" and
			stretch with it. Nothing sits to the right to push. Since the 61st batch (user
			2026-10-02, SPEC I204g, V546d) a vampire's names are as wide as the longest of the
			eleven needs and the dots start 2 after them: the root's generator places each row's
			name, dots and twins, and the box is 382.

			A MAGE splits it in two since the 88th batch (user 2026-10-08, SPEC I231a, V572): COMBAT
			ATTRIBUTES (this box, 151 tall, no line) and COMBAT ABILITIES below. The two titles swap
			by visibility - renderGameMode shows one, never writes a text.
		-->
		<layout name="boxCombatTraits" left="970" top="0" width="320" height="351">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label name="lblCombatTraits3" left="20" top="15" width="280" height="20" text="COMBAT TRAITS" horzTextAlign="center" anchors="left top right"/>
			<label name="lblCombatAttrs3" left="20" top="15" width="280" height="20" text="COMBAT ATTRIBUTES" horzTextAlign="center" anchors="left top right" visible="false"/>

			<layout left="35" top="36" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="strength" nome="Strength"/></layout>
			<layout left="35" top="61" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="dexterity" nome="Dexterity"/></layout>
			<layout left="35" top="86" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="stamina" nome="Stamina"/></layout>
			<layout left="35" top="111" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="perception" nome="Perception"/></layout>
			<!-- A MAGE's fifth combat attribute (user 2026-10-08, SPEC I234a, V575a): hidden for anyone else, where it would sit on the line below. -->
			<layout name="roRowWits3" left="35" top="136" width="250" height="25" anchors="left top right" visible="false"><ReadOnlyTrait field="wits" nome="Wits"/></layout>

			<horzLine name="lineCombatTraits3" left="30" top="141" width="260" strokeColor="white" anchors="left top right"/>
		</layout>

		<!-- The seven ability rows in a box of their own (user 2026-10-08, SPEC I231a, V572a), because
		     a mage's COMBAT ABILITIES is a real box - the align="client" backdrop is what carries the
		     era's fill and ornament, and a loose rectangle inside COMBAT TRAITS would carry none.
		     Everyone else sees no box: backdrop and title are hidden and the layout sits exactly where
		     the rows always were (115 + 36 = 151), as wide as COMBAT TRAITS (VAMP_GEOM widens both),
		     so Vampire and Mortal look as before. A mage's is 288 since the 91st batch: 35 + 91 + 2 + 5 x 25 + 35 (SPEC I234f). -->
		<layout name="boxCombatAbils3" left="970" top="115" width="320" height="236">
			<rectangle name="rectCombatAbils3" align="client" color="black" xradius="14" yradius="14" cornerType="innerRound" visible="false"/>
			<label name="lblCombatAbils3" left="20" top="15" width="280" height="20" text="COMBAT ABILITIES" horzTextAlign="center" anchors="left top right" visible="false"/>

			<layout left="35" top="36" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="alertness" nome="Alertness"/></layout>
			<layout left="35" top="61" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="athletics" nome="Athletics"/></layout>
			<layout left="35" top="86" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="awareness" nome="Awareness"/></layout>
			<layout left="35" top="111" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="brawl" nome="Brawl"/></layout>
			<layout left="35" top="136" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="ranged" nome="Firearms"/></layout>
			<!-- A MAGE's MARTIAL ARTS right after the ranged row (user 2026-10-08, SPEC I234a, Q149.1, V575a): hidden for anyone
			     else, on MELEE's authored spot; for a mage renderGameMode moves MELEE and STEALTH 25 down (their top only). -->
			<layout name="roRowMartialArts3" left="35" top="161" width="250" height="25" anchors="left top right" visible="false"><ReadOnlyTrait field="martialArts" nome="Martial Arts"/></layout>
			<layout name="roRowMelee3" left="35" top="161" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="melee" nome="Melee"/></layout>
			<layout name="roRowStealth3" left="35" top="186" width="250" height="25" anchors="left top right" ><ReadOnlyTrait field="stealth" nome="Stealth"/></layout>
		</layout>
	</scrollBox>

	<!--
		Two entry points, same reason as the Main tab: the dataLink catches later edits, the
		onNodeReady catches the sheet being opened (SPEC V19 / V33).

		TWO links, because they watch different things (SPEC V123). The health track reads the
		track length and the language and nothing else; the mirror reads the traits and the era.
		One link over both lists meant that ticking any of the eighty trait dots re-rendered the
		health track as well - and that render wrote all ten health rows back, which woke
		everything hanging off THEM. That cascade is what froze a saved sheet on open (SPEC B34).
	-->
	<dataLink fields="{'healthLevels', 'language'}" onChange="renderHealthTrack(self, 'dynHealth3_');"/>
	<dataLink fields="{'sheetTheme', 'strength_2', 'strength_3', 'strength_4', 'strength_5', 'dexterity_2', 'dexterity_3', 'dexterity_4', 'dexterity_5', 'stamina_2', 'stamina_3', 'stamina_4', 'stamina_5', 'perception_2', 'perception_3', 'perception_4', 'perception_5', 'alertness_1', 'alertness_2', 'alertness_3', 'alertness_4', 'alertness_5', 'athletics_1', 'athletics_2', 'athletics_3', 'athletics_4', 'athletics_5', 'awareness_1', 'awareness_2', 'awareness_3', 'awareness_4', 'awareness_5', 'brawl_1', 'brawl_2', 'brawl_3', 'brawl_4', 'brawl_5', 'firearms_1', 'firearms_2', 'firearms_3', 'firearms_4', 'firearms_5', 'melee_1', 'melee_2', 'melee_3', 'melee_4', 'melee_5', 'stealth_1', 'stealth_2', 'stealth_3', 'stealth_4', 'stealth_5', 'archery_1', 'archery_2', 'archery_3', 'archery_4', 'archery_5', 'willpower_1', 'willpower_2', 'willpower_3', 'willpower_4', 'willpower_5', 'willpower_6', 'willpower_7', 'willpower_8', 'willpower_9', 'willpower_10', 'conscience_2', 'conscience_3', 'conscience_4', 'conscience_5', 'selfControl_2', 'selfControl_3', 'selfControl_4', 'selfControl_5', 'courage_2', 'courage_3', 'courage_4', 'courage_5', 'strength_6', 'strength_7', 'strength_8', 'strength_9', 'dexterity_6', 'dexterity_7', 'dexterity_8', 'dexterity_9', 'stamina_6', 'stamina_7', 'stamina_8', 'stamina_9', 'perception_6', 'perception_7', 'perception_8', 'perception_9', 'alertness_6', 'alertness_7', 'alertness_8', 'alertness_9', 'athletics_6', 'athletics_7', 'athletics_8', 'athletics_9', 'awareness_6', 'awareness_7', 'awareness_8', 'awareness_9', 'brawl_6', 'brawl_7', 'brawl_8', 'brawl_9', 'melee_6', 'melee_7', 'melee_8', 'melee_9', 'stealth_6', 'stealth_7', 'stealth_8', 'stealth_9', 'firearms_6', 'firearms_7', 'firearms_8', 'firearms_9', 'archery_6', 'archery_7', 'archery_8', 'archery_9', 'wits_2', 'wits_3', 'wits_4', 'wits_5', 'wits_6', 'wits_7', 'wits_8', 'wits_9', 'martialArts_1', 'martialArts_2', 'martialArts_3', 'martialArts_4', 'martialArts_5', 'martialArts_6', 'martialArts_7', 'martialArts_8', 'martialArts_9', 'game', 'generation'}" onChange="renderCombatTraits(self);"/>

	<!-- The twelve picker buttons of this tab (SPEC I157g, I107a2, V455e). A THIRD link and not
	     a row added to either of the two above, for the reason the comment up there gives: the
	     health track and the trait mirror watch different things, and this one watches the
	     twelve slots plus the language. -->
	<dataLink fields="{'language', 'attack_1', 'attack_2', 'attack_3', 'attack_4', 'attack_5', 'attack_6', 'attack_7', 'attack_8', 'attack_9', 'attack_10', 'attack_11', 'armorClass', 'shieldClass'}" onChange="renderCombatButtons(self);"/>

	<event name="onNodeReady">
		renderHealthTrack(self, 'dynHealth3_');
		renderCombatTraits(self);
		renderCombatButtons(self);
	</event>
</form>
