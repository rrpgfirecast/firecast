	<!-- The first paint of THIS tab (SPEC I188f/g). The painters already walk both infixes and their
	     dataLinks live on WoD20.11; these two events cover a sheet whose Ghoul tab never shows. -->
	<event name="onShow">
		renderXPBoxes(self);
		renderDiscButtons(self);
		renderPathButtons(self);
		renderRitualButtons(self);
		renderRevWeakness(self);
		renderVampCaps(self);
		renderCombatTraits(self);
	</event>

	<event name="onNodeReady">
		renderMainPaths(self);
		renderVampCaps(self);
	</event>
</form>
