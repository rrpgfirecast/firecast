			<label name="lblMfCustomNameB" left="520" top="71" width="460" height="20" text="Name" visible="false"/>
			<edit name="edtMfCustomNameB" left="520" top="95" width="460" height="24" visible="false" onKeyDown="escClose(self, event, false);"/>
			<label name="lblMfRevenantB" left="520" top="125" width="460" height="20" text="Revenant" visible="false"/>
			<imageCheckBox name="chkMfRevenantB" left="520" top="147" width="25" height="25" autoChange="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" visible="false" onClick="mfRevenantChange(self);"/>
			<label name="lblMfWeakB" left="520" top="177" width="460" height="20" text="Revenant Weakness" visible="false"/>
			<edit name="edtMfWeakB" left="520" top="199" width="460" height="24" visible="false" onKeyDown="escClose(self, event, false);"/>
			<label name="lblMfLevelB" left="520" top="125" width="460" height="20" text="Ritual Level" visible="false"/>
			<imageCheckBox name="chkMfLvl_1B" left="520" top="147" width="25" height="25" autoChange="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" visible="false" onClick="mfLevelClick(self, 1);"/>
			<imageCheckBox name="chkMfLvl_2B" left="545" top="147" width="25" height="25" autoChange="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" visible="false" onClick="mfLevelClick(self, 2);"/>
			<imageCheckBox name="chkMfLvl_3B" left="570" top="147" width="25" height="25" autoChange="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" visible="false" onClick="mfLevelClick(self, 3);"/>
			<imageCheckBox name="chkMfLvl_4B" left="595" top="147" width="25" height="25" autoChange="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" visible="false" onClick="mfLevelClick(self, 4);"/>
			<imageCheckBox name="chkMfLvl_5B" left="620" top="147" width="25" height="25" autoChange="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" visible="false" onClick="mfLevelClick(self, 5);"/>
			<imageCheckBox name="chkMfLvl_6B" left="645" top="147" width="25" height="25" autoChange="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" visible="false" onClick="mfLevelClick(self, 6);"/>
			<imageCheckBox name="chkMfLvl_7B" left="670" top="147" width="25" height="25" autoChange="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" visible="false" onClick="mfLevelClick(self, 7);"/>
			<imageCheckBox name="chkMfLvl_8B" left="695" top="147" width="25" height="25" autoChange="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" visible="false" onClick="mfLevelClick(self, 8);"/>
			<imageCheckBox name="chkMfLvl_9B" left="720" top="147" width="25" height="25" autoChange="false" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" visible="false" onClick="mfLevelClick(self, 9);"/>
			<label name="lblMfClanDiscB" left="520" top="237" width="460" height="20" text="Clan Disciplines" visible="false"/>
			<button name="dynMfClanDisc_1B" left="520" top="261" width="460" height="24" visible="false" onClick="mfSubOpen(self, 1);"/>
			<button name="dynMfClanDisc_2B" left="520" top="289" width="460" height="24" visible="false" onClick="mfSubOpen(self, 2);"/>
			<button name="dynMfClanDisc_3B" left="520" top="317" width="460" height="24" visible="false" onClick="mfSubOpen(self, 3);"/>
			<!-- The seven cells of a CUSTOM weapon, and they belong to the weapon list ALONE
			     (SPEC I157n, Q77.3, user 2026-09-07 ask 3). The cells on the sheet became
			     read-only in the same batch, so THIS is the only door left for typing one -
			     which is why they live in the pane and not on the tab (SPEC I157k, V460e).
			     Two rows, at the same y the level dots and the Revenant row use: the lists are
			     different, so no two of these groups can ever be lit at once, and a second set
			     of coordinates for one place would be two owners of it (SPEC V135).
			     Born hidden, like every other group in here: the box opens on a book entry far
			     more often than on a custom one, and what is authored is the common case. -->
			<label name="lblMfWpn_rollB" left="520" top="125" width="160" height="20" text="Roll" visible="false"/>
			<edit name="edtMfWpn_rollB" left="520" top="147" width="160" height="24" visible="false" onKeyDown="escClose(self, event, false);"/>
			<label name="lblMfWpn_diffB" left="690" top="125" width="50" height="20" text="Diff." visible="false"/>
			<edit name="edtMfWpn_diffB" left="690" top="147" width="50" height="24" visible="false" onKeyDown="escClose(self, event, false);"/>
			<label name="lblMfWpn_damageB" left="750" top="125" width="130" height="20" text="Damage" visible="false"/>
			<edit name="edtMfWpn_damageB" left="750" top="147" width="130" height="24" visible="false" onKeyDown="escClose(self, event, false);"/>
			<label name="lblMfWpn_rangeB" left="890" top="125" width="90" height="20" text="Range" visible="false"/>
			<edit name="edtMfWpn_rangeB" left="890" top="147" width="90" height="24" visible="false" onKeyDown="escClose(self, event, false);"/>
			<label name="lblMfWpn_rateB" left="520" top="177" width="80" height="20" text="Rate" visible="false"/>
			<edit name="edtMfWpn_rateB" left="520" top="199" width="80" height="24" visible="false" onKeyDown="escClose(self, event, false);"/>
			<label name="lblMfWpn_clipB" left="610" top="177" width="80" height="20" text="Clip" visible="false"/>
			<edit name="edtMfWpn_clipB" left="610" top="199" width="80" height="24" visible="false" onKeyDown="escClose(self, event, false);"/>
			<label name="lblMfWpn_concealB" left="700" top="177" width="280" height="20" text="Conceal" visible="false"/>
			<comboBox name="edtMfWpn_concealB" left="700" top="199" width="280" height="24" visible="false"/>
			<!-- The two cells of a CUSTOM armour (SPEC I157o). One row, so the pane closes one
			     step higher than the weapon one does; the notes are the description editor the
			     pane already has, and mfConfirm writes that text to armorDescription as well. -->
			<label name="lblMfArm_ratingB" left="520" top="125" width="160" height="20" text="Rating" visible="false"/>
			<edit name="edtMfArm_ratingB" left="520" top="147" width="160" height="24" visible="false" onKeyDown="escClose(self, event, false);"/>
			<label name="lblMfArm_penaltyB" left="690" top="125" width="160" height="20" text="Penalty" visible="false"/>
			<edit name="edtMfArm_penaltyB" left="690" top="147" width="160" height="24" visible="false" onKeyDown="escClose(self, event, false);"/>
			<textEditor name="edtMfDescB" left="520" top="71" width="460" height="609" readOnly="true" wordWrap="true" transparent="true" fontSize="12" onKeyDown="escClose(self, event, true);"/>
		</layout>
		</layout>
	</layout>

	<!-- The right-click menu of the pickers (SPEC I260a, R194a). backOpacity 0: the one window that
		leaves what is behind it lit. -->
	<popup name="popMfMenu" width="100" height="30" backOpacity="0" autoScopeNode="false" padding="{top=5,bottom=5,left=5,right=5}">
		<button name="btnMfMenuRemove" align="top" height="20" onClick="mfMenuRemove(self);"/>
	</popup>

	<!--
		The tab switch is driven from HERE, though the checkboxes that feed it live on the
		Storyteller tab (SPEC V95, 28th round). That tab is one of the three this hides, and a
		hidden tab cannot be trusted to run the code that hides its neighbours - that is how a
		fresh sheet came up with all three power tabs on show (SPEC B26).
	-->
	<!--
		Filling Clan/Family fills the four clan Discipline slots (SPEC I37). Watched from HERE
		and not from WoD20.12, where the slots are drawn: that file is inside a managed tab,
		and a sheet whose table never turned Show Ghoul on would keep whatever the last clan
		left behind (SPEC V95, B26).

		'language' too, since T968 (SPEC V430, I148b): renderClanFamilyButton and renderBearing
		translate what they paint. renderClanDisc reads no language and writes nothing when
		nothing changed, so riding along costs it nothing.

		clanFamilyCustomDisc_1..3 too, since T983 (SPEC I153f, V440): a player who reopens the box
		and changes only the trio leaves the NAME alone, so clanFamily never moves and the link
		would never fire. The box would close over four slots that did not change, with nothing
		raised - the silent shape of B58 and B62.

		renderVampCaps since the 73rd batch (SPEC I216e): a mage-ghoul's pool on the Main takes the
		family's ceiling, so the family moves its dots.
	-->
	<dataLink fields="{'language', 'clanFamily', 'clanFamilyCustomDisc_1', 'clanFamilyCustomDisc_2', 'clanFamilyCustomDisc_3'}">
		<event name="onChange">
			renderClanDisc(self);
			renderClanFamilyButton(self);
			renderBearing(self);
			renderVampCaps(self);
		</event>
	</dataLink>

	<!--
		`defaultValue` belongs to dataLink and NOT to the comboBox. Authoring it on the combo is
		accepted by the XML parser and REJECTED by rdk, which exits 1 with an empty message and
		deletes the .rpk - the B19 failure mode, and it cost a file-level bisection to find. The
		six other defaultValues on this sheet all sit on a dataLink; this is the seventh.
		
		It does not WRITE the field (SPEC I51, V12), so a sheet saved before this round still
		arrives with road = nil - renderBearing falls back to Humanity for exactly that reason.
	-->
	<dataLink field="road" defaultValue="Path of Humanity"/>
	<!--
		The road line, watched from HERE for the same reason clanFamily is: the labels are drawn
		on WoD20.1, but what moves them lives in three different places - the family on the
		Disciplines tab, the road combo on Main, and the ten dots beside it. One watcher over all
		twelve fields means no entry can move the rating without the line being recomputed
		(SPEC I99h, V330d).
		
		The ten humanity fields are listed one by one and not by prefix: `fields` takes a literal
		table, and a dot that fell out of the list would go unwatched in silence.

		'language' rides on this link and on the five below it since T968 (SPEC V430, I148b, B156):
		the painters translate what they write and the traversal of WoD20.6 skips dyn* controls
		(SPEC V31), so the link is the only thing that repaints them the moment the language is
		switched. The tabs already had it on their links; the root form had not.
		'game' and 'stShowDisciplines' since the 33rd batch: they decide whether the bearing line
		shows at all (SPEC I178d, V516d).
	-->
	<dataLink fields="{'language', 'road', 'humanity_1', 'humanity_2', 'humanity_3', 'humanity_4', 'humanity_5', 'humanity_6', 'humanity_7', 'humanity_8', 'humanity_9', 'humanity_10', 'game', 'stShowDisciplines'}">
		<event name="onChange">
			renderBearing(self);
		</event>
	</dataLink>

	<!-- What the True Brujah weakness prices off (SPEC I266c): the log is derived, so these move
	     the balance without a click, and nothing else would repaint it. -->
	<dataLink fields="{'clanFamily', 'game', 'road', 'conscienceName', 'selfControlName'}">
		<event name="onChange">
			if not xpQuiet then renderAllXPBoxes(self); xpLedgerRefresh(self); end;
		</event>
	</dataLink>

	<!--
		The twenty-two merit/flaw name buttons carry TEXT and text is not data (SPEC I107a2):
		nothing brings it back when the sheet opens, so one watcher over their fields repaints
		them - and lights or dims the ! note button beside each (SPEC I170g, V500e). Listed one
		by one and not by prefix, for the reason the ten humanity fields are: `fields` takes a
		literal table and a row that fell out of it would go unwatched in silence. It stopped at
		m6/f6 until the 25th batch while the tables ran to m10/f10 (SPEC R170g); V500e reads
		both ends off MERIT_ROWS now.
	-->
	<dataLink fields="{'language', 'merit_m0', 'merit_m1', 'merit_m2', 'merit_m3', 'merit_m4', 'merit_m5', 'merit_m6', 'merit_m7', 'merit_m8', 'merit_m9', 'merit_m10', 'merit_f0', 'merit_f1', 'merit_f2', 'merit_f3', 'merit_f4', 'merit_f5', 'merit_f6', 'merit_f7', 'merit_f8', 'merit_f9', 'merit_f10'}">
		<event name="onChange">
			renderMeritButtons(self);
			renderGameMode(self);
		</event>
	</dataLink>

	<!--
		The twenty-one background name buttons, the same watcher for the same reason (SPEC
		I107a2, I113, T808), and the same ! note buttons (SPEC V500e). It stopped at
		background_16 until the 25th batch - a leftover from when the last five rows were
		typed; BACKGROUND_FREE_ROWS is 0, so every row is a picker and every row is here
		(SPEC R170g).
	-->
	<dataLink fields="{'language', 'background_1', 'background_2', 'background_3', 'background_4', 'background_5', 'background_6', 'background_7', 'background_8', 'background_9', 'background_10', 'background_11', 'background_12', 'background_13', 'background_14', 'background_15', 'background_16', 'background_17', 'background_18', 'background_19', 'background_20', 'background_21'}">
		<event name="onChange">
			renderBgButtons(self);
		</event>
		</dataLink>

	<!--
		The eleven list orders (SPEC I174f, I175b, V508c). Lua-owned - no widget carries them, only
		rowDropCommit writes them - so this watcher is the exception V8 declares (SPEC I3). It is
		what moves the rows when the order changes under an open sheet: another client's drop,
		or a switch to a character with a different order. Tweened, not instant.
	-->
	<dataLink fields="{'orderBackground', 'orderMerit', 'orderFlaw', 'orderPsychic', 'orderNumina', 'orderHedgeRitual', 'orderDisc', 'orderMainPath', 'orderSecPath', 'orderRitual', 'orderAttack'}">
		<event name="onChange">
			rowOrderApply(self, false);
		</event>
	</dataLink>

	<!--
		SPEC I170d, T1075f - the ONE trigger of the column's bars. It watches the ACTIVE node
		(this is the root's scope, so `sheet`): only the active character's dots ever change - a
		bar selects its row before it writes, and mcShared never touches a dot - so repainting
		the active row is enough. The 84 fields are written out, not prefixed, for the reason the
		name watchers above give - fifty blood dots since the 45th batch, and `game`/`generation`
		because they move a vampire's blood maximum (SPEC I188c); `avatar` is the last, so setting the photo on the Main clears
		the row's photo placeholder at once (SPEC I171b). mcBarsSoon DEFERS: a prefix write lights up to twenty fields and
		a dataLink fires once per field, and each repaint walks the whole control tree (SPEC
		R170f), so twenty writes become one repaint (SPEC V498d).
	-->
	<dataLink fields="{'willpower_1', 'willpower_2', 'willpower_3', 'willpower_4', 'willpower_5', 'willpower_6', 'willpower_7', 'willpower_8', 'willpower_9', 'willpower_10', 'willpower_c1', 'willpower_c2', 'willpower_c3', 'willpower_c4', 'willpower_c5', 'willpower_c6', 'willpower_c7', 'willpower_c8', 'willpower_c9', 'willpower_c10', 'bloodPool_1', 'bloodPool_2', 'bloodPool_3', 'bloodPool_4', 'bloodPool_5', 'bloodPool_6', 'bloodPool_7', 'bloodPool_8', 'bloodPool_9', 'bloodPool_10', 'bloodPool_11', 'bloodPool_12', 'bloodPool_13', 'bloodPool_14', 'bloodPool_15', 'bloodPool_16', 'bloodPool_17', 'bloodPool_18', 'bloodPool_19', 'bloodPool_20', 'bloodPool_21', 'bloodPool_22', 'bloodPool_23', 'bloodPool_24', 'bloodPool_25', 'bloodPool_26', 'bloodPool_27', 'bloodPool_28', 'bloodPool_29', 'bloodPool_30', 'bloodPool_31', 'bloodPool_32', 'bloodPool_33', 'bloodPool_34', 'bloodPool_35', 'bloodPool_36', 'bloodPool_37', 'bloodPool_38', 'bloodPool_39', 'bloodPool_40', 'bloodPool_41', 'bloodPool_42', 'bloodPool_43', 'bloodPool_44', 'bloodPool_45', 'bloodPool_46', 'bloodPool_47', 'bloodPool_48', 'bloodPool_49', 'bloodPool_50', 'quint_1', 'quint_2', 'quint_3', 'quint_4', 'quint_5', 'quint_6', 'quint_7', 'quint_8', 'quint_9', 'quint_10', 'clanFamily', 'game', 'generation', 'avatar'}" onChange="mcBarsSoon(self);"/>

	<!--
		SPEC I185e, T1154c - how many health boxes the ACTIVE character's row shows. mcRender
		already reads each row's own n.healthLevels; what went away in the 41st batch is the
		trigger - Health Levels used to be a shared setting, and a change fired mcShared ->
		mcApply -> mcRender. Now it is the character's own, set in the WoD20.10 box on the
		active node, so this link watches the active node (the root's scope, outside every
		dataScopeBox, SPEC V526g) and repaints at once. It also fires on a switch between two
		characters with different tracks; mcRender is idempotent, so that is one repaint more,
		not a wrong one.
	-->
	<dataLink field="healthLevels" onChange="mcRender(self);"/>

		<!--
			Wave 2 of I113e (SPEC T842): the two header buttons. The language-only link that
			sat below it repainted the SPECIALTIES list and left with it in the 44th batch: a
			language change already repaints every ! through applyLanguage and
			renderAbilityLabels (SPEC I187d, V512c, V527c).
		-->
		<dataLink fields="{'language', 'nature', 'demeanor', 'mageAffiliation', 'mageSect'}">
			<event name="onChange">
				renderHeaderButtons(self);
			</event>
		</dataLink>

		<dataLink fields="{'language', 'road', 'conscienceName', 'selfControlName'}">
			<event name="onChange">
				renderVirtueButtons(self);
			</event>
		</dataLink>

	<!--
		renderGameMode and renderVampCaps since the 73rd batch (SPEC I216e, V553f): a MAGE's Show
		Ghoul brings the Main's pool and its ceiling. No vampFlagsOff here - it would turn a mage's
		Show Ghoul back off the moment it went on.
	-->
	<!-- The mage's Quintessence and Paradox (user 2026-10-06, SPEC I219b, V556b): the numbers draw
	     the ring, typed or moved by a click on it. -->
	<dataLink fields="{'qpQuint', 'qpParadox'}" onChange="renderQpWheel(self);"/>

	<!-- The mage's Arete caps the spheres, and the Combat tab's copy shows both (SPEC I221j/k, V560b). -->
	<dataLink fields="{'arete_2', 'arete_3', 'arete_4', 'arete_5', 'arete_6', 'arete_7', 'arete_8', 'arete_9', 'arete_10', 'sphere_correspondence_1', 'sphere_correspondence_2', 'sphere_correspondence_3', 'sphere_correspondence_4', 'sphere_correspondence_5', 'sphere_entropy_1', 'sphere_entropy_2', 'sphere_entropy_3', 'sphere_entropy_4', 'sphere_entropy_5', 'sphere_forces_1', 'sphere_forces_2', 'sphere_forces_3', 'sphere_forces_4', 'sphere_forces_5', 'sphere_life_1', 'sphere_life_2', 'sphere_life_3', 'sphere_life_4', 'sphere_life_5', 'sphere_matter_1', 'sphere_matter_2', 'sphere_matter_3', 'sphere_matter_4', 'sphere_matter_5', 'sphere_mind_1', 'sphere_mind_2', 'sphere_mind_3', 'sphere_mind_4', 'sphere_mind_5', 'sphere_prime_1', 'sphere_prime_2', 'sphere_prime_3', 'sphere_prime_4', 'sphere_prime_5', 'sphere_spirit_1', 'sphere_spirit_2', 'sphere_spirit_3', 'sphere_spirit_4', 'sphere_spirit_5', 'sphere_time_1', 'sphere_time_2', 'sphere_time_3', 'sphere_time_4', 'sphere_time_5'}" onChange="renderSpheres(self);"/>

	<dataLink fields="{'stShowNumina', 'stShowDisciplines'}">
		<event name="onChange">
			applyTabVisibility(self);
			renderGameMode(self);
			renderVampCaps(self);
		</event>
	</dataLink>

	<!--
		The GAME, a choice since the 45th batch (user 2026-10-01, SPEC I188). It opens Vampire and
		closes Ghoul, swaps column three of the Main header, takes Potence off the front of the
		clan Disciplines and moves every ceiling the generation sets. The ability lists answer to
		it too, from WoD20.6, where renderAbilityLabels lives. The generation moves only the
		ceilings, so its link repaints only those.
	-->
	<dataLink field="game">
		<event name="onChange">
			vampFlagsOff();
			applyTabVisibility(self);
			renderGameMode(self);
			renderClanDisc(self);
			renderVampCaps(self);
			seedFoci(self);
		</event>
	</dataLink>

	<dataLink field="generation" onChange="renderVampCaps(self);"/>

	<!--
		Shown again, asked again (SPEC V96). Nothing tells the sheet that its reader's role in
		the room changed - neither `jogador` nor `mesa` publishes an event, they are getters
		only (SPEC R34) - so the single answer taken at load would freeze: a storyteller who
		had opened this sheet as a player came back to it with no Storyteller tab, and the
		checkboxes that could have switched it back are ON that tab (SPEC B27). Leaving the
		sheet and opening it again is the way back.
	-->
	<event name="onShow">
		wodTrace("root.onShow");
		applyTabVisibility(self);
	</event>

	<event name="onNodeReady">
		wodTrace("root.onNodeReady");
		-- Everything seeded here is the sheet writing to itself, so it is written quietly: the
		-- Appearance dot would otherwise put the guard through a full walk of the ledger before
		-- the sheet is even on screen (SPEC V107).
		xpQuiet = true;

		-- Before every painter, here and not in a tab that may never come up (SPEC I263c).
		ritualMigrate();

		-- A sheet saved before the 27th round has nil here and was showing Numina all along,
		-- so the flag is written true once rather than left nil: the renderer already treats
		-- nil as visible (SPEC V89), and this keeps the checkbox from reading unticked beside
		-- a tab that is plainly there.
		if sheet ~= nil and sheet.stShowNumina == nil then setField("stShowNumina", true); end;

		-- ...and a vampire's two flags go off, the seed's own kind of write (SPEC I190k, V536d).
		vampFlagsOff();

		-- Appearance is the one attribute drawn without a fixed first dot, so that a character
		-- can be at zero (SPEC I3). Zero is not the DEFAULT though - a new sheet starts at one
		-- like the other eight (SPEC V104), and only a dot the player switched off keeps it at
		-- zero. nil means nobody has touched it yet; false is a decision and is left alone.
		if sheet ~= nil and sheet.appearance_1 == nil then setField("appearance_1", true); end;

		-- A ghoul opens with ten of twenty (SPEC I29). Seeded once, keyed on nil exactly like the
		-- dot above: nil is "nobody has touched this yet" and false is a decision, so a player who
		-- spends blood down to zero and closes the sheet does not find it refilled on the way back.
		if sheet ~= nil and sheet.bloodPool_1 == nil then
			for i = 1, 10, 1 do setField("bloodPool_" .. i, true); end;
		end;

		-- The domitor is a thirteenth-generation vampire until somebody says otherwise (the
		-- owner's ask of 2026-09-04). The value written is "13" and not "13th": items are what
		-- the box SHOWS and values are what it stores, and a combo handed a value outside its
		-- own values list paints EMPTY without raising a thing (SPEC B91, I144i).
		--
		-- Keyed on nil like the two seeds above, and never on "": the picker authors an empty
		-- item, so "" is a DECISION and re-seeding would hand 13 back to a player who cleared
		-- it on purpose (SPEC V15, V104, I29). This does move GEN_MAX on an old sheet that
		-- never chose one - renderMaxDisc gains a ceiling where it had none - and that is the
		-- change that was asked for, not a side effect (SPEC V420).
		if sheet ~= nil and sheet.dominatorGen == nil then setField("dominatorGen", "13"); end;

		-- A vampire is of the thirteenth generation until somebody says otherwise (user 2026-10-01,
		-- SPEC I188b). Same seed, same key on nil and the same reason as the domitor's above; it
		-- costs a mortal sheet nothing, since only the Vampire header and tab read it.
		if sheet ~= nil and sheet.generation == nil then setField("generation", "13"); end;

		-- T957 renamed the theme's VALUE (SPEC I146b, V52e): a sheet saved on the old key would
		-- fall to the DEFAULT palette by V52 and grow a fifth item in the combo (SPEC C). Rewritten
		-- once, here, and this line is the one place the old spelling is still allowed to exist.
		if sheet ~= nil and sheet.sheetTheme == "Victorian Era" then setField("sheetTheme", "Victorian Age"); end;

		-- A value outside the Game box's three would sit there as nothing the box can show: one
		-- of the four longer names this sheet used to offer, or nothing at all (SPEC V110). The
		-- box is a choice since the 45th batch (SPEC I188a) and the rule did not change with it.
		-- It runs here rather than on the Settings tab because that tab may never be opened -
		-- the same reason V95 moved the tab switch up here.
		if sheet ~= nil then
			local g = sheet.game;

			if g ~= "Vampire" and g ~= "Mortal" and g ~= "Mage" then
				setField("game", "Mortal");
			end;
		end;

		-- Before xpQuiet drops: this can write four names and up to twenty dots on a sheet
		-- that was saved under a clan whose trio has since changed, and every one of those
		-- writes would otherwise walk the ledger on the way in (SPEC B30, B34).
		renderClanDisc(self);

		xpQuiet = false;

		applyTabVisibility(self);

		-- What the GAME decides on screen, at open (SPEC I188b/h): the Main header's column three
		-- and the Vampire tab's ceilings. Both only paint - the fields are read, never written.
		renderGameMode(self);
		renderVampCaps(self);

		-- The mage's wheel at open (user 2026-10-06, SPEC I219b/d): it counts a 75th-batch sheet's
		-- marks into the numbers first, then draws - and paints (SPEC I223a).
		renderQpWheel(self);

		-- The mage's sphere ceiling at open (SPEC I221j): it only paints.
		renderSpheres(self);

		-- A mage's seven first Foci, once (SPEC I223j).
		seedFoci(self);

		-- The font the player last chose, put back on all eight description panes (SPEC I103c,
		-- V334e). One walk, at open, and it writes nothing: the field is READ here and only
		-- fontStep writes it, so this is not the sheet writing to itself (SPEC V107).
		applyDescFont(self);

		-- The fourteen merit/flaw name buttons, repainted from the fields (SPEC I107a2). Same
		-- reason as applyDescFont above it: a button's text is not a field, so nothing restores
		-- it on its own.
		renderMeritButtons(self);

		-- The sixteen background name buttons, same reason (SPEC I107a2, I113, T808).
			renderBgButtons(self);

			-- The eleven lists in the order the player dragged them, at once - no
			-- tween on open (SPEC I174f, V508c). Beside renderBgButtons because it is the same
			-- job: rows the XML authors, placed from fields nothing else restores.
			rowOrderApply(self, true);

			-- Nature and Demeanor, wave 2 of I113e - same reason (SPEC T842). The seven speciality
			-- buttons are NOT painted from here: WoD20.1 already paints them when it opens, and a
			-- second call would be a second owner (V135). The name is left unwritten on purpose -
			-- V164 counts that call by raw text, comments included, which is the V166 trap.
			renderHeaderButtons(self);

			-- The two Virtue pickers, same reason (SPEC I250d).
			renderVirtueButtons(self);

		-- The floor under the reveal (SPEC V167, I15). The theme paint is what normally
		-- lights the sheet, and it is the last load paint there is - but which of this
		-- event, a tab's dataLink and a tab's own onNodeReady runs first is unknown
		-- (SPEC R47), and a paint that throws or never fires would leave the player
		-- staring at nothing. A timer cannot fire early and cannot depend on the paint,
		-- which is exactly the two properties this needs. setTimeout is only
		-- asynchronous with a positive interval (SPEC R44).
		--
		-- mcInit runs before the timer, not after: it restores the last active character
		-- (SPEC Q88.3) and that restore is itself a setNodeObject, which sheetReveal's own
		-- delay should not race (SPEC I169d).
		mcInit(self);

		setTimeout(function() sheetReveal(self); end, 1500);

		-- LAST, after the reveal is armed (SPEC I186g): it needs what mcInit found, and a write
		-- the host refuses to a player who only reads this sheet must not cost the reveal.
		purgeDeleted();

		-- Same place, same reason (SPEC I249e).
		clearRemovedBook();
	</event>
</form>
