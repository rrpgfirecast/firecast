			-- Which hedge paths an affiliation FAVOURS, and it is the same block of the book the
			-- casting attribute comes from - `Favored Attributes:` and `Favored Paths:` are two
			-- lines of one entry (SPEC I67, R105). One Affinity Path is chosen from this list, so
			-- what filters is the FIRST hedge row and not the seventeen (M20 Sorcerer p. 8).
			--
			-- ABSENCE of a key means "filters nothing", never "offers nothing". `Lone Practitioner`
			-- and the empty item of V15 have no entry here on purpose: the unaligned magician picks
			-- from everything (SPEC V271d). A key holding an EMPTY table would be the blank dropdown
			-- of B6 arriving through another door, which is why the gate refuses one.
			--
			-- NORMALISED to the sheet's own spelling, and the normalisation is MEASURED rather than
			-- tidied: the three books write five names outside it (SPEC I67) - `Summon, Binding, and
			-- Warding` and `Summoning/Binding/Warding` -> `Summoning, Binding, and Warding`,
			-- `Shadowcasting` and hedge `Shadow` -> `Shadows`, `Ephemera (Ghosts)` -> `Ephemera`,
			-- `Mana Manipulation` -> `Quintessence Manipulation`, and
			-- `Herbalism` -> `Alchemy`, which M20 Sorcerer p. 18 says in
			-- print it folded into (SPEC R106). A value the numina picker does not carry is a
			-- filter that blanks the whole row.
			--
			-- `Mogen HaLev` carries BOTH of its book lists - the body's and the `Female Auxiliary`
			-- one - because this sheet has no sex field and inventing one to prune three paths is
			-- outside what was asked.
			AFFINITY = {
				["The Ancient Order of The Aeon Rites"] = { "Conjuration", "Divination", "Enchantment", "Summoning, Binding, and Warding" },
				["The Arcanum"] = { "Alchemy", "Conveyance", "Enchantment", "Summoning, Binding, and Warding" },
				["Balamo’ob"] = { "Alchemy", "Healing", "Shapeshifting", "Summoning, Binding, and Warding" },
				["The Children of Osiris"] = { "Alchemy", "Ephemera", "Healing", "Oneiromancy" },
				["The Cult of Isis"] = { "Divination", "Fascination", "Fortune", "Healing" },
				["The Cult of Mercury"] = { "Conjuration", "Conveyance", "Divination", "Fortune" },
				["The Dozen Priests of the Pythian Order"] = { "Divination", "Healing", "Shapeshifting", "Weather Control" },
				["The Fenian"] = { "Fascination", "Shapeshifting", "Weather Control" },
				["Forn Jafnaðr"] = { "Divination", "Enchantment", "Hellfire", "Summoning, Binding, and Warding" },
				["Maison Liban"] = { "Fortune", "Quintessence Manipulation", "Shadows", "Summoning, Binding, and Warding" },
				["Mogen HaLev"] = { "Divination", "Ephemera", "Fortune", "Healing", "Summoning, Binding, and Warding", "Weather Control" },
				["Nebuu-Afef, The Order of The Golden Fly"] = { "Conjuration", "Hellfire", "Shadows", "Shapeshifting" },
				["The Nephite Priesthood"] = { "Divination", "Enchantment", "Hellfire", "Summoning, Binding, and Warding", "Weather Control" },
				["The Seven Thunders"] = { "Divination", "Fortune", "Healing", "Hellfire" },
				["The Silver Portal"] = { "Ephemera", "Fascination", "Oneiromancy", "Shadows" },
				["The Society of Enlightened Altruistic Ideologies (SEAI)"] = { "Alchemy", "Conjuration", "Conveyance", "Enchantment" },
				["The Star Council"] = { "Enchantment", "Healing", "Quintessence Manipulation", "Shadows" },
				["Thal’hun"] = { "Conjuration", "Fortune", "Hellfire", "Quintessence Manipulation" },
				["U.S. Government (Project Twilight)"] = { "Divination", "Fortune", "Hellfire" },
				["Uzoma"] = { "Alchemy", "Healing", "Quintessence Manipulation", "Summoning, Binding, and Warding" },
				["The Society of Leopold"] = { "Via Geniorum", "Via Necromantiae" },
				["Followers of Set"] = { "Fascination", "Illusion", "Shapeshifting" },
				["Giovanni"] = { "Divination", "Shadows", "Summoning, Binding, and Warding" },
			};

			-- The casting Attribute the same book entry favours (SPEC I68, R105). TWENTY keys and
			-- not twenty-three: only the M20 Sorcerer affiliations carry a `Favored Attributes:`
			-- line, always two names. The three that come from the other two books declare no
			-- attribute at all (SPEC R107, R108), so they have no key and open all nine - the same
			-- nil that means "filters nothing" above. Inventing two attributes for them would be
			-- data with no source.
			--
			-- The names are the NINE of PICKER_LIST["hedgeAttr"], in the sheet's own spelling:
			-- `Inteligence` has been the field name since SPEC I3, and correcting it here alone
			-- would break the bijection V264a measures in both directions.
			CASTING_ATTR = {
				["The Ancient Order of The Aeon Rites"] = { "Inteligence", "Wits" },
				["The Arcanum"] = { "Inteligence", "Wits" },
				["Balamo’ob"] = { "Stamina", "Wits" },
				["The Children of Osiris"] = { "Inteligence", "Wits" },
				["The Cult of Isis"] = { "Charisma", "Manipulation" },
				["The Cult of Mercury"] = { "Charisma", "Stamina" },
				["The Dozen Priests of the Pythian Order"] = { "Charisma", "Inteligence" },
				["The Fenian"] = { "Manipulation", "Appearance" },
				["Forn Jafnaðr"] = { "Dexterity", "Wits" },
				["Maison Liban"] = { "Inteligence", "Manipulation" },
				["Mogen HaLev"] = { "Inteligence", "Perception" },
				["Nebuu-Afef, The Order of The Golden Fly"] = { "Strength", "Stamina" },
				["The Nephite Priesthood"] = { "Stamina", "Wits" },
				["The Seven Thunders"] = { "Charisma", "Manipulation" },
				["The Silver Portal"] = { "Charisma", "Perception" },
				["The Society of Enlightened Altruistic Ideologies (SEAI)"] = { "Inteligence", "Manipulation" },
				["The Star Council"] = { "Perception", "Inteligence" },
				["Thal’hun"] = { "Inteligence", "Wits" },
				["U.S. Government (Project Twilight)"] = { "Dexterity", "Wits" },
				["Uzoma"] = { "Charisma", "Wits" },
			};

			-- Which hedge magic PATH each ritual belongs to (SPEC I83b, user 2026-08-26). It is
			-- the table the level filter reads: a ritual is offered only while the path it comes
			-- from stands at its level or above, and a path the sheet does not carry answers zero,
			-- so it opens nothing at all - not even its first level (SPEC I83a).
			--
			-- The LEVEL is not in here. It is read off the item text, `<n>. <name>`, the same
			-- grammar the vampire rituals use and hedgeRitualLevel already reads for the price
			-- (SPEC V269d, V310c). Two sources for one number is what would let the dots on
			-- screen say three while the filter measured four.
			--
			-- ONE path per ritual, a string and not a list. If a book turns out to print a ritual
			-- under two paths (SPEC R114 has that open), the value becomes a list and the read
			-- becomes a max, which is what pathLevel already does for a path with two owners -
			-- three lines, in one place. Writing the list shape now would be flexibility nobody
			-- asked for, on data nobody has read yet.
			--
			-- It opens EMPTY because PICKER_LIST["hedgeRitual"] opens empty (SPEC V269e): the
			-- powers are entered in a round of their own (SPEC T690). This is NOT the dead data
			-- of B55 - that was a table with no READER, and this one is born with its reader in
			-- the same pass (SPEC T688 is atomic for the reason T605 was).
			HEDGE_RITUAL_PATH = {
