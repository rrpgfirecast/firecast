<?xml version="1.0" encoding="UTF-8"?>
<form name="frmWoD20th" formType="sheetTemplate" dataType="AndreOliveira.Styllern.WoD20th" title="WoD 20th" align="client" theme="dark">
	<script>
		<![CDATA[
			-- ONE Lua environment per form INSTANCE (SPEC I168, B169, R168). Firecast opens every
			-- character sheet as its own instance of this form, and the compiler copies this whole
			-- CDATA - the tab scripts included - into the body of constructNew_frmWoD20th(), right
			-- under `local sheet = nil;`. Every `function name()` below is therefore a GLOBAL that
			-- the newest instance overwrites, closing over ITS `sheet`: with two sheets open, every
			-- renderer, price and guard called from the older tab read and wrote the newer character.
			-- The speciality pickers (repainted on show) and the storyteller flags read at click time
			-- (`stFreeBuy`, SPEC B168) were where it showed.
			--
			-- Rebinding _ENV to a fresh table that falls back to _G makes every global this script
			-- writes land in a table of this instance alone, and every closure created after this
			-- line - the event listeners the compiler emits below the script included - looks names
			-- up there first. The SDK globals (gui, NDB, Log, setTimeout, require) still come from _G
			-- through the fallback. Lua 5.4 (Firecast ships lua54x64.dll; setfenv does not exist),
			-- and it MUST be the first statement: a global assigned above it would land in _G and be
			-- shared by every open sheet again (SPEC V487a).
			--
			-- It costs one chunk-scope local (SPEC V347): tabRootOf gave its slot back for it.
			local _ENV = setmetatable({}, { __index = _G });

			-- Every field write this sheet makes to ITSELF goes through here (SPEC V122).
			--
			-- Writing a value that is already there is not free: it wakes every dataLink on
			-- that field and every renderer hanging off them, and those renderers write more
			-- fields. The renderers below run on load and on both switches, so the same value
			-- was being written back dozens of times per open and each write bought a whole
			-- cascade - which is what froze the sheet on a saved character (SPEC B34).
			--
			-- Four lines, in one place, so the gate has one thing to check instead of every
			-- assignment in the file.
			-- ---- PICKER_LIST (SPEC I27, 68th round) ------------------------------------------
			--
			-- Every picker list the sheet offers, declared ONCE, keyed by FIELD ROOT. It used to
			-- live inline in each template's items=/values=, which meant the twenty-five ritual
			-- combos each carried their own copy of the same 284 names - 480,053 bytes of pure
			-- duplication in the compiled .lfm.lua (SPEC R92d).
			--
			-- On the ROOT and not per form (SPEC I27 rule 1): WoD20.1 and WoD20.2 carry no <script> at
			-- all, and four of these lists live in them. The root script is parsed before any
			-- <import>, the same reason the health track sits here.
			--
			-- items and values are ONE list: the authored pair was identical for all eleven
			-- declarations (measured). pickerItems writes values from it and items from it after
			-- the era/language pass, which is what keeps the pair aligned (SPEC V202).
			--
			-- CONSTANT: nothing writes into these tables (SPEC V201). One table_remove here would
			-- poison every combo that shares it, and there is no authored copy left to recover
			-- from - that is what the second leg of V201 forbids.
			PICKER_LIST = {
				-- >>> PICKER_LIST_BEGIN (SPEC V211b - the gate finds this region by MARKER)
				["clan"] = {
					"", "Assamite", "Brujah", "Followers of Set", "Gangrel", "Giovanni", "Lasombra", "Malkavian",
					"Nosferatu", "Ravnos", "Toreador", "Tremere", "Tzimisce", "Ventrue", "Baali", "Blood Brothers",
					"Daughters of Cacophony", "Harbingers of Skulls", "Kiasyd", "Nagaraja", "Salubri", "Samedi",
					"True Brujah", "Ahrimanes", "Anda", "Cappadocians", "Lamia", "Lhiannan", "Noiad", "Assamite Antitribu",
					"Brujah Antitribu", "City Gangrel", "Country Gangrel", "Malkavian Antitribu", "Nosferatu Antitribu",
					"Ravnos Antitribu", "Salubri Antitribu", "Serpents of the Light", "Toreador Antitribu",
					"Tremere Antitribu", "Assamite Sorcerers", "Assamite Viziers", "Daitya", "Tlacique", "Warrior Setites",
					"Gangrel (Marine)", "Lasombra Antitribu", "Dominate Malkavians", "Brahman", "Telyavelic Tremere",
					"Old Clan Tzimisce", "Gargoyles (Modern)", "Gargoyles (Scout)", "Gargoyles (Sentinel)",
					"Gargoyles (Warrior)", "Ventrue Antitribu", "Salubri (Wu Zao / Watchers)", "Angellis Ater", "Maeghar", "Panders", "Caitiff",
					"Children of Osiris",
				},
				-- The revenant families (SPEC R93, I29b). A list of its OWN, not an alias and not an
				-- append: clan and family are two lists because the clan picker is going to be shown
				-- somewhere else WITHOUT the families, and only the ghoul dropdown wants both at once.
				--
				-- No empty item here - the empty one comes from `clan`, which leads the union.
				-- TWO names carry an era, and they split on DIFFERENT axes. Bratovich splits on the
				-- TRIO: Dark Ages has Potence where Modern has Fortitude. Grimaldi splits on the
				-- WEAKNESS, which is the second axis R93 never compared - the trio is the same
				-- Celerity/Dominate/Fortitude in both books, but da p.454 caps the family at eight
				-- blood points and gr p.98 gives it a behavioural flaw with no number in it at all
				-- (SPEC R129, I108b, the user 2026-08-28).
				--
				-- Obertus was re-read on 2026-08-28 (SPEC T786, Q17) and does NOT split by era: the trio
				-- matches in both books, and the weakness diverges only in WHICH Derangement - da p.454
				-- says Obsession, gr p.102 says Obsessive-Compulsive - which this sheet does not model,
				-- because a Derangement here is a box the player types into.
				--
				-- What the re-read DID turn up is a third kind of variant: a LINE inside a family.
				-- gr p.102 - "Obertus revenants, who display signs of the Narov line, should swap
				-- Obfuscate for Dominate." That is a CONDITION and not a free pick, so it is carried as
				-- its own entry rather than as a choice slot: a choice slot would hand Dominate to any
				-- Obertus, which is permission the book does not give. The shape is the one
				-- Gargoyles (Scout)/(Sentinel)/(Warrior) already set (Q21, the user 2026-08-28).
				["family"] = {
					"Basarab", "Bratovich (Dark Ages)", "Bratovitch (Modern)", "D'Habi", "Danislav",
					"Ducheski", "Enrathi", "Grimaldi (Dark Ages)", "Grimaldi (Modern)",
					"Kairouan Brotherhood", "Keskinen",
					"Khavi", "Krevcheski", "Marijava", "Obertus", "Obertus (Narov)", "Oprichniki",
					"Rafastio", "Rossellini",
					"Servants of Anushin-Rawan", "Szantovich", "Vlaszy", "Zantosa",
				},
				-- The morality roster (SPEC I99c, I253). 70 rows, GENERATED from research/road_bearing.tsv,
				-- which is the MEASURED source: the three R rows are what was known before it.
				--
				-- `Humanity` leads and is NOT the empty item - a character without a road IS on Humanity,
				-- so there is no empty road to clear back to (SPEC C, the declared V15 exception).
				--
				-- `values` carries all 70 in every era; only the `items` filter, on the ROAD_ERA axis
				-- further down (SPEC I99c2) - the second axis V24 already declares. Names collide with
				-- other lists ON PURPOSE: `The Path of Blood` is BOTH a road and a Thaumaturgy path,
				-- which is trap 5 of research/README.md. Separate lists in separate places, and the one
				-- .lang key serves both because both read `A Trilha do Sangue`.
				["road"] = {
					"Path of Humanity", "The Path of Blood", "The Path of the Bones", "The Path of Caine", "The Path of Cathari",
					"The Path of the Feral Heart", "The Path of Honorable Accord", "The Path of Lilith",
					"The Path of Metamorphosis", "The Path of Night", "The Path of Paradox",
					"The Path of Power and the Inner Voice", "The Path of Typhon", "The Path of the Hive",
					"The Path of the Scorched Heart", "The Path of Self-Focus", "The Path of Asakku",
					"The Path of Entelechy", "The Path of Ecstasy", "The Path of the Warrior", "Road of the Beast",
					"Road of Humanity", "Road of Kings", "Road of Lilith", "Road of Metamorphosis",
					"Road of Sin", "Road of Bones", "Road of Yasa", "Road of Blood", "Road of Paradox",
					"The Code of Samiel", "Road of the Abyss", "Road of Set", "Path of the Archangel",
					"Road of Angra Mainyu", "Road of Ahura Mazda", "Path of the Hunter", "Path of Journeys",
					"Path of Liberation", "Path of Christianity", "Path of Life/Judaism", "Path of the Prophet/Islam", "Path of Breath",
					"Path of Community", "Path of Illumination", "Path of Chivalry", "Path of Devaraja", "Path of Daena",
					"Path of Thorns", "Path of Veils", "Path of Making", "Path of Pleasure", "Path of the Devil",
					"Path of Screams", "Path of Watchful Gods", "Philosophy of the Beast", "Philosophy of the Divinities",
					"Thought of Dionysus/Bacchus", "Thought of Ares/Mars", "Thought of Hades/Pluto", "Thought of Athena/Minerva",
					"Philosophy of Humanity", "Philosophy of Paradise", "Philosophy of the Western Paradox",
					"Philosophy of the Eastern Paradox", "Philosophy of the Thinker", "Philosophy of the Damned",
					"Philosophy of Destruction", "Philosophy of Blood", "Philosophy of the Serpents",
				},
				-- The two Virtues a Road can replace (SPEC I250a, V593a). No empty first item, the second
				-- exception to V15 after `road`: a character always holds a Virtue, so there is nothing
				-- to remove (SPEC Q162.3). No sheet holding no name means the first item of each.
				["virtue1"] = {
					"Conscience", "Conviction", "Reflection",
				},
				["virtue2"] = {
					"Self-Control", "Instinct", "Wisdom",
				},
				["nature"] = {
					"", "Activist", "Architect", "Autocrat", "Benefactor", "Bon Vivant", "Bravo", "Bureaucrat", "Caregiver",
					"Celebrant", "Chameleon", "Child", "Comedian", "Competitor", "Conformist", "Conniver", "Contrary",
					"Creep Show", "Critic", "Crusader", "Curmudgeon", "Dabbler", "Defender", "Deviant", "Director", "Enigma",
					"Explorer", "Eye of the Storm", "Fanatic", "Follower", "Gallant", "Gambler", "Grifter", "Guru", "Hacker",
					"Idealist", "Innovator", "Jester", "Judge", "Leader", "Loner", "Machine", "Mad Scientist", "Martyr",
					"Masochist", "Mediator", "Mercenary", "Monster", "Optimist", "Pedagogue", "Penitent", "Perfectionist",
					"Philosopher", "Pragmatist", "Prophet", "Rebel", "Rogue", "Sadist", "Samaritan", "Scientist",
					"Sensualist", "Soldier", "Survivor", "Thrill-Seeker", "Traditionalist", "Trendsetter", "Trickster",
					"Tyrant", "Visionary",
				},
				-- No "speciality" list since the 27th batch: the trait picker of the SPECIALTIES box
				-- (gone itself since the 44th, SPEC I187a) left with its rows, and each trait's !
				-- opens its own specialities (SPEC I172g, V148
				-- retired). The fifty names live on in SPEC_TRAIT, which the ! window reads.
				-- Fifty-nine items since T998, which re-measured every source on the ERA axis and
				-- rewrote research/bg_essence.tsv. Until then the list held 47 and deduped by GAME
				-- (SPEC I105b); the user replaced that axis with MEANING (SPEC I105e), so the
				-- suffix now names whichever of era, game or book actually separates the two
				-- readings. Seven names carry one:
				--
				--   Generation   - no dots means 13th generation in V20 p.114, 12th in V20 Dark
				--                  Ages p.181 and 11th in the Classical Age p.156, and each book
				--                  prints its own five rungs.
				--   Resources    - what the dots buy changes with the century: spices, salt, land
				--                  and servants (Classical Age p.157), gold, tithes and taxes
				--                  (Dark Ages p.181), cash, stock and criminal infrastructure
				--                  (V20 p.115), and M20 Victorian Age p.121 prints a ladder of
				--                  its own, Poor through Opulence.
				--   Influence    - the Classical Age ladder IS the cursus honorum and bars anyone
				--                  above one dot from staying a plebeian (p.157); M20 p.316 buys
				--                  social deference among Sleepers instead of political weight,
				--                  rolls as a dice pool, climbs to ten and can be LOST by acting
				--                  badly (SPEC R155); V20 p.114 and Dark Ages p.181 are the same
				--                  generic scale as each other.
				--   Status       - three different social ladders: the Kindred (V20 p.118), the
				--                  Awakened (M20 p.325) and the Society of Leopold (Hunters
				--                  Hunted II p.123).
				--   Library      - Hunters Hunted II p.140 lowers a research difficulty by the
				--                  rating; M20 p.318 is a collection of books.
				--   Rank         - a government agency's chain of command (HH II p.134) against a
				--                  title among the masses (M20 p.321).
				--   Requisitions - equipment points per story (HH II p.134) against the
				--                  Technocracy's materiel chart (M20 p.321).
				--   Totem        - a personal pact with a spirit (M20 p.326) against a PACK trait
				--                  the whole pack pools its points into (W20 p.140).
				--
				-- `Hunters Hunted` is a BOOK label, not a game: HH II is a Vampire-line book about
				-- mortal hunters, so `(Vampire)` would lie (SPEC Q76.1, R145).
				--
				-- Once a name splits, EVERY era with a source gets an item even where two of them
				-- read alike (SPEC I105e(6)) - `Influence (Dark Ages)` and `Influence (Modern
				-- Nights)` each cite their own book, and a single label could not honestly cover
				-- both. Names that do NOT split stay one item: `Mentor` is "an elder who guides
				-- you, and the rating is his power" in all five books, `Fame` prints the same
				-- hunting-difficulty cut in V20, Dark Ages and the Classical Age, and `Allies`
				-- and `Contacts` are the same ladder everywhere (SPEC I105e(3)).
				["background"] = {
					"", "Allies", "Alternate Identity", "Ancestors", "Arcane", "Armory", "Artifacts", "Avatar", "Backup",
					"Base of Operations", "Certification", "Chantry", "Contacts", "Cult", "Demesne", "Destiny", "Domain",
					"Dream", "Enhancement", "Fame", "Familiar", "Fetish",
					"Generation (Classical Age)", "Generation (Dark Ages)", "Generation (Modern Nights)",
					"Guide", "Herd",
					"Influence (Classical Age)", "Influence (Dark Ages)", "Influence (Mage)", "Influence (Modern Nights)",
					"Kinfolk", "Legend",
					"Library (Hunters Hunted)", "Library (Mage)",
					"Mentor", "Node", "Past Lives", "Patron", "Pure Breed",
					"Rank (Hunters Hunted)", "Rank (Mage)",
					"Requisitions (Hunters Hunted)", "Requisitions (Mage)",
					"Resources (Classical Age)", "Resources (Dark Ages)", "Resources (Modern Nights)",
					"Resources (Victorian Age)",
					"Retainers", "Rites", "Rituals", "Sanctum", "Secret Weapons", "Spies",
					"Status (Hunters Hunted)", "Status (Mage)", "Status (Vampire)",
					"Totem (Mage)", "Totem (Werewolf)", "Wonder",
				},
				-- Twenty-seven hedge paths since the 94th round, when the three books were swept whole
				-- and six the sheet did not carry came back with a page each (SPEC I69, R106, R107, R108).
				-- `Ephemera` still stands BEFORE `Enchantment`: the list inherited that from the book's own
				-- contents page and reordering it is a change nobody asked for - the six new ones take their
				-- alphabetical place and that one exception stays.
				["numina"] = {
					"", "Alchemy", "Conjuration", "Conveyance", "Curses", "Divination",
					"Ephemera", "Enchantment", "Fascination", "Fortune", "Healing", "Hellfire", "Illusion",
					"Maelstroms", "Necromancy", "Necronics", "Oneiromancy", "Quintessence Manipulation", "Shadows",
					"Shapeshifting", "Starlight", "Summoning, Binding, and Warding",
					"Via Geniorum", "Via Necromantiae", "Weather Control",
				},
				["psychic"] = {
					"", "Animal Psychics", "Anti-Psychic", "Astral Projection", "Biocontrol", "Channeling", "Clairvoyance",
					"Cyberkinesis", "Cyberpathy", "Ectoplasmic Generation", "Mind Shields", "Precognition",
					"Psychic Healing", "Psychic Hypnosis", "Psychic Invisibility", "Psychic Vampirism", "Psychokinesis",
					"Psychometry", "Psychoportation", "Pyrokinesis", "Shadow", "Synergy", "Telepathy",
				},
				-- The twenty-four affiliations a hedge magician can belong to, and it is a PICKER
				-- of prose like every other name on this sheet (SPEC I66, I27). The key is
				-- `hedgeAffiliation` and not `affiliation`: fieldRoot drops the "cbo" and
				-- lowercases the FIRST letter only, so cboHedgeAffiliation resolves here. A wrong
				-- key is not a compile error - it falls through to `or c.values`, which T493
				-- emptied, and the dropdown opens blank with rdk exiting 0 (SPEC V211a, B6).
				--
				-- Sorted by the WHOLE string, so the thirteen that open with `The` group under T,
				-- exactly as mainPath already does. `Lone Practitioner` is the BOOK's term for the
				-- unaffiliated (M20 Sorcerer p. 79) and is a choice of its own: the empty first
				-- item means "not answered yet" and the two are not the same state, though the
				-- filters of I67/I68 prune nothing for either (SPEC V15, V270c).
				["hedgeAffiliation"] = {
					"", "Balamo’ob", "Followers of Set", "Forn Jafnaðr", "Giovanni", "Lone Practitioner",
					"Maison Liban", "Mogen HaLev", "Nebuu-Afef, The Order of The Golden Fly",
					"Thal’hun", "The Ancient Order of The Aeon Rites", "The Arcanum", "The Children of Osiris",
					"The Cult of Isis", "The Cult of Mercury",
					"The Dozen Priests of the Pythian Order", "The Fenian", "The Nephite Priesthood",
					"The Seven Thunders", "The Silver Portal",
					"The Society of Enlightened Altruistic Ideologies (SEAI)", "The Society of Leopold",
					"The Star Council", "U.S. Government (Project Twilight)", "Uzoma",
				},
				-- `faith` was a list of four religions until the 90th round, when the row became a
				-- typed field (SPEC I61, user 2026-08-23). It is gone rather than kept dormant:
				-- a PICKER_LIST key with no cbo* reading it is the dead data B55 cost a whole
				-- round of research to find. The four `wod.` keys stay in the .lang - nothing
				-- reprimands an unused key, and `Other` has other readers.
				-- The attribute a hedge magician casts on (SPEC I60). It is the same NINE names
				-- XP_ATTRS carries below, and the gate compares the two lists in BOTH directions
				-- for the reason V148 does it for the trait picker: an attribute that entered one
				-- side only would pass every count check on the sheet. `Inteligence` is the
				-- sheet's own spelling and has been since SPEC I3 - correcting it here alone
				-- would break the bijection, not fix a typo.
				["hedgeAttr"] = {
					"", "Strength", "Dexterity", "Stamina", "Charisma", "Manipulation", "Appearance",
					"Perception", "Inteligence", "Wits",
				},
				-- The rituals of static magic, and the list opens EMPTY on purpose: the powers are
				-- entered in a round of their own (user 2026-08-23, SPEC I65). The key still has to
				-- exist - pickerItems falls back to c.values when it finds none, and the box would
				-- come up outside the axis that translates it, which is B57 through another door
				-- (SPEC V269e). The empty first item is V15's, the same one every picker opens with.
				["hedgeRitual"] = {
					"",
					"1. Death Curse",
					"1. Deathsight",
					"1. Eldritch Mark",
					"1. Face Theft",
					"1. Healing Slumber",
					"1. Lifting Shadows",
					"1. Sprint",
					"1. Symbol Interpretation",
					"2. Bedtime Story",
					"2. Cruel Whispers",
					"2. Enhance Craftsmanship",
					"2. Fire's Weal",
					"2. Hellblade",
					"2. Jolt",
					"2. Object Permanence",
					"2. Quintessence Infusion",
					"2. Rest in Peace",
					"2. Step on a Crack",
					"2. Teleport Ward",
					"3. Always Armed",
					"3. Bashert",
					"3. Belle/Beau/Bright of the Ball",
					"3. Calm Above, Hell Below",
					"3. Get Me the Heck Outta Here!",
					"3. Grip of Shades",
					"3. Hard-Light Constructs",
					"3. Invade Demesne",
					"3. Mike's Cure-All",
					"3. Purification of the Inferno",
					"3. Shape Quintessence",
					"3. Shitstorm",
					"3. Shroud Bubble",
					"3. Shut It Down",
					"3. Wrapped in a Shroud",
					"4. Doxxing",
					"4. Dream Scream",
					"4. Extraction",
					"4. Fix the True Form",
					"4. Forced Medium",
					"4. Freudian Slip",
					"4. Humor Alignment",
					"4. Information Superhighway",
					"4. Instant Feast",
					"4. Love Potion Number 9",
					"5. Generational Wealth",
					"5. Megafauna Transformation",
					"5. Oubliette",
					"5. Overwrite",
					"5. Shelter for the Dead",
					"5. Smoldering Ruin",
					"5. Steal Life",
					"5. Teleportal",
				},
				["disc"] = {
					"", "Abombwe", "Abyss Mysticism", "Animalism", "Assamite Sorcery", "Auspex", "Bardo", "Celerity",
					"Chimerstry", "Daimonion", "Dark Thaumaturgy", "Dementation", "Dominate", "Flight", "Fortitude",
					"Koldunic Sorcery", "Melpominee", "Mytherceria", "Necromancy", "Obeah", "Obfuscate", "Obtenebration",
					"Ogham", "Potence", "Presence", "Protean", "Quietus", "Sanguinus", "Serpentis", "Setite Sorcery",
					"Spiritus", "Temporis", "Thanatosis", "Thaumaturgy", "Valeren", "Vicissitude", "Visceratika",
				},
				["mainPath"] = {
					"", "Ash Path", "Awakening of the Steel", "Bone Path", "Cenotaph Path", "Corpse in the Monster",
					"Die Herrschaft des Wyrm", "Elemental Mastery", "Grave’s Decay", "Hands of Destruction", "Iter Pernix",
					"Lure of Flames", "Mastery of the Mortal Shell", "Movement of the Mind", "Neptune’s Might",
					"Path of Conjuring", "Path of Corruption", "Path of Haunting", "Path of Mars",
					"Path of Spirit Manipulation", "Path of Technomancy", "Path of the Father’s Vengeance",
					"Path of the Focused Mind", "Path of the Levinbolt", "Potestas Exsecrabilis", "Rego Calatio",
					"Sepulchre Path", "The Bialowieza Kraina", "The Black Sea Kraina",
					"The Blessings of the Great Dark Mother", "The Covenant of Enki", "The Fires of the Inferno",
					"The Flow of Ashe", "The Green Path", "The Hand of the Magi", "The Hunter’s Winds", "The Keeper’s Way",
					"The Kraina of Enoch", "The Kraina of the Well", "The Laws of Suleiman", "The Nightshade Path",
					"The Path of Blood", "The Path of Jinn’s Gift", "The Path of Life’s Waters", "The Path of Phobos",
					"The Path of Praapti", "The Path of Skulls", "The Path of Woe", "The Path of the Ailing Jackal",
					"The Path of the Evil Eye", "The Path of the Twilight Garden", "The Revelations of Duat",
					"The Revelations of Eden", "The Revelations of Midgard", "The Taking of the Spirit",
					"The Transylvanian Kraina", "The Way of Earth", "The Way of Fire", "The Way of Sorrows",
					"The Way of Water", "The Way of Wind", "The Way of the Spirit", "Ushabti", "Vitreous Path",
					"Weather Control",
				},
				["ritual"] = {
					"", "1. Ambrus Kelemen’s Aegis", "1. Armor of Diamond Serenity", "1. Bind the Accusing Tongue",
					"1. Blood Mastery", "1. Blood Rush", "1. Blood into Water", "1. Brand", "1. CCTV",
					"1. Call of the Hungry Dead", "1. Calling Card", "1. Chime of Unseen Spirits",
					"1. Communicate with Kindred Sire", "1. Death’s Communion", "1. Defense of the Sacred Haven",
					"1. Deflection of Wooden Doom", "1. Devil’s Touch", "1. Domino of Life", "1. Drinking Death",
