				["5. Overwrite"] = "Necronics",
				["5. Shelter for the Dead"] = "Maelstroms",
				["5. Smoldering Ruin"] = "Hellfire",
				["5. Steal Life"] = "Necromancy",
				["5. Teleportal"] = "Conveyance",
			};

			-- >>> TAB_LIST_BEGIN (SPEC I32, V228: one list, every reader on it)
			-- The eleven tabs, in the order the strip draws them. Every name in the XML is built
			-- from these mechanically - pane `tab<X>`, button `btnTab<X>`, fill `tabOn<X>` - so the
			-- list and the sheet cannot drift into disagreeing about which tabs exist.
			TAB_LIST = {
				"Main", "Traits", "Numina", "Disciplines", "Vampire", "Magick", "Combat", "Inventory",
				"Background", "Progress", "Notes", "Settings", "Storyteller",
			};
			-- <<< TAB_LIST_END

			-- >>> TAB_W_BEGIN (SPEC I36, V232: one width, both readers)
			-- How wide each tab button is, in TAB_LIST order, and the two numbers that lay the
			-- eleven of them out. The strip REFLOWS: a tab the storyteller turned off loses its
			-- button and the ones to its right slide left, so the bar has no hole in the middle
			-- of it (SPEC I36, user 2026-08-22). Numina and Ghoul are the two that can go, and
			-- both sit in the MIDDLE, which is why this could not stay a matter of authored left.
			--
			-- The widths live here instead of being read back off the control because WRITING
			-- geometry from Lua is proved on this sheet - WoD20.9 has written width and height
			-- since the 27th round - and READING it is not: a nil coming back would scatter an
			-- invalid left across twenty-two rectangles in silence, and the fallback that would
			-- guard against it costs the very second copy this table already is. The gate welds
			-- the table to the XML instead, the same weld V49 puts on HEALTH_ROW_PITCH.
			-- Vampire (45th batch, SPEC I188e) sits right after Ghoul and is as wide: the two never
			-- show together, so the bar keeps the length it always had.
			-- Magick (80th batch, SPEC I223g) sits right after Vampire: a mage's own tab, so it never
			-- shows beside Vampire either.
			TAB_W = {
				99, 79, 79, 92, 92, 86, 86, 105, 105, 112, 99, 125, 112,
			};
			STRIP_X0  = 30;
			STRIP_GAP = 4;
			-- <<< TAB_W_END

			-- Which tab is open is SESSION state and must never become a field (SPEC V227): a field
			-- syncs to every client of the table, so the player clicking Combat would drag the
			-- storyteller off whatever they were reading. It is also for ever - a field name cannot
			-- be renamed without dropping what is saved under it (SPEC I3, V2).
			activeTab = "tabMain";

			-- SUB_TABS is GONE with T830, and so is the whole sub-tab idea (SPEC I117, I118, pedidos
			-- 4 and 5). It held two groups, both of them the Numina tab's: the Ghoul group left in
			-- T832 when that tab became three columns, and wave after wave the same answer came back -
			-- three panes side by side beat three panes stacked behind a bar. T830 does it for Numina
			-- and the table has no entry left to hold. The strips went with it: numStrip and
			-- hedgeStrip are off WoD20.7, so nothing on the sheet declares a sub-tab any more.
			--
			-- renderSubTabs went too. Kept over an empty table it would walk nothing and paint
			-- nothing on every tab change, which is dead work no reader can tell from live work
			-- (SPEC B55). selectTab keeps its name and its ONE job - the eleven root tabs still call
			-- it - and what it lost is the search that always fell through (SPEC V268 retired).
			-- >>> GEN_MAX_BEGIN (SPEC I29, V218: one map, both readers)
			-- The ceiling a domitor's generation puts on a ghoul's Disciplines. Keyed by the VALUE the
			-- combo stores ("4".."14"), which is why that value is a plain number and the ordinal is
			-- only what the item READS (SPEC I29). Read by renderMaxDisc for the label and by xpClick
			-- for the refusal - a second copy is how the number shown and the number charged diverge.
			GEN_MAX = {
				["4"] = 5, ["5"] = 4, ["6"] = 3, ["7"] = 2,
				["8"] = 1, ["9"] = 1, ["10"] = 1, ["11"] = 1, ["12"] = 1, ["13"] = 1,
				["14"] = 0,
			};
			-- <<< GEN_MAX_END

			-- A VAMPIRE's own generation, the table the user handed over on 2026-10-01 (SPEC I188c,
			-- V529): blood pool, Discipline ceiling and blood per turn, keyed by the value cmbGeneration
			-- stores ("4".."15"). ONE table for the four readers - the ceiling xpClick refuses by, the
			-- pool bloodClick caps, the column's blood bar and the faded dots of the Vampire tab - so
			-- the number shown and the number enforced cannot drift apart (the reason GEN_MAX is one map).
			VAMP_GEN = {
				["4"]  = { pool = 50, disc = 9, turn = 10 },
				["5"]  = { pool = 40, disc = 8, turn = 8 },
				["6"]  = { pool = 30, disc = 7, turn = 6 },
				["7"]  = { pool = 20, disc = 6, turn = 4 },
				["8"]  = { pool = 15, disc = 5, turn = 3 },
				["9"]  = { pool = 14, disc = 5, turn = 2 },
				["10"] = { pool = 13, disc = 5, turn = 1 },
				["11"] = { pool = 12, disc = 5, turn = 1 },
				["12"] = { pool = 11, disc = 5, turn = 1 },
				["13"] = { pool = 10, disc = 5, turn = 1 },
				["14"] = { pool = 10, disc = 4, turn = 1 },
				["15"] = { pool = 10, disc = 3, turn = 1 },
			};

			-- The ONE reader of VAMP_GEN (SPEC V529b). `n` is a node - the column paints rows that are
			-- not the active sheet - and nil means the active one. A generation nobody picked reads as
			-- the thirteenth, the default the user asked for: the seed in onNodeReady writes it, and
			-- this covers a column character whose node never went through that seed.
			function vampGen(n)
				n = n or sheet;

				local g = (n ~= nil) and n.generation or nil;

				return VAMP_GEN[tostring(g)] or VAMP_GEN["13"];
			end;

			-- The vampire's SHEET - boxes, nine dots, ability lists, Numina locked - and not its rules
			-- (user 2026-10-06, SPEC I216a, V553a). A mage wears it too, with no Vampire tab: the rules
			-- (generation, clan, blood) still ask for "Vampire" by name, so a mage plays as a mortal
			-- and, with Show Ghoul on, as a ghoul (SPEC Q128.1).
			function vampLayout()
				return sheet ~= nil and (sheet.game == "Vampire" or sheet.game == "Mage");
			end;

			-- The ceiling on the blood pool, for the dots and for the column's bar alike (SPEC I188c).
			-- A vampire's comes from the generation; anyone else's from the revenant family, as before.
			function bloodCap(n)
				n = n or sheet;

				if n ~= nil and n.game == "Vampire" then return vampGen(n).pool; end;

				return familyCap("bloodPool", n);
			end;

			-- nil means NO ceiling, and that is not the same as zero: a mortal with no domitor is not a
			-- ghoul with a fourteenth-generation one (SPEC V220a). A vampire is asked first and always
			-- has one - his own generation, never the domitor's (SPEC I188c, V529d).
			function maxDiscLevel()
				if sheet == nil then return nil; end;

				if sheet.game == "Vampire" then return vampGen().disc; end;

				local g = sheet.dominatorGen;

				if g == nil or g == "" then return nil; end;

				return GEN_MAX[tostring(g)];
			end;

			-- `renderMaxDisc` NAO fica aqui, e a ausencia e deliberada (SPEC B51, V223). Ele anda da
			-- raiz por `tabRootOf`, que e um `local function` declarado ~1050 linhas ABAIXO deste
			-- ponto, e Lua resolve nome nao-local em tempo de COMPILACAO: corpo escrito acima do
			-- `local` vira GETGLOBAL e acha nil rodando. Foi exatamente o erro que o label deu ao
			-- user. Ele mora logo abaixo de `applyTabVisibility`, o outro global que anda da raiz.
			-- Nao devolver p/ ca ao lado de GEN_MAX: a leitura melhora e o label morre.

			function setField(name, value)
				if sheet == nil then return; end;
				if sheet[name] ~= value then sheet[name] = value; end;
			end;

			-- ---- SPEC T492: TEMPORARY instrumentation. It comes OUT before the round closes --
			--
			-- The "before" the round has to have MEASURED (SPEC C), and what T497 reads. It answers
			-- two things the gate cannot: how many times each entry point actually runs on an open,
			-- and whether a description require was ever REACHED (SPEC R92b, R92i, B47, B48).
			--
			-- It lives on the ROOT form because every tab has to reach it and the root <script> is
			-- parsed before any <import> - the same reason the health track lives here.
			--
			-- Log.i needs API 87.3 and the generated module.xml declares 88.2 (SPEC R92i).
			WOD_HITS = {};
			
			function wodTrace(what)
				WOD_HITS[what] = (WOD_HITS[what] or 0) + 1;
				Log.i("WOD", what .. " x" .. WOD_HITS[what]);
			end;

			-- Health track, shared by the Main tab and its mirror on the Combat tab.
			--
			-- It lives on the ROOT form on purpose: this script is parsed before the <import>
			-- of any tab, so both tabs can call into it without depending on which sibling tab
			-- happened to load first. SPEC R.9 / B.9 is the same lesson from the other side -
			-- a tab form cannot reach its siblings, so anything two tabs share belongs here.

			-- The 10 lists are LITERAL from the user (SPEC C, V39). They are NOT derivable:
			-- 6 is 7 minus Bruised and 5 is that minus Hurt, but 4 skips Crippled instead of
			-- continuing to trim from the top. Do not "simplify" this into a loop.
			HEALTH_LEVELS = {
				[1]  = {"Incapacitated"},
				[2]  = {"Injured (-1)", "Incapacitated"},
				[3]  = {"Injured (-1)", "Wounded (-2)", "Incapacitated"},
				[4]  = {"Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Incapacitated"},
				[5]  = {"Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[6]  = {"Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[7]  = {"Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[8]  = {"Bruised", "Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[9]  = {"Bruised", "Bruised", "Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
				[10] = {"Bruised", "Bruised", "Bruised", "Bruised", "Hurt (-1)", "Injured (-1)", "Wounded (-2)", "Mauled (-2)", "Crippled (-5)", "Incapacitated"},
			};

			-- These labels are written by Lua, so they never pass through the WoD20.6 translation
			-- traversal - that routine snapshots the authored English once and would restore a
			-- stale snapshot the moment the track length changed. Same arrangement as the numina
			-- description block (SPEC V31): whoever writes the text owns both languages.
			-- The gate checks this table against localization.lang, like it does the PT map.
			HEALTH_PT = {
				["Bruised"]        = "Escoriado",
				["Hurt (-1)"]      = "Machucado (-1)",
				["Injured (-1)"]   = "Ferido (-1)",
				["Wounded (-2)"]   = "Ferido Gravemente (-2)",
				["Mauled (-2)"]    = "Espancado (-2)",
				["Crippled (-5)"]  = "Aleijado (-5)",
				["Incapacitated"]  = "Incapacitado",
			};

			-- The four damage marks, LITERAL from the user (SPEC C, V41), in cycle order. Mark 1
			-- is a single space, not "": the sheet stores exactly what the box shows.
			HEALTH_MARKS = {" ", "/", "X", "*"};

			-- CLANS (SPEC I17). Dormant data: nothing reads it yet (SPEC V174), and the clan
			-- combo on Main is invisible and disabled (SPEC V173). Frozen by SPEC T430 from the
			-- core and Dark Ages; `open` counts slots the player fills from the whole list.
			local CLANS = {
				-- >>> CLANS_BEGIN (generated - SPEC T434, T430 froze the lists)
				["Assamite"] = { fixed = {"Celerity", "Obfuscate", "Quietus"} },
				["Brujah"] = { fixed = {"Celerity", "Potence", "Presence"} },
