				["Gargoyles (Scout)"]    = { fixed = {"Auspex", "Obfuscate", "Flight"} },
				["Gargoyles (Sentinel)"] = { fixed = {"Flight", "Potence", "Fortitude"} },
				["Gargoyles (Warrior)"]  = { fixed = {"Flight", "Fortitude", "Protean"} },
				["Ventrue Antitribu"] = { fixed = {"Dominate", "Fortitude"}, choice = {"Auspex", "Presence"} },
				["Salubri (Wu Zao / Watchers)"] = { fixed = {"Auspex", "Fortitude"}, choice = {"Obeah", "Valeren"} },
				["Angellis Ater"]     = { fixed = {"Daimonion", "Dominate"}, choice = {"Potence", "Presence", "Obfuscate"} },
				["Maeghar"]            = { choice = {"Mytherceria", "Necromancy"}, open = 2 },
				["Panders"]            = { open = 3 },
				["Caitiff"]            = { open = 3 },
				["Children of Osiris"] = { open = 3 },
				-- The revenant families (SPEC R93, T640). Eighteen trios come from the books; the
