				-- are his call, not the book's. They were FOUR and are THREE - Keskinen, Krevcheski
				-- and Marijava - since T938 took Katayama out of the list (SPEC I143k): it is the
				-- only one of the four the book gives no weakness for, in prose or otherwise, and
				-- its trio went with it because a trio for a name nobody can pick is dead data.
				-- Keskinen and Marijava DO carry a weakness, written as prose in the "Other
				-- Families" page rather than under a Weakness: label, and Krevcheski is the
				-- Ducheski under the surname they abandoned - all three stay.
				["Basarab"]                   = { fixed = {"Animalism", "Dominate", "Presence"} },
				["Bratovich (Dark Ages)"]     = { fixed = {"Animalism", "Potence", "Vicissitude"} },
				["Bratovitch (Modern)"]       = { fixed = {"Animalism", "Fortitude", "Vicissitude"} },
				["D'Habi"]                    = { fixed = {"Presence", "Obfuscate", "Daimonion"} },
