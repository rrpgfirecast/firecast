				["City Gangrel"] = { fixed = {"Celerity", "Obfuscate", "Protean"} },
				["Country Gangrel"] = { fixed = {"Animalism", "Fortitude", "Protean"} },
				["Malkavian Antitribu"] = { fixed = {"Auspex", "Dementation", "Obfuscate"} },
