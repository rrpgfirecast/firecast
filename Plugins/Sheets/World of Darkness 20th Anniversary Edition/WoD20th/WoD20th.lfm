				["Assamite Viziers"] = { fixed = {"Auspex", "Celerity", "Quietus"} },
				["Daitya"] = { fixed = {"Presence", "Obfuscate", "Serpentis"} },
				["Tlacique"] = { fixed = {"Obfuscate", "Presence", "Protean"} },
				["Warrior Setites"] = { fixed = {"Potence", "Presence", "Serpentis"} },
				["Gangrel (Marine)"] = { fixed = {"Animalism", "Fortitude", "Protean"} },
				["Lasombra Antitribu"] = { fixed = {"Dominate", "Obtenebration", "Potence"} },
