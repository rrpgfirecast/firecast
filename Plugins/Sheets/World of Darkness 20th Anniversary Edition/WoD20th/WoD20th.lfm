			-- Two answers derived once, so nothing walks the table to ask them (SPEC V205).
			POWER_LEVEL = {};
			POWER_DISC  = {};

			for discName, discList in pairs(DISC_POWERS) do
				for discI = 1, #discList, 1 do
					POWER_LEVEL[discList[discI][2]] = discList[discI][1];
					POWER_DISC[discList[discI][2]]  = discName;
				end;
			end;

			-- What an extra power costs per level (SPEC I255b, Q166.1). The book says x4 in clan and x6
			-- out of it (SPEC R192b); the table's price is this one.
			POWER_XP = 5;
			-- Extra slots per row, and rows in the panel: Presence at nine holds 9 free slots and the 12
			-- its 19 powers leave over (SPEC R192c, V603b).
			POWER_SLOTS = 12;
			DV_ROWS     = 21;

			-- The fourth key stopped being an alias in the 107th round (SPEC I29b, T510). Clan and
			-- family are two AUTHORED lists now - the clan picker is going to be shown somewhere
			-- else without the families - and only this dropdown offers both, so what it gets is
			-- their UNION, built once here and never written again.
			--
			-- Three invariants all say the same thing about the shape. V201 wants PICKER_LIST
			-- constant: this is born in the constructor and nothing writes it afterwards, which is
			-- exactly as constant as the two lists standing behind it. V208 forbids two tables with
			-- the same content: the union holds neither list's content. V211c calls an alias
			-- identity, and that is why the families are NOT appended to `clan` - a push there
			-- would grow the Main tab's clan picker with them, which is what B50 already paid for
			-- once.
			--
			-- The local is the point: writing straight into PICKER_LIST["clanFamily"][n] would be a
			-- table growing inside the map, and V294c reads the source for exactly that shape.
			-- >>> CLANFAMILY_UNION_BEGIN (SPEC V294 - the gate finds this region by MARKER)
			local clanFamilyUnion = {};
			local clanFamilyCount = 0;

			for i = 1, #PICKER_LIST["clan"], 1 do
				clanFamilyCount = clanFamilyCount + 1;
				clanFamilyUnion[clanFamilyCount] = PICKER_LIST["clan"][i];
			end;

			for i = 1, #PICKER_LIST["family"], 1 do
				clanFamilyCount = clanFamilyCount + 1;
				clanFamilyUnion[clanFamilyCount] = PICKER_LIST["family"][i];
			end;

			PICKER_LIST["clanFamily"] = clanFamilyUnion;
			-- <<< CLANFAMILY_UNION_END

			-- Which affiliation each sect of PICKER_LIST["sect"] belongs to (user 2026-10-06, SPEC
			-- I216h, R186b), the book's three parts. pickAllowed reads it: a mage of a playable
			-- affiliation is offered its sects, one with none or a custom one all twenty-five.
			SECT_AFFILIATION = {
				["Akashic Brotherhood"] = "Traditions", ["Celestial Chorus"] = "Traditions", ["Cult of Ecstasy"] = "Traditions",
				["Dreamspeakers"] = "Traditions", ["Euthanatos"] = "Traditions", ["Order of Hermes"] = "Traditions",
				["Society of Ether"] = "Traditions", ["Verbena"] = "Traditions", ["Virtual Adepts"] = "Traditions",
				["Iteration X"] = "Technocracy", ["New World Order"] = "Technocracy", ["Progenitors"] = "Technocracy",
				["Syndicate"] = "Technocracy", ["Void Engineers"] = "Technocracy",
				["Ahl-i-Batin"] = "Disparates", ["Bata'a"] = "Disparates", ["Children of Knowledge"] = "Disparates",
				["Hollow Ones"] = "Disparates", ["Kopa Loei"] = "Disparates", ["Ngoma"] = "Disparates",
				["Orphans"] = "Disparates", ["Sisters of Hippolyta"] = "Disparates", ["Taftani"] = "Disparates",
				["Templar Knights"] = "Disparates", ["Wu Lung"] = "Disparates",
			};

			-- The Aspects of each Hedge Path, keyed by the picker's own value (101st batch, SPEC
			-- I244d, R190): the general Aspects a Path names (M20 Sorcerer p.13-14) and the ones its
			-- own System adds. A Path with no key here has no Aspects and its button stays dark (SPEC
			-- Q156.1), and so does a custom Path. GLOBAL and not a local: this form sits at its
