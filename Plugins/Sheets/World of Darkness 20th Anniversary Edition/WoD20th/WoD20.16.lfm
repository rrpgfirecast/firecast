			<edit name="edtMkParadox" field="qpParadox" type="number" decimalPlaces="0" left="190" top="209" width="40" height="20" horzTextAlign="center" vertTextAlign="center"/>
		</layout>

		<!-- WILLPOWER under QUINTESSENCE / PARADOX (user 2026-10-09, SPEC I240a, V581a): the Combat tab's
		     mirror, the fourth on the sheet. Its dots carry no field and are painted by WoD20.3's
		     paintWillpower through xpFind, like the Vampire tab's copy; its boxes own willpower_c1..c10, a
		     declared mirror of the Main's (SPEC V36). Title, the Main's 8 and the 52 of dots and boxes are
		     ONE object centred in the Combat's 110 (SPEC V547), here 356 wide like the column. The names
		     carry mk, since this form is pasted into the root (SPEC V530e). -->
		<layout name="boxMkWillpower" left="1083" top="746" width="356" height="110">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<template name="MkWillpowerMirror">
				<imageCheckBox name="mkWp_1" left="0" top="0" width="25" height="25" autoChange="false" opacity="0.40" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
				<imageCheckBox name="mkWp_2" left="25" top="0" width="25" height="25" autoChange="false" opacity="0.40" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
				<imageCheckBox name="mkWp_3" left="50" top="0" width="25" height="25" autoChange="false" opacity="0.40" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
				<imageCheckBox name="mkWp_4" left="75" top="0" width="25" height="25" autoChange="false" opacity="0.40" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
				<imageCheckBox name="mkWp_5" left="100" top="0" width="25" height="25" autoChange="false" opacity="0.40" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
				<imageCheckBox name="mkWp_6" left="125" top="0" width="25" height="25" autoChange="false" opacity="0.40" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
				<imageCheckBox name="mkWp_7" left="150" top="0" width="25" height="25" autoChange="false" opacity="0.40" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
				<imageCheckBox name="mkWp_8" left="175" top="0" width="25" height="25" autoChange="false" opacity="0.40" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
				<imageCheckBox name="mkWp_9" left="200" top="0" width="25" height="25" autoChange="false" opacity="0.40" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>
				<imageCheckBox name="mkWp_10" left="225" top="0" width="25" height="25" autoChange="false" opacity="0.40" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png"/>

				<checkBox left="0" top="27" width="25" height="25" field="willpower_c1" onClick="wpSpentClick('willpower_c1');" onChange="wpSpentChange('willpower_c1');"/>
				<checkBox left="25" top="27" width="25" height="25" field="willpower_c2" onClick="wpSpentClick('willpower_c2');" onChange="wpSpentChange('willpower_c2');"/>
				<checkBox left="50" top="27" width="25" height="25" field="willpower_c3" onClick="wpSpentClick('willpower_c3');" onChange="wpSpentChange('willpower_c3');"/>
				<checkBox left="75" top="27" width="25" height="25" field="willpower_c4" onClick="wpSpentClick('willpower_c4');" onChange="wpSpentChange('willpower_c4');"/>
				<checkBox left="100" top="27" width="25" height="25" field="willpower_c5" onClick="wpSpentClick('willpower_c5');" onChange="wpSpentChange('willpower_c5');"/>
				<checkBox left="125" top="27" width="25" height="25" field="willpower_c6" onClick="wpSpentClick('willpower_c6');" onChange="wpSpentChange('willpower_c6');"/>
				<checkBox left="150" top="27" width="25" height="25" field="willpower_c7" onClick="wpSpentClick('willpower_c7');" onChange="wpSpentChange('willpower_c7');"/>
				<checkBox left="175" top="27" width="25" height="25" field="willpower_c8" onClick="wpSpentClick('willpower_c8');" onChange="wpSpentChange('willpower_c8');"/>
				<checkBox left="200" top="27" width="25" height="25" field="willpower_c9" onClick="wpSpentClick('willpower_c9');" onChange="wpSpentChange('willpower_c9');"/>
				<checkBox left="225" top="27" width="25" height="25" field="willpower_c10" onClick="wpSpentClick('willpower_c10');" onChange="wpSpentChange('willpower_c10');"/>
			</template>
			<label name="lblMkWillpower" left="20" top="15" width="316" height="20" text="WILLPOWER" horzTextAlign="center"/>
			<layout name="bodyMkWillpower" left="53" top="43" width="250" height="52">
				<MkWillpowerMirror/>
			</layout>
		</layout>
	</scrollBox>

	<dataLink field="language" onChange="magickRelabel(self);"/>

	<!-- The WILLPOWER copy's first paint (user 2026-10-09, SPEC I240b, V581b): its dots are WoD20.3's
	     to paint, on willpower's dataLinks there; this covers a sheet opened on this tab, as the Vampire
	     tab's onShow does (SPEC V545c). -->
	<event name="onShow">
		renderXPBoxes(self);
		renderCombatTraits(self);
	</event>
</form>
