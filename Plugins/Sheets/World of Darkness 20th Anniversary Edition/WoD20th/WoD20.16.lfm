				<imageCheckBox name="mkSph_prime_1" left="100" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('sphere_prime_1', self);"/>
