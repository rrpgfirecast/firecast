		<layout name="boxMkQp" left="1083" top="497" width="356" height="244">
			<rectangle align="client" color="black" xradius="14" yradius="14" cornerType="innerRound"/>
			<label left="98" top="15" width="107" height="20" text="QUINTESSENCE" horzTextAlign="trailing"/>
			<edit name="edtMkQuint" field="qpQuint" type="number" decimalPlaces="0" left="210" top="15" width="40" height="20" horzTextAlign="center" vertTextAlign="center"/>
			<layout name="mkQpRing" left="98" top="42" width="160" height="160">
				<rectangle name="mkQpMark_1" left="0" top="61" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="279" hitTest="true" cursor="handPoint" onClick="cycleQpMark(1);"/>
				<rectangle name="mkQpMark_2" left="7" top="39" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="297" hitTest="true" cursor="handPoint" onClick="cycleQpMark(2);"/>
				<rectangle name="mkQpMark_3" left="20" top="20" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="315" hitTest="true" cursor="handPoint" onClick="cycleQpMark(3);"/>
				<rectangle name="mkQpMark_4" left="39" top="7" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="333" hitTest="true" cursor="handPoint" onClick="cycleQpMark(4);"/>
				<rectangle name="mkQpMark_5" left="61" top="0" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="351" hitTest="true" cursor="handPoint" onClick="cycleQpMark(5);"/>
				<rectangle name="mkQpMark_6" left="83" top="0" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="9" hitTest="true" cursor="handPoint" onClick="cycleQpMark(6);"/>
				<rectangle name="mkQpMark_7" left="105" top="7" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="27" hitTest="true" cursor="handPoint" onClick="cycleQpMark(7);"/>
				<rectangle name="mkQpMark_8" left="124" top="20" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="45" hitTest="true" cursor="handPoint" onClick="cycleQpMark(8);"/>
				<rectangle name="mkQpMark_9" left="137" top="39" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="63" hitTest="true" cursor="handPoint" onClick="cycleQpMark(9);"/>
				<rectangle name="mkQpMark_10" left="144" top="61" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="81" hitTest="true" cursor="handPoint" onClick="cycleQpMark(10);"/>
				<rectangle name="mkQpMark_11" left="144" top="83" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="99" hitTest="true" cursor="handPoint" onClick="cycleQpMark(11);"/>
				<rectangle name="mkQpMark_12" left="137" top="105" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="117" hitTest="true" cursor="handPoint" onClick="cycleQpMark(12);"/>
				<rectangle name="mkQpMark_13" left="124" top="124" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="135" hitTest="true" cursor="handPoint" onClick="cycleQpMark(13);"/>
				<rectangle name="mkQpMark_14" left="105" top="137" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="153" hitTest="true" cursor="handPoint" onClick="cycleQpMark(14);"/>
				<rectangle name="mkQpMark_15" left="83" top="144" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="171" hitTest="true" cursor="handPoint" onClick="cycleQpMark(15);"/>
				<rectangle name="mkQpMark_16" left="61" top="144" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="189" hitTest="true" cursor="handPoint" onClick="cycleQpMark(16);"/>
				<rectangle name="mkQpMark_17" left="39" top="137" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="207" hitTest="true" cursor="handPoint" onClick="cycleQpMark(17);"/>
				<rectangle name="mkQpMark_18" left="20" top="124" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="225" hitTest="true" cursor="handPoint" onClick="cycleQpMark(18);"/>
				<rectangle name="mkQpMark_19" left="7" top="105" width="16" height="16" color="#00000000" strokeColor="white" strokeSize="2" xradius="2" yradius="2" rotationAngle="243" hitTest="true" cursor="handPoint" onClick="cycleQpMark(19);"/>
