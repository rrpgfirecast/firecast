				<imageCheckBox name="mkArete_6" left="125" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('arete_6', self);"/>
				<imageCheckBox name="mkArete_7" left="150" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('arete_7', self);"/>
