				<imageCheckBox name="mkSph_prime_3" left="150" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('sphere_prime_3', self);"/>
				<imageCheckBox name="mkSph_prime_4" left="175" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('sphere_prime_4', self);"/>
				<imageCheckBox name="mkSph_prime_5" left="200" top="0" width="25" height="25" checkedImage="images/prime_on.png" uncheckedImage="images/prime_off.png" autoChange="false" onClick="xpClick('sphere_prime_5', self);"/>
