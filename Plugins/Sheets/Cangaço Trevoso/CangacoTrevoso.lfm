<?xml version='1.0' encoding='UTF-8'?>
<form name="frmCangacoTrevoso" formType="sheetTemplate" dataType="br.com.fichas.CangacoTrevoso" title="Cangaço Trevoso" align="client" theme="dark">
  <script><![CDATA[require("dialogs.lua")
require("ndb.lua")
require("system.lua")

local maiores = {"parrudez", "destreza", "esperteza", "presenca"}
local menores = {
    "forca", "saude", "coordenacao", "ligeireza",
    "inteligencia", "percepcao", "simpatia", "valentia"
}
local competencias = {
    "alerta", "arma_fio", "arma_poiva", "artista", "boniteza",
    "catimbo", "compadres", "cura", "dinheiro", "estudo",
    "fama", "fineza", "preparo_fisico", "sair_tapa",
    "sobrevivenca", "surdina"
}

local mapaMaior = {
    ["Parrudez"] = "parrudez",
    ["Destreza"] = "destreza",
    ["Esperteza"] = "esperteza",
    ["Presença"] = "presenca"
}
local mapaMenor = {
    ["Fôrça"] = "forca",
    ["Saúde"] = "saude",
    ["Coordenação"] = "coordenacao",
    ["Ligeireza"] = "ligeireza",
    ["Intiligência"] = "inteligencia",
    ["Percepção"] = "percepcao",
    ["Simpatia"] = "simpatia",
    ["Valentia"] = "valentia"
}
local mapaCompetencia = {
    ["Alerta"] = "alerta",
    ["Arma de Fio"] = "arma_fio",
    ["Arma de Póiva"] = "arma_poiva",
    ["Artista"] = "artista",
    ["Boniteza"] = "boniteza",
    ["Catimbó"] = "catimbo",
    ["Compadres"] = "compadres",
    ["Cura"] = "cura",
    ["Dinheiro"] = "dinheiro",
    ["Estudo"] = "estudo",
    ["Fama"] = "fama",
    ["Fineza"] = "fineza",
    ["Preparo Físico"] = "preparo_fisico",
    ["Sair na Tapa"] = "sair_tapa",
    ["Sobrevivênça"] = "sobrevivenca",
    ["Surdina"] = "surdina"
}

local function n(v)
    return tonumber(v) or 0
end

local function clamp(v, minimo, maximo)
    return math.max(minimo, math.min(maximo, n(v)))
end

local function avisar(mensagem)
    showMessage(mensagem)
end

local function getMesa()
    return Firecast.getMesaDe(sheet)
end

-- Mensagem compartilhada no chat: cor e negrito são enviados com TalemarkOptions.
local function enviarAoChat(chat, mensagem, cor)
    local parametros = nil
    if cor ~= nil then
        parametros = {
            talemarkOptions = {
                defaultTextStyle = {color = cor, bold = true},
                parseSmileys = false
            }
        }
    end
    chat:asyncSendStd(mensagem, parametros)
end

local function expressao2d6(bonus)
    bonus = math.floor(n(bonus))
    if bonus > 0 then return "2d6+" .. bonus end
    if bonus < 0 then return "2d6" .. bonus end
    return "2d6"
end

-- Lê os valores naturais dos dois dados, sem considerar qualquer modificador.
local function tipoCritico(rolagem)
    if rolagem == nil or rolagem.ops == nil then return nil end
    for _, op in ipairs(rolagem.ops) do
        if op.tipo == "dado" and tonumber(op.face) == 6 then
            local resultados = op.resultados
            if resultados ~= nil and #resultados == 2 then
                if resultados[1] == 6 and resultados[2] == 6 then
                    return "acerto"
                end
                if resultados[1] == 1 and resultados[2] == 1 then
                    return "falha"
                end
            end
        end
    end
    return nil
end

local function modFerimento()
    local ferimentos = clamp(sheet.firidas, 0, 4)
    if ferimentos >= 3 then return -2 end
    if ferimentos == 2 then return -1 end
    return 0
end

local function bonusPoder(atributo)
    if sheet.poder_ativo ~= true then return 0 end
    local arquetipo = sheet.arquetipo or ""
    local nivel = n(sheet.maledicencia)
    if arquetipo == "Besta-fera" and nivel >= 2 then
        if atributo == "percepcao" then return 2 end
    end
    if arquetipo == "Sangue nos Ói" and nivel >= 2 then
        if atributo == "coordenacao" then return 1 end
    end
    return 0
end

local function complemento(nome)
    if nome == "carrera" then
        return n(sheet.saude) + n(sheet.ligeireza)
    end
    if nome == "iniciativa" then
        return n(sheet.ligeireza) + n(sheet.percepcao)
    end
    if nome == "leriado" then
        return n(sheet.inteligencia) + n(sheet.simpatia)
    end
    if nome == "cabrerisse" then
        return n(sheet.percepcao) + n(sheet.valentia)
    end
    return 0
end

-- Evita reenviar ao servidor os mesmos valores em cada abertura/rolagem.
local function atualizarComplementos()
    local valores = {
        valor_carrera = complemento("carrera"),
        valor_iniciativa = complemento("iniciativa"),
        valor_leriado = complemento("leriado"),
        valor_cabrerisse = complemento("cabrerisse")
    }
    for campo, valor in pairs(valores) do
        if tonumber(sheet[campo]) ~= valor then
            sheet[campo] = valor
        end
    end
end

local function bonusComplemento(nome)
    if sheet.poder_ativo ~= true then return 0 end
    local arquetipo = sheet.arquetipo or ""
    local nivel = n(sheet.maledicencia)
    if arquetipo == "Raio da Silibrina" and nivel >= 2 then
        if nome == "carrera" or nome == "iniciativa" then return 2 end
    end
    if arquetipo == "Enrrolador" and nivel >= 2 then
        if nome == "leriado" then return 2 end
    end
    return 0
end

local function penalidadeAtiva()
    if sheet.poder_ativo == true then
        if sheet.arquetipo == "Sangue nos Ói" then
            if n(sheet.maledicencia) >= 5 then return 0 end
        end
    end
    return modFerimento()
end

local function validar()
    atualizarComplementos()
    local sumMaj, sumMen = 0, 0
    local sumCompet, sumIncompet, numIncompet = 0, 0, 0
    local erros = {}
    for _, campo in ipairs(maiores) do
        local valor = n(sheet[campo])
        sumMaj = sumMaj + valor
        if valor < 1 or valor > 5 or valor ~= math.floor(valor) then
            table.insert(erros, "Atributo maior inválido: " .. campo)
        end
    end
    for _, campo in ipairs(menores) do
        local valor = n(sheet[campo])
        sumMen = sumMen + valor
        if valor < 0 or valor > 5 or valor ~= math.floor(valor) then
            table.insert(erros, "Atributo menor inválido: " .. campo)
        end
    end
    for _, campo in ipairs(competencias) do
        local valor = n(sheet["comp_" .. campo])
        local inc = n(sheet["inc_" .. campo])
        sumCompet = sumCompet + valor
        sumIncompet = sumIncompet + inc
        if inc > 0 then numIncompet = numIncompet + 1 end
        if valor < 0 or valor > 3 or inc < 0 or inc > 3 then
            table.insert(erros, "Competência/incompetência inválida: " .. campo)
        end
        if valor ~= math.floor(valor) or inc ~= math.floor(inc) then
            table.insert(erros, "Use valores inteiros: " .. campo)
        end
        if valor > 0 and inc > 0 then
            table.insert(erros, "Competência e incompetência juntas: " .. campo)
        end
    end
    if sumMaj ~= 10 then
        table.insert(erros, "Atributos maiores: " .. sumMaj .. "/10")
    end
    if sumMen ~= 15 then
        table.insert(erros, "Atributos menores: " .. sumMen .. "/15")
    end
    if numIncompet > 3 then
        table.insert(erros, "No máximo três incompetências iniciais")
    end
    local limite = 4 + n(sheet.inteligencia) + sumIncompet
    if sumCompet ~= limite then
        table.insert(erros, "Competências: " .. sumCompet .. "/" .. limite)
    end
    sheet.resumo_pontos = "MAIORES " .. sumMaj .. "/10 | MENORES " .. sumMen .. "/15"
    if #erros == 0 then
        avisar("Distribuição inicial válida! " .. sheet.resumo_pontos)
    else
        avisar(table.concat(erros, "\n"))
    end
end


-- Uma rolagem nativa da mesa. Resultado normal ja aparece automaticamente
-- no chat; so sao enviadas mensagens adicionais para CRITICOS.
local function rolar(bonus, descricao, modo, callbackExtra)
    local mesa = getMesa()
    if mesa == nil or mesa.chat == nil then
        avisar("Abra a ficha em uma mesa para rolar os dados.")
        return
    end
    local chat = mesa.chat
    local expressao = expressao2d6(bonus)
    chat:rolarDados(expressao, descricao, function(rolada)
        if sheet == nil or rolada == nil then return end
        local total = n(rolada.resultado)
        local critico = tipoCritico(rolada)
        sheet.ultimo_teste = total
        sheet.ultimo_bonus = bonus
        if modo == "ataque" then sheet.ultimo_ataque = total end
        if critico == "acerto" then
            enviarAoChat(chat, "ACERTO CRÍTICO! Dois 6 naturais (6 + 6).", "#3586E8")
        elseif critico == "falha" then
            enviarAoChat(chat, "FALHA CRÍTICA! Dois 1 naturais (1 + 1).", "#E14B4B")
        end
        if callbackExtra ~= nil then callbackExtra(total, critico) end
    end)
end

local function bonusCompetencia(chave)
    if chave == nil then return 0 end
    return n(sheet["comp_" .. chave]) - n(sheet["inc_" .. chave])
end

local function rolarAtributos(chaveMaior, chaveMenor, nomeMaior, nomeMenor)
    local bonus = n(sheet[chaveMaior]) + n(sheet[chaveMenor])
    bonus = bonus + bonusPoder(chaveMenor)
    bonus = bonus + penalidadeAtiva() + n(sheet.teste_mod)
    local descricao = nomeMaior .. " + " .. nomeMenor
    rolar(bonus, descricao, "teste")
end

local function rolarComplemento(chave, titulo)
    atualizarComplementos()
    local bonus = complemento(chave) + bonusComplemento(chave)
    bonus = bonus + penalidadeAtiva() + n(sheet.teste_mod)
    rolar(bonus, titulo, "teste")
end

-- Cada competencia e rolada com o atributo maior/menor que o usuario
-- escolheu no painel de configuracao, respeitando a liberdade narrativa.
local function rolarCompetencia(chave, titulo)
    local maiorNome = sheet.teste_maior_nome or "Parrudez"
    local menorNome = sheet.teste_menor_nome or "Fôrça"
    local maior = mapaMaior[maiorNome]
    local menor = mapaMenor[menorNome]
    if maior == nil or menor == nil then
        avisar("Selecione os atributos para testar esta competência.")
        return
    end
    local bonus = n(sheet[maior]) + n(sheet[menor])
    bonus = bonus + bonusPoder(menor) + bonusCompetencia(chave)
    bonus = bonus + penalidadeAtiva() + n(sheet.teste_mod)
    rolar(bonus, maiorNome .. " + " .. menorNome .. " + " .. titulo, "teste")
end

-- Ataque sem equipamento cadastrado (equipamentos possui tambem botoes
-- individuais para cada arma, incluindo seu bonus especifico).
local function rolarAtaque(chaveCompetencia, nomeCompetencia)
    local bonus = n(sheet.destreza) + n(sheet.coordenacao)
    bonus = bonus + bonusPoder("coordenacao")
    bonus = bonus + bonusCompetencia(chaveCompetencia)
    bonus = bonus + penalidadeAtiva() + n(sheet.teste_mod)
    rolar(bonus, "Ataque: " .. nomeCompetencia, "ataque")
end

local function sofrerDano()
    local dano = math.max(0, n(sheet.dano_recebido) - n(sheet.protecao))
    dano = math.max(0, dano - n(sheet.protecao_extra))
    local saude = n(sheet.saude)
    if saude <= 0 then
        avisar("Saúde precisa ser maior que zero para calcular Firidas.")
        return
    end
    local novos = math.floor(dano / saude)
    local antes = clamp(sheet.firidas, 0, 4)
    sheet.firidas = math.min(4, antes + novos)
    sheet.ultimo_dano = dano
    local texto = "Dano líquido " .. dano .. ": " .. novos .. " Firida(s)."
    texto = texto .. " Total " .. sheet.firidas .. "/4."
    avisar(texto)
end

local function curar()
    if n(sheet.firidas) < 1 then
        avisar("Nenhuma Firida para curar.")
        return
    end
    local dificuldade = 10 + n(sheet.parrudez)
    local bonus = n(sheet.teste_cura_bonus)
    if sheet.cura_propria then bonus = bonus + penalidadeAtiva() end
    rolar(bonus, "Cura (dificuldade " .. dificuldade .. ")", "cura", function(total, critico)
        if critico ~= "falha" and total >= dificuldade then
            sheet.firidas = math.max(0, n(sheet.firidas) - 1)
        end
    end)
end

local function gastarFicha(poder)
    if n(sheet.fichas) <= 0 then
        avisar("Sem fichas narrativas disponíveis.")
        return
    end
    if poder and n(sheet.maledicencia) >= 10 then
        avisar("Maledicência 10: controle do Mestre.")
        return
    end
    if poder and n(sheet.nivel_poder_uso) > n(sheet.maledicencia) then
        avisar("Poder ainda não desbloqueado.")
        return
    end
    sheet.fichas = n(sheet.fichas) - 1
    if poder and n(sheet.nivel_poder_uso) >= 2 then
        sheet.maledicencia = math.min(10, n(sheet.maledicencia) + 1)
    end
    if n(sheet.maledicencia) >= 10 then
        avisar("Maledicência 10: personagem sob controle do Mestre.")
    end
end

local function riquezaInicial()
    local pontos, maus = 0, 0
    for _, campo in ipairs(competencias) do
        pontos = pontos + n(sheet["comp_" .. campo])
        maus = maus + n(sheet["inc_" .. campo])
    end
    sheet.reis = 180 + 60 * pontos - 60 * maus
    avisar("Réis iniciais estimados: " .. sheet.reis)
end

local function iniciar()
    if sheet == nil then return end
    -- A ficha existente deve ser apenas lida: abrir como mestre não pode
    -- regravar valores nem disparar dezenas de sincronizações redundantes.
    if sheet.inicializado then
        return
    end

    -- Um único lote SOMENTE na primeira criação: endUpdate libera a
    -- sincronização logo após os padrões serem preenchidos.
    NDB.beginUpdate(sheet)
    local ok, erro = pcall(function()
    local function padrao(campo, valor)
        if sheet[campo] == nil then sheet[campo] = valor end
    end
    padrao("nivel", 1)
    padrao("maledicencia", 1)
    padrao("fichas", 3)
    padrao("firidas", 0)
    for _, campo in ipairs(maiores) do padrao(campo, 1) end
    for _, campo in ipairs(menores) do padrao(campo, 0) end
    for _, campo in ipairs(competencias) do
        padrao("comp_" .. campo, 0)
        padrao("inc_" .. campo, 0)
    end
    padrao("protecao", 0)
    padrao("protecao_extra", 0)
    padrao("teste_mod", 0)
    padrao("teste_tipo_nome", "Padrão")
    padrao("teste_maior_nome", "Parrudez")
    padrao("teste_menor_nome", "Fôrça")
    padrao("teste_comp_nome", "Sem competência")
    padrao("teste_dificuldade", 10)
    padrao("nivel_poder_uso", 1)
    padrao("reis", 180)
    padrao("cura_propria", false)
    padrao("arma_branca", false)
    atualizarComplementos()
    sheet.inicializado = true
    end)
    -- Mesmo se algum campo falhar, libera o estado em alterações.
    NDB.endUpdate(sheet)
    if not ok then avisar("Falha ao inicializar ficha: " .. tostring(erro)) end
end

-- A escolha é feita pelo diálogo nativo do Firecast (imagens locais ou URL).
-- O valor retornado é persistido em foto_personagem e o retrato é atualizado.
local function escolherFoto()
    Dialogs.selectImageURL(sheet.foto_personagem or "", function(url)
        if sheet ~= nil and url ~= nil and url ~= "" then
            sheet.foto_personagem = url
        end
    end)
end

local function removerFoto()
    sheet.foto_personagem = nil
end
]]></script>
  <event name="onNodeReady"><![CDATA[iniciar()]]></event>
  <tabControl align="client" tabIndex="0">
    <tab title="Geral">
  <scrollBox align="client">
    <layout align="top" height="941">
      <layout align="client" height="941">
        <image align="client" src="/assets/background_geral.jpg" style="stretch" />
        <layout width="400" height="200" left="117" top="200">
          <image src="/assets/01_identificacao_e_retrato.png" align="top" height="58" style="autoFit" margins="{bottom=23}" />
          <layout align="top" height="124">
            <layout align="left" width="103" margins="{left=9,right=10}">
              <image align="top" height="91" field="foto_personagem" editable="true" style="autoFit" hint="Clique para selecionar a foto" />
              <button text="Trocar foto" align="top" height="24" margins="{top=5}" fontSize="11">
                <event name="onClick">escolherFoto()</event>
              </button>
            </layout>
            <layout align="client" margins="{right=12}">
              <layout align="top" height="28">
                <label text="Nome" align="left" width="62" fontSize="12" />
                <edit field="nome" align="client" fontSize="12" />
              </layout>
              <layout align="top" height="28">
                <label text="Jogador" align="left" width="62" fontSize="12" />
                <edit field="jogador" align="client" fontSize="12" />
              </layout>
              <layout align="top" height="28">
                <label text="Bando" align="left" width="62" fontSize="12" />
                <edit field="bando" align="client" fontSize="12" />
              </layout>
              <layout align="top" height="30">
                <label text="Arquétipo" align="left" width="64" fontSize="12" />
                <comboBox field="arquetipo" items="{'Quarto de Cela', 'Sangue nos Ói', 'Bileiro', 'Besta-fera', 'Peito de Aço', 'Enrrolador', 'Caixão e Vela Preta', 'Sorrateiro', 'Raio da Silibrina'}" align="client" fontSize="12" />
              </layout>
            </layout>
          </layout>
        </layout>
        <layout width="399" height="228" left="115" top="455">
          <image src="/assets/02_historia_e_complementos.png" align="top" height="50" style="autoFit" margins="{bottom=5}"/>
          <layout align="top" height="28" margins="{left=35,right=45}">
            <label text="Virtude" align="left" width="45" fontSize="12" />
            <edit field="virtude" align="left" fontSize="12" width="100"/>
          <layout align="left" width="12" />
            <label text="Fraqueza" align="left" width="60" fontSize="12" />
            <edit field="fraqueza" align="left" fontSize="12" width="130" />
          </layout>
          <layout align="top" height="26" margins="{left=35,right=45}">
            <label text="Carrêra" align="left" width="93" fontSize="12" />
            <edit field="valor_carrera" align="left" width="52" fontSize="12" />
            <button text="Rolar" align="right" height="25" width="79" fontSize="12">
              <event name="onClick">rolarComplemento("carrera", "Carrêra")</event>
            </button>
          </layout>
          <layout align="top" height="26" margins="{left=35,right=45}">
            <label text="Iniciativa" align="left" width="93" fontSize="12" />
            <edit field="valor_iniciativa" align="left" width="52" fontSize="12" />
            <button text="Rolar" align="right" height="25" width="79" fontSize="12">
              <event name="onClick">rolarComplemento("iniciativa", "Iniciativa")</event>
            </button>
          </layout>
          <layout align="top" height="26" margins="{left=35,right=45}">
            <label text="Leriado" align="left" width="93" fontSize="12" />
            <edit field="valor_leriado" align="left" width="52" fontSize="12" />
            <button text="Rolar" align="right" height="25" width="79" fontSize="12">
              <event name="onClick">rolarComplemento("leriado", "Leriado")</event>
            </button>
          </layout>
          <layout align="top" height="26" margins="{left=35,right=45}">
            <label text="Cabrêrisse" align="left" width="93" fontSize="12" />
            <edit field="valor_cabrerisse" align="left" width="52" fontSize="12" />
            <button text="Rolar" align="right" height="25" width="79" fontSize="12">
              <event name="onClick">rolarComplemento("cabrerisse", "Cabrêrisse")</event>
            </button>
          </layout>
          <button text="Atualizar complementos" align="left" height="24" margins="{left=120,right=14,top=3}" width="190" fontSize="12">
            <event name="onClick">atualizarComplementos()</event>
          </button>
        </layout>
        <layout width="575" height="500" left="610" top="210">
          <image src="/assets/03_atributos_e_testes.png" align="top" height="76" style="autoFit" margins="{bottom=1}"/>
          <layout align="top" height="8" />
          <layout align="top" height="157" margins="{left=9,right=9}">
            <layout align="left" width="267" frameStyle="/frames/card_panel.xml">
              <layout align="client" margins="{left=12,right=12,top=11,bottom=10}">
                  <image src="/assets/11_parrudez.png" align="top" height="36"  style="autoFit" margins="{bottom=5}" />
                <layout align="top" height="30">
                  <label fontStyle="bold" text="Atributo maior" align="left" width="102" fontSize="12" />
                  <edit fontStyle="bold" field="parrudez" align="left" width="48" fontSize="12" />
                </layout>
                <layout align="top" height="30">
                  <label text="Fôrça" align="left" width="102" fontSize="12" />
                  <edit field="forca" align="left" width="48" fontSize="12" />
                  <button text="Rolar" align="right" height="27" width="69" fontSize="11">
                    <event name="onClick">rolarAtributos("parrudez", "forca", "Parrudez", "Fôrça")</event>
                  </button>
                </layout>
                <layout align="top" height="30">
                  <label text="Saúde" align="left" width="102" fontSize="12" />
                  <edit field="saude" align="left" width="48" fontSize="12" />
                  <button text="Rolar" align="right" height="27" width="69" fontSize="11">
                    <event name="onClick">rolarAtributos("parrudez", "saude", "Parrudez", "Saúde")</event>
                  </button>
                </layout>
              </layout>
            </layout>
            <layout align="left" width="11" />
            <layout align="left" width="267" frameStyle="/frames/card_panel.xml">
              <layout align="client" margins="{left=12,right=12,top=11,bottom=10}">
                <image src="/assets/12_destreza.png" align="top" height="36"  style="autoFit" margins="{bottom=5}" />
                <layout align="top" height="30">
                  <label fontStyle="bold" text="Atributo maior" align="left" width="102" fontSize="12" />
                  <edit fontStyle="bold" field="destreza" align="left" width="48" fontSize="12" />
                </layout>
                <layout align="top" height="30">
                  <label text="Coordenação" align="left" width="102" fontSize="12" />
                  <edit field="coordenacao" align="left" width="48" fontSize="12" />
                  <button text="Rolar" align="right" height="27" width="69" fontSize="11">
                    <event name="onClick">rolarAtributos("destreza", "coordenacao", "Destreza", "Coordenação")</event>
                  </button>
                </layout>
                <layout align="top" height="30">
                  <label text="Ligeireza" align="left" width="102" fontSize="12" />
                  <edit field="ligeireza" align="left" width="48" fontSize="12" />
