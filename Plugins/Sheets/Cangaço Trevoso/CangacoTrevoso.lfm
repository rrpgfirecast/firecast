    <tab title="Equipamentos">
      <scrollBox align="client">
        <layout align="top" g="container" g-auto-height="true" g-cnt-gutter="18" g-cnt-line-spacing="22" g-cnt-horz-align="center" g-cnt-min-grid-width="740">
            <image src="/assets/background_equipamentos_1.png" align="client" style="stretch"/>
          <layout g="col" g-width="12" g-width-md="12" g-width-lg="12" g-width-xl="6" height="920" g-margin-bottom="20" g-max-width="850">
            <layout align="client" margins="{left=64, top=174, right=64, bottom=105}">
            <layout align="top" height="70">
              <image
                  src="/assets/08_armas_e_ataques.png"
                  align="left"
                  width="600"
                  height="45"
                  style="autoFit"
                  margins="{left=80}"/>
            </layout>             
              <label align="top" height="42" text="Cadastre armas e role o ataque no próprio item; os dados vão para o chat da mesa." fontColor="#CFCFCF"/>
              <layout align="top" height="40" padding="{left=12,right=12}">
                <button align="client" text="Adicionar arma / item">
                  <event name="onClick"><![CDATA[self.listaItens:append()]]></event>
                </button>
              </layout>
              <layout align="top" height="19"/>
              <recordList name="listaItens" field="itens" templateForm="frmCangacoItem" align="top" height="405" autoHeight="false"/>
            </layout>
          </layout>
          <layout g="col" g-width="12" g-width-md="12" g-width-lg="12" g-width-xl="6" height="780" g-margin-bottom="20" g-max-width="850">
            <layout align="client" margins="{left=64, top=174, right=64, bottom=105}">
              <layout align="top" height="90">
                <image
                    src="/assets/15_ataques_rapidos_e_heranca.png"
                    align="left"
                    width="600"
                    height="90"
                    style="autoFit"
                    margins="{left=80}"/>
              </layout> 
              <label align="top" height="42" text="Atalhos para ataques sem item cadastrado. O Mestre compara a sua rolagem." fontColor="#CFCFCF"/>
              <layout align="top" height="40" padding="{left=12,right=12}">
                <button align="client" text="Atacar: Arma de Fio">
                  <event name="onClick"><![CDATA[rolarAtaque("arma_fio", "Arma de Fio")]]></event>
                </button>
              </layout>
              <layout align="top" height="40" padding="{left=12,right=12}">
                <button align="client" text="Atacar: Arma de Póiva">
                  <event name="onClick"><![CDATA[rolarAtaque("arma_poiva", "Arma de Póiva")]]></event>
                </button>
              </layout>
              <layout align="top" height="26"/>
              <layout align="top" height="90">
                <image
                    src="/assets/herança.png"
                    align="left"
                    width="600"
                    height="90"
                    style="autoFit"
                    margins="{left=80}"/>
              </layout> 
              <layout align="top" height="34" padding="{left=12,right=10}">
                <label align="left" width="82" text="Objeto"/>
                <edit align="left" width="242" field="heranca"/>
              </layout>
              <layout align="top" height="34" padding="{left=12,right=10}">
                <label align="left" width="82" text="Efeito"/>
                <edit align="left" width="242" field="heranca_efeito"/>
              </layout>
              <layout align="top" height="18"/>
              <label align="top" height="42" text="Munição, alcance e dano de cada arma são informados na lista ao lado." fontColor="#CFCFCF"/>
            </layout>
          </layout>
        </layout>
      </scrollBox>
    </tab>
    <tab title="Condições e Cura">
      <scrollBox align="client">
        <layout align="top" g="container" g-auto-height="true" g-cnt-gutter="18" g-cnt-line-spacing="22" g-cnt-horz-align="center" g-cnt-min-grid-width="740">
          <image src="/assets/background_firidas_cura.png" align="client" style="stretch"/>

          <layout g="col" g-width="12" g-width-md="12" g-width-lg="12" g-width-xl="6" height="900" g-margin-bottom="20" g-max-width="850">
            <layout align="client" margins="{left=64, top=174, right=64, bottom=105}">
              <layout align="top" height="90">
                <image
                    src="/assets/09_firidas_e_protecao.png"
                    align="left"
                    width="600"
                    height="90"
                    style="autoFit"
                    margins="{left=95}"/>
              </layout>               <label align="top" height="42" text="Quatro caixas de Firidas; proteção descontada de cada ataque recebido." fontColor="#CFCFCF"/>
              <layout align="top" height="34" padding="{left=12,right=10}">
                <label align="left" width="160" text="Firidas (0 a 4)"/>
                <edit align="left" width="76" field="firidas"/>
              </layout>
              <layout align="top" height="34" padding="{left=12,right=10}">
                <label align="left" width="160" text="Dano recebido"/>
                <edit align="left" width="76" field="dano_recebido"/>
              </layout>
              <layout align="top" height="34" padding="{left=12,right=10}">
                <label align="left" width="160" text="Proteção"/>
                <edit align="left" width="76" field="protecao"/>
              </layout>
              <layout align="top" height="34" padding="{left=12,right=10}">
                <label align="left" width="160" text="Prot. extra"/>
                <edit align="left" width="76" field="protecao_extra"/>
              </layout>
              <layout align="top" height="40" padding="{left=12,right=12}">
                <button align="client" text="Aplicar dano e Firidas">
                  <event name="onClick"><![CDATA[sofrerDano()]]></event>
                </button>
              </layout>
              <layout align="top" height="40" padding="{left=12,right=12}">
                <button align="client" text="Mostrar estado dos ferimentos">
                  <event name="onClick"><![CDATA[avisar("Firidas: " .. n(sheet.firidas) .. "/4. Penalidade atual: " .. modFerimento())]]></event>
                </button>
              </layout>
            </layout>
          </layout>
          <layout g="col" g-width="12" g-width-md="12" g-width-lg="12" g-width-xl="6" height="800" g-margin-bottom="20" g-max-width="850">
            <layout align="client" margins="{left=64, top=174, right=64, bottom=105}">
            <layout align="top" height="80">
              <image
                  src="/assets/16_cura.png"
                  align="left"
                  width="600"
                  height="60"
                  style="autoFit"
                  margins="{left=80}"/>
            </layout>               <label align="top" height="42" text="O valor de Cura considera Parrudez do ferido. Teste do curador contra 10 + Parrudez." fontColor="#CFCFCF"/>
              <layout align="top" height="34" padding="{left=12,right=10}">
                <label align="left" width="150" text="Bônus da cura"/>
                <edit align="left" width="80" field="teste_cura_bonus"/>
              </layout>
              <layout align="top" height="38" padding="{left=16}">
                <label align="left" width="150" text="Cura própria?"/>
                <checkBox align="left" width="48" field="cura_propria"/>
              </layout>
              <layout align="top" height="40" padding="{left=12,right=12}">
                <button align="client" text="Rolar teste de cura">
                  <event name="onClick"><![CDATA[curar()]]></event>
                </button>
              </layout>
              <label align="top" height="42" text="A cura e a verificação de ferimentos seguem o funcionamento anterior da ficha." fontColor="#CFCFCF"/>
            </layout>
          </layout>
        </layout>
      </scrollBox>
    </tab>
    <tab title="Maledicência">
      <scrollBox align="client">
        <layout align="top" g="container" g-auto-height="true" g-cnt-gutter="18" g-cnt-line-spacing="22" g-cnt-horz-align="center" g-cnt-min-grid-width="740">

          <image src="/assets/background_maledicência.png" align="client" style="stretch"/>
          <layout g="col" g-width="12" g-width-md="12" g-width-lg="12" g-width-xl="6" height="900" g-margin-bottom="20" g-max-width="850">
            <layout align="client" margins="{left=89, top=174, right=64, bottom=105}">
              <layout align="top" height="70" margins="{top=40, bottom=40}">
                <image
                    src="/assets/17_fichas_narrativas.png"
                    align="left"
                    width="500"
                    height="45"
                    style="autoFit"
                    margins="{left=130}"/>
              </layout>               
              <layout align="top" height="34" padding="{left=12,right=10}">
                <label align="left" width="155" text="Fichas disponíveis"/>
                <edit align="left" width="74" field="fichas"/>
              </layout>
              <layout align="top" height="34" padding="{left=12,right=10}">
                <label align="left" width="155" text="Maledicência"/>
                <edit align="left" width="74" field="maledicencia"/>
              </layout>
              <layout align="top" height="34" padding="{left=12,right=10}">
                <label align="left" width="155" text="Nível do poder"/>
                <edit align="left" width="74" field="nivel_poder_uso"/>
              </layout>
              <layout align="top" height="38" padding="{left=16}">
                <label align="left" width="160" text="Poder ativo na cena?"/>
                <checkBox align="left" width="48" field="poder_ativo"/>
              </layout>
              <layout align="top" height="40" padding="{left=12,right=12}">
                <button align="client" text="Gastar ficha narrativa">
                  <event name="onClick"><![CDATA[gastarFicha(false)]]></event>
                </button>
              </layout>
              <layout align="top" height="40" padding="{left=12,right=12}">
                <button align="client" text="Usar poder de Maledicência">
                  <event name="onClick"><![CDATA[gastarFicha(true)]]></event>
                </button>
              </layout>
              <layout align="top" height="40" padding="{left=12,right=12}">
                <button align="client" text="Ganhar 1 ficha">
                  <event name="onClick"><![CDATA[sheet.fichas=n(sheet.fichas)+1]]></event>
                </button>
              </layout>
              <layout align="top" height="40" padding="{left=12,right=12}">
                <button align="client" text="Redenção: -1 Maledicência">
                  <event name="onClick"><![CDATA[sheet.maledicencia=math.max(1,n(sheet.maledicencia)-1)]]></event>
                </button>
              </layout>
            </layout>
          </layout>
          <layout g="col" g-width="12" g-width-md="12" g-width-lg="12" g-width-xl="6" height="710" g-margin-bottom="20" g-max-width="850">
            <layout align="client" margins="{left=64, top=174, right=64, bottom=105}">
              <layout align="top" height="70" margins="{bottom=40, top=40}">
                <image
                    src="/assets/10_maledicencia_regras_e_lembretes.png"
                    align="left"
                    width="600"
                    height="45"
                    style="autoFit"
                    margins="{left=60}"/>
              </layout>              
              <label align="top" height="42" text="Use os poderes do arquétipo conforme o PDF e a decisão do Mestre." fontColor="#CFCFCF"/>
              <layout align="top" height="18"/>            
              <label align="top" height="42" text="Nível de Maledicência 10: personagem deixa o controle do jogador." fontColor="#CFCFCF"/>
              <label align="top" height="42" text="Crítico: 6+6. Falha crítica: 1+1. A decisão narrativa continua com a mesa." fontColor="#CFCFCF"/>
              <label align="top" height="42" text="O uso de poder acima do nível 1 pode aumentar a Maledicência." fontColor="#CFCFCF"/>
            </layout>
          </layout>
        </layout>
      </scrollBox>
    </tab>
    <tab title="Anotações">
      <scrollBox align="client">
        <layout align="top" g="container" g-auto-height="true" g-cnt-gutter="18" g-cnt-line-spacing="22" g-cnt-horz-align="center" g-cnt-min-grid-width="740">
          <image src="/assets/background_anotações.png" align="client" style="stretch"/>

          <layout g="col" g-width="12" g-width-md="12" g-width-lg="12" g-width-xl="6" height="870"  g-margin-bottom="20" g-max-width="850">
            <layout align="client" margins="{left=64, top=174, right=64, bottom=105}">
              <layout align="top" height="70" margins="{bottom=50, top=30}">
                <image
                    src="/assets/anotações.png"
                    align="left"
                    width="600"
                    height="45"
                    style="autoFit"
                    margins="{left=90}"/>
              </layout>              
              <textEditor align="top" height="420" margins="{left=30}" field="anotacoes"/>
            </layout>
          </layout>
          <layout g="col" g-width="12" g-width-md="12" g-width-lg="12" g-width-xl="6" height="710" g-margin-bottom="20" g-max-width="850">
            <layout align="client" margins="{left=64, top=174, right=64, bottom=105}">
              <layout align="top" height="90" margins="{bottom=40, top=23}">
                <image
                    src="/assets/referencias.png"
                    align="left"
                    width="600"
                    height="90"
                    style="autoFit"
                    margins="{left=80}"/>
              </layout>               
              <label align="top" height="42" text="Dificuldades de referência: 10 padrão, 15 desafiador, 20 difícil." fontColor="#CFCFCF"/>
              <label align="top" height="42" text="Rolagem padrão: 2d6 + maior + menor + competência. Complemento: 2d6 + complemento + competência." fontColor="#CFCFCF"/>
              <label align="top" height="42" text="Combate resistido: cada participante rola os próprios dados; o Mestre resolve a disputa." fontColor="#CFCFCF"/>
              <label align="top" height="42" text="Dano: margem da vitória + dano da arma (+ Fôrça em armas brancas)." fontColor="#CFCFCF"/>
              <label align="top" height="42" text="Cada Firida equivale a múltiplos de Saúde no mesmo ataque, após a proteção." fontColor="#CFCFCF"/>
            </layout>
          </layout>
        </layout>
      </scrollBox>
    </tab>
  </tabControl>
</form>
