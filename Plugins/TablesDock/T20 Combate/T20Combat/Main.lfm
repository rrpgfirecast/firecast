<?xml version="1.0" encoding="UTF-8"?>
<form name="frmT20Combat" formType="tablesDock" dataType="codex.t20.combate"
      title="T20 Combate" align="client" theme="dark" width="430" height="720">
    <script><![CDATA[
        require("firecast.lua")
        require("ndb.lua")
        require("dialogs.lua")
        require("utils.lua")
        require("scene.lua")
        require("system.lua")
        local T20DragState = require("T20Combat/DragState.lua")

        local FIB_DATA_TYPE = "fib.Tormenta20"
        local room = nil
        local chatReceiver = nil
        local selectedCombatant = nil
        local selectedCharacter = nil
        local selectedCharacterSheet = nil
        local syncCombatantToken = nil
        local cancelTokenLink = nil
        local unlinkCombatantTokens = nil
        local registerSheetObserver = nil
        local bindTokenToCombatant = nil
        local scenePluginId = nil
        local sceneItemHandlers = {}
        local tokenLinkHandlers = {}
        local pendingTokenCombatant = nil
        local pendingTargetAttacker = nil
        local pendingAttacks = {}
        local getCombatantTargets = nil
        local applyQuickEffectToTargets = nil
        local syncCombatantAuras = nil
        local applyAuraAction = nil
        local ConfiguredSpells = {}
        ConfiguredSpells.QuickNPC = {}
        ConfiguredSpells.QuickNPC.Abilities = {}
        ConfiguredSpells.PanelResize = {active=false}
        ConfiguredSpells.InitiativeSync = {}
        ConfiguredSpells.EffectSync = {pending={}}
        ConfiguredSpells.UIMenus = {}
        ConfiguredSpells.Opposed = {}
        ConfiguredSpells.BestOfTwo = {}
        ConfiguredSpells.BestOfTwo.suppressedDamage = {}
        ConfiguredSpells.MaximumDamage = {}
        local pendingSpellAreaConfig = nil
        local pendingSpellAreaMove = nil
        local targetRequestListener = nil
        local sheetObservers = {}
        local removeDefeatedNPC = nil
        local npcRemovalPending = {}
        local refreshTurnHighlight = nil
        local turnHighlightToken = nil
        local turnHighlightScene = nil
        local turnHighlightGeneration = 0
        local TURN_GLOW_OUTER = "codexT20TurnGlowOuterV1"
        local TURN_GLOW_INNER = "codexT20TurnGlowInnerV1"
        local PlayerDown = {}

        local skillDefinitions = {
            {id="Acro", category="physical"}, {id="Ades", category="mental"},
            {id="Atle", category="physical"}, {id="Atua", category="mental"},
            {id="Cava", category="physical"}, {id="Conh", category="mental"},
            {id="Cura", category="mental"}, {id="Dipl", category="mental"},
            {id="Enga", category="mental"}, {id="Fort", category="physical"},
            {id="Furt", category="physical"}, {id="Guer", category="mental"},
            {id="Inic", category="physical"}, {id="Inti", category="mental"},
            {id="Intu", category="mental"}, {id="Inve", category="mental"},
            {id="Joga", category="mental"}, {id="Ladi", category="physical"},
            {id="Luta", category="physical"}, {id="Mist", category="mental"},
            {id="Nobr", category="mental"}, {id="Ofi1", category="mental"},
            {id="Ofi2", category="mental"}, {id="Perc", category="mental"},
            {id="Pilo", category="physical"}, {id="Pont", category="physical"},
            {id="Refl", category="physical"}, {id="Reli", category="mental"},
            {id="Sobr", category="mental"}, {id="Vont", category="mental"}
        }

        local conditionDefinitions = {
            abalado = {
                name="Abalado", summary="-2 em testes de pericia; repetido vira Apavorado.",
                effects={skillAll=-2}, escalatesTo="apavorado"
            },
            agarrado = {
                name="Agarrado", summary="Desprevenido, imovel, -2 em ataques; apenas armas leves.",
                includes={"desprevenido", "imovel"}, effects={attack=-2}
            },
            alquebrado = {
                name="Alquebrado", summary="Habilidades e magias custam +1 PM.",
                effects={pmExtra=1}
            },
            apavorado = {
                name="Apavorado", summary="-5 em testes de pericia e deve fugir da fonte do medo.",
                effects={skillAll=-5}
            },
            atordoado = {
                name="Atordoado", summary="Desprevenido e sem acoes.",
                includes={"desprevenido"}, effects={actionState="Sem acoes"}
            },
            caido = {
                name="Caido", summary="-5 em ataques corpo a corpo; Defesa -5 corpo a corpo e +5 a distancia.",
                effects={contextualDefense=true, contextualAttack=true, movementState="1,5m"}
            },
            cego = {
                name="Cego", summary="Desprevenido, lento, -5 em pericias fisicas; alvos tem camuflagem total.",
                includes={"desprevenido", "lento"}, effects={skillPhysical=-5, perceptionBlocked=true}
            },
            confuso = {
                name="Confuso", summary="Rola 1d6 no inicio do turno para determinar o comportamento.",
                effects={startEffect="confuso"}
            },
            debilitado = {
                name="Debilitado", summary="-5 em testes fisicos; repetido deixa Inconsciente.",
                effects={skillPhysical=-5, attributePhysical=-5}, escalatesTo="inconsciente"
            },
            desprevenido = {
                name="Desprevenido", summary="-5 na Defesa e em Reflexos.",
                effects={defense=-5, reflex=-5}
            },
            doente = {
                name="Doente", summary="Sob efeito de uma doenca; efeitos definidos pela doenca.",
                effects={}
            },
            em_chamas = {
                name="Em Chamas", summary="Sofre 1d6 de fogo no inicio do turno.",
                effects={startEffect="em_chamas"}
            },
            enjoado = {
                name="Enjoado", summary="Apenas uma acao padrao ou de movimento por rodada.",
                effects={actionState="Padrao ou movimento"}
            },
            enredado = {
                name="Enredado", summary="Lento, vulneravel e -2 em ataques.",
                includes={"lento", "vulneravel"}, effects={attack=-2}
            },
            envenenado = {
                name="Envenenado", summary="Efeito e duracao definidos pelo veneno.",
                effects={}
            },
            esmorecido = {
                name="Esmorecido", summary="-5 em testes mentais.",
                effects={skillMental=-5, attributeMental=-5}
            },
            exausto = {
                name="Exausto", summary="Debilitado, lento e vulneravel; repetido deixa Inconsciente.",
                includes={"debilitado", "lento", "vulneravel"}, effects={}, escalatesTo="inconsciente"
            },
            fascinado = {
                name="Fascinado", summary="-5 em Percepcao e sem acoes alem de observar a fonte.",
                effects={perception=-5, actionState="Apenas observar"}
            },
            fatigado = {
                name="Fatigado", summary="Fraco e vulneravel; repetido vira Exausto.",
                includes={"fraco", "vulneravel"}, effects={}, escalatesTo="exausto"
            },
            fraco = {
                name="Fraco", summary="-2 em testes fisicos; repetido vira Debilitado.",
                effects={skillPhysical=-2, attributePhysical=-2}, escalatesTo="debilitado"
            },
            frustrado = {
                name="Frustrado", summary="-2 em testes mentais; repetido vira Esmorecido.",
                effects={skillMental=-2, attributeMental=-2}, escalatesTo="esmorecido"
            },
            imovel = {
                name="Imovel", summary="Deslocamentos reduzidos a 0m.",
                effects={movementState="0m"}
            },
            inconsciente = {
                name="Inconsciente", summary="Indefeso e sem acoes.",
                includes={"indefeso"}, effects={actionState="Sem acoes"}
            },
            indefeso = {
                name="Indefeso", summary="Defesa -10, falha automatica em Reflexos; sujeito a golpe de misericordia.",
                includes={"desprevenido"}, effects={defense=-10, reflexAutoFail=true}
            },
            lento = {
                name="Lento", summary="Deslocamentos pela metade; nao pode correr ou investir.",
                effects={movementState="Metade"}
            },
            ofuscado = {
                name="Ofuscado", summary="-2 em ataques e Percepcao.",
                effects={attack=-2, perception=-2}
            },
            paralisado = {
                name="Paralisado", summary="Imovel, indefeso; apenas acoes puramente mentais.",
                includes={"imovel", "indefeso"}, effects={actionState="Apenas acoes mentais"}
            },
            pasmo = {
                name="Pasmo", summary="Sem acoes, exceto reacoes.",
                effects={actionState="Apenas reacoes"}
            },
            petrificado = {
                name="Petrificado", summary="Inconsciente e resistencia a dano 8.",
                includes={"inconsciente"}, effects={damageReduction=8}
            },
            sangrando = {
                name="Sangrando", summary="Teste de Constituicao CD 15 no inicio do turno; falha causa 1d6.",
                effects={startEffect="sangrando"}
            },
            surdo = {
                name="Surdo", summary="Nao ouve, -5 em Iniciativa e condicao ruim para lancar magias.",
                effects={initiative=-5, hearingBlocked=true}
            },
            surpreendido = {
                name="Surpreendido", summary="Desprevenido; sem acoes, exceto reacoes.",
                includes={"desprevenido"}, effects={actionState="Apenas reacoes"}
            },
            vulneravel = {
                name="Vulneravel", summary="-2 na Defesa.",
                effects={defense=-2}
            }
        }

        local conditionOrder = {
            "abalado", "agarrado", "alquebrado", "apavorado", "atordoado", "caido", "cego",
            "confuso", "debilitado", "desprevenido", "doente", "em_chamas", "enjoado", "enredado",
            "envenenado", "esmorecido", "exausto", "fascinado", "fatigado", "fraco", "frustrado",
            "imovel", "inconsciente", "indefeso", "lento", "ofuscado", "paralisado", "pasmo",
            "petrificado", "sangrando", "surdo", "surpreendido", "vulneravel"
        }

        local function postChat(text)
            if room == nil or room.chat == nil then return end
            pcall(function() room.chat:enviarMensagem("[T20 Combate] " .. text) end)
        end

        local function isLocalGM()
            return room ~= nil and room.meuJogador ~= nil and room.meuJogador.isMestre == true
        end

        function ConfiguredSpells.canManageCombatant(combatant)
            if room == nil or room.meuJogador == nil or combatant == nil then return false end
            if isLocalGM() then return true end
            local code = tonumber(combatant.characterCode)
            local mainCode = tonumber(room.meuJogador.personagemPrincipal)
            local character = code and room:findBibliotecaItem(code) or nil
            local ownerLogin = character and character.dono and character.dono.login or nil
            local playerLogin = room.meuJogador.login
            return (character ~= nil and character.dono == room.meuJogador) or
                   (ownerLogin ~= nil and tostring(ownerLogin) == tostring(playerLogin or "")) or
                   (mainCode ~= nil and mainCode >= 0 and code == mainCode)
        end
        local function requireGM()
            if not isLocalGM() then
                showMessage("Apenas um mestre da mesa pode alterar o controle do combate.")
                return false
            end
            return true
        end

        local function canManageSelectedConditions()
            if room == nil or room.meuJogador == nil then return false end
            if isLocalGM() then return true end
            if selectedCombatant == nil then
                showMessage("Selecione seu personagem primeiro.")
                return false
            end

            if ConfiguredSpells.canManageCombatant(selectedCombatant) then return true end

            showMessage("Voce so pode alterar as condicoes dos seus proprios personagens.")
            return false
        end

        local function canRollSelectedInitiative()
            if room == nil or room.meuJogador == nil then return false end
            if isLocalGM() then return true end
            if selectedCombatant == nil then
                showMessage("Selecione seu personagem primeiro.")
                return false
            end

            local selectedCode = tonumber(selectedCombatant.characterCode)
            local mainCode = tonumber(room.meuJogador.personagemPrincipal)
            local character = selectedCode and room:findBibliotecaItem(selectedCode) or nil
            local isOwner = character ~= nil and character.dono == room.meuJogador

            if isOwner or (mainCode ~= nil and mainCode >= 0 and selectedCode == mainCode) then
                return true
            end

            showMessage("Voce so pode rolar a iniciativa dos seus proprios personagens.")
            return false
        end
        local function childContainer(root, fieldName, create)
            if root == nil then return nil end
            local container = root[fieldName]
            if container == nil and create then
                container = NDB.createChildNode(root, fieldName)
            end
            return container
        end

        local function childNodes(root, fieldName)
            local container = childContainer(root, fieldName, false)
            if container == nil then return {} end
            return NDB.getChildNodes(container)
        end

        local function findCondition(root, conditionId)
            local nodes = childNodes(root, "t20cConditions")
            for i = 1, #nodes do
                if nodes[i].conditionId == conditionId then return nodes[i] end
            end
            return nil
        end

        local function copyCondition(source, targetRoot)
            local container = childContainer(targetRoot, "t20cConditions", true)
            local target = NDB.createChildNode(container, "condition")
            target.conditionId = source.conditionId
            target.conditionName = source.conditionName
            target.effectSummary = source.effectSummary
            target.durationType = source.durationType
            target.remaining = source.remaining
        end

        local function setMostSevere(target, key, value)
            if value == nil then return end
            if type(value) == "number" then
                local current = target[key]
                if current == nil or value < current then target[key] = value end
            elseif target[key] == nil then
                target[key] = value
            end
        end

        local function calculateEffects(root)
            local result = {}
            local visited = {}

            local function visit(conditionId)
                if visited[conditionId] then return end
                visited[conditionId] = true
                local definition = conditionDefinitions[conditionId]
                if definition == nil then return end

                if definition.includes ~= nil then
                    for i = 1, #definition.includes do visit(definition.includes[i]) end
                end

                local effects = definition.effects or {}
                for key, value in pairs(effects) do setMostSevere(result, key, value) end
            end

            local conditions = childNodes(root, "t20cConditions")
            for i = 1, #conditions do visit(conditions[i].conditionId) end
            return result
        end

        local function minimumPenalty(...)
            local values = {...}
            local result = 0
            for i = 1, #values do
                local value = tonumber(values[i]) or 0
                if value < result then result = value end
            end
            return result
        end

        local function applyNumericDelta(node, valueField, markerField, newDelta)
            if node == nil then return end
            local oldDelta = tonumber(node[markerField]) or 0
            local currentValue
            if node[valueField] == nil then
                currentValue = 0
                oldDelta = 0
            else
                currentValue = tonumber(node[valueField]) or 0
            end
            local manualValue = currentValue - oldDelta
            node[valueField] = manualValue + (tonumber(newDelta) or 0)
            node[markerField] = tonumber(newDelta) or 0
        end

        local function conditionSummary(root)
            local nodes = childNodes(root, "t20cConditions")
            if #nodes == 0 then return "Sem condicoes" end
            table.sort(nodes, function(a, b)
                return (a.conditionName or "") < (b.conditionName or "")
            end)
            local parts = {}
            for i = 1, #nodes do
                local duration = "cena"
                if nodes[i].durationType == "rounds" then
                    duration = tostring(nodes[i].remaining or 0) .. "r"
                end
                parts[#parts + 1] = (nodes[i].conditionName or "Condicao") .. " (" .. duration .. ")"
            end
            return table.concat(parts, ", ")
        end

        local function calculateBuffTotals(root)
            local totals = {attack=0, damage=0, defense=0}
            local buffs = childNodes(root, "t20cBuffs")
            for i = 1, #buffs do
                totals.attack = totals.attack + (tonumber(buffs[i].attackBonus) or 0)
                totals.damage = totals.damage + (tonumber(buffs[i].damageBonus) or 0)
                totals.defense = totals.defense + (tonumber(buffs[i].defenseBonus) or 0)
            end
            return totals
        end

        local function buffDurationText(buff)
            if buff.durationType == "rounds" then return tostring(buff.remaining or 0) .. "r" end
            if buff.durationType == "manual" then return "manual" end
            return "cena"
        end

        local function buffSummary(root)
            local buffs = childNodes(root, "t20cBuffs")
            if #buffs == 0 then return "" end
            local parts = {}
            for i = 1, #buffs do
                parts[#parts + 1] = (buffs[i].buffName or "Buff") ..
                    " (" .. buffDurationText(buffs[i]) .. ")"
            end
            return table.concat(parts, ", ")
        end

        local function auraDurationText(aura)
            if aura.durationType == "rounds" then return tostring(aura.remaining or 0) .. "r" end
            if aura.durationType == "manual" then return "manual" end
            return "cena"
        end

        local function auraSummary(combatant)
            if combatant == nil then return "" end
            local auras = childNodes(combatant, "t20cAuras")
            if #auras == 0 then return "" end
            local parts = {}
            for i = 1, #auras do
                parts[#parts + 1] = (auras[i].auraName or "Aura") .. " " ..
                    tostring(auras[i].radiusMeters or 0) .. "m (" ..
                    auraDurationText(auras[i]) .. ")"
            end
            return "Auras: " .. table.concat(parts, ", ")
        end
        local function combinedStatusSummary(root)
            local conditions = conditionSummary(root)
            local buffs = buffSummary(root)
            if buffs == "" then return conditions end
            if conditions == "Sem condicoes" then return buffs end
            return conditions .. " | " .. buffs
        end
        local function getCombatants()
            if sheet == nil then return {} end
            return childNodes(sheet, "combatants")
        end

        local function newCombatantId()
            sheet.nextCombatantId = (tonumber(sheet.nextCombatantId) or 0) + 1
            return tostring(sheet.nextCombatantId)
        end

        local function ensureCombatantId(combatant)
            if combatant.combatantId == nil or tostring(combatant.combatantId) == "" then
                combatant.combatantId = newCombatantId()
            else
                local numericId = tonumber(combatant.combatantId)
                if numericId ~= nil and numericId > (tonumber(sheet.nextCombatantId) or 0) then
                    sheet.nextCombatantId = numericId
                end
            end
            return tostring(combatant.combatantId)
        end

        local function findReusableCombatant(characterCode)
            local nodes = getCombatants()
            for i = 1, #nodes do
                if tonumber(nodes[i].characterCode) == tonumber(characterCode) and
                   nodes[i].isIndependent ~= true then
                    return nodes[i]
                end
            end
            return nil
        end

        local function clearSheetAppliedDeltas(characterSheet)
            for i = 1, #skillDefinitions do
                local skill = skillDefinitions[i]
                applyNumericDelta(characterSheet, "outr" .. skill.id, "t20cAppliedOutr" .. skill.id, 0)
            end
            applyNumericDelta(characterSheet, "Outros_B_CA", "t20cAppliedDefense", 0)

            local attacks = childNodes(characterSheet, "listaDeAtaques")
            for i = 1, #attacks do
                applyNumericDelta(attacks[i], "bonusAtaque", "t20cAppliedAttack", 0)
            end
            local spells = childNodes(characterSheet, "listaDeMagias")
            for i = 1, #spells do
                applyNumericDelta(spells[i], "bonusAtaque", "t20cAppliedAttack", 0)
            end

            characterSheet.t20cPhysicalPenalty = 0
            characterSheet.t20cMentalPenalty = 0
            characterSheet.t20cPmExtra = 0
            characterSheet.t20cMovementState = "Normal"
            characterSheet.t20cActionState = "Normal"
            characterSheet.t20cReflexAutoFail = false
            characterSheet.t20cContextualDefense = false
            characterSheet.t20cConditionSummary = "Sem condicoes"
            characterSheet.t20cDamageBuff = 0
            characterSheet.t20cBuffSummary = ""
        end

        local function migrateLegacyEnemyConditions(combatant, characterSheet)
            if combatant == nil or combatant.isIndependent ~= true or characterSheet == nil then return end
            if characterSheet.t20cInstanceMigrationDone == true then return end
            characterSheet.t20cInstanceMigrationDone = true

            local legacy = childNodes(characterSheet, "t20cConditions")
            local current = childNodes(combatant, "t20cConditions")
            if #current == 0 then
                for i = 1, #legacy do copyCondition(legacy[i], combatant) end
            end
            for i = #legacy, 1, -1 do NDB.deleteNode(legacy[i]) end
            clearSheetAppliedDeltas(characterSheet)
        end

        local function conditionRoot(combatant, characterSheet)
            if combatant ~= nil and combatant.isIndependent == true then
                migrateLegacyEnemyConditions(combatant, characterSheet)
                return combatant
            end
            return characterSheet
        end

        local function signedNumber(value)
            local number = tonumber(value) or 0
            if number > 0 then return "+" .. tostring(number) end
            return tostring(number)
        end

        local function effectsSummary(effects, characterSheet, buffs, combatant)
            local defensePenalty = tonumber(effects.defense) or 0
            local attackPenalty = minimumPenalty(effects.skillAll, effects.skillPhysical, effects.attack)
            local physicalPenalty = minimumPenalty(effects.skillAll, effects.skillPhysical, effects.attributePhysical)
            local mentalPenalty = minimumPenalty(effects.skillAll, effects.skillMental, effects.attributeMental)
            local defenseBonus = tonumber(buffs and buffs.defense) or 0
            local attackBonus = tonumber(buffs and buffs.attack) or 0
            local damageBonus = tonumber(buffs and buffs.damage) or 0
            local defenseText = "Defesa " .. signedNumber(defensePenalty + defenseBonus)
            local effectiveDefense = tonumber(combatant and combatant.effectiveDefense)
            if effectiveDefense ~= nil then defenseText = "Defesa " .. tostring(effectiveDefense) end
            return defenseText .. " | Ataque " .. signedNumber(attackPenalty + attackBonus) ..
                   " | Dano " .. signedNumber(damageBonus) ..
                   " | Fisicos " .. signedNumber(physicalPenalty) ..
                   " | Mentais " .. signedNumber(mentalPenalty)
        end

        local function syncConditionEffects(combatant, character, characterSheet)
            if combatant == nil or characterSheet == nil then return end
            local root = conditionRoot(combatant, characterSheet)
            local effects = calculateEffects(root)
            local buffs = calculateBuffTotals(root)

            local physicalPenalty = minimumPenalty(effects.skillAll, effects.skillPhysical, effects.attributePhysical)
            local mentalPenalty = minimumPenalty(effects.skillAll, effects.skillMental, effects.attributeMental)
            local initiativePenalty = minimumPenalty(effects.skillAll, effects.skillPhysical, effects.initiative)
            local attackPenalty = minimumPenalty(effects.skillAll, effects.skillPhysical, effects.attack)
            local mentalAttackPenalty = minimumPenalty(effects.skillAll, effects.skillMental, effects.attack)

            combatant.physicalPenalty = physicalPenalty
            combatant.mentalPenalty = mentalPenalty
            combatant.reflexPenalty = minimumPenalty(effects.skillAll, effects.skillPhysical, effects.reflex)
            combatant.reflexAutoFail = effects.reflexAutoFail == true
            combatant.initiativePenalty = initiativePenalty
            combatant.defensePenalty = tonumber(effects.defense) or 0
            combatant.attackPenalty = attackPenalty
            combatant.mentalAttackPenalty = mentalAttackPenalty
            combatant.attackBuff = buffs.attack
            combatant.damageBuff = buffs.damage
            combatant.defenseBuff = buffs.defense
            combatant.pmExtra = tonumber(effects.pmExtra) or 0
            combatant.movementState = effects.movementState or "Normal"
            combatant.actionState = effects.actionState or "Normal"
            local statusText = combinedStatusSummary(root)
            local currentAuraSummary = auraSummary(combatant)
            if currentAuraSummary ~= "" then
                if statusText == "Sem condicoes" then
                    statusText = currentAuraSummary
                else
                    statusText = statusText .. " | " .. currentAuraSummary
                end
            end
            local downState = tostring(combatant.downState or "")
            if downState == "dead" then
                statusText = "MORTO (-10 PV) | " .. statusText
            elseif downState == "stable" then
                statusText = statusText .. " | Estado: estabilizado"
            elseif downState == "testing" then
                statusText = statusText .. " | Estado: Constituicao CD 15 pendente"
            end
            combatant.conditionsText = statusText

            if combatant.isIndependent == true then
                local baseDefense = tonumber(characterSheet.CA)
                combatant.effectiveDefense = baseDefense and
                    (baseDefense + (tonumber(combatant.defensePenalty) or 0) + buffs.defense) or nil
                if combatant.maxHP == nil then
                    combatant.maxHP = tonumber(characterSheet.PVs_Totais) or tonumber(characterSheet.PVs_Atuais) or 0
                end
                if combatant.currentHP == nil then
                    combatant.currentHP = tonumber(characterSheet.PVs_Atuais) or tonumber(combatant.maxHP) or 0
                end
                if combatant.maxPM == nil then
                    combatant.maxPM = tonumber(characterSheet.PMs_Totais)
                end
                if combatant.currentPM == nil then
                    combatant.currentPM = tonumber(characterSheet.PMs_Atuais) or tonumber(combatant.maxPM)
                end
            else
                NDB.beginUpdate(characterSheet)

                for i = 1, #skillDefinitions do
                    local skill = skillDefinitions[i]
                    local categoryPenalty = skill.category == "physical" and
                        (effects.skillPhysical or 0) or (effects.skillMental or 0)
                    local specificPenalty = 0
                    if skill.id == "Perc" then specificPenalty = effects.perception or 0 end
                    if skill.id == "Inic" then specificPenalty = effects.initiative or 0 end
                    if skill.id == "Refl" then specificPenalty = effects.reflex or 0 end
                    local penalty = minimumPenalty(effects.skillAll, categoryPenalty, specificPenalty)
                    applyNumericDelta(characterSheet, "outr" .. skill.id, "t20cAppliedOutr" .. skill.id, penalty)
                end

                applyNumericDelta(characterSheet, "Outros_B_CA", "t20cAppliedDefense",
                                  (tonumber(effects.defense) or 0) + buffs.defense)

                local attacks = childNodes(characterSheet, "listaDeAtaques")
                for i = 1, #attacks do
                    applyNumericDelta(attacks[i], "bonusAtaque", "t20cAppliedAttack",
                                      attackPenalty + buffs.attack)
                end
                local spells = childNodes(characterSheet, "listaDeMagias")
                for i = 1, #spells do
                    applyNumericDelta(spells[i], "bonusAtaque", "t20cAppliedAttack",
                                      mentalAttackPenalty + buffs.attack)
                end

                characterSheet.t20cPhysicalPenalty = physicalPenalty
                characterSheet.t20cMentalPenalty = mentalPenalty
                characterSheet.t20cPmExtra = tonumber(effects.pmExtra) or 0
                characterSheet.t20cMovementState = effects.movementState or "Normal"
                characterSheet.t20cActionState = effects.actionState or "Normal"
                characterSheet.t20cReflexAutoFail = effects.reflexAutoFail == true
                characterSheet.t20cContextualDefense = effects.contextualDefense == true
                characterSheet.t20cConditionSummary = conditionSummary(root)
                characterSheet.t20cDamageBuff = buffs.damage
                characterSheet.t20cBuffSummary = buffSummary(root)

                NDB.endUpdate(characterSheet)
                combatant.currentHP = tonumber(characterSheet.PVs_Atuais) or combatant.currentHP or 0
                combatant.maxHP = tonumber(characterSheet.PVs_Totais) or combatant.maxHP or 0
                combatant.currentPM = tonumber(characterSheet.PMs_Atuais)
                combatant.maxPM = tonumber(characterSheet.PMs_Totais)
                combatant.effectiveDefense = tonumber(characterSheet.CA)
            end
            combatant.effectsText = effectsSummary(effects, characterSheet, buffs, combatant)

            if syncCombatantToken ~= nil then
                syncCombatantToken(combatant, character, characterSheet)
            end
            if removeDefeatedNPC ~= nil then
                removeDefeatedNPC(combatant, character)
            end
        end

        function ConfiguredSpells.EffectSync.schedule(combatant, character, characterSheet)
            if combatant == nil or characterSheet == nil then return end
            local key = tostring(combatant.combatantId or combatant.characterCode or combatant)
            if ConfiguredSpells.EffectSync.pending[key] == true then return end
            ConfiguredSpells.EffectSync.pending[key] = true
            setTimeout(function()
                ConfiguredSpells.EffectSync.pending[key] = nil
                pcall(function()
                    syncConditionEffects(combatant, character, characterSheet)
                end)
            end, 1)
        end
        local function openCharacterSheet(character, onReady)
            if character == nil then return end
            character:asyncOpenNDB():thenDo(
                function(characterSheet)
                    if registerSheetObserver ~= nil then
                        registerSheetObserver(character, characterSheet)
                    end
                    if onReady ~= nil then onReady(characterSheet) end
                end,
                function(errorMessage)
                    showMessage("Nao foi possivel abrir a ficha: " .. tostring(errorMessage))
                end
            )
        end

        local function withSelectedSheet(callback)
            local combatant = selectedCombatant
            if combatant == nil then
                showMessage("Selecione um combatente primeiro.")
                return
            end

            local code = tonumber(combatant.characterCode)
            local character = room and room:findBibliotecaItem(code) or nil
            if character == nil or character.tipo ~= "personagem" then
                showMessage("O personagem selecionado nao foi encontrado na biblioteca.")
                return
            end

            if selectedCharacterSheet ~= nil and selectedCharacter ~= nil and
               tonumber(selectedCharacter.codigoInterno) == code then
                callback(combatant, character, selectedCharacterSheet)
                return
            end

            openCharacterSheet(character, function(characterSheet)
                selectedCharacter = character
                selectedCharacterSheet = characterSheet
                callback(combatant, character, characterSheet)
            end)
        end

        local function removeConditionById(combatant, character, characterSheet, conditionId)
            local root = conditionRoot(combatant, characterSheet)
            local node = findCondition(root, conditionId)
            if node ~= nil then NDB.deleteNode(node) end
            ConfiguredSpells.EffectSync.schedule(combatant, character, characterSheet)
        end

        local function addCondition(combatant, character, characterSheet, conditionId, durationText)
            local definition = conditionDefinitions[conditionId]
            if definition == nil then return end
            local root = conditionRoot(combatant, characterSheet)

            local existing = findCondition(root, conditionId)
            if existing ~= nil and definition.escalatesTo ~= nil then
                local escalatedId = definition.escalatesTo
                local escalatedDefinition = conditionDefinitions[escalatedId]
                NDB.deleteNode(existing)
                conditionId = escalatedId
                definition = escalatedDefinition
                postChat((combatant.name or "Personagem") .. " agravou a condicao para " .. definition.name .. ".")
                existing = findCondition(root, conditionId)
            end

            local durationNumber = tonumber(durationText)
            local durationType = "scene"
            local remaining = nil
            if durationNumber ~= nil and durationNumber > 0 then
                durationType = "rounds"
                remaining = math.floor(durationNumber)
            end

            local node = existing
            if node == nil then
                local container = childContainer(root, "t20cConditions", true)
                node = NDB.createChildNode(container, "condition")
            end
            if node == nil then
                showMessage("Nao foi possivel salvar a condicao.")
                return
            end

            node.conditionId = conditionId
            node.conditionName = definition.name
            node.effectSummary = definition.summary
            node.durationType = durationType
            node.remaining = remaining

            syncConditionEffects(combatant, character, characterSheet)
            postChat(definition.name .. " aplicada a " .. (combatant.name or "Personagem") .. ".")
        end

        local function chooseConditionToAdd()
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                local names = {}
                for i = 1, #conditionOrder do names[i] = conditionDefinitions[conditionOrder[i]].name end
                Dialogs.choose("Aplicar condicao", names,
                    function(selected, selectedIndex)
                        if not selected then return end
                        local conditionId = conditionOrder[selectedIndex]
                        Dialogs.inputQuery(
                            "Duracao",
                            "Numero de rodadas (deixe vazio para durar ate o fim da cena):",
                            "",
                            function(durationText)
                                if durationText == nil then return end
                                addCondition(combatant, character, characterSheet, conditionId, durationText)
                            end
                        )
                    end
                )
            end)
        end

        local function chooseConditionToRemove()
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                local root = conditionRoot(combatant, characterSheet)
                local conditions = childNodes(root, "t20cConditions")
                if #conditions == 0 then
                    showMessage("Este combatente nao possui condicoes registradas.")
                    return
                end
                table.sort(conditions, function(a, b) return (a.conditionName or "") < (b.conditionName or "") end)
                local names = {}
                for i = 1, #conditions do names[i] = conditions[i].conditionName or "Condicao" end
                Dialogs.choose("Remover condicao", names,
                    function(selected, selectedIndex)
                        if not selected then return end
                        local conditionName = conditions[selectedIndex].conditionName
                        NDB.deleteNode(conditions[selectedIndex])
                        ConfiguredSpells.EffectSync.schedule(combatant, character, characterSheet)
                        postChat(conditionName .. " removida de " .. (combatant.name or "Personagem") .. ".")
                    end
                )
            end)
        end

        local function clearSelectedConditions()
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                Dialogs.choose("Limpar condicoes", {"Sim", "Nao"},
                    function(selected, selectedIndex)
                        if not selected or selectedIndex ~= 1 then return end
                        local root = conditionRoot(combatant, characterSheet)
                        local conditions = childNodes(root, "t20cConditions")
                        for i = #conditions, 1, -1 do NDB.deleteNode(conditions[i]) end
                        ConfiguredSpells.EffectSync.schedule(combatant, character, characterSheet)
                        postChat("Todas as condicoes foram removidas de " .. (combatant.name or "Personagem") .. ".")
                    end
                )
            end)
        end
        local quickBuffTypes = {
            {key="attack", name="Ataque", attack=1, damage=0, defense=0},
            {key="damage", name="Dano", attack=0, damage=1, defense=0},
            {key="defense", name="Defesa", attack=0, damage=0, defense=1},
            {key="all", name="Todos", attack=1, damage=1, defense=1}
        }

        local function quickBuffTypeByKey(key)
            for i = 1, #quickBuffTypes do
                if quickBuffTypes[i].key == key then return quickBuffTypes[i] end
            end
            return nil
        end

        local function createQuickBuff(combatant, character, characterSheet,
                                       buffType, value, durationType, remaining)
            local root = conditionRoot(combatant, characterSheet)
            local container = childContainer(root, "t20cBuffs", true)
            local node = NDB.createChildNode(container, "buff")
            if node == nil then
                showMessage("Nao foi possivel salvar o efeito.")
                return false
            end
            local effectKind = value < 0 and "Debuff" or "Buff"
            node.buffId = tostring(ensureCombatantId(combatant)) .. ":" ..
                          tostring(System.getTickCount()) .. ":" .. tostring(#childNodes(root, "t20cBuffs"))
            node.buffName = effectKind .. " " .. buffType.name .. " " .. signedNumber(value)
            node.effectKind = string.lower(effectKind)
            node.attackBonus = (tonumber(buffType.attack) or 0) * value
            node.damageBonus = (tonumber(buffType.damage) or 0) * value
            node.defenseBonus = (tonumber(buffType.defense) or 0) * value
            node.durationType = durationType
            node.remaining = remaining
            syncConditionEffects(combatant, character, characterSheet)
            postChat(node.buffName .. " aplicado a " ..
                     (combatant.name or "Personagem") .. " (" .. buffDurationText(node) .. ").")
            return true
        end

        local function applyQuickEffectToCombatant(combatant, buffType, value,
                                                   durationType, remaining)
            if combatant == nil or buffType == nil then return false end
            local character = room:findBibliotecaItem(tonumber(combatant.characterCode))
            if character == nil then return false end
            openCharacterSheet(character, function(characterSheet)
                createQuickBuff(combatant, character, characterSheet, buffType, value,
                                durationType, remaining)
            end)
            return true
        end

        applyQuickEffectToTargets = function(source, effectKey, value, durationType, remaining)
            local buffType = quickBuffTypeByKey(tostring(effectKey or ""))
            value = tonumber(value)
            if source == nil or buffType == nil or value == nil or value == 0 then return 0 end
            if durationType ~= "scene" and durationType ~= "rounds" and durationType ~= "manual" then
                return 0
            end
            if durationType == "rounds" then
                remaining = math.floor(tonumber(remaining) or 0)
                if remaining <= 0 then return 0 end
            else
                remaining = nil
            end

            local targets = getCombatantTargets and getCombatantTargets(source) or {}
            if #targets == 0 then
                postChat((source.name or "Combatente") .. " tentou aplicar um efeito, mas nao possui alvos marcados.")
                return 0
            end
            local applied = 0
            for i = 1, #targets do
                if applyQuickEffectToCombatant(targets[i], buffType, value,
                                               durationType, remaining) then
                    applied = applied + 1
                end
            end
            sheet.lastCapture = (value < 0 and "Debuff" or "Buff") .. " aplicado em " ..
                                tostring(applied) .. " alvo(s) de " .. (source.name or "Combatente")
            return applied
        end

        local function requestQuickEffectForTargets(source, buffType, value,
                                                    durationType, remaining)
            if source == nil or buffType == nil then return false end
            if isLocalGM() then
                return applyQuickEffectToTargets(source, buffType.key, value,
                                                 durationType, remaining) > 0
            end
            NDB.broadcastMessage(sheet, "t20c_target_request", {
                attackerId=tostring(ensureCombatantId(source)),
                action="quick_effect_targets",
                effectKey=buffType.key,
                effectValue=value,
                effectDurationType=durationType,
                effectRemaining=remaining
            })
            pcall(function()
                sheet.lastCapture = "Pedido enviado ao mestre para aplicar o efeito nos alvos"
            end)
            return true
        end

        function ConfiguredSpells.requestQuickEffectForSelected(target, buffType, value,
                                                                 durationType, remaining)
            if target == nil or buffType == nil or room == nil or room.meuJogador == nil then
                return false
            end
            if isLocalGM() then
                return applyQuickEffectToCombatant(target, buffType, value,
                                                   durationType, remaining)
            end

            local mainCode = tonumber(room.meuJogador.personagemPrincipal)
            local source = mainCode and findReusableCombatant(mainCode) or nil
            if source == nil then
                local combatants = getCombatants()
                for i = 1, #combatants do
                    if ConfiguredSpells.canManageCombatant(combatants[i]) then
                        source = combatants[i]
                        break
                    end
                end
            end
            if source == nil or tostring(source.combatantId or "") == "" then
                showMessage("Seu personagem precisa estar no tracker para aplicar um efeito em outro combatente.")
                return false
            end

            NDB.broadcastMessage(sheet, "t20c_target_request", {
                attackerId=tostring(source.combatantId),
                targetId=tostring(target.combatantId or ""),
                action="quick_effect_selected",
                effectKey=buffType.key,
                effectValue=value,
                effectDurationType=durationType,
                effectRemaining=remaining
            })
            pcall(function()
                sheet.lastCapture = "Pedido enviado ao mestre para aplicar o efeito em " ..
                                    tostring(target.name or "combatente")
            end)
            return true
        end
        local function chooseQuickEffectScope(combatant, character, characterSheet,
                                              buffType, value, durationType, remaining)
            local canUseAsSource = ConfiguredSpells.canManageCombatant(combatant)
            local choices = canUseAsSource and
                            {"Combatente selecionado", "Todos os alvos marcados"} or
                            {"Combatente selecionado"}
            Dialogs.choose("Aplicar efeito em", choices,
                function(scopeSelected, scopeIndex)
                    if not scopeSelected then return end
                    if scopeIndex == 2 then
                        if getCombatantTargets == nil or #getCombatantTargets(combatant) == 0 then
                            showMessage("Marque pelo menos um alvo antes de aplicar o efeito.")
                            return
                        end
                        requestQuickEffectForTargets(combatant, buffType, value,
                                                     durationType, remaining)
                    elseif canUseAsSource then
                        createQuickBuff(combatant, character, characterSheet, buffType, value,
                                        durationType, remaining)
                    else
                        ConfiguredSpells.requestQuickEffectForSelected(
                            combatant, buffType, value, durationType, remaining)
                    end
                end)
        end

        local function chooseQuickEffectDuration(combatant, character, characterSheet,
                                                 buffType, value)
            Dialogs.choose("Duracao do efeito",
                {"Ate o fim da cena", "Numero de rodadas", "Ate remover manualmente"},
                function(durationSelected, durationIndex)
                    if not durationSelected then return end
                    if durationIndex == 2 then
                        Dialogs.inputQuery("Rodadas", "Por quantas rodadas o efeito deve durar?", "1",
                            function(roundsText)
                                if roundsText == nil then return end
                                local rounds = math.floor(tonumber(roundsText) or 0)
                                if rounds <= 0 then
                                    showMessage("Informe uma quantidade valida de rodadas.")
                                    return
                                end
                                chooseQuickEffectScope(combatant, character, characterSheet,
                                                       buffType, value, "rounds", rounds)
                            end)
                    elseif durationIndex == 3 then
                        chooseQuickEffectScope(combatant, character, characterSheet,
                                               buffType, value, "manual", nil)
                    else
                        chooseQuickEffectScope(combatant, character, characterSheet,
                                               buffType, value, "scene", nil)
                    end
                end)
        end

        function ConfiguredSpells.openQuickBuffWizard(combatant, character, characterSheet)
            Dialogs.choose("Buff ou Debuff", {"Buff (bonus)", "Debuff (penalidade)"},
                function(kindSelected, kindIndex)
                    if not kindSelected then return end
                    local sign = kindIndex == 2 and -1 or 1
                    local names = {}
                    for i = 1, #quickBuffTypes do names[i] = quickBuffTypes[i].name end
                    Dialogs.choose(kindIndex == 2 and "Tipo de debuff" or "Tipo de buff", names,
                        function(typeSelected, typeIndex)
                            if not typeSelected then return end
                            local buffType = quickBuffTypes[typeIndex]
                            Dialogs.inputQuery(
                                kindIndex == 2 and "Valor do debuff" or "Valor do buff",
                                "Informe o valor sem sinal (ex.: 2):", "2",
                                function(valueText)
                                    if valueText == nil then return end
                                    local magnitude = math.abs(tonumber(valueText) or 0)
                                    if magnitude == 0 then
                                        showMessage("Informe um numero diferente de zero, como 2.")
                                        return
                                    end
                                    chooseQuickEffectDuration(combatant, character, characterSheet,
                                                              buffType, magnitude * sign)
                                end)
                        end)
                end)
        end

        local function chooseQuickBuffToAdd()
            if room == nil or room.meuJogador == nil then return end
            local combatant = selectedCombatant
            if combatant == nil then
                showMessage("Selecione quem recebera o buff ou debuff primeiro.")
                return
            end
            if ConfiguredSpells.canManageCombatant(combatant) then
                withSelectedSheet(function(selected, character, characterSheet)
                    ConfiguredSpells.openQuickBuffWizard(selected, character, characterSheet)
                end)
            else
                local character = room:findBibliotecaItem(tonumber(combatant.characterCode))
                ConfiguredSpells.openQuickBuffWizard(combatant, character, nil)
            end
        end        local function chooseQuickBuffToRemove()
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                local root = conditionRoot(combatant, characterSheet)
                local buffs = childNodes(root, "t20cBuffs")
                if #buffs == 0 then
                    showMessage("Este combatente nao possui buffs ou debuffs registrados.")
                    return
                end
                local names = {}
                for i = 1, #buffs do
                    names[i] = (buffs[i].buffName or "Buff") ..
                               " (" .. buffDurationText(buffs[i]) .. ")"
                end
                Dialogs.choose("Remover efeito", names,
                    function(selected, selectedIndex)
                        if not selected then return end
                        local buffName = buffs[selectedIndex].buffName or "Efeito"
                        NDB.deleteNode(buffs[selectedIndex])
                        ConfiguredSpells.EffectSync.schedule(combatant, character, characterSheet)
                        postChat(buffName .. " removido de " ..
                                 (combatant.name or "Personagem") .. ".")
                    end
                )
            end)
        end

        local function clearSelectedBuffs()
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                local root = conditionRoot(combatant, characterSheet)
                local buffs = childNodes(root, "t20cBuffs")
                if #buffs == 0 then
                    showMessage("Este combatente nao possui buffs ou debuffs registrados.")
                    return
                end
                Dialogs.choose("Limpar efeitos", {"Confirmar", "Cancelar"},
                    function(selected, selectedIndex)
                        if not selected or selectedIndex ~= 1 then return end
                        for i = #buffs, 1, -1 do NDB.deleteNode(buffs[i]) end
                        ConfiguredSpells.EffectSync.schedule(combatant, character, characterSheet)
                        postChat("Todos os buffs e debuffs foram removidos de " ..
                                 (combatant.name or "Personagem") .. ".")
                    end
                )
            end)
        end
        local function collectCharacters(item, destination)
            if item == nil then return end
            if item.tipo == "personagem" and item.dataType == FIB_DATA_TYPE then
                destination[#destination + 1] = item
            end
            local children = item.children or {}
            for i = 1, #children do collectCharacters(children[i], destination) end
        end

        local function characterDisplayName(character, characterSheet)
            local function useful(value)
                local text = tostring(value or "")
                if text == "" then return nil end
                return text
            end

            return useful(characterSheet and characterSheet.NOME_DO_PERSONAGEM) or
                   useful(character and character.nome) or
                   useful(character and character.name) or
                   "Personagem"
        end

        local function instanceLabel(index)
            local value = math.max(1, math.floor(tonumber(index) or 1))
            local result = ""
            while value > 0 do
                local remainder = (value - 1) % 26
                result = string.char(65 + remainder) .. result
                value = math.floor((value - 1) / 26)
            end
            return result
        end

        local function nextInstanceIndex(characterCode)
            local highest = 0
            local nodes = getCombatants()
            for i = 1, #nodes do
                if tonumber(nodes[i].characterCode) == tonumber(characterCode) and
                   nodes[i].isIndependent == true then
                    highest = math.max(highest, tonumber(nodes[i].instanceIndex) or 0)
                end
            end
            return highest + 1
        end

        local function updateCombatantName(combatant, character, characterSheet)
            local baseName = characterDisplayName(character, characterSheet)
            combatant.baseName = baseName
            if combatant.isIndependent == true then
                combatant.instanceIndex = tonumber(combatant.instanceIndex) or
                    nextInstanceIndex(combatant.characterCode)
                combatant.instanceLabel = instanceLabel(combatant.instanceIndex)
                combatant.name = baseName .. " " .. combatant.instanceLabel
            else
                combatant.instanceLabel = ""
                combatant.name = baseName
            end
        end

        local function updateCombatantFromSheet(combatant, character, characterSheet)
            if combatant == nil or characterSheet == nil then return end
            ensureCombatantId(combatant)
            updateCombatantName(combatant, character, characterSheet)
            syncConditionEffects(combatant, character, characterSheet)
            if ConfiguredSpells.syncSummary ~= nil then
                ConfiguredSpells.syncSummary(combatant, characterSheet)
            end
            if ConfiguredSpells.QuickNPC.Abilities.syncSummary ~= nil then
                ConfiguredSpells.QuickNPC.Abilities.syncSummary(combatant, characterSheet)
            end
            if PlayerDown.handleHP ~= nil then
                PlayerDown.handleHP(combatant, character, characterSheet, true)
            end

            local baseInitiative = tonumber(characterSheet.totalInic) or 0
            if combatant.isIndependent == true then
                combatant.initiativeMod = baseInitiative + (tonumber(combatant.initiativePenalty) or 0)
            else
                combatant.initiativeMod = baseInitiative
            end
            self.rclCombatants:sort()
        end

        local TOKEN_HP_COLOR = "#2ECC71"
        local TOKEN_PM_COLOR = "#66CCFF"
        local TOKEN_DEFENSE_COLOR = "#F1C40F"

        local function currentRoomCode()
            return room and room.codigoInterno or nil
        end

        local function isSceneFromCurrentRoom(scene)
            if scene == nil or room == nil then return false end
            local sceneRoom = Firecast.getMesaDe(scene)
            return sceneRoom ~= nil and
                   tostring(sceneRoom.codigoInterno) == tostring(currentRoomCode())
        end

        local function loadedRoomScenes()
            local result = {}
            local scenes = SceneLib.getLoadedScenes() or {}
            for i = 1, #scenes do
                if isSceneFromCurrentRoom(scenes[i]) then
                    result[#result + 1] = scenes[i]
                end
            end
            return result
        end

        local function forEachRoomToken(callback)
            local scenes = loadedRoomScenes()
            for sceneIndex = 1, #scenes do
                local scene = scenes[sceneIndex]
                for itemIndex = 1, #scene.items do
                    local item = scene.items[itemIndex]
                    if item ~= nil and item.objectType == "token" then
                        callback(item, scene)
                    end
                end
            end
        end

        local function canEditToken(token)
            if room == nil or room.meuJogador == nil or token == nil then return false end
            if isLocalGM() then return true end
            return token.isMine == true
        end

        local function clearTokenBars(token)
            token.barValue1 = ""
            token.barMax1 = ""
            token.barValue2 = ""
            token.barMax2 = ""
            token.barValue3 = ""
            token.barMax3 = ""
        end

        local function bindingVersion(combatant)
            return tostring(math.floor(tonumber(combatant and combatant.tokenLinkVersion) or 0))
        end

        local function tokenMatchesCombatant(token, combatant)
            if token == nil or combatant == nil or token.userData == nil then return false end
            local storedRoom = tostring(token.userData.codexT20RoomId or "")
            local wantedRoom = tostring(currentRoomCode() or "")
            local storedId = tostring(token.userData.codexT20CombatantId or "")
            local storedVersion = tostring(token.userData.codexT20LinkVersion or "0")
            return (storedRoom == "" or storedRoom == wantedRoom) and
                   storedId == tostring(ensureCombatantId(combatant)) and
                   storedVersion == bindingVersion(combatant)
        end

        local function findCombatantByBinding(combatantId, version)
            local nodes = getCombatants()
            for i = 1, #nodes do
                if tostring(ensureCombatantId(nodes[i])) == tostring(combatantId or "") and
                   bindingVersion(nodes[i]) == tostring(version or "0") then
                    return nodes[i]
                end
            end
            return nil
        end

        local function findTokenForCombatant(combatant)
            local foundToken = nil
            local foundScene = nil
            forEachRoomToken(function(token, scene)
                if foundToken == nil and tokenMatchesCombatant(token, combatant) then
                    foundToken = token
                    foundScene = scene
                end
            end)
            return foundToken, foundScene
        end

        local AURA_FILL_PREFIX = "codexT20AuraFillV1:"
        local AURA_PATH = "M 0.5 0 C 0.776 0 1 0.224 1 0.5 " ..
                          "C 1 0.776 0.776 1 0.5 1 " ..
                          "C 0.224 1 0 0.776 0 0.5 C 0 0.224 0.224 0 0.5 0 Z"

        local function normalizeAuraColor(value)
            local color = string.upper(tostring(value or ""))
            if string.match(color, "^#%x%x%x%x%x%x$") == nil then return nil end
            return color
        end

        local function auraOpName(auraId)
            return AURA_FILL_PREFIX .. tostring(auraId or "")
        end

        local function deleteAuraOpFromToken(token, auraId)
            if token == nil or token.isObjectAlive == false or token.canvas == nil then return false end
            local op = token.canvas:findByName(auraOpName(auraId))
            if op == nil then return false end
            pcall(function() op:delete() end)
            return true
        end

        local function drawAuraOnToken(token, scene, aura, zIndex)
            if token == nil or scene == nil or aura == nil or not canEditToken(token) then return false end
            local radius = tonumber(aura.radiusMeters)
            local color = normalizeAuraColor(aura.auraColor)
            if radius == nil or radius <= 0 or color == nil then return false end
            deleteAuraOpFromToken(token, aura.auraId)

            local op = token.canvas:addPath()
            if op == nil then return false end
            op.name = auraOpName(aura.auraId)
            op.data = AURA_PATH
            op.x = -radius; op.y = -radius
            op.width = radius * 2; op.height = radius * 2
            op.xMetric = "worldMetric"; op.yMetric = "worldMetric"
            op.widthMetric = "worldMetric"; op.heightMetric = "worldMetric"
            op.xOrigin = 0.5; op.yOrigin = 0.5
            op.color = color .. "30"
            op.strokeColor = color .. "D8"
            op.strokeSize = 2
            op.strokeSizeMetric = "screenMetric"
            op.strokeJoin = "round"
            op.z = -10000 + (tonumber(zIndex) or 0)
            op.visibility = "everyone"
            op.rotMode = "ignoreCanvasRot"
            op.outOfOrderMode = "beforeOwnerLayer"
            return true
        end

        local function deleteAuraVisual(combatant, auraId)
            if combatant == nil then return false end
            local token, scene = findTokenForCombatant(combatant)
            if token == nil or scene == nil or not canEditToken(token) then return false end
            local changed = deleteAuraOpFromToken(token, auraId)
            if changed then pcall(function() scene:sendDelayedUpdates() end) end
            return changed
        end

        local function clearAuraVisuals(combatant)
            if combatant == nil then return false end
            local token, scene = findTokenForCombatant(combatant)
            if token == nil or scene == nil or not canEditToken(token) then return false end
            local changed = false
            local auras = childNodes(combatant, "t20cAuras")
            for i = 1, #auras do
                if deleteAuraOpFromToken(token, auras[i].auraId) then changed = true end
            end
            if changed then pcall(function() scene:sendDelayedUpdates() end) end
            return changed
        end

        syncCombatantAuras = function(combatant)
            if combatant == nil or combatant.tokenLinked ~= true then return false end
            local token, scene = findTokenForCombatant(combatant)
            if token == nil or scene == nil or not canEditToken(token) then return false end
            local auras = childNodes(combatant, "t20cAuras")
            local changed = false
            for i = 1, #auras do
                if drawAuraOnToken(token, scene, auras[i], i) then changed = true end
            end
            if changed then pcall(function() scene:sendDelayedUpdates() end) end
            return changed
        end
        local function deleteHighlightOps(token)
            if token == nil or token.isObjectAlive == false or token.canvas == nil then return false end
            local changed = false
            local outer = token.canvas:findByName(TURN_GLOW_OUTER)
            local inner = token.canvas:findByName(TURN_GLOW_INNER)
            if outer ~= nil then pcall(function() outer:delete() end); changed = true end
            if inner ~= nil then pcall(function() inner:delete() end); changed = true end
            return changed
        end

        local function clearTurnHighlight()
            turnHighlightGeneration = turnHighlightGeneration + 1
            if deleteHighlightOps(turnHighlightToken) and turnHighlightScene ~= nil then
                pcall(function() turnHighlightScene:sendDelayedUpdates() end)
            end
            turnHighlightToken = nil
            turnHighlightScene = nil
        end

        local function clearAllTurnHighlights()
            turnHighlightGeneration = turnHighlightGeneration + 1
            if not isLocalGM() then
                turnHighlightToken = nil
                turnHighlightScene = nil
                return
            end
            forEachRoomToken(function(token, scene)
                if canEditToken(token) and deleteHighlightOps(token) then
                    pcall(function() scene:sendDelayedUpdates() end)
                end
            end)
            turnHighlightToken = nil
            turnHighlightScene = nil
        end

        refreshTurnHighlight = function(combatant)
            if not isLocalGM() then return end
            clearTurnHighlight()
            if combatant == nil then return end

            local token, scene = findTokenForCombatant(combatant)
            if token == nil or scene == nil or not canEditToken(token) then return end
            deleteHighlightOps(token)

            local ringPath = "M 0.5 0.02 C 0.765 0.02 0.98 0.235 0.98 0.5 " ..
                             "C 0.98 0.765 0.765 0.98 0.5 0.98 " ..
                             "C 0.235 0.98 0.02 0.765 0.02 0.5 " ..
                             "C 0.02 0.235 0.235 0.02 0.5 0.02 Z"
            local outer = token.canvas:addPath()
            if outer == nil then return end
            outer.name = TURN_GLOW_OUTER
            outer.data = ringPath
            outer.x = -0.05; outer.y = -0.05
            outer.width = 1.10; outer.height = 1.10
            outer.color = "#00000000"
            outer.strokeColor = "#FFD42A90"
            outer.strokeSize = 8
            outer.strokeSizeMetric = "screenMetric"
            outer.strokeJoin = "round"
            outer.z = 10000
            outer.visibility = "everyone"
            outer.outOfOrderMode = "afterOwnerLayer"

            local inner = token.canvas:addPath()
            if inner == nil then
                pcall(function() outer:delete() end)
                return
            end
            inner.name = TURN_GLOW_INNER
            inner.data = ringPath
            inner.x = -0.035; inner.y = -0.035
            inner.width = 1.07; inner.height = 1.07
            inner.color = "#00000000"
            inner.strokeColor = "#FFF4A3"
            inner.strokeSize = 3
            inner.strokeSizeMetric = "screenMetric"
            inner.strokeJoin = "round"
            inner.strokeDash = "dash"
            inner.z = 10001
            inner.visibility = "everyone"
            inner.outOfOrderMode = "afterOwnerLayer"

            turnHighlightToken = token
            turnHighlightScene = scene
            turnHighlightGeneration = turnHighlightGeneration + 1
            local generation = turnHighlightGeneration
            local bright = true
            pcall(function() scene:sendDelayedUpdates() end)

            local function pulse()
                if generation ~= turnHighlightGeneration or turnHighlightToken ~= token or
                   token.isObjectAlive == false or outer.isObjectAlive == false or
                   inner.isObjectAlive == false then return end
                bright = not bright
                outer.opacity = bright and 1.0 or 0.38
                inner.opacity = bright and 0.72 or 1.0
                inner.strokeColor = bright and "#FFF8C5" or "#F4B942"
                pcall(function() scene:sendDelayedUpdates() end)
                setTimeout(pulse, 420)
            end
            setTimeout(pulse, 420)
        end
        unlinkCombatantTokens = function(combatant, clearBars, preserveDeathMarker)
            if combatant == nil then return 0 end
            clearAuraVisuals(combatant)
            local removed = 0
            forEachRoomToken(function(token, scene)
                if tokenMatchesCombatant(token, combatant) and canEditToken(token) then
                    if preserveDeathMarker ~= true and PlayerDown.clearMarkerFromToken ~= nil then
                        PlayerDown.clearMarkerFromToken(token)
                    end
                    token.userData.codexT20CombatantId = nil
                    token.userData.codexT20LinkVersion = nil
                    token.userData.codexT20RoomId = nil
                    if clearBars == true then clearTokenBars(token) end
                    removed = removed + 1
                    pcall(function() scene:sendDelayedUpdates() end)
                end
            end)
            combatant.tokenLinkVersion = (tonumber(combatant.tokenLinkVersion) or 0) + 1
            combatant.tokenLinked = false
            combatant.tokenLinkText = "Token: nao vinculado"
            combatant.tokenName = nil
            if refreshTurnHighlight ~= nil and sheet ~= nil and
               tostring(sheet.currentCombatantId or "") == tostring(combatant.combatantId or "") then
                refreshTurnHighlight(combatant)
            end
            return removed
        end

        local function writeTokenBars(token, combatant, characterSheet)
            if not canEditToken(token) then return false end

            local currentHP = tonumber(combatant.currentHP)
            local maxHP = tonumber(combatant.maxHP)
            if currentHP ~= nil or maxHP ~= nil then
                currentHP = math.max(0, currentHP or maxHP or 0)
                maxHP = math.max(1, maxHP or currentHP, currentHP)
                token.barValue1 = tostring(currentHP)
                token.barMax1 = tostring(maxHP)
                token.barColor1 = TOKEN_HP_COLOR
            else
                token.barValue1 = ""
                token.barMax1 = ""
            end

            local currentPM = tonumber(combatant.currentPM)
            local maxPM = tonumber(combatant.maxPM)
            if currentPM == nil and characterSheet ~= nil then
                currentPM = tonumber(characterSheet.PMs_Atuais)
            end
            if maxPM == nil and characterSheet ~= nil then
                maxPM = tonumber(characterSheet.PMs_Totais)
            end
            if (maxPM or 0) > 0 or (currentPM or 0) > 0 then
                currentPM = math.max(0, currentPM or maxPM or 0)
                maxPM = math.max(1, maxPM or currentPM, currentPM)
                combatant.currentPM = currentPM
                combatant.maxPM = maxPM
                token.barValue2 = tostring(currentPM)
                token.barMax2 = tostring(maxPM)
                token.barColor2 = TOKEN_PM_COLOR
            else
                token.barValue2 = ""
                token.barMax2 = ""
            end

            local defense = tonumber(combatant.effectiveDefense)
            if defense == nil and characterSheet ~= nil then defense = tonumber(characterSheet.CA) end
            if defense ~= nil then
                token.barValue3 = tostring(defense)
                token.barMax3 = tostring(math.max(1, defense))
                token.barColor3 = TOKEN_DEFENSE_COLOR
            else
                token.barValue3 = ""
                token.barMax3 = ""
            end
            return true
        end

        syncCombatantToken = function(combatant, character, characterSheet)
            if combatant == nil or combatant.tokenLinked ~= true then return false end
            local token, scene = findTokenForCombatant(combatant)
            if token == nil then
                combatant.tokenLinkText = "Token: vinculado (tabuleiro fechado)"
                return false
            end
            if not writeTokenBars(token, combatant, characterSheet) then return false end
            combatant.tokenName = token.name or combatant.name or "Token"
            combatant.tokenLinkText = "Token: " .. tostring(combatant.tokenName)
            if PlayerDown.syncMarker ~= nil then PlayerDown.syncMarker(combatant) end
            pcall(function() scene:sendDelayedUpdates() end)
            return true
        end

        local function findCombatantById(combatantId)
            local nodes = getCombatants()
            for i = 1, #nodes do
                if tostring(ensureCombatantId(nodes[i])) == tostring(combatantId or "") then
                    return nodes[i]
                end
            end
            return nil
        end

        bindTokenToCombatant = function(target, token, scene, assignCharacter)
            if target == nil or token == nil or token.objectType ~= "token" then return false end
            if not canEditToken(token) then return false end

            local previousId = tostring(token.userData.codexT20CombatantId or "")
            local previousVersion = tostring(token.userData.codexT20LinkVersion or "0")
            local previousCombatant = findCombatantByBinding(previousId, previousVersion)
            unlinkCombatantTokens(target, false)
            if previousCombatant ~= nil and previousCombatant ~= target then
                unlinkCombatantTokens(previousCombatant, false)
            end

            if assignCharacter == true then
                pcall(function() token.ownerCharacter = tonumber(target.characterCode) or 0 end)
            end
            token.userData.codexT20CombatantId = tostring(ensureCombatantId(target))
            token.userData.codexT20LinkVersion = bindingVersion(target)
            token.userData.codexT20RoomId = tostring(currentRoomCode() or "")
            pcall(function() token.name = target.name or token.name end)
            target.tokenLinked = true
            target.tokenName = token.name or target.name or "Token"
            target.tokenLinkText = "Token: " .. tostring(target.tokenName)

            local character = room:findBibliotecaItem(tonumber(target.characterCode))
            if character ~= nil then
                openCharacterSheet(character, function(characterSheet)
                    updateCombatantFromSheet(target, character, characterSheet)
                end)
            end
            pcall(function() scene:sendDelayedUpdates() end)
            if refreshTurnHighlight ~= nil and sheet ~= nil and
               tostring(sheet.currentCombatantId or "") == tostring(target.combatantId or "") then
                refreshTurnHighlight(target)
            end
            if syncCombatantAuras ~= nil then syncCombatantAuras(target) end
            if PlayerDown.syncMarker ~= nil then PlayerDown.syncMarker(target) end
            return true
        end
        local function findCombatantForToken(token)
            if token == nil or token.userData == nil then return nil end
            return findCombatantByBinding(
                tostring(token.userData.codexT20CombatantId or ""),
                tostring(token.userData.codexT20LinkVersion or "0")
            )
        end

        local function targetNodes(attacker)
            if attacker == nil then return {} end
            return childNodes(attacker, "t20cTargets")
        end

        local function updateAreaModeText(attacker)
            if attacker == nil then return end
            local mode = tostring(attacker.areaMode or "defense")
            if mode == "save_half" or mode == "save_none" then
                local resultText = mode == "save_half" and "metade" or "anula"
                local armedText = attacker.areaArmed == true and " - aguardando dano da ficha" or ""
                attacker.areaModeText = "Magia: " .. tostring(attacker.areaSaveType or "Resistencia") ..
                                        " CD " .. tostring(attacker.areaSaveCD or "?") ..
                                        " (" .. resultText .. ")" .. armedText
            else
                attacker.areaMode = "defense"
                attacker.areaModeText = "Magia: desativada (Ataque x Defesa)"
                attacker.areaArmed = false
            end
        end

        local function findTargetNode(attacker, targetId)
            local nodes = targetNodes(attacker)
            for i = 1, #nodes do
                if tostring(nodes[i].targetCombatantId or "") == tostring(targetId or "") then
                    return nodes[i]
                end
            end
            return nil
        end

        local function migrateLegacyTarget(attacker)
            if attacker == nil or #targetNodes(attacker) > 0 then return end
            local legacyId = tostring(attacker.targetCombatantId or "")
            if legacyId == "" then return end
            local target = findCombatantById(legacyId)
            if target == nil or target == attacker then
                attacker.targetCombatantId = nil
                attacker.targetName = nil
                return
            end
            local container = childContainer(attacker, "t20cTargets", true)
            local node = NDB.createChildNode(container, "target")
            node.targetCombatantId = tostring(ensureCombatantId(target))
            node.targetName = target.name or "Combatente"
        end

        local function syncTargetSummary(attacker)
            if attacker == nil then return 0 end
            local nodes = targetNodes(attacker)
            local names = {}
            local firstTarget = nil
            for i = 1, #nodes do
                local target = findCombatantById(nodes[i].targetCombatantId)
                if target ~= nil and target ~= attacker then
                    nodes[i].targetName = target.name or nodes[i].targetName or "Combatente"
                    names[#names + 1] = nodes[i].targetName
                    if firstTarget == nil then firstTarget = target end
                elseif isLocalGM() then
                    NDB.deleteNode(nodes[i])
                end
            end

            attacker.targetCount = #names
            if firstTarget ~= nil then
                attacker.targetCombatantId = tostring(ensureCombatantId(firstTarget))
                attacker.targetName = firstTarget.name or "Combatente"
                attacker.targetText = "Alvos (" .. tostring(#names) .. "): " .. table.concat(names, ", ")
            else
                attacker.targetCombatantId = nil
                attacker.targetName = nil
                attacker.targetText = "Alvos: nenhum"
            end
            updateAreaModeText(attacker)
            return #names
        end

        getCombatantTargets = function(attacker)
            if attacker == nil then return {} end
            migrateLegacyTarget(attacker)
            syncTargetSummary(attacker)
            local result = {}
            local nodes = targetNodes(attacker)
            for i = 1, #nodes do
                local target = findCombatantById(nodes[i].targetCombatantId)
                if target ~= nil and target ~= attacker then result[#result + 1] = target end
            end
            return result
        end

        local function hasCombatantTargets(attacker)
            return #getCombatantTargets(attacker) > 0
        end

        local function addCombatantTarget(attacker, target)
            if attacker == nil or target == nil or attacker == target then return false end
            local targetId = tostring(ensureCombatantId(target))
            migrateLegacyTarget(attacker)
            if findTargetNode(attacker, targetId) ~= nil then
                syncTargetSummary(attacker)
                return false
            end
            local container = childContainer(attacker, "t20cTargets", true)
            local node = NDB.createChildNode(container, "target")
            node.targetCombatantId = targetId
            node.targetName = target.name or "Combatente"
            syncTargetSummary(attacker)
            return true
        end

        local function removeCombatantTarget(attacker, targetId)
            if attacker == nil then return false end
            migrateLegacyTarget(attacker)
            local removed = false
            local nodes = targetNodes(attacker)
            for i = #nodes, 1, -1 do
                if tostring(nodes[i].targetCombatantId or "") == tostring(targetId or "") then
                    NDB.deleteNode(nodes[i])
                    removed = true
                end
            end
            syncTargetSummary(attacker)
            return removed
        end

        local function clearCombatantTargets(attacker)
            if attacker == nil then return false end
            local nodes = targetNodes(attacker)
            local hadTargets = #nodes > 0 or tostring(attacker.targetCombatantId or "") ~= ""
            for i = #nodes, 1, -1 do NDB.deleteNode(nodes[i]) end
            attacker.targetCombatantId = nil
            attacker.targetName = nil
            attacker.targetCount = 0
            attacker.targetText = "Alvos: nenhum"
            attacker.areaMode = "defense"
            attacker.areaSaveType = nil
            attacker.areaSaveCD = nil
            attacker.areaArmed = false
            attacker.areaModeText = "Magia: desativada (Ataque x Defesa)"
            attacker.bestOfTwoArmed = false
            attacker.bestOfTwoArmedAt = nil
            attacker.maximumDamageArmed = false
            attacker.maximumDamageArmedAt = nil
            return hadTargets
        end

        local function applyAreaMode(attacker, mode, saveType, saveCD, armed)
            if attacker == nil then return false end
            if mode == "save_half" or mode == "save_none" then
                attacker.areaMode = mode
                attacker.areaSaveType = saveType
                attacker.areaSaveCD = tonumber(saveCD)
                attacker.areaArmed = armed == true
            else
                attacker.areaMode = "defense"
                attacker.areaSaveType = nil
                attacker.areaSaveCD = nil
                attacker.areaArmed = false
            end
            updateAreaModeText(attacker)
            return true
        end

        local function applyTargetAction(attacker, target, action, options)
            action = action or "add"
            if action == "clear" then return clearCombatantTargets(attacker) end
            if action == "remove" then
                return removeCombatantTarget(attacker, target and ensureCombatantId(target) or nil)
            end
            if action == "area_mode" then
                options = options or {}
                return applyAreaMode(attacker, options.mode, options.saveType,
                                     options.saveCD, options.armed)
            end
            return addCombatantTarget(attacker, target)
        end

        local function announceTargetAction(attacker, target, action, changed)
            if not changed then return end
            if action == "clear" then
                postChat((attacker.name or "Combatente") .. " limpou os alvos marcados.")
            elseif action == "remove" and target ~= nil then
                postChat((attacker.name or "Combatente") .. " removeu " ..
                         (target.name or "Combatente") .. " da lista de alvos.")
            elseif action == "add" and target ~= nil then
                postChat((attacker.name or "Combatente") .. " adicionou " ..
                         (target.name or "Combatente") .. " como alvo.")
            elseif action == "area_mode" then
                postChat((attacker.name or "Combatente") .. " preparou " ..
                         tostring(attacker.areaModeText or "o modo magia") .. ".")
            end
        end

        local function requestCombatantTarget(attacker, target, action, options)
            if attacker == nil or room == nil or room.meuJogador == nil then return false end
            action = action or "add"
            if isLocalGM() then
                local changed = applyTargetAction(attacker, target, action, options)
                announceTargetAction(attacker, target, action, changed)
                return changed
            end

            options = options or {}
            NDB.broadcastMessage(sheet, "t20c_target_request", {
                attackerId=tostring(ensureCombatantId(attacker)),
                targetId=target and tostring(ensureCombatantId(target)) or "",
                action=action,
                mode=options.mode,
                saveType=options.saveType,
                saveCD=options.saveCD,
                armed=options.armed
            })
            return true
        end

        local function handleTargetRequest(sender, messageId, message)
            if not isLocalGM() then return end
            if type(message) ~= "table" then return end
            local attacker = findCombatantById(message.attackerId)
            if attacker == nil then return end

            local character = room:findBibliotecaItem(tonumber(attacker.characterCode))
            local ownerLogin = character and character.dono and character.dono.login or nil
            local senderLogin = type(sender) == "table" and sender.login or sender
            local senderMain = type(sender) == "table" and tonumber(sender.personagemPrincipal) or nil
            local isOwner = ownerLogin ~= nil and tostring(ownerLogin) == tostring(senderLogin or "")
            local isMain = senderMain ~= nil and senderMain == tonumber(attacker.characterCode)
            if not isOwner and not isMain then return end

            local action = tostring(message.action or "add")
            if action == "quick_effect_targets" then
                if applyQuickEffectToTargets ~= nil then
                    applyQuickEffectToTargets(attacker, message.effectKey,
                        message.effectValue, message.effectDurationType,
                        message.effectRemaining)
                end
                return
            end
            if action == "quick_effect_selected" then
                local target = findCombatantById(message.targetId)
                local buffType = quickBuffTypeByKey(tostring(message.effectKey or ""))
                local value = tonumber(message.effectValue)
                local durationType = tostring(message.effectDurationType or "")
                local remaining = tonumber(message.effectRemaining)
                if target == nil or buffType == nil or value == nil or value == 0 or
                   math.abs(value) > 1000 then return end
                if durationType ~= "scene" and durationType ~= "rounds" and
                   durationType ~= "manual" then return end
                if durationType == "rounds" then
                    remaining = math.floor(remaining or 0)
                    if remaining < 1 or remaining > 10000 then return end
                else
                    remaining = nil
                end
                applyQuickEffectToCombatant(target, buffType, value,
                                            durationType, remaining)
                return
            end
            if action == "configured_spell_cast" then
                if ConfiguredSpells.cast ~= nil then
                    ConfiguredSpells.cast(attacker, message.spellId)
                end
                return
            end
            if action == "best_of_two_arm" then
                if ConfiguredSpells.BestOfTwo.arm ~= nil then
                    ConfiguredSpells.BestOfTwo.arm(attacker, message.armed == true)
                end
                return
            end
            if action == "maximum_damage_arm" then
                if ConfiguredSpells.MaximumDamage.arm ~= nil then
                    ConfiguredSpells.MaximumDamage.arm(attacker, message.armed == true)
                end
                return
            end
            if action == "opposed_check" then
                local target = findCombatantById(message.targetId)
                local mode = tostring(message.opposedMode or "")
                if target == nil or target == attacker then return end
                if mode ~= "attack" and mode ~= "free" then return end
                if ConfiguredSpells.Opposed.resolve ~= nil then
                    ConfiguredSpells.Opposed.resolve(attacker, target, mode)
                end
                return
            end
            if action == "aura_create" or action == "aura_update" or
               action == "aura_remove" or action == "aura_clear" then
                if applyAuraAction ~= nil then applyAuraAction(attacker, action, message) end
                return
            end
            local target = nil
            if tostring(message.targetId or "") ~= "" then
                target = findCombatantById(message.targetId)
                if target == nil then return end
            end
            if (action == "add" or action == "remove") and target == nil then return end

            local changed = applyTargetAction(attacker, target, action, {
                mode=message.mode,
                saveType=message.saveType,
                saveCD=message.saveCD,
                armed=message.armed
            })
            announceTargetAction(attacker, target, action, changed)
        end

        local function markSelectedTarget()
            if not canManageSelectedConditions() then return end
            local attacker = selectedCombatant
            if attacker == nil then return end

            cancelTokenLink()
            local scenes = loadedRoomScenes()
            if #scenes == 0 then
                sheet.lastCapture = "Abra o tabuleiro desta mesa para adicionar alvos"
                return
            end

            pendingTargetAttacker = attacker
            for i = 1, #scenes do
                local scene = scenes[i]
                local previous = scene.viewport.onMouseUp
                local handler = nil
                handler = function(event)
                    if type(previous) == "function" then pcall(previous, event) end
                    local source = pendingTargetAttacker
                    if source == nil then return end

                    local worldX, worldY = scene.viewport:screenToWorld(event.x, event.y)
                    local token = scene.items:itemAtPoint(worldX, worldY, "tokens")
                    if token == nil or token.objectType ~= "token" then
                        sheet.lastCapture = "Nenhum token encontrado; clique diretamente sobre um alvo"
                        return
                    end
                    local target = findCombatantForToken(token)
                    if target == nil then
                        sheet.lastCapture = "Esse token ainda nao esta vinculado ao tracker"
                        return
                    end
                    if target == source then
                        sheet.lastCapture = "O atacante nao pode ser o proprio alvo"
                        return
                    end

                    if not requestCombatantTarget(source, target, "add") then
                        sheet.lastCapture = (target.name or "Combatente") .. " ja esta na lista de alvos"
                        return
                    end
                    pcall(function() token.selected = true end)
                    sheet.lastCapture = "Alvo adicionado: " .. (target.name or "Combatente") ..
                                        ". Clique em outro token ou em Finalizar"
                end
                scene.viewport.onMouseUp = handler
                tokenLinkHandlers[#tokenLinkHandlers + 1] = {
                    scene=scene, previous=previous, handler=handler
                }
            end
            sheet.lastCapture = "Selecao multipla: clique nos alvos de " ..
                                (attacker.name or "combatente") .. " e depois em Finalizar"
        end

        local function finishTargetSelection()
            local attacker = pendingTargetAttacker
            cancelTokenLink()
            if attacker ~= nil then
                local count = syncTargetSummary(attacker)
                sheet.lastCapture = "Selecao finalizada: " .. tostring(count) .. " alvo(s) de " ..
                                    (attacker.name or "Combatente")
            else
                sheet.lastCapture = "Nenhuma selecao de alvos estava ativa"
            end
        end

        local function chooseTargetToRemove()
            if not canManageSelectedConditions() then return end
            local attacker = selectedCombatant
            local targets = getCombatantTargets(attacker)
            if #targets == 0 then
                showMessage("Este combatente nao possui alvos marcados.")
                return
            end
            local names = {}
            for i = 1, #targets do names[i] = targets[i].name or "Combatente" end
            Dialogs.choose("Remover alvo", names,
                function(selected, selectedIndex)
                    if not selected or targets[selectedIndex] == nil then return end
                    local target = targets[selectedIndex]
                    if requestCombatantTarget(attacker, target, "remove") then
                        sheet.lastCapture = "Alvo removido: " .. (target.name or "Combatente")
                    end
                end)
        end

        local function clearSelectedTarget()
            if not canManageSelectedConditions() then return end
            local attacker = selectedCombatant
            if attacker == nil then return end
            if requestCombatantTarget(attacker, nil, "clear") then
                sheet.lastCapture = "Alvos limpos: " .. (attacker.name or "Combatente")
            end
        end

        local function chooseSpellMode()
            if not canManageSelectedConditions() then return end
            local attacker = selectedCombatant
            if attacker == nil then return end
            local choices = {
                "Desativar modo magia (Ataque x Defesa)",
                "Reflexos: sucesso reduz a metade", "Reflexos: sucesso anula",
                "Fortitude: sucesso reduz a metade", "Fortitude: sucesso anula",
                "Vontade: sucesso reduz a metade", "Vontade: sucesso anula"
            }
            local configs = {
                {mode="defense"},
                {mode="save_half", saveType="Reflexos"}, {mode="save_none", saveType="Reflexos"},
                {mode="save_half", saveType="Fortitude"}, {mode="save_none", saveType="Fortitude"},
                {mode="save_half", saveType="Vontade"}, {mode="save_none", saveType="Vontade"}
            }
            Dialogs.choose("Modo magia", choices,
                function(selected, selectedIndex)
                    if not selected or configs[selectedIndex] == nil then return end
                    local config = configs[selectedIndex]
                    if config.mode == "defense" then
                        requestCombatantTarget(attacker, nil, "area_mode", config)
                        sheet.lastCapture = "Modo magia desativado; ataques usam Ataque x Defesa"
                        return
                    end
                    Dialogs.inputQuery("Resistencia da magia", "Classe de Dificuldade (CD):",
                        tostring(attacker.areaSaveCD or 10),
                        function(value)
                            local cd = tonumber(value)
                            if cd == nil then
                                showMessage("Informe uma CD numerica, como 20.")
                                return
                            end
                            config.saveCD = cd
                            config.armed = true
                            requestCombatantTarget(attacker, nil, "area_mode", config)
                            sheet.lastCapture = "Magia preparada: use o dado do ataque na ficha; " ..
                                                "os campos Ataque e Dano devem estar preenchidos"
                        end)
                end)
        end
        local function findAuraNode(combatant, auraId)
            local auras = childNodes(combatant, "t20cAuras")
            for i = 1, #auras do
                if tostring(auras[i].auraId or "") == tostring(auraId or "") then return auras[i] end
            end
            return nil
        end

        local function refreshAuraState(combatant)
            if combatant == nil then return end
            if syncCombatantAuras ~= nil then syncCombatantAuras(combatant) end
            local character = room:findBibliotecaItem(tonumber(combatant.characterCode))
            if character ~= nil then
                openCharacterSheet(character, function(characterSheet)
                    syncConditionEffects(combatant, character, characterSheet)
                end)
            end
        end

        local function validAuraDuration(durationType, remaining)
            if durationType == "scene" or durationType == "manual" then return true, nil end
            if durationType == "rounds" then
                local rounds = math.floor(tonumber(remaining) or 0)
                if rounds > 0 then return true, rounds end
            end
            return false, nil
        end

        applyAuraAction = function(combatant, action, data)
            if combatant == nil or type(data) ~= "table" then return false end
            local auras = childNodes(combatant, "t20cAuras")
            if action == "aura_remove" then
                local aura = findAuraNode(combatant, data.auraId)
                if aura == nil then return false end
                local auraName = aura.auraName or "Aura"
                deleteAuraVisual(combatant, aura.auraId)
                NDB.deleteNode(aura)
                refreshAuraState(combatant)
                postChat(auraName .. " removida de " .. (combatant.name or "Combatente") .. ".")
                return true
            end
            if action == "aura_clear" then
                if #auras == 0 then return false end
                for i = #auras, 1, -1 do
                    deleteAuraVisual(combatant, auras[i].auraId)
                    NDB.deleteNode(auras[i])
                end
                refreshAuraState(combatant)
                postChat("Todas as auras foram removidas de " ..
                         (combatant.name or "Combatente") .. ".")
                return true
            end
            if action ~= "aura_create" and action ~= "aura_update" then return false end

            local name = tostring(data.auraName or "Aura")
            name = string.gsub(name, "^%s+", "")
            name = string.gsub(name, "%s+$", "")
            if name == "" then name = "Aura" end
            local radius = tonumber(data.auraRadius)
            local color = normalizeAuraColor(data.auraColor)
            local durationOK, remaining = validAuraDuration(data.auraDurationType,
                                                              data.auraRemaining)
            if radius == nil or radius < 0.5 or radius > 100 or color == nil or not durationOK then
                postChat("Nao foi possivel criar a aura: configuracao invalida.")
                return false
            end

            local aura = nil
            if action == "aura_update" then aura = findAuraNode(combatant, data.auraId) end
            if aura == nil then
                combatant.nextAuraId = (tonumber(combatant.nextAuraId) or 0) + 1
                local container = childContainer(combatant, "t20cAuras", true)
                aura = NDB.createChildNode(container, "aura")
                if aura == nil then return false end
                aura.auraId = tostring(ensureCombatantId(combatant)) .. "-" ..
                              tostring(combatant.nextAuraId)
            else
                deleteAuraVisual(combatant, aura.auraId)
            end
            aura.auraName = name
            aura.radiusMeters = radius
            aura.auraColor = color
            aura.durationType = data.auraDurationType
            aura.remaining = remaining
            refreshAuraState(combatant)
            postChat(name .. " configurada em " .. (combatant.name or "Combatente") ..
                     ": raio " .. tostring(radius) .. "m, cor " .. color ..
                     ", duracao " .. auraDurationText(aura) .. ".")
            return true
        end

        local function requestAuraAction(combatant, action, data)
            if combatant == nil then return false end
            data = data or {}
            data.attackerId = tostring(ensureCombatantId(combatant))
            data.action = action
            if isLocalGM() then return applyAuraAction(combatant, action, data) end
            NDB.broadcastMessage(sheet, "t20c_target_request", data)
            sheet.lastCapture = "Pedido de aura enviado ao mestre"
            return true
        end

        local auraColors = {
            {name="Amarela", value="#FFD42A"}, {name="Azul", value="#33AAFF"},
            {name="Vermelha", value="#FF3B3B"}, {name="Verde", value="#2ECC71"},
            {name="Roxa", value="#B05CFF"}, {name="Branca", value="#FFFFFF"}
        }

        local function chooseAuraColor(defaultColor, callback)
            local names = {}
            for i = 1, #auraColors do names[i] = auraColors[i].name end
            names[#names + 1] = "Cor personalizada"
            Dialogs.choose("Cor da aura", names,
                function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex <= #auraColors then
                        callback(auraColors[selectedIndex].value)
                        return
                    end
                    Dialogs.inputQuery("Cor personalizada", "Informe a cor em hexadecimal (ex.: #00FFFF):",
                        normalizeAuraColor(defaultColor) or "#00FFFF",
                        function(colorText)
                            local color = normalizeAuraColor(colorText)
                            if color == nil then
                                showMessage("Use uma cor hexadecimal no formato #RRGGBB.")
                                return
                            end
                            callback(color)
                        end)
                end)
        end

        local function chooseAuraDuration(existingAura, callback)
            Dialogs.choose("Duracao da aura",
                {"Ate o fim da cena", "Numero de rodadas", "Ate remover manualmente"},
                function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex == 2 then
                        Dialogs.inputQuery("Rodadas", "Por quantas rodadas a aura deve durar?",
                            tostring(existingAura and existingAura.remaining or 1),
                            function(roundsText)
                                local rounds = math.floor(tonumber(roundsText) or 0)
                                if rounds <= 0 then
                                    showMessage("Informe uma quantidade valida de rodadas.")
                                    return
                                end
                                callback("rounds", rounds)
                            end)
                    elseif selectedIndex == 3 then
                        callback("manual", nil)
                    else
                        callback("scene", nil)
                    end
                end)
        end

        local function configureAura(combatant, existingAura)
            Dialogs.inputQuery("Nome da aura", "Nome da magia ou efeito:",
                tostring(existingAura and existingAura.auraName or "Aura"),
                function(nameText)
                    if nameText == nil then return end
                    Dialogs.inputQuery("Tamanho da aura", "Raio em metros (ex.: 9):",
                        tostring(existingAura and existingAura.radiusMeters or 9),
                        function(radiusText)
                            local radiusTextNormalized = string.gsub(tostring(radiusText or ""), ",", ".")
                            local radius = tonumber(radiusTextNormalized)
                            if radius == nil or radius < 0.5 or radius > 100 then
                                showMessage("Informe um raio entre 0,5 e 100 metros.")
                                return
                            end
                            chooseAuraColor(existingAura and existingAura.auraColor or "#FFD42A",
                                function(color)
                                    chooseAuraDuration(existingAura,
                                        function(durationType, remaining)
                                            local action = existingAura and "aura_update" or "aura_create"
                                            requestAuraAction(combatant, action, {
                                                auraId=existingAura and existingAura.auraId or nil,
                                                auraName=nameText,
                                                auraRadius=radius,
                                                auraColor=color,
                                                auraDurationType=durationType,
                                                auraRemaining=remaining
                                            })
                                        end)
                                end)
                        end)
                end)
        end

        local function chooseExistingAura(combatant, title, callback)
            local auras = childNodes(combatant, "t20cAuras")
            if #auras == 0 then
                showMessage("Este combatente nao possui auras.")
                return
            end
            local names = {}
            for i = 1, #auras do
                names[i] = (auras[i].auraName or "Aura") .. " - " ..
                           tostring(auras[i].radiusMeters or 0) .. "m - " ..
                           auraDurationText(auras[i])
            end
            Dialogs.choose(title, names,
                function(selected, selectedIndex)
                    if selected and auras[selectedIndex] ~= nil then callback(auras[selectedIndex]) end
                end)
        end

        local function manageSelectedAuras()
            if not canManageSelectedConditions() then return end
            local combatant = selectedCombatant
            if combatant == nil then return end
            Dialogs.choose("Auras", {"Criar aura", "Editar aura", "Remover aura", "Limpar auras"},
                function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex == 1 then
                        if combatant.tokenLinked ~= true then
                            showMessage("Vincule um token a este combatente antes de criar a aura.")
                            return
                        end
                        configureAura(combatant, nil)
                    elseif selectedIndex == 2 then
                        chooseExistingAura(combatant, "Editar aura",
                            function(aura) configureAura(combatant, aura) end)
                    elseif selectedIndex == 3 then
                        chooseExistingAura(combatant, "Remover aura",
                            function(aura)
                                requestAuraAction(combatant, "aura_remove", {auraId=aura.auraId})
                            end)
                    else
                        if #childNodes(combatant, "t20cAuras") == 0 then
                            showMessage("Este combatente nao possui auras.")
                            return
                        end
                        Dialogs.choose("Limpar auras", {"Confirmar", "Cancelar"},
                            function(confirmSelected, confirmIndex)
                                if confirmSelected and confirmIndex == 1 then
                                    requestAuraAction(combatant, "aura_clear", {})
                                end
                            end)
                    end
                end)
        end
        local function syncSelectedTokenBars()
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                updateCombatantFromSheet(combatant, character, characterSheet)
                if not syncCombatantToken(combatant, character, characterSheet) then
                    showMessage("Este combatente ainda nao possui um token vinculado neste tabuleiro.")
                else
                    showMessage("Barras do token sincronizadas.")
                end
            end)
        end

        local function syncAllTokenBars()
            if not requireGM() then return end
            local nodes = getCombatants()
            local linked = 0
            for i = 1, #nodes do
                local combatant = nodes[i]
                if combatant.tokenLinked == true then
                    linked = linked + 1
                    local character = room:findBibliotecaItem(tonumber(combatant.characterCode))
                    if character ~= nil then
                        openCharacterSheet(character, function(characterSheet)
                            updateCombatantFromSheet(combatant, character, characterSheet)
                        end)
                    end
                end
            end
            if linked == 0 then
                showMessage("Nenhum combatente possui token vinculado.")
            else
                showMessage("Sincronizando as barras de " .. tostring(linked) .. " token(s).")
            end
        end

        cancelTokenLink = function()
            pendingTokenCombatant = nil
            pendingTargetAttacker = nil
            pendingSpellAreaConfig = nil
            pendingSpellAreaMove = nil
            for i = 1, #tokenLinkHandlers do
                local entry = tokenLinkHandlers[i]
                pcall(function()
                    if entry.scene ~= nil and entry.scene.isObjectAlive and
                       entry.scene.viewport.onMouseUp == entry.handler then
                        entry.scene.viewport.onMouseUp = entry.previous
                    end
                end)
            end
            tokenLinkHandlers = {}
        end

        local function linkSelectedToken()
            if not canManageSelectedConditions() then return end
            local combatant = selectedCombatant
            if combatant == nil then
                showMessage("Selecione um combatente primeiro.")
                return
            end

            cancelTokenLink()
            local scenes = loadedRoomScenes()
            if #scenes == 0 then
                showMessage("Abra o tabuleiro desta mesa antes de vincular o token.")
                return
            end

            pendingTokenCombatant = combatant
            for i = 1, #scenes do
                local scene = scenes[i]
                local previous = scene.viewport.onMouseUp
                local handler = nil
                handler = function(event)
                    if type(previous) == "function" then pcall(previous, event) end
                    local target = pendingTokenCombatant
                    if target == nil then return end

                    local worldX, worldY = scene.viewport:screenToWorld(event.x, event.y)
                    local token = scene.items:itemAtPoint(worldX, worldY, "tokens")
                    if token == nil or token.objectType ~= "token" then
                        sheet.lastCapture = "Nenhum token encontrado; clique diretamente sobre o token"
                        return
                    end
                    if not canEditToken(token) then
                        sheet.lastCapture = "Somente o dono do token ou o mestre pode vincula-lo"
                        return
                    end

                    if not bindTokenToCombatant(target, token, scene, false) then
                        sheet.lastCapture = "Nao foi possivel vincular esse token"
                        return
                    end
                    cancelTokenLink()
                    if isLocalGM() then
                        sheet.lastCapture = "Mestre vinculou o token de " .. (target.name or "Combatente")
                    else
                        sheet.lastCapture = "Token vinculado: " .. (target.name or "Combatente")
                    end

                end
                scene.viewport.onMouseUp = handler
                tokenLinkHandlers[#tokenLinkHandlers + 1] = {
                    scene=scene, previous=previous, handler=handler
                }
            end
            sheet.lastCapture = "Clique no token de " .. (combatant.name or "combatente") .. " no tabuleiro"

        end

        local function unlinkSelectedToken()
            if not canManageSelectedConditions() then return end
            local combatant = selectedCombatant
            if combatant == nil then return end
            local removed = unlinkCombatantTokens(combatant, true)
            if removed > 0 then
                showMessage("Token desvinculado e barras limpas.")
            else
                showMessage("Vinculo removido. O token nao estava em um tabuleiro aberto.")
            end
        end
        local SpellAreas = {
            OP="codexT20SpellAreaV1",
            CIRCLE_PATH="M 0.5 0 C 0.776 0 1 0.224 1 0.5 " ..
                        "C 1 0.776 0.776 1 0.5 1 " ..
                        "C 0.224 1 0 0.776 0 0.5 C 0 0.224 0.224 0 0.5 0 Z",
            RECT_PATH="M 0 0 L 1 0 L 1 1 L 0 1 Z",
            CONE_PATH="M 0 0.5 L 0.7071 0.14645 " ..
                      "C 0.9024 0.2441 1 0.365 1 0.5 " ..
                      "C 1 0.635 0.9024 0.7559 0.7071 0.85355 Z",
            shapes={
                {id="sphere", label="Esfera (raio)"},
                {id="cylinder", label="Cilindro (raio e altura)"},
                {id="cone", label="Cone (alcance e direcao)"},
                {id="line", label="Linha (comprimento e largura)"},
                {id="square", label="Quadrado (lado)"},
                {id="cube", label="Cubo (lado e altura)"},
                {id="custom", label="Outra: retangulo personalizado"}
            }
        }
        function SpellAreas.trimAreaText(value)
            local text = tostring(value or "")
            text = string.gsub(text, "^%s+", "")
            text = string.gsub(text, "%s+$", "")
            return text
        end

        function SpellAreas.parseAreaNumber(value)
            local normalized = string.gsub(tostring(value or ""), ",", ".")
            return tonumber(normalized)
        end

        function SpellAreas.formatAreaNumber(value)
            local number = tonumber(value) or 0
            local text = string.format("%.1f", number)
            return string.gsub(text, "%.0$", "")
        end

        function SpellAreas.spellAreaShapeLabel(shape)
            for i = 1, #SpellAreas.shapes do
                if SpellAreas.shapes[i].id == shape then return SpellAreas.shapes[i].label end
            end
            return "Area personalizada"
        end

        function SpellAreas.isDirectionalSpellArea(shape)
            return shape == "cone" or shape == "line"
        end

        function SpellAreas.spellAreaDimensions(config)
            local primary = tonumber(config.primary) or 1.5
            local secondary = tonumber(config.secondary) or 1.5
            if config.shape == "sphere" or config.shape == "cylinder" then
                return primary * 2, primary * 2
            elseif config.shape == "cone" then
                return primary, primary * 2
            elseif config.shape == "line" then
                return primary, secondary
            elseif config.shape == "square" or config.shape == "cube" then
                return primary, primary
            end
            return primary, secondary
        end

        function SpellAreas.spellAreaPath(shape)
            if shape == "sphere" or shape == "cylinder" then return SpellAreas.CIRCLE_PATH end
            if shape == "cone" then return SpellAreas.CONE_PATH end
            return SpellAreas.RECT_PATH
        end

        function SpellAreas.isSpellArea(item)
            if item == nil or item.objectType ~= "userDrawing" or item.userData == nil then return false end
            return item.userData.codexT20SpellArea == true or
                   tostring(item.userData.codexT20SpellArea or "") == "true"
        end

        function SpellAreas.currentUserLogin()
            if room == nil or room.meuJogador == nil then return "" end
            return tostring(room.meuJogador.login or room.meuJogador.codigoInterno or "")
        end
        function SpellAreas.setStatus(value)
            pcall(function()
                if sheet ~= nil then sheet.lastCapture = tostring(value or "") end
            end)
        end

        function SpellAreas.canManageSpellArea(item)
            if not SpellAreas.isSpellArea(item) then return false end
            if isLocalGM() then return true end
            if item.isMine == true then return true end
            return tostring(item.userData.areaOwnerLogin or "") == SpellAreas.currentUserLogin()
        end

        function SpellAreas.spellAreaConfigFromItem(item)
            if not SpellAreas.isSpellArea(item) then return nil end
            return {
                name=tostring(item.userData.areaName or "Area de magia"),
                shape=tostring(item.userData.areaShape or "sphere"),
                primary=tonumber(item.userData.areaPrimary) or 1.5,
                secondary=tonumber(item.userData.areaSecondary) or 1.5,
                color=normalizeAuraColor(item.userData.areaColor) or "#33AAFF",
                durationType=tostring(item.userData.areaDurationType or "scene"),
                remaining=tonumber(item.userData.areaRemaining),
                rotation=tonumber(item.rotation) or tonumber(item.userData.areaRotation) or 0
            }
        end

        function SpellAreas.spellAreaDurationText(config)
            if config.durationType == "rounds" then
                return tostring(math.floor(tonumber(config.remaining) or 0)) .. " rodada(s)"
            end
            if config.durationType == "manual" then return "manual" end
            return "ate o fim da cena"
        end

        function SpellAreas.spellAreaMeasureText(config)
            local p = SpellAreas.formatAreaNumber(config.primary)
            local s = SpellAreas.formatAreaNumber(config.secondary)
            if config.shape == "sphere" then return "raio " .. p .. "m" end
            if config.shape == "cylinder" then return "raio " .. p .. "m, altura " .. s .. "m" end
            if config.shape == "cone" then return p .. "m de alcance" end
            if config.shape == "line" then return p .. "m x " .. s .. "m" end
            if config.shape == "square" then return "lado " .. p .. "m" end
            if config.shape == "cube" then return "lado " .. p .. "m, altura " .. s .. "m" end
            return p .. "m x " .. s .. "m"
        end

        function SpellAreas.getSpellAreaOrigin(item)
            local centerX, centerY = item:getCenter(false)
            local config = SpellAreas.spellAreaConfigFromItem(item)
            if config == nil or not SpellAreas.isDirectionalSpellArea(config.shape) then return centerX, centerY end
            local angle = math.rad(tonumber(item.rotation) or 0)
            local offset = (tonumber(config.primary) or 0) / 2
            return centerX - math.cos(angle) * offset,
                   centerY - math.sin(angle) * offset
        end

        function SpellAreas.setSpellAreaOrigin(item, worldX, worldY)
            local config = SpellAreas.spellAreaConfigFromItem(item)
            if config == nil then return false end
            if SpellAreas.isDirectionalSpellArea(config.shape) then
                local angle = math.rad(tonumber(item.rotation) or 0)
                local offset = (tonumber(config.primary) or 0) / 2
                item:setCenter(worldX + math.cos(angle) * offset,
                               worldY + math.sin(angle) * offset, false)
            else
                item:setCenter(worldX, worldY, false)
            end
            return true
        end

        function SpellAreas.applySpellAreaVisual(item, config)
            if item == nil or config == nil or item.userData == nil then return false end
            local color = normalizeAuraColor(config.color)
            local width, height = SpellAreas.spellAreaDimensions(config)
            if color == nil or width <= 0 or height <= 0 then return false end

            item:beginUpdate()
            item.layer = "tokens"
            item.visible = true
            item.locked = false
            item.snapToGrid = true
            item.z = -5000
            item.width = width
            item.height = height
            item.rotation = tonumber(config.rotation) or tonumber(item.rotation) or 0

            item.userData.codexT20SpellArea = true
            item.userData.areaVersion = 1
            item.userData.areaName = SpellAreas.trimAreaText(config.name) ~= "" and SpellAreas.trimAreaText(config.name) or "Area de magia"
            item.userData.areaShape = config.shape
            item.userData.areaPrimary = tonumber(config.primary)
            item.userData.areaSecondary = tonumber(config.secondary)
            item.userData.areaColor = color
            item.userData.areaDurationType = config.durationType
            item.userData.areaRemaining = config.durationType == "rounds" and
                                              math.floor(tonumber(config.remaining) or 1) or nil
            item.userData.areaRotation = tonumber(config.rotation) or tonumber(item.rotation) or 0
            if tostring(item.userData.areaOwnerLogin or "") == "" then
                item.userData.areaOwnerLogin = SpellAreas.currentUserLogin()
            end

            item.canvas:clear()
            local op = item.canvas:addPath()
            op.name = SpellAreas.OP
            op.data = SpellAreas.spellAreaPath(config.shape)
            op.x = 0; op.y = 0; op.width = 1; op.height = 1
            op.xMetric = "canvasMetric"; op.yMetric = "canvasMetric"
            op.widthMetric = "canvasMetric"; op.heightMetric = "canvasMetric"
            op.color = color .. "38"
            op.strokeColor = color .. "F2"
            op.strokeSize = 3
            op.strokeSizeMetric = "screenMetric"
            op.z = 0
            item:endUpdate()
            return true
        end

        function SpellAreas.collectManagedSpellAreas()
            local result = {}
            local scenes = loadedRoomScenes()
            for sceneIndex = 1, #scenes do
                local scene = scenes[sceneIndex]
                for itemIndex = 1, #scene.items do
                    local item = scene.items[itemIndex]
                    if SpellAreas.canManageSpellArea(item) then
                        result[#result + 1] = {scene=scene, item=item, sceneIndex=sceneIndex}
                    end
                end
            end
            table.sort(result, function(a, b)
                local an = string.lower(tostring(a.item.userData.areaName or ""))
                local bn = string.lower(tostring(b.item.userData.areaName or ""))
                if an == bn then return tonumber(a.item.objectID or 0) < tonumber(b.item.objectID or 0) end
                return an < bn
            end)
            return result
        end

        function SpellAreas.chooseManagedSpellArea(title, callback)
            local areas = SpellAreas.collectManagedSpellAreas()
            if #areas == 0 then
                showMessage(isLocalGM() and "Nao existem areas de magia nos tabuleiros abertos." or
                                            "Voce ainda nao criou areas de magia neste tabuleiro.")
                return
            end
            local labels = {}
            for i = 1, #areas do
                local config = SpellAreas.spellAreaConfigFromItem(areas[i].item)
                local owner = tostring(areas[i].item.userData.areaOwnerLogin or "")
                local suffix = isLocalGM() and owner ~= "" and (" - " .. owner) or ""
                labels[i] = config.name .. " | " .. SpellAreas.spellAreaShapeLabel(config.shape) ..
                            " | " .. SpellAreas.spellAreaMeasureText(config) .. suffix
            end
            Dialogs.choose(title, labels, function(selected, selectedIndex)
                if selected and areas[selectedIndex] ~= nil then callback(areas[selectedIndex]) end
            end)
        end

        function SpellAreas.chooseSpellAreaScene(callback)
            local scenes = loadedRoomScenes()
            if #scenes == 0 then
                showMessage("Abra o tabuleiro desta mesa antes de criar uma area.")
                return
            end
            if #scenes == 1 then callback(scenes[1]); return end
            local labels = {}
            for i = 1, #scenes do labels[i] = "Tabuleiro aberto " .. tostring(i) end
            Dialogs.choose("Escolha o tabuleiro", labels, function(selected, selectedIndex)
                if selected and scenes[selectedIndex] ~= nil then callback(scenes[selectedIndex]) end
            end)
        end

        function SpellAreas.askSpellAreaNumber(title, prompt, defaultValue, callback)
            Dialogs.inputQuery(title, prompt, SpellAreas.formatAreaNumber(defaultValue), function(value)
                local number = SpellAreas.parseAreaNumber(value)
                if number == nil or number < 0.5 or number > 300 then
                    showMessage("Informe uma medida entre 0,5 e 300 metros.")
                    return
                end
                callback(number)
            end)
        end

        function SpellAreas.askSpellAreaDimensions(shape, existing, callback)
            local primary = existing and existing.shape == shape and existing.primary or nil
            local secondary = existing and existing.shape == shape and existing.secondary or nil
            if shape == "sphere" then
                SpellAreas.askSpellAreaNumber("Esfera", "Raio em metros (ex.: 6):", primary or 6,
                    function(radius) callback(radius, 0) end)
            elseif shape == "cylinder" then
                SpellAreas.askSpellAreaNumber("Cilindro", "Raio em metros:", primary or 3,
                    function(radius)
                        SpellAreas.askSpellAreaNumber("Cilindro", "Altura em metros:", secondary or 6,
                            function(height) callback(radius, height) end)
                    end)
            elseif shape == "cone" then
                SpellAreas.askSpellAreaNumber("Cone", "Alcance/comprimento em metros:", primary or 6,
                    function(length) callback(length, 0) end)
            elseif shape == "line" then
                SpellAreas.askSpellAreaNumber("Linha", "Comprimento em metros:", primary or 15,
                    function(length)
                        SpellAreas.askSpellAreaNumber("Linha", "Largura em metros (padrao T20: 1,5):", secondary or 1.5,
                            function(width) callback(length, width) end)
                    end)
            elseif shape == "square" then
                SpellAreas.askSpellAreaNumber("Quadrado", "Tamanho do lado em metros:", primary or 3,
                    function(side) callback(side, 0) end)
            elseif shape == "cube" then
                SpellAreas.askSpellAreaNumber("Cubo", "Tamanho do lado em metros:", primary or 3,
                    function(side)
                        SpellAreas.askSpellAreaNumber("Cubo", "Altura em metros:", secondary or side,
                            function(height) callback(side, height) end)
                    end)
            else
                SpellAreas.askSpellAreaNumber("Area personalizada", "Comprimento em metros:", primary or 6,
                    function(length)
                        SpellAreas.askSpellAreaNumber("Area personalizada", "Largura em metros:", secondary or 3,
                            function(width) callback(length, width) end)
                    end)
            end
        end

        function SpellAreas.configureSpellArea(existing, callback)
            Dialogs.inputQuery(existing and "Editar area" or "Nova area de magia", "Nome da magia/area:",
                existing and existing.name or "Area de magia", function(nameText)
                    local name = SpellAreas.trimAreaText(nameText)
                    if name == "" then name = "Area de magia" end
                    local labels = {}
                    for i = 1, #SpellAreas.shapes do labels[i] = SpellAreas.shapes[i].label end
                    Dialogs.choose("Forma da area", labels, function(selected, selectedIndex)
                        if not selected or SpellAreas.shapes[selectedIndex] == nil then return end
                        local shape = SpellAreas.shapes[selectedIndex].id
                        SpellAreas.askSpellAreaDimensions(shape, existing, function(primary, secondary)
                            chooseAuraColor(existing and existing.color or "#33AAFF", function(color)
                                chooseAuraDuration(existing, function(durationType, remaining)
                                    callback({
                                        name=name, shape=shape, primary=primary, secondary=secondary,
                                        color=color, durationType=durationType, remaining=remaining,
                                        rotation=existing and existing.rotation or 0
                                    })
                                end)
                            end)
                        end)
                    end)
                end)
        end

        function SpellAreas.chooseInitialSpellAreaRotation(config, callback)
            if not SpellAreas.isDirectionalSpellArea(config.shape) then callback(0); return end
            local labels = {
                "Direita (0 graus)", "Diagonal inferior direita (45 graus)",
                "Baixo (90 graus)", "Diagonal inferior esquerda (135 graus)",
                "Esquerda (180 graus)", "Diagonal superior esquerda (225 graus)",
                "Cima (270 graus)", "Diagonal superior direita (315 graus)"
            }
            local angles = {0, 45, 90, 135, 180, 225, 270, 315}
            Dialogs.choose("Direcao inicial", labels, function(selected, selectedIndex)
                if selected and angles[selectedIndex] ~= nil then callback(angles[selectedIndex]) end
            end)
        end

        function SpellAreas.createSpellAreaAt(scene, config, worldX, worldY)
            local item = nil
            local ok, errorMessage = pcall(function()
                item = scene.items:addUserDrawing("tokens")
                if item == nil then error("addUserDrawing retornou nil") end
                item:markAsMyDrawing()
                config.rotation = tonumber(config.rotation) or 0
                if not SpellAreas.applySpellAreaVisual(item, config) then error("configuracao invalida") end
                SpellAreas.setSpellAreaOrigin(item, worldX, worldY)
                scene.items:clearSelection()
                item.selected = true
                scene.workingLayer = "tokens"
                scene:sendDelayedUpdates()
            end)
            if not ok then
                if item ~= nil then pcall(function() item:delete() end) end
                showMessage("Nao foi possivel criar a area neste tabuleiro: " .. tostring(errorMessage))
                return nil
            end
            postChat(SpellAreas.currentUserLogin() .. " criou " .. config.name .. " (" ..
                     SpellAreas.spellAreaMeasureText(config) .. ", " .. SpellAreas.spellAreaDurationText(config) .. ").")
            return item
        end

        function SpellAreas.armSpellAreaPlacement(scene, config)
            cancelTokenLink()
            pendingSpellAreaConfig = config
            local previous = scene.viewport.onMouseUp
            local handler = nil
            handler = function(event)
                if type(previous) == "function" then pcall(previous, event) end
                local pending = pendingSpellAreaConfig
                if pending == nil then return end
                local worldX, worldY = scene.viewport:screenToWorld(event.x, event.y)
                local item = SpellAreas.createSpellAreaAt(scene, pending, worldX, worldY)
                cancelTokenLink()
                if item ~= nil then
                    SpellAreas.setStatus("Area criada e selecionada. Arraste para mover ou use Areas de magia.")
                end
            end
            scene.viewport.onMouseUp = handler
            tokenLinkHandlers[#tokenLinkHandlers + 1] = {scene=scene, previous=previous, handler=handler}
            if SpellAreas.isDirectionalSpellArea(config.shape) then
                SpellAreas.setStatus("Clique no ponto de origem da " .. config.name .. " no tabuleiro")
            else
                SpellAreas.setStatus("Clique no centro da " .. config.name .. " no tabuleiro")
            end
        end

        function SpellAreas.createSpellArea()
            SpellAreas.configureSpellArea(nil, function(config)
                SpellAreas.chooseInitialSpellAreaRotation(config, function(rotation)
                    config.rotation = rotation
                    SpellAreas.chooseSpellAreaScene(function(scene) SpellAreas.armSpellAreaPlacement(scene, config) end)
                end)
            end)
        end

        function SpellAreas.selectSpellAreaForDrag(record)
            local item, scene = record.item, record.scene
            if not SpellAreas.canManageSpellArea(item) then return end
            scene.items:clearSelection()
            item.locked = false
            item.selected = true
            scene.workingLayer = "tokens"
            scene:sendDelayedUpdates()
            SpellAreas.setStatus("Area selecionada: arraste a parte colorida ou as alcas no mapa")
            showMessage("Area selecionada. Voce pode arrasta-la no mapa; use Girar para mudar a direcao.")
        end

        function SpellAreas.armSpellAreaMove(record)
            local item, scene = record.item, record.scene
            if not SpellAreas.canManageSpellArea(item) then return end
            cancelTokenLink()
            pendingSpellAreaMove = item
            local previous = scene.viewport.onMouseUp
            local handler = nil
            handler = function(event)
                if type(previous) == "function" then pcall(previous, event) end
                local target = pendingSpellAreaMove
                if target == nil or target.isObjectAlive == false then return end
                local worldX, worldY = scene.viewport:screenToWorld(event.x, event.y)
                SpellAreas.setSpellAreaOrigin(target, worldX, worldY)
                scene.items:clearSelection()
                target.selected = true
                scene.workingLayer = "tokens"
                scene:sendDelayedUpdates()
                local name = tostring(target.userData.areaName or "Area")
                cancelTokenLink()
                SpellAreas.setStatus("Area movida: " .. name)
            end
            scene.viewport.onMouseUp = handler
            tokenLinkHandlers[#tokenLinkHandlers + 1] = {scene=scene, previous=previous, handler=handler}
            SpellAreas.setStatus("Clique no novo ponto da area " .. tostring(item.userData.areaName or ""))
        end

        function SpellAreas.editSpellArea(record)
            local item, scene = record.item, record.scene
            if not SpellAreas.canManageSpellArea(item) then return end
            local old = SpellAreas.spellAreaConfigFromItem(item)
            local originX, originY = SpellAreas.getSpellAreaOrigin(item)
            SpellAreas.configureSpellArea(old, function(config)
                config.rotation = tonumber(item.rotation) or old.rotation or 0
                if SpellAreas.applySpellAreaVisual(item, config) then
                    SpellAreas.setSpellAreaOrigin(item, originX, originY)
                    item.selected = true
                    scene:sendDelayedUpdates()
                    SpellAreas.setStatus("Area editada: " .. config.name)
                end
            end)
        end

        function SpellAreas.rotateSpellArea(record)
            local item, scene = record.item, record.scene
            if not SpellAreas.canManageSpellArea(item) then return end
            local choices = {"Girar +45 graus", "Girar +90 graus", "Girar -45 graus",
                             "Girar -90 graus", "Meia-volta (180 graus)", "Informar angulo"}
            local deltas = {45, 90, -45, -90, 180}
            local function applyRotation(angle)
                local originX, originY = SpellAreas.getSpellAreaOrigin(item)
                angle = angle % 360
                item.rotation = angle
                item.userData.areaRotation = angle
                SpellAreas.setSpellAreaOrigin(item, originX, originY)
                scene.items:clearSelection()
                item.selected = true
                scene.workingLayer = "tokens"
                scene:sendDelayedUpdates()
                SpellAreas.setStatus("Area girada para " .. SpellAreas.formatAreaNumber(angle) .. " graus")
            end
            Dialogs.choose("Girar area", choices, function(selected, selectedIndex)
                if not selected then return end
                if selectedIndex <= #deltas then
                    applyRotation((tonumber(item.rotation) or 0) + deltas[selectedIndex])
                else
                    Dialogs.inputQuery("Angulo da area", "Graus (0 a 359):",
                        SpellAreas.formatAreaNumber(item.rotation or 0), function(value)
                            local angle = SpellAreas.parseAreaNumber(value)
                            if angle == nil then showMessage("Informe um angulo numerico."); return end
                            applyRotation(angle)
                        end)
                end
            end)
        end

        function SpellAreas.removeSpellArea(record)
            local item, scene = record.item, record.scene
            if not SpellAreas.canManageSpellArea(item) then return end
            local name = tostring(item.userData.areaName or "Area de magia")
            Dialogs.choose("Remover area", {"Remover " .. name, "Cancelar"},
                function(selected, selectedIndex)
                    if not selected or selectedIndex ~= 1 then return end
                    pcall(function() item:delete() end)
                    pcall(function() scene:sendDelayedUpdates() end)
                    postChat(name .. " foi removida do mapa.")
                end)
        end

        function SpellAreas.manageExistingSpellArea()
            SpellAreas.chooseManagedSpellArea("Escolha a area", function(record)
                local choices = {"Selecionar para arrastar", "Mover clicando no novo ponto",
                                 "Girar", "Editar tamanho, cor ou duracao", "Remover"}
                Dialogs.choose("Administrar area", choices, function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex == 1 then SpellAreas.selectSpellAreaForDrag(record)
                    elseif selectedIndex == 2 then SpellAreas.armSpellAreaMove(record)
                    elseif selectedIndex == 3 then SpellAreas.rotateSpellArea(record)
                    elseif selectedIndex == 4 then SpellAreas.editSpellArea(record)
                    elseif selectedIndex == 5 then SpellAreas.removeSpellArea(record) end
                end)
            end)
        end

        function SpellAreas.clearManagedSpellAreas()
            local areas = SpellAreas.collectManagedSpellAreas()
            if #areas == 0 then showMessage("Nao existem areas que voce possa remover."); return end
            local label = isLocalGM() and "Remover todas as areas dos tabuleiros abertos" or
                                          "Remover todas as minhas areas"
            Dialogs.choose("Limpar areas", {label, "Cancelar"}, function(selected, selectedIndex)
                if not selected or selectedIndex ~= 1 then return end
                for i = #areas, 1, -1 do pcall(function() areas[i].item:delete() end) end
                for i = 1, #loadedRoomScenes() do
                    pcall(function() loadedRoomScenes()[i]:sendDelayedUpdates() end)
                end
                postChat(tostring(#areas) .. " area(s) de magia foram removidas do mapa.")
            end)
        end

        function SpellAreas.manageSpellAreas()
            if room == nil or room.meuJogador == nil then return end
            Dialogs.choose("Areas de magia", {"Criar nova area", "Administrar area existente",
                                               "Limpar areas", "Cancelar"},
                function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex == 1 then SpellAreas.createSpellArea()
                    elseif selectedIndex == 2 then SpellAreas.manageExistingSpellArea()
                    elseif selectedIndex == 3 then SpellAreas.clearManagedSpellAreas() end
                end)
        end

        function SpellAreas.tickSpellAreasRound()
            if not isLocalGM() then return end
            local scenes = loadedRoomScenes()
            for sceneIndex = 1, #scenes do
                local scene = scenes[sceneIndex]
                local changed = false
                for itemIndex = #scene.items, 1, -1 do
                    local item = scene.items[itemIndex]
                    if SpellAreas.isSpellArea(item) and item.userData.areaDurationType == "rounds" then
                        local remaining = math.floor(tonumber(item.userData.areaRemaining) or 1) - 1
                        if remaining <= 0 then
                            local name = tostring(item.userData.areaName or "Area de magia")
                            pcall(function() item:delete() end)
                            postChat(name .. " terminou e foi removida do mapa.")
                        else
                            item.userData.areaRemaining = remaining
                        end
                        changed = true
                    end
                end
                if changed then pcall(function() scene:sendDelayedUpdates() end) end
            end
        end

        function SpellAreas.clearSceneSpellAreas(durationType)
            if not isLocalGM() then return 0 end
            local removed = 0
            local scenes = loadedRoomScenes()
            for sceneIndex = 1, #scenes do
                local scene = scenes[sceneIndex]
                local changed = false
                for itemIndex = #scene.items, 1, -1 do
                    local item = scene.items[itemIndex]
                    if SpellAreas.isSpellArea(item) and
                       (durationType == nil or item.userData.areaDurationType == durationType) then
                        pcall(function() item:delete() end)
                        removed = removed + 1
                        changed = true
                    end
                end
                if changed then pcall(function() scene:sendDelayedUpdates() end) end
            end
            return removed
        end
        local function handleDraggedToken(scene, item)
            local pending = T20DragState.pending
            if pending == nil or item == nil or item.objectType ~= "token" then return end
            if tostring(pending.roomCode or "") ~= tostring(currentRoomCode() or "") then return end

            local elapsed = System.getTickCount() - (tonumber(pending.startedAt) or 0)
            if elapsed < 0 or elapsed > 20000 then
                T20DragState.pending = nil
                return
            end

            local expectedCharacter = tonumber(pending.characterCode)
            local tokenCharacter = tonumber(item.ownerCharacter) or 0
            if tokenCharacter ~= 0 and tokenCharacter ~= expectedCharacter then return end

            local combatant = findCombatantById(pending.combatantId)
            if combatant == nil or tonumber(combatant.characterCode) ~= expectedCharacter then
                T20DragState.pending = nil
                return
            end

            T20DragState.pending = nil
            if bindTokenToCombatant(combatant, item, scene, true) then
                sheet.lastCapture = "Token criado e vinculado: " .. (combatant.name or "Combatente")
            else
                showMessage("O token foi criado, mas nao foi possivel vincula-lo automaticamente.")
            end
        end

        local function registerSceneDragIntegration()
            if scenePluginId ~= nil then return end
            scenePluginId = SceneLib.registerPlugin(function(scene, attachment)
                if not isSceneFromCurrentRoom(scene) then return end
                local previous = scene.items.onItemAdded
                local handler = nil
                handler = function(item)
                    if type(previous) == "function" then pcall(previous, item) end
                    handleDraggedToken(scene, item)
                end
                scene.items.onItemAdded = handler
                sceneItemHandlers[#sceneItemHandlers + 1] = {
                    scene=scene, previous=previous, handler=handler
                }
                if isLocalGM() and
                   refreshTurnHighlight ~= nil then
                    setTimeout(function()
                        refreshTurnHighlight(findCombatantById(sheet.currentCombatantId))
                    end, 1)
                end
            end)
        end

        local function unregisterSceneDragIntegration()
            for i = 1, #sceneItemHandlers do
                local entry = sceneItemHandlers[i]
                pcall(function()
                    if entry.scene ~= nil and entry.scene.isObjectAlive and
                       entry.scene.items.onItemAdded == entry.handler then
                        entry.scene.items.onItemAdded = entry.previous
                    end
                end)
            end
            sceneItemHandlers = {}
            if scenePluginId ~= nil then
                SceneLib.unregisterPlugin(scenePluginId)
                scenePluginId = nil
            end
            if T20DragState.pending ~= nil and
               tostring(T20DragState.pending.roomCode or "") == tostring(currentRoomCode() or "") then
                T20DragState.pending = nil
            end
        end
        registerSheetObserver = function(character, characterSheet)
            if character == nil or characterSheet == nil then return end
            local key = tostring(character.codigoInterno or "")
            if key == "" or sheetObservers[key] ~= nil then return end

            local observer = NDB.newObserver(characterSheet)
            observer.onChanged = function(node, attribute)
                if attribute ~= "PVs_Atuais" and attribute ~= "PVs_Totais" and
                   attribute ~= "PMs_Atuais" and attribute ~= "PMs_Totais" and
                   attribute ~= "CA" then
                    return
                end

                local nodes = getCombatants()
                for i = 1, #nodes do
                    local combatant = nodes[i]
                    if tonumber(combatant.characterCode) == tonumber(character.codigoInterno) then
                        if combatant.isIndependent ~= true then
                            combatant.currentHP = tonumber(characterSheet.PVs_Atuais) or combatant.currentHP
                            combatant.maxHP = tonumber(characterSheet.PVs_Totais) or combatant.maxHP
                            combatant.currentPM = tonumber(characterSheet.PMs_Atuais)
                            combatant.maxPM = tonumber(characterSheet.PMs_Totais)
                            combatant.effectiveDefense = tonumber(characterSheet.CA)
                        elseif attribute == "CA" then
                            local baseDefense = tonumber(characterSheet.CA)
                            combatant.effectiveDefense = baseDefense and
                                (baseDefense + (tonumber(combatant.defensePenalty) or 0) + buffs.defense) or nil
                        end
                        if syncCombatantToken ~= nil then
                            syncCombatantToken(combatant, character, characterSheet)
                        end
                        if removeDefeatedNPC ~= nil then
                            removeDefeatedNPC(combatant, character)
                        end
                        if attribute == "PVs_Atuais" and PlayerDown.handleHP ~= nil then
                            PlayerDown.handleHP(combatant, character, characterSheet, true)
                        end
                    end
                end
            end
            local function refreshConfiguredSpellSummaries()
                if ConfiguredSpells.syncSummary == nil then return end
                local combatants = getCombatants()
                for i = 1, #combatants do
                    local combatant = combatants[i]
                    if tonumber(combatant.characterCode) == tonumber(character.codigoInterno) and
                       combatant.isIndependent ~= true then
                        ConfiguredSpells.syncSummary(combatant, characterSheet)
                    end
                end
            end
            local function refreshConditionEffectSummaries()
                if not isLocalGM() then return end
                local combatants = getCombatants()
                for i = 1, #combatants do
                    local combatant = combatants[i]
                    if tonumber(combatant.characterCode) == tonumber(character.codigoInterno) and
                       combatant.isIndependent ~= true then
                        ConfiguredSpells.EffectSync.schedule(combatant, character, characterSheet)
                    end
                end
            end
            observer.onDeepChanged = function(node, attribute)
                if attribute == "spellName" or attribute == "pmCost" or
                   attribute == "damageFormula" or attribute == "resolutionMode" or
                   attribute == "attackBonus" or attribute == "saveType" or
                   attribute == "saveCD" then
                    refreshConfiguredSpellSummaries()
                end
                if attribute == "conditionId" or attribute == "conditionName" or
                   attribute == "effectSummary" or attribute == "buffId" or
                   attribute == "buffName" or attribute == "effectKind" or
                   attribute == "attackBonus" or attribute == "damageBonus" or
                   attribute == "defenseBonus" or attribute == "durationType" or
                   attribute == "remaining" then
                    refreshConditionEffectSummaries()
                end
            end
            observer.onDeepChildAdded = function(node)
                refreshConfiguredSpellSummaries()
                refreshConditionEffectSummaries()
            end
            observer.onDeepChildRemoved = function(node)
                refreshConfiguredSpellSummaries()
                refreshConditionEffectSummaries()
            end
            sheetObservers[key] = {observer=observer, characterSheet=characterSheet}
            refreshConditionEffectSummaries()
        end
        local function addCombatant(character, combatantType)
            combatantType = combatantType == "npc" and "npc" or "player"
            local createInstance = combatantType == "npc"
            local existing = nil
            if createInstance ~= true then existing = findReusableCombatant(character.codigoInterno) end
            if existing ~= nil then
                existing.combatantType = "player"
                existing.combatantTypeText = "Tipo: Jogador"
                existing.isIndependent = false
                existing.ownerLogin = character.dono and character.dono.login or existing.ownerLogin or ""
                ensureCombatantId(existing)
                updateCombatantName(existing, character, nil)
                openCharacterSheet(character, function(characterSheet)
                    updateCombatantFromSheet(existing, character, characterSheet)
                end)
                return existing
            end

            local node = self.rclCombatants:append()
            if node == nil then return nil end
            node.combatantId = newCombatantId()
            node.characterCode = character.codigoInterno
            node.isIndependent = createInstance == true
            node.combatantType = combatantType
            node.combatantTypeText = combatantType == "npc" and "Tipo: NPC" or "Tipo: Jogador"
            if node.isIndependent == true then
                node.instanceIndex = nextInstanceIndex(character.codigoInterno)
                node.instanceLabel = instanceLabel(node.instanceIndex)
            else
                node.instanceLabel = ""
            end
            node.ownerLogin = character.dono and character.dono.login or ""
            node.initiative = 0
            node.initiativeMod = 0
            node.conditionsText = "Sem condicoes"
            node.effectsText = "Sem penalidades"
            node.turnMarker = ""
            node.tokenLinked = false
            node.tokenLinkVersion = 0
            node.tokenLinkText = "Token: nao vinculado"
            node.targetText = "Alvos: nenhum"
            node.targetCount = 0
            node.spellSummary = "Nenhuma magia cadastrada"
            node.abilitySummary = "Nenhuma habilidade cadastrada"
            node.areaMode = "defense"
            node.areaModeText = "Magia: desativada (Ataque x Defesa)"
            node.areaArmed = false
            updateCombatantName(node, character, nil)

            openCharacterSheet(character, function(characterSheet)
                updateCombatantFromSheet(node, character, characterSheet)
            end)
            return node
        end

        local function chooseCharacterToAdd(combatantType)
            if not requireGM() then return end
            combatantType = combatantType == "npc" and "npc" or "player"
            local characters = {}
            collectCharacters(room.biblioteca, characters)
            if #characters == 0 then
                showMessage("Nenhuma ficha fib.Tormenta20 foi encontrada na biblioteca da mesa.")
                return
            end
            table.sort(characters, function(a, b) return (a.nome or "") < (b.nome or "") end)
            local names = {}
            for i = 1, #characters do names[i] = characters[i].nome or "Personagem" end
            local title = combatantType == "npc" and "Adicionar NPC" or "Adicionar jogador"
            Dialogs.choose(title, names,
                function(selected, selectedIndex)
                    if not selected then return end
                    local character = characters[selectedIndex]
                    if combatantType == "player" then
                        local playerNode = addCombatant(character, "player")
                        if playerNode ~= nil then
                            self.rclCombatants.selectedNode = playerNode
                            self.rclCombatants:sort()
                            sheet.lastCapture = (playerNode.name or character.nome or "Jogador") ..
                                                " adicionado com regras de jogador"
                        end
                        return
                    end
                    Dialogs.inputQuery(
                        "Quantidade",
                        "Quantos NPCs independentes deseja adicionar? (1 a 50)",
                        "1",
                        function(quantityText)
                            local quantity = math.floor(tonumber(quantityText) or 0)
                            if quantity < 1 or quantity > 50 then
                                showMessage("Informe uma quantidade entre 1 e 50.")
                                return
                            end
                            local lastNode = nil
                            for i = 1, quantity do
                                lastNode = addCombatant(character, "npc")
                            end
                            if lastNode ~= nil then
                                self.rclCombatants.selectedNode = lastNode
                                self.rclCombatants:sort()
                                sheet.lastCapture = tostring(quantity) .. " NPC(s) adicionado(s): " ..
                                                    (character.nome or "NPC")
                            end
                        end
                    )
                end
            )
        end

        local function setManualInitiative()
            if not requireGM() then return end
            local combatant = selectedCombatant
            if combatant == nil then showMessage("Selecione um combatente primeiro."); return end
            Dialogs.inputQuery("Iniciativa", "Resultado da Iniciativa:", tostring(combatant.initiative or 0),
                function(value)
                    local number = tonumber(value)
                    if number == nil then showMessage("Informe um numero valido."); return end
                    combatant.initiative = number
                    self.rclCombatants:sort()
                end
            )
        end

        local function rollSelectedInitiative()
            if not canRollSelectedInitiative() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                local isGM = isLocalGM()
                if isGM then syncConditionEffects(combatant, character, characterSheet) end
                local bonus = tonumber(characterSheet.totalInic) or 0
                if combatant.isIndependent == true then
                    bonus = bonus + (tonumber(combatant.initiativePenalty) or 0)
                end
                local name = characterDisplayName(character, characterSheet)
                if isGM then updateCombatantName(combatant, character, characterSheet) end
                local requestId = tostring(combatant.combatantId or "none")
                local requestTag = " T20C_INIT:" .. tostring(combatant.characterCode) ..
                                   ":" .. requestId
                room.chat:rolarDados(
                    "1d20 + " .. tostring(bonus),
                    "[T20 Combate] Iniciativa de " .. name .. requestTag,
                    function(rolled)
                        if isGM then
                            combatant.initiative = tonumber(rolled.resultado) or 0
                            combatant.initiativeMod = bonus
                            self.rclCombatants:sort()
                        else
                            pcall(function()
                                sheet.lastCapture = "Iniciativa enviada ao mestre; aguardando sincronizacao"
                            end)
                        end
                    end
                )
            end)
        end        local function rollAllInitiatives()
            if not requireGM() then return end
            local nodes = getCombatants()
            if #nodes == 0 then showMessage("Adicione combatentes primeiro."); return end

            local remaining = #nodes
            sheet.lastCapture = "Rolando todas as iniciativas..."

            local function finishOne()
                remaining = remaining - 1
                if remaining <= 0 then
                    self.rclCombatants:sort()
                    sheet.lastCapture = "Todas as iniciativas foram roladas."
                end
            end

            for i = 1, #nodes do
                local combatant = nodes[i]
                local character = room:findBibliotecaItem(tonumber(combatant.characterCode))
                if character == nil then
                    finishOne()
                else
                    character:asyncOpenNDB():thenDo(
                        function(characterSheet)
                            updateCombatantFromSheet(combatant, character, characterSheet)
                            local bonus = tonumber(characterSheet.totalInic) or 0
                            if combatant.isIndependent == true then
                                bonus = bonus + (tonumber(combatant.initiativePenalty) or 0)
                            end
                            room.chat:rolarDados(
                                "1d20 + " .. tostring(bonus),
                                "[T20 Combate] Iniciativa de " .. (combatant.name or "Personagem"),
                                function(rolled)
                                    combatant.initiative = tonumber(rolled.resultado) or 0
                                    combatant.initiativeMod = bonus
                                    finishOne()
                                end
                            )
                        end,
                        function()
                            finishOne()
                        end
                    )
                end
            end
        end
        local function rollMyInitiative()
            if room == nil or room.meuJogador == nil then
                showMessage("Abra o painel dentro de uma mesa.")
                return
            end

            local code = tonumber(room.meuJogador.personagemPrincipal)
            if code == nil or code < 0 then
                showMessage("Escolha seu personagem principal na mesa antes de rolar.")
                return
            end

            local character = room:findBibliotecaItem(code)
            if character == nil or character.tipo ~= "personagem" then
                showMessage("Seu personagem principal nao foi encontrado na biblioteca.")
                return
            end
            if character.dataType ~= FIB_DATA_TYPE then
                showMessage("Seu personagem principal precisa usar a ficha fib.Tormenta20.")
                return
            end

            local isGM = isLocalGM()
            local combatant = findReusableCombatant(code)
            if combatant == nil and isGM then
                combatant = addCombatant(character, "player")
            end

            openCharacterSheet(character, function(characterSheet)
                local bonus = tonumber(characterSheet.totalInic) or 0
                local name = characterDisplayName(character, characterSheet)
                if combatant ~= nil and isGM then
                    updateCombatantFromSheet(combatant, character, characterSheet)
                    combatant.ownerLogin = room.meuJogador.login or combatant.ownerLogin or ""
                    combatant.initiativeMod = bonus
                end

                local requestId = combatant ~= nil and
                                  tostring(combatant.combatantId or "none") or "none"
                local requestTag = " T20C_INIT:" .. tostring(code) .. ":" .. requestId
                room.chat:rolarDados(
                    "1d20 + " .. tostring(bonus),
                    "[T20 Combate] Minha iniciativa - " .. name .. requestTag,
                    function(rolled)
                        if isGM and combatant ~= nil then
                            combatant.initiative = tonumber(rolled.resultado) or 0
                            combatant.initiativeMod = bonus
                            sheet.lastCapture = name .. " rolou " .. tostring(combatant.initiative)
                            self.rclCombatants.selectedNode = combatant
                            self.rclCombatants:sort()
                        else
                            pcall(function()
                                sheet.lastCapture = "Iniciativa enviada ao mestre; aguardando sincronizacao"
                            end)
                        end
                    end
                )
            end)
        end
        local function repairCombatants()
            local nodes = getCombatants()
            local isGM = isLocalGM()

            for i = #nodes, 1, -1 do
                local node = nodes[i]
                local code = tonumber(node.characterCode)
                local character = code and room:findBibliotecaItem(code) or nil

                if character == nil then
                    if isGM then NDB.deleteNode(node) end
                elseif character.tipo ~= "personagem" or character.dataType ~= FIB_DATA_TYPE then
                    if isGM then NDB.deleteNode(node) end
                else
                    ensureCombatantId(node)
                    if tostring(node.downState or "") == "testing" then
                        node.downTestPending = false
                    end
                    if node.tokenLinkVersion == nil then node.tokenLinkVersion = 0 end
                    if node.tokenLinked == nil then node.tokenLinked = false end
                    if node.tokenLinkText == nil then node.tokenLinkText = "Token: nao vinculado" end
                    migrateLegacyTarget(node)
                    syncTargetSummary(node)
                    node.areaMode = "defense"
                    node.areaSaveType = nil
                    node.areaSaveCD = nil
                    node.areaArmed = false
                    node.areaModeText = "Magias configuradas automaticamente"
                    if node.isIndependent == nil then node.isIndependent = character.dono == nil end
                    if node.isIndependent == true and node.instanceIndex == nil then
                        node.instanceIndex = nextInstanceIndex(code)
                    end
                    updateCombatantName(node, character, nil)
                    character:asyncOpenNDB():thenDo(
                        function(characterSheet)
                            updateCombatantFromSheet(node, character, characterSheet)
                        end,
                        function() end
                    )
                end
            end

            if sheet.currentCombatantId == nil and sheet.currentCharacterCode ~= nil then
                local oldCode = tonumber(sheet.currentCharacterCode)
                for i = 1, #nodes do
                    if tonumber(nodes[i].characterCode) == oldCode then
                        sheet.currentCombatantId = ensureCombatantId(nodes[i])
                        break
                    end
                end
            end
        end

        local function adjustSelectedHP(delta)
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                local current
                local maximum
                if combatant.isIndependent == true then
                    current = tonumber(combatant.currentHP) or 0
                    maximum = tonumber(combatant.maxHP) or 0
                    current = math.max(0, current + delta)
                    if delta > 0 and maximum > 0 then current = math.min(maximum, current) end
                    combatant.currentHP = current
                else
                    current = tonumber(characterSheet.PVs_Atuais) or 0
                    maximum = tonumber(characterSheet.PVs_Totais) or 0
                    current = math.max(-10, current + delta)
                    if delta > 0 and maximum > 0 then current = math.min(maximum, current) end
                    characterSheet.PVs_Atuais = current
                    combatant.currentHP = current
                    combatant.maxHP = maximum
                end
                if syncCombatantToken ~= nil then
                    syncCombatantToken(combatant, character, characterSheet)
                end
                postChat((combatant.name or "Personagem") .. " agora esta com " ..
                         tostring(current) .. "/" .. tostring(maximum) .. " PV.")
                if removeDefeatedNPC ~= nil then removeDefeatedNPC(combatant, character) end
                if PlayerDown.handleHP ~= nil then
                    PlayerDown.handleHP(combatant, character, characterSheet, true)
                end
            end)
        end

        local function defineSelectedHP()
            if not canManageSelectedConditions() then return end
            local combatant = selectedCombatant
            if combatant == nil then return end
            local initial = tostring(combatant.currentHP or 0) .. "/" .. tostring(combatant.maxHP or 0)
            Dialogs.inputQuery("Pontos de Vida", "Informe PV atual/maximo (ex.: 18/25):", initial,
                function(value)
                    if value == nil then return end
                    local currentText, maximumText = string.match(value, "^%s*(%-?%d+)%s*/%s*(%d+)%s*$")
                    local current = tonumber(currentText)
                    local maximum = tonumber(maximumText)
                    if current == nil or maximum == nil or maximum < 0 then
                        showMessage("Use o formato atual/maximo, por exemplo 18/25.")
                        return
                    end
                    local minimumHP = combatant.isIndependent == true and 0 or -10
                    current = math.max(minimumHP, math.min(current, maximum))
                    withSelectedSheet(function(target, character, characterSheet)
                        if tostring(target.combatantId) ~= tostring(combatant.combatantId) then return end
                        target.currentHP = current
                        target.maxHP = maximum
                        if target.isIndependent ~= true then
                            characterSheet.PVs_Atuais = current
                            characterSheet.PVs_Totais = maximum
                        end
                        if syncCombatantToken ~= nil then
                            syncCombatantToken(target, character, characterSheet)
                        end
                        if removeDefeatedNPC ~= nil then removeDefeatedNPC(target, character) end
                        if PlayerDown.handleHP ~= nil then
                            PlayerDown.handleHP(target, character, characterSheet, true)
                        end
                    end)
                end
            )
        end

        function ConfiguredSpells.adjustSelectedPM(delta)
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                local current
                local maximum
                if combatant.isIndependent == true then
                    current = tonumber(combatant.currentPM) or
                              tonumber(characterSheet.PMs_Atuais) or 0
                    maximum = tonumber(combatant.maxPM) or
                              tonumber(characterSheet.PMs_Totais) or current
                    current = math.max(0, current + delta)
                    if maximum > 0 then current = math.min(maximum, current) end
                    combatant.currentPM = current
                    combatant.maxPM = maximum
                else
                    current = tonumber(characterSheet.PMs_Atuais) or 0
                    maximum = tonumber(characterSheet.PMs_Totais) or 0
                    current = math.max(0, current + delta)
                    if maximum > 0 then current = math.min(maximum, current) end
                    characterSheet.PMs_Atuais = current
                    combatant.currentPM = current
                    combatant.maxPM = maximum
                end
                if syncCombatantToken ~= nil then
                    syncCombatantToken(combatant, character, characterSheet)
                end
                postChat((combatant.name or "Personagem") .. " agora esta com " ..
                         tostring(current) .. "/" .. tostring(maximum) .. " PM.")
            end)
        end

        function ConfiguredSpells.defineSelectedPM()
            if not canManageSelectedConditions() then return end
            local combatant = selectedCombatant
            if combatant == nil then return end
            local initial = tostring(combatant.currentPM or 0) .. "/" ..
                            tostring(combatant.maxPM or 0)
            Dialogs.inputQuery("Pontos de Mana", "Informe PM atual/maximo (ex.: 8/12):", initial,
                function(value)
                    if value == nil then return end
                    local currentText, maximumText =
                        string.match(value, "^%s*(%d+)%s*/%s*(%d+)%s*$")
                    local current = tonumber(currentText)
                    local maximum = tonumber(maximumText)
                    if current == nil or maximum == nil or maximum < 0 then
                        showMessage("Use o formato atual/maximo, por exemplo 8/12.")
                        return
                    end
                    current = math.max(0, math.min(current, maximum))
                    withSelectedSheet(function(target, character, characterSheet)
                        if tostring(target.combatantId) ~= tostring(combatant.combatantId) then return end
                        target.currentPM = current
                        target.maxPM = maximum
                        if target.isIndependent ~= true then
                            characterSheet.PMs_Atuais = current
                            characterSheet.PMs_Totais = maximum
                        end
                        if syncCombatantToken ~= nil then
                            syncCombatantToken(target, character, characterSheet)
                        end
                        postChat((target.name or "Personagem") .. " agora esta com " ..
                                 tostring(current) .. "/" .. tostring(maximum) .. " PM.")
                    end)
                end)
        end

        local function removeSelectedCombatant()
            if not requireGM() then return end
            local combatant = selectedCombatant
            if combatant == nil then return end
            local removedId = tostring(ensureCombatantId(combatant))
            local nodes = getCombatants()
            for i = 1, #nodes do
                removeCombatantTarget(nodes[i], removedId)
            end
            if unlinkCombatantTokens ~= nil then unlinkCombatantTokens(combatant, true) end
            NDB.deleteNode(combatant)
            selectedCombatant = nil
            selectedCharacter = nil
            selectedCharacterSheet = nil
            self.detailScope:setNodeObject(nil)
            self.detailScope.visible = false
            if sheet ~= nil and tostring(sheet.currentCombatantId or "") == removedId then
                sheet.currentCombatantId = nil
                sheet.currentCharacterCode = nil
                sheet.currentName = "Nenhum"
            end
        end

        local function sortedCombatants()
            local nodes = getCombatants()
            table.sort(nodes, function(a, b)
                local initA = tonumber(a.initiative) or 0
                local initB = tonumber(b.initiative) or 0
                if initA ~= initB then return initA > initB end
                local modA = tonumber(a.initiativeMod) or 0
                local modB = tonumber(b.initiativeMod) or 0
                if modA ~= modB then return modA > modB end
                return (a.name or "") < (b.name or "")
            end)
            return nodes
        end

        local function markCurrent(combatant)
            local nodes = getCombatants()
            for i = 1, #nodes do nodes[i].turnMarker = "" end
            if combatant ~= nil then
                ensureCombatantId(combatant)
                combatant.turnMarker = ">"
                sheet.currentCombatantId = combatant.combatantId
                sheet.currentCharacterCode = combatant.characterCode
                sheet.currentName = combatant.name or "Personagem"
                self.rclCombatants.selectedNode = combatant
            else
                sheet.currentCombatantId = nil
                sheet.currentCharacterCode = nil
                sheet.currentName = "Nenhum"
            end
            if refreshTurnHighlight ~= nil then refreshTurnHighlight(combatant) end
        end
        local function applyDamage(combatant, character, characterSheet, amount, reason, silent)
            local current
            if combatant.isIndependent == true then
                current = tonumber(combatant.currentHP)
                if current == nil then current = tonumber(characterSheet.PVs_Atuais) end
                if current == nil then
                    postChat((combatant.name or "Personagem") .. " sofreu " .. tostring(amount) ..
                             " de dano por " .. reason .. ", mas o PV atual nao era numerico.")
                    return
                end
                combatant.currentHP = math.max(0, current - amount)
                current = combatant.currentHP
            else
                current = tonumber(characterSheet.PVs_Atuais)
                if current == nil then
                    postChat((combatant.name or "Personagem") .. " sofreu " .. tostring(amount) ..
                             " de dano por " .. reason .. ", mas o PV atual nao era numerico.")
                    return
                end
                characterSheet.PVs_Atuais = math.max(-10, current - amount)
                combatant.currentHP = characterSheet.PVs_Atuais
                current = characterSheet.PVs_Atuais
            end
            if syncCombatantToken ~= nil then
                syncCombatantToken(combatant, character, characterSheet)
            end
            if silent ~= true then
                postChat((combatant.name or "Personagem") .. " sofreu " .. tostring(amount) ..
                         " de dano por " .. reason .. " e ficou com " .. tostring(current) .. " PV.")
            end
            if removeDefeatedNPC ~= nil then removeDefeatedNPC(combatant, character) end
            if PlayerDown.handleHP ~= nil then
                PlayerDown.handleHP(combatant, character, characterSheet, true)
            end
            return current
        end

        PlayerDown.DEATH_BG = "codexT20DeathBgV1"
        PlayerDown.DEATH_X = "codexT20DeathXV1"
        PlayerDown.CIRCLE_PATH = "M 0.5 0 C 0.776 0 1 0.224 1 0.5 " ..
                                 "C 1 0.776 0.776 1 0.5 1 " ..
                                 "C 0.224 1 0 0.776 0 0.5 C 0 0.224 0.224 0 0.5 0 Z"
        PlayerDown.X_PATH = "M 0.18 0.18 L 0.82 0.82 M 0.82 0.18 L 0.18 0.82"
        PlayerDown.X_INSET = 0.14
        PlayerDown.X_SIZE = 0.72
        PlayerDown.X_STROKE = 4

        function PlayerDown.isPlayer(combatant, character)
            if combatant == nil then return false end
            if combatant.combatantType == "player" then return true end
            if combatant.combatantType == "npc" then return false end
            if combatant.isIndependent == true then return false end
            local ownerLogin = tostring(combatant.ownerLogin or "")
            return ownerLogin ~= "" or (character ~= nil and character.dono ~= nil)
        end

        local function isNPCCombatant(combatant, character)
            if combatant == nil then return false end
            if combatant.combatantType == "npc" then return true end
            if combatant.combatantType == "player" then return false end
            local ownerLogin = tostring(combatant.ownerLogin or "")
            return combatant.isIndependent == true or
                   (ownerLogin == "" and (character == nil or character.dono == nil))
        end

        function PlayerDown.clearMarkerFromToken(token)
            if token == nil or token.isObjectAlive == false or token.canvas == nil then return false end
            local changed = false
            local bg = token.canvas:findByName(PlayerDown.DEATH_BG)
            local cross = token.canvas:findByName(PlayerDown.DEATH_X)
            if bg ~= nil then pcall(function() bg:delete() end); changed = true end
            if cross ~= nil then pcall(function() cross:delete() end); changed = true end
            return changed
        end

        function PlayerDown.resizeMarkerOnToken(token)
            if token == nil or token.isObjectAlive == false or token.canvas == nil then return false end
            local cross = token.canvas:findByName(PlayerDown.DEATH_X)
            if cross == nil then return false end
            cross.x = PlayerDown.X_INSET
            cross.y = PlayerDown.X_INSET
            cross.width = PlayerDown.X_SIZE
            cross.height = PlayerDown.X_SIZE
            cross.strokeSize = PlayerDown.X_STROKE
            return true
        end

        function PlayerDown.syncMarker(combatant)
            if not isLocalGM() or combatant == nil or combatant.tokenLinked ~= true then return false end
            local token, scene = findTokenForCombatant(combatant)
            if token == nil or scene == nil or not canEditToken(token) then return false end
            local changed = PlayerDown.clearMarkerFromToken(token)
            if tostring(combatant.downState or "") == "dead" then
                local bg = token.canvas:addPath()
                if bg ~= nil then
                    bg.name = PlayerDown.DEATH_BG
                    bg.data = PlayerDown.CIRCLE_PATH
                    bg.x = 0.06; bg.y = 0.06; bg.width = 0.88; bg.height = 0.88
                    bg.color = "#050505C8"
                    bg.strokeColor = "#8B0000F0"
                    bg.strokeSize = 4
                    bg.strokeSizeMetric = "screenMetric"
                    bg.z = 12000
                    bg.visibility = "everyone"
                    bg.outOfOrderMode = "afterOwnerLayer"
                    changed = true
                end
                local cross = token.canvas:addPath()
                if cross ~= nil then
                    cross.name = PlayerDown.DEATH_X
                    cross.data = PlayerDown.X_PATH
                    cross.x = PlayerDown.X_INSET; cross.y = PlayerDown.X_INSET
                    cross.width = PlayerDown.X_SIZE; cross.height = PlayerDown.X_SIZE
                    cross.color = "#00000000"
                    cross.strokeColor = "#FF2424"
                    cross.strokeSize = PlayerDown.X_STROKE
                    cross.strokeSizeMetric = "screenMetric"
                    cross.strokeJoin = "round"
                    cross.z = 12001
                    cross.visibility = "everyone"
                    cross.outOfOrderMode = "afterOwnerLayer"
                    changed = true
                end
            end
            if changed then pcall(function() scene:sendDelayedUpdates() end) end
            return changed
        end

        function PlayerDown.ensureFallenCondition(combatant, character, characterSheet)
            local root = conditionRoot(combatant, characterSheet)
            if findCondition(root, "caido") == nil then
                addCondition(combatant, character, characterSheet, "caido", "")
                combatant.downAutoCaido = true
            end
        end

        function PlayerDown.refresh(combatant, character, characterSheet)
            syncConditionEffects(combatant, character, characterSheet)
            if syncCombatantToken ~= nil then syncCombatantToken(combatant, character, characterSheet) end
            PlayerDown.syncMarker(combatant)
        end

        function PlayerDown.clearState(combatant, character, characterSheet)
            local oldState = tostring(combatant.downState or "")
            if oldState == "" then return false end
            local removeAutomaticCaido = combatant.downAutoCaido == true
            combatant.downState = nil
            combatant.downNeedsTest = nil
            combatant.downTestPending = nil
            combatant.downAutoCaido = nil
            if removeAutomaticCaido then
                removeConditionById(combatant, character, characterSheet, "caido")
            else
                syncConditionEffects(combatant, character, characterSheet)
            end
            if syncCombatantToken ~= nil then syncCombatantToken(combatant, character, characterSheet) end
            PlayerDown.syncMarker(combatant)
            postChat((combatant.name or "Personagem") ..
                     " voltou a ter PV positivos; o estado de queda foi removido.")
            return true
        end

        function PlayerDown.markDead(combatant, character, characterSheet)
            local wasDead = tostring(combatant.downState or "") == "dead"
            PlayerDown.ensureFallenCondition(combatant, character, characterSheet)
            combatant.downState = "dead"
            combatant.downNeedsTest = false
            combatant.downTestPending = false
            combatant.currentHP = -10
            if tonumber(characterSheet.PVs_Atuais) ~= -10 then characterSheet.PVs_Atuais = -10 end
            PlayerDown.refresh(combatant, character, characterSheet)
            if not wasDead then
                postChat((combatant.name or "Personagem") ..
                         " chegou a -10 PV e MORREU. O token recebeu o marcador de morte.")
            end
            return true
        end

        function PlayerDown.rollConstitution(combatant, character, characterSheet)
            if not isLocalGM() or not PlayerDown.isPlayer(combatant, character) then return false end
            if tostring(combatant.downState or "") ~= "testing" or
               combatant.downTestPending == true then return false end
            local hp = tonumber(characterSheet.PVs_Atuais) or tonumber(combatant.currentHP) or 0
            if hp > 0 then PlayerDown.clearState(combatant, character, characterSheet); return false end
            if hp <= -10 then PlayerDown.markDead(combatant, character, characterSheet); return false end

            local displayName = combatant.name or characterDisplayName(character, characterSheet)
            local bonus = (tonumber(characterSheet.ModCon) or 0) +
                          (tonumber(combatant.physicalPenalty) or 0)
            combatant.downTestPending = true
            combatant.downNeedsTest = false
            room.chat:rolarDados("1d20 + " .. tostring(bonus),
                "[T20 Combate] Caido - Constituicao CD 15 - " .. displayName,
                function(rolled)
                    if tostring(combatant.downState or "") ~= "testing" then
                        combatant.downTestPending = false
                        return
                    end
                    local currentHP = tonumber(characterSheet.PVs_Atuais) or
                                      tonumber(combatant.currentHP) or 0
                    if currentHP > 0 then
                        combatant.downTestPending = false
                        PlayerDown.clearState(combatant, character, characterSheet)
                        return
                    end
                    if currentHP <= -10 then
                        combatant.downTestPending = false
                        PlayerDown.markDead(combatant, character, characterSheet)
                        return
                    end

                    local result = tonumber(rolled.resultado) or 0
                    if result >= 15 then
                        combatant.downState = "stable"
                        combatant.downNeedsTest = false
                        combatant.downTestPending = false
                        PlayerDown.refresh(combatant, character, characterSheet)
                        postChat(displayName .. " passou em Constituicao CD 15 (" ..
                                 tostring(result) .. ") e ficou ESTABILIZADO; nao fara novos testes.")
                        return
                    end

                    room.chat:rolarDados("1d6", "[T20 Combate] Dano por falha - " .. displayName,
                        function(damageRoll)
                            if tostring(combatant.downState or "") ~= "testing" then
                                combatant.downTestPending = false
                                return
                            end
                            local damage = math.max(0, tonumber(damageRoll.resultado) or 0)
                            local remaining = applyDamage(combatant, character, characterSheet,
                                                          damage, "falha de Constituicao", true)
                            if tostring(combatant.downState or "") ~= "dead" then
                                combatant.downTestPending = false
                                combatant.downNeedsTest = true
                                PlayerDown.refresh(combatant, character, characterSheet)
                                postChat(displayName .. " falhou em Constituicao CD 15 (" ..
                                         tostring(result) .. "), sofreu " .. tostring(damage) ..
                                         " de dano e ficou com " .. tostring(remaining or "?") ..
                                         " PV; repetira o teste no proximo turno.")
                            end
                        end)
                end)
            return true
        end

        function PlayerDown.handleHP(combatant, character, characterSheet, immediateTest)
            if not isLocalGM() or not PlayerDown.isPlayer(combatant, character) or
               characterSheet == nil then return false end
            local hp = tonumber(characterSheet.PVs_Atuais) or tonumber(combatant.currentHP)
            if hp == nil then return false end
            if hp < -10 then
                hp = -10
                combatant.currentHP = -10
                if combatant.downClampActive ~= true then
                    combatant.downClampActive = true
                    characterSheet.PVs_Atuais = -10
                    combatant.downClampActive = nil
                end
            else
                combatant.currentHP = hp
            end

            if hp <= -10 then return PlayerDown.markDead(combatant, character, characterSheet) end
            if hp > 0 then return PlayerDown.clearState(combatant, character, characterSheet) end

            PlayerDown.ensureFallenCondition(combatant, character, characterSheet)
            local state = tostring(combatant.downState or "")
            if state == "dead" then
                PlayerDown.refresh(combatant, character, characterSheet)
                return true
            end
            if state == "" then
                combatant.downState = "testing"
                combatant.downNeedsTest = true
                combatant.downTestPending = false
                PlayerDown.refresh(combatant, character, characterSheet)
                postChat((combatant.name or "Personagem") ..
                         " chegou a 0 PV ou menos, ficou CAIDO e deve testar Constituicao CD 15.")
                if immediateTest == true then
                    PlayerDown.rollConstitution(combatant, character, characterSheet)
                end
            else
                PlayerDown.refresh(combatant, character, characterSheet)
            end
            return true
        end

        function PlayerDown.onTurnStart(combatant, character, characterSheet)
            if not isLocalGM() or not PlayerDown.isPlayer(combatant, character) then return false end
            PlayerDown.handleHP(combatant, character, characterSheet, false)
            if tostring(combatant.downState or "") == "dead" then
                postChat((combatant.name or "Personagem") .. " esta morto e nao realiza acoes.")
                return true
            end
            if tostring(combatant.downState or "") == "testing" and
               combatant.downNeedsTest == true and combatant.downTestPending ~= true then
                PlayerDown.rollConstitution(combatant, character, characterSheet)
            end
            return false
        end
        local function processTurnStart(combatant)
            if combatant == nil then return end
            local character = room:findBibliotecaItem(tonumber(combatant.characterCode))
            if character == nil then return end

            openCharacterSheet(character, function(characterSheet)
                syncConditionEffects(combatant, character, characterSheet)
                local root = conditionRoot(combatant, characterSheet)
                local displayName = combatant.name or characterDisplayName(character, characterSheet)
                if PlayerDown.onTurnStart ~= nil and
                   PlayerDown.onTurnStart(combatant, character, characterSheet) == true then
                    return
                end

                if findCondition(root, "em_chamas") ~= nil then
                    room.chat:rolarDados("1d6", "[T20 Combate] Em Chamas - " .. displayName,
                        function(rolled)
                            applyDamage(combatant, character, characterSheet,
                                        tonumber(rolled.resultado) or 0, "Em Chamas")
                        end
                    )
                end

                if findCondition(root, "sangrando") ~= nil then
                    local bonus = (tonumber(characterSheet.ModCon) or 0) +
                                  (tonumber(combatant.physicalPenalty) or 0)
                    room.chat:rolarDados("1d20 + " .. tostring(bonus),
                        "[T20 Combate] Sangrando - Constituicao CD 15 - " .. displayName,
                        function(rolled)
                            if (tonumber(rolled.resultado) or 0) >= 15 then
                                removeConditionById(combatant, character, characterSheet, "sangrando")
                                postChat(displayName .. " estabilizou e parou de sangrar.")
                            else
                                room.chat:rolarDados("1d6",
                                    "[T20 Combate] Dano de Sangramento - " .. displayName,
                                    function(damageRoll)
                                        applyDamage(combatant, character, characterSheet,
                                            tonumber(damageRoll.resultado) or 0, "Sangramento")
                                    end
                                )
                            end
                        end
                    )
                end

                if findCondition(root, "confuso") ~= nil then
                    room.chat:rolarDados("1d6", "[T20 Combate] Confuso - " .. displayName,
                        function(rolled)
                            local result = tonumber(rolled.resultado) or 0
                            local outcomes = {
                                "move em uma direcao aleatoria (role 1d8)",
                                "nao age, exceto reacoes", "nao age, exceto reacoes",
                                "ataca a criatura mais proxima", "ataca a criatura mais proxima",
                                "age normalmente e remove Confuso"
                            }
                            postChat(displayName .. ": " .. (outcomes[result] or "resultado invalido") .. ".")
                            if result == 6 then
                                removeConditionById(combatant, character, characterSheet, "confuso")
                            end
                        end
                    )
                end
            end)
        end

        local function processTurnEnd(combatant)
            if combatant == nil then return end
            local character = room:findBibliotecaItem(tonumber(combatant.characterCode))
            if character == nil then return end
            openCharacterSheet(character, function(characterSheet)
                local root = conditionRoot(combatant, characterSheet)
                local conditions = childNodes(root, "t20cConditions")
                local changed = false
                for i = #conditions, 1, -1 do
                    if conditions[i].durationType == "rounds" then
                        local remaining = (tonumber(conditions[i].remaining) or 1) - 1
                        if remaining <= 0 then
                            postChat((conditions[i].conditionName or "Condicao") .. " terminou em " ..
                                     (combatant.name or "Personagem") .. ".")
                            NDB.deleteNode(conditions[i])
                        else
                            conditions[i].remaining = remaining
                        end
                        changed = true
                    end
                end
                local buffs = childNodes(root, "t20cBuffs")
                for i = #buffs, 1, -1 do
                    if buffs[i].durationType == "rounds" then
                        local remaining = (tonumber(buffs[i].remaining) or 1) - 1
                        if remaining <= 0 then
                            postChat((buffs[i].buffName or "Buff") .. " terminou em " ..
                                     (combatant.name or "Personagem") .. ".")
                            NDB.deleteNode(buffs[i])
                        else
                            buffs[i].remaining = remaining
                        end
                        changed = true
                    end
                end
                local auras = childNodes(combatant, "t20cAuras")
                for i = #auras, 1, -1 do
                    if auras[i].durationType == "rounds" then
                        local remaining = (tonumber(auras[i].remaining) or 1) - 1
                        if remaining <= 0 then
                            postChat((auras[i].auraName or "Aura") .. " terminou em " ..
                                     (combatant.name or "Personagem") .. ".")
                            deleteAuraVisual(combatant, auras[i].auraId)
                            NDB.deleteNode(auras[i])
                        else
                            auras[i].remaining = remaining
                        end
                        changed = true
                    end
                end
                if changed then
                    ConfiguredSpells.EffectSync.schedule(combatant, character, characterSheet)
                    if syncCombatantAuras ~= nil then syncCombatantAuras(combatant) end
                end
            end)
        end

        removeDefeatedNPC = function(combatant, character)
            if combatant == nil or tonumber(combatant.currentHP) == nil or
               tonumber(combatant.currentHP) > 0 then return false end
            if not isLocalGM() then return false end

            if not isNPCCombatant(combatant, character) then return false end

            local defeatedId = tostring(ensureCombatantId(combatant))
            if npcRemovalPending[defeatedId] == true then return true end
            npcRemovalPending[defeatedId] = true

            setTimeout(function()
                if npcRemovalPending[defeatedId] ~= true then return end
                npcRemovalPending[defeatedId] = nil
                local defeated = findCombatantById(defeatedId)
                if defeated == nil or (tonumber(defeated.currentHP) or 1) > 0 then return end
                local defeatedCharacter = room and room:findBibliotecaItem(tonumber(defeated.characterCode)) or nil
                if not isNPCCombatant(defeated, defeatedCharacter) then return end

                local ordered = sortedCombatants()
                local defeatedIndex = nil
                for i = 1, #ordered do
                    if tostring(ensureCombatantId(ordered[i])) == defeatedId then
                        defeatedIndex = i
                        break
                    end
                end
                local wasCurrent = tostring(sheet.currentCombatantId or "") == defeatedId
                local successor = nil
                local wrapped = false
                if wasCurrent and defeatedIndex ~= nil and #ordered > 1 then
                    local successorIndex = defeatedIndex + 1
                    if successorIndex > #ordered then successorIndex = 1; wrapped = true end
                    successor = ordered[successorIndex]
                end

                local defeatedName = defeated.name or "NPC"
                local nodes = getCombatants()
                for i = 1, #nodes do
                    removeCombatantTarget(nodes[i], defeatedId)
                end
                defeated.downState = "dead"
                if PlayerDown.syncMarker ~= nil then PlayerDown.syncMarker(defeated) end
                if unlinkCombatantTokens ~= nil then unlinkCombatantTokens(defeated, false, true) end
                NDB.deleteNode(defeated)

                if selectedCombatant ~= nil and
                   tostring(selectedCombatant.combatantId or "") == defeatedId then
                    selectedCombatant = nil
                    selectedCharacter = nil
                    selectedCharacterSheet = nil
                    self.detailScope:setNodeObject(nil)
                    self.detailScope.visible = false
                end
                if tostring(sheet.previousCombatantId or "") == defeatedId then
                    sheet.previousCombatantId = nil
                    sheet.previousRound = nil
                end
                if tostring(sheet.redoCombatantId or "") == defeatedId then
                    sheet.redoCombatantId = nil
                    sheet.redoRound = nil
                end

                postChat(defeatedName .. " chegou a 0 PV e foi removido do tracker.")
                if wasCurrent then
                    if successor ~= nil then
                        if wrapped then
                            sheet.round = (tonumber(sheet.round) or 1) + 1
                            SpellAreas.tickSpellAreasRound()
                        end
                        markCurrent(successor)
                        postChat("Rodada " .. tostring(sheet.round or 1) .. " - turno de " ..
                                 (successor.name or "Personagem") .. ".")
                        processTurnStart(successor)
                    else
                        markCurrent(nil)
                    end
                end
            end, 1)
            return true
        end
        local function advanceTurn()
            local nodes = sortedCombatants()
            if #nodes == 0 then showMessage("Adicione combatentes primeiro."); return end

            local currentIndex = 0
            local currentId = tostring(sheet.currentCombatantId or "")
            for i = 1, #nodes do
                if tostring(ensureCombatantId(nodes[i])) == currentId then
                    currentIndex = i
                    break
                end
            end

            local nextIndex = currentIndex + 1
            if currentIndex == 0 then nextIndex = 1 end
            if nextIndex > #nodes then nextIndex = 1 end
            local nextCombatant = nodes[nextIndex]

            local redoId = tostring(sheet.redoCombatantId or "")
            if redoId ~= "" and tostring(ensureCombatantId(nextCombatant)) == redoId then
                sheet.previousCombatantId = currentIndex > 0 and nodes[currentIndex].combatantId or nil
                sheet.previousRound = tonumber(sheet.round) or 1
                sheet.round = tonumber(sheet.redoRound) or tonumber(sheet.round) or 1
                sheet.redoCombatantId = nil
                sheet.redoRound = nil
                markCurrent(nextCombatant)
                postChat("Turno restaurado para " .. (nextCombatant.name or "Personagem") .. ".")
                return
            end

            sheet.redoCombatantId = nil
            sheet.redoRound = nil
            sheet.previousCombatantId = currentIndex > 0 and nodes[currentIndex].combatantId or nil
            sheet.previousRound = tonumber(sheet.round) or 1

            if currentIndex > 0 then processTurnEnd(nodes[currentIndex]) end

            if currentIndex > 0 and nextIndex == 1 then
                sheet.round = (tonumber(sheet.round) or 1) + 1
                SpellAreas.tickSpellAreasRound()
            end

            markCurrent(nextCombatant)
            postChat("Rodada " .. tostring(sheet.round or 1) .. " - turno de " ..
                     (nextCombatant.name or "Personagem") .. ".")
            processTurnStart(nextCombatant)
        end

        local function nextTurn()
            if not requireGM() then return end
            advanceTurn()
        end

        local function previousTurn()
            if not requireGM() then return end
            local previousId = tostring(sheet.previousCombatantId or "")
            if previousId == "" then
                showMessage("Nao ha um turno anterior registrado para voltar.")
                return
            end

            local nodes = sortedCombatants()
            local previousCombatant = nil
            for i = 1, #nodes do
                if tostring(ensureCombatantId(nodes[i])) == previousId then
                    previousCombatant = nodes[i]
                    break
                end
            end
            if previousCombatant == nil then
                showMessage("O combatente do turno anterior nao esta mais na ordem.")
                return
            end

            sheet.redoCombatantId = sheet.currentCombatantId
            sheet.redoRound = tonumber(sheet.round) or 1
            sheet.round = tonumber(sheet.previousRound) or tonumber(sheet.round) or 1
            sheet.previousCombatantId = nil
            sheet.previousRound = nil
            markCurrent(previousCombatant)
            postChat("O mestre voltou o turno para " .. (previousCombatant.name or "Personagem") .. ".")
        end

        local function requestEndMyTurn()
            if room == nil or room.meuJogador == nil then return end
            local currentId = tostring(sheet.currentCombatantId or "")
            if currentId == "" then
                showMessage("O combate ainda nao possui um turno ativo.")
                return
            end

            local currentCombatant = nil
            local nodes = getCombatants()
            for i = 1, #nodes do
                if tostring(ensureCombatantId(nodes[i])) == currentId then
                    currentCombatant = nodes[i]
                    break
                end
            end
            if currentCombatant == nil then
                showMessage("O combatente atual nao foi encontrado.")
                return
            end

            if isLocalGM() then
                Dialogs.choose("Encerrar turno", {"Confirmar", "Cancelar"},
                    function(selected, selectedIndex)
                        if selected and selectedIndex == 1 then advanceTurn() end
                    end
                )
                return
            end

            local character = room:findBibliotecaItem(tonumber(currentCombatant.characterCode))
            local mainCode = tonumber(room.meuJogador.personagemPrincipal)
            local isOwner = character ~= nil and character.dono == room.meuJogador
            local isMain = mainCode ~= nil and mainCode >= 0 and
                           tonumber(currentCombatant.characterCode) == mainCode
            if not isOwner and not isMain then
                showMessage("Agora nao e o turno de um personagem seu.")
                return
            end

            Dialogs.choose("Encerrar meu turno",
                {"Confirmar fim do turno", "Cancelar"},
                function(selected, selectedIndex)
                    if not selected or selectedIndex ~= 1 then return end
                    room.chat:enviarMensagem(
                        "[T20 Combate] " .. (currentCombatant.name or room.meuJogador.nick or "Jogador") ..
                        " encerrou o turno. T20C_END:" .. currentId
                    )
                end
            )
        end
        local function restartCombat()
            if not requireGM() then return end
            sheet.round = 1
            sheet.currentCombatantId = nil
            sheet.currentCharacterCode = nil
            sheet.currentName = "Nenhum"
            sheet.previousCombatantId = nil
            sheet.previousRound = nil
            sheet.redoCombatantId = nil
            sheet.redoRound = nil
            markCurrent(nil)
            postChat("A ordem de combate foi reiniciada.")
        end

        local function clearInitiative()
            if not requireGM() then return end
            Dialogs.choose("Limpar ordem", {"Sim", "Nao"},
                function(selected, selectedIndex)
                    if not selected or selectedIndex ~= 1 then return end
                    local nodes = getCombatants()
                    for i = #nodes, 1, -1 do NDB.deleteNode(nodes[i]) end
                    sheet.round = 1
                    sheet.currentCombatantId = nil
                    sheet.currentCharacterCode = nil
                    sheet.currentName = "Nenhum"
                    sheet.previousCombatantId = nil
                    sheet.previousRound = nil
                    sheet.redoCombatantId = nil
                    sheet.redoRound = nil
                    selectedCombatant = nil
                    selectedCharacter = nil
                    selectedCharacterSheet = nil
                    self.detailScope:setNodeObject(nil)
                    self.detailScope.visible = false
                    if refreshTurnHighlight ~= nil then refreshTurnHighlight(nil) end
                end
            )
        end

        local function endScene()
            if not requireGM() then return end
            Dialogs.choose("Encerrar cena", {"Remover condicoes, efeitos, auras e areas de magia da cena", "Cancelar"},
                function(selected, selectedIndex)
                    if not selected or selectedIndex ~= 1 then return end
                    local nodes = getCombatants()
                    for i = 1, #nodes do
                        local combatant = nodes[i]
                        local auras = childNodes(combatant, "t20cAuras")
                        for j = #auras, 1, -1 do
                            if auras[j].durationType == "scene" then
                                deleteAuraVisual(combatant, auras[j].auraId)
                                NDB.deleteNode(auras[j])
                            end
                        end
                        local character = room:findBibliotecaItem(tonumber(combatant.characterCode))
                        if character ~= nil then
                            openCharacterSheet(character, function(characterSheet)
                                local root = conditionRoot(combatant, characterSheet)
                                local conditions = childNodes(root, "t20cConditions")
                                for j = #conditions, 1, -1 do NDB.deleteNode(conditions[j]) end
                                local buffs = childNodes(root, "t20cBuffs")
                                for j = #buffs, 1, -1 do
                                    if buffs[j].durationType == "scene" then NDB.deleteNode(buffs[j]) end
                                end
                                ConfiguredSpells.EffectSync.schedule(combatant, character, characterSheet)
                            end)
                        end
                    end
                    local removedAreas = SpellAreas.clearSceneSpellAreas("scene")
                    postChat("Cena encerrada; condicoes, efeitos, auras e " .. tostring(removedAreas) ..
                             " area(s) de magia da cena foram removidos.")
                end
            )
        end

        local function normalizeAttackName(value)
            local text = tostring(value or "")
            text = string.gsub(text, "^%s+", "")
            text = string.gsub(text, "%s+$", "")
            return string.lower(text)
        end

        local function playerMessageKey(player)
            if player == nil then return nil end
            return tostring(player.login or player.codigoInterno or "")
        end

        local function findAttackerForPlayer(player)
            if player == nil then return nil end
            local isMessageGM = player.isMestre == true
            if isMessageGM and selectedCombatant ~= nil and hasCombatantTargets(selectedCombatant) then
                return selectedCombatant
            end

            local current = findCombatantById(sheet.currentCombatantId)
            if isMessageGM and current ~= nil and hasCombatantTargets(current) then
                return current
            end

            local mainCode = tonumber(player.personagemPrincipal)
            local nodes = getCombatants()
            if mainCode ~= nil and mainCode >= 0 then
                for i = 1, #nodes do
                    if tonumber(nodes[i].characterCode) == mainCode and hasCombatantTargets(nodes[i]) then
                        return nodes[i]
                    end
                end
            end

            local onlyOwned = nil
            for i = 1, #nodes do
                local combatant = nodes[i]
                if hasCombatantTargets(combatant) then
                    local character = room:findBibliotecaItem(tonumber(combatant.characterCode))
                    local ownerLogin = character and character.dono and character.dono.login or nil
                    local playerLogin = player and player.login or nil
                    if character ~= nil and (character.dono == player or
                       (ownerLogin ~= nil and tostring(ownerLogin) == tostring(playerLogin))) then
                        if onlyOwned ~= nil then return nil end
                        onlyOwned = combatant
                    end
                end
            end
            return onlyOwned
        end
        local function firstNaturalD20(roll)
            if roll == nil or roll.ops == nil then return nil end
            for i = 1, #roll.ops do
                local op = roll.ops[i]
                if op.tipo == "dado" and tonumber(op.face) == 20 and
                   op.resultados ~= nil and op.resultados[1] ~= nil then
                    return tonumber(op.resultados[1])
                end
            end
            return nil
        end

        local function attackNameFromContent(content)
            return string.match(tostring(content or ""), ":%s*(.-)%s*$") or "Ataque"
        end

        local function damageNameFromContent(content)
            local text = tostring(content or "")
            return string.match(text, "[Dd][Aa][Nn][Oo]%s*:%s*(.-)%s*$") or
                   string.match(text, ":%s*(.-)%s*$") or "Ataque"
        end

        local function contentHeading(content)
            local text = tostring(content or "")
            local colon = string.find(text, ":", 1, true)
            if colon == nil then return string.lower(text) end
            return string.lower(string.sub(text, 1, colon - 1))
        end

        local function contentIsCriticalDamage(content)
            local text = tostring(content or "")
            return string.find(text, "Crítico", 1, true) ~= nil or
                   string.find(text, "CRÍTICO", 1, true) ~= nil or
                   string.find(string.lower(text), "critico", 1, true) ~= nil
        end

        local function beginPendingAttack(message, automaticCritical)
            local attacker = nil
            if ConfiguredSpells.MaximumDamage.findArmedAttacker ~= nil then
                attacker = ConfiguredSpells.MaximumDamage.findArmedAttacker(message.player)
            end
            if attacker == nil then attacker = findAttackerForPlayer(message.player) end
            if attacker == nil or tostring(attacker.areaMode or "defense") ~= "defense" then
                return false
            end
            local targets = getCombatantTargets(attacker)
            if #targets == 0 then return false end

            local targetData = {}
            for i = 1, #targets do
                local defense = tonumber(targets[i].effectiveDefense)
                if defense ~= nil then
                    targetData[#targetData + 1] = {
                        targetId=tostring(ensureCombatantId(targets[i])),
                        defense=defense
                    }
                else
                    postChat("A Defesa de " .. (targets[i].name or "alvo") ..
                             " nao esta disponivel; este alvo sera ignorado.")
                end
            end
            if #targetData == 0 then return true end

            local key = playerMessageKey(message.player)
            if key == nil or key == "" then return false end
            local natural = automaticCritical and 20 or firstNaturalD20(message.roll)
            local attackAdjustment = 0
            if attacker.isIndependent == true then
                attackAdjustment = (tonumber(attacker.attackPenalty) or 0) +
                                   (tonumber(attacker.attackBuff) or 0)
            end
            local rawTotal = tonumber(message.roll and message.roll.resultado)
            local total = automaticCritical and nil or ((rawTotal or 0) + attackAdjustment)
            local attackName = automaticCritical and "" or attackNameFromContent(message.content)
            local maximumDamage = attacker.maximumDamageArmed == true
            if maximumDamage then
                attacker.maximumDamageArmed = false
                attacker.maximumDamageArmedAt = nil
            end
            pendingAttacks[key] = {
                attackerId=tostring(ensureCombatantId(attacker)),
                targets=targetData,
                attackName=attackName,
                total=total,
                natural=natural,
                automaticCritical=automaticCritical == true,
                attackAdjustment=attackAdjustment,
                maximumDamage=maximumDamage,
                startedAt=System.getTickCount()
            }

            if natural == 1 then
                pendingAttacks[key] = nil
                postChat((attacker.name or "Combatente") .. " atacou " ..
                         tostring(#targetData) .. " alvo(s) com " .. attackName ..
                         ": FALHA CRITICA (1 natural). Nenhum dano aplicado.")
                sheet.lastCapture = "Falha critica em area: " .. (attacker.name or "Combatente")
            end
            return true
        end

        local function resolvePendingDamage(message)
            local key = playerMessageKey(message.player)
            local pending = key and pendingAttacks[key] or nil
            if pending == nil then return false end
            local elapsed = System.getTickCount() - (tonumber(pending.startedAt) or 0)
            if elapsed < 0 or elapsed > 20000 then
                pendingAttacks[key] = nil
                return false
            end

            local damageName = damageNameFromContent(message.content)
            if pending.attackName ~= "" and
               normalizeAttackName(pending.attackName) ~= normalizeAttackName(damageName) then
                return false
            end

            pendingAttacks[key] = nil
            local attacker = findCombatantById(pending.attackerId)
            if attacker == nil then return true end
            local targets = pending.targets or {}
            if #targets == 0 and pending.targetId ~= nil then
                targets[1] = {targetId=pending.targetId, defense=pending.defense}
            end

            local rolledDamage = math.max(0, tonumber(message.roll and message.roll.resultado) or 0)
            local originalRolledDamage = rolledDamage
            local maximumValue = nil
            if pending.maximumDamage == true and
               ConfiguredSpells.MaximumDamage.fromRoll ~= nil then
                maximumValue = ConfiguredSpells.MaximumDamage.fromRoll(message.roll)
                if maximumValue ~= nil then
                    rolledDamage = math.max(0, maximumValue)
                    postChat("DANO MAXIMO de " .. tostring(attacker.name or "Combatente") ..
                             ": " .. tostring(originalRolledDamage) .. " substituido por " ..
                             tostring(rolledDamage) .. " em " .. damageName .. ".")
                else
                    postChat("DANO MAXIMO de " .. tostring(attacker.name or "Combatente") ..
                             " nao conseguiu ler os dados de " .. damageName ..
                             "; o dano rolado foi mantido.")
                end
            end
            local damageBuff = tonumber(attacker.damageBuff) or 0
            local damage = math.max(0, rolledDamage + damageBuff)
            local damageBuffNote = damageBuff ~= 0 and
                ("; buff de Dano " .. signedNumber(damageBuff)) or ""
            local maximumDamageNote = maximumValue ~= nil and "; DANO MAXIMO" or ""
            local isCritical = pending.automaticCritical == true or
                               pending.natural == 20 or
                               contentIsCriticalDamage(message.content)
            local attackName = pending.attackName ~= "" and pending.attackName or damageName

            for i = 1, #targets do
                local targetInfo = targets[i]
                local target = findCombatantById(targetInfo.targetId)
                if target ~= nil then
                    local defense = tonumber(target.effectiveDefense) or tonumber(targetInfo.defense)
                    local hit = pending.natural ~= 1 and
                        (pending.natural == 20 or ((tonumber(pending.total) or -999999) >=
                                       (defense or 999999)))
                    local comparison = pending.automaticCritical and "critico automatico" or
                        (pending.natural == 20 and
                            ("20 natural; acerto automatico (" ..
                             tostring(pending.total or "?") .. " vs Defesa " ..
                             tostring(defense or "?") .. ")") or
                            (tostring(pending.total or "?") .. " vs Defesa " ..
                             tostring(defense or "?")))

                    if not hit then
                        local missStatus = isCritical and
                            "AMEACA DE CRITICO, mas nao superou a Defesa; ERRO" or "ERRO"
                        postChat((attacker.name or "Combatente") .. " atacou " ..
                                 (target.name or "Combatente") .. " com " .. attackName .. " (" ..
                                 comparison .. "): " .. missStatus .. ". " .. tostring(damage) ..
                                 " de dano ignorado" .. damageBuffNote .. maximumDamageNote .. ".")
                    else
                        local character = room:findBibliotecaItem(tonumber(target.characterCode))
                        if character ~= nil then
                            openCharacterSheet(character, function(characterSheet)
                                local remaining = applyDamage(target, character, characterSheet, damage,
                                                              attackName, true)
                                local status = isCritical and "CRITICO" or "ACERTO"
                                local suffix = remaining and ("; PV restante " .. tostring(remaining)) or ""
                                postChat((attacker.name or "Combatente") .. " atacou " ..
                                         (target.name or "Combatente") .. " com " .. attackName .. " (" ..
                                         comparison .. "): " .. status .. ", " .. tostring(damage) ..
                                         " de dano aplicado" .. damageBuffNote .. maximumDamageNote .. suffix .. ".")
                            end)
                        end
                    end
                end
            end
            sheet.lastCapture = "Ataque em area resolvido contra " .. tostring(#targets) .. " alvo(s)"
            return true
        end

        local function resistanceBonus(target, character, characterSheet, saveType)
            syncConditionEffects(target, character, characterSheet)
            local bonus = 0
            if saveType == "Fortitude" then
                bonus = tonumber(characterSheet.totalFort) or 0
                if target.isIndependent == true then
                    bonus = bonus + (tonumber(target.physicalPenalty) or 0)
                end
            elseif saveType == "Vontade" then
                bonus = tonumber(characterSheet.totalVont) or 0
                if target.isIndependent == true then
                    bonus = bonus + (tonumber(target.mentalPenalty) or 0)
                end
            else
                bonus = tonumber(characterSheet.totalRefl) or 0
                if target.isIndependent == true then
                    bonus = bonus + (tonumber(target.reflexPenalty) or 0)
                end
            end
            local autoFail = saveType == "Reflexos" and
                (target.reflexAutoFail == true or characterSheet.t20cReflexAutoFail == true)
            return bonus, autoFail
        end

        local function applyAreaSaveDamage(attacker, target, character, characterSheet,
                                           damage, effectName, saveType, saveCD,
                                           saveResult, succeeded, mode, damageBuffNote)
            local appliedDamage = damage
            if succeeded then
                if mode == "save_half" then
                    appliedDamage = math.floor(damage / 2)
                else
                    appliedDamage = 0
                end
            end

            local remaining = tonumber(target.currentHP)
            if appliedDamage > 0 then
                remaining = applyDamage(target, character, characterSheet, appliedDamage,
                                        effectName, true)
            end
            local saveStatus = succeeded and "SUCESSO" or "FALHA"
            local damageStatus = appliedDamage > 0 and
                (tostring(appliedDamage) .. " de dano aplicado") or "nenhum dano aplicado"
            local suffix = remaining and ("; PV restante " .. tostring(remaining)) or ""
            postChat((target.name or "Combatente") .. " fez " .. saveType ..
                     " " .. tostring(saveResult or "falha automatica") .. " vs CD " ..
                     tostring(saveCD) .. ": " .. saveStatus .. ", " .. damageStatus ..
                     damageBuffNote .. suffix .. ".")
        end

        local function resolvePreparedAreaDamage(message)
            local attacker = nil
            if ConfiguredSpells.MaximumDamage.findArmedAttacker ~= nil then
                attacker = ConfiguredSpells.MaximumDamage.findArmedAttacker(message.player)
            end
            if attacker == nil then attacker = findAttackerForPlayer(message.player) end
            if attacker == nil or attacker.areaArmed ~= true then return false end
            local mode = tostring(attacker.areaMode or "")
            if mode ~= "save_half" and mode ~= "save_none" then return false end
            local saveType = tostring(attacker.areaSaveType or "Reflexos")
            local saveCD = tonumber(attacker.areaSaveCD)
            if saveCD == nil then return false end
            local targets = getCombatantTargets(attacker)
            if #targets == 0 then return false end

            attacker.areaArmed = false
            updateAreaModeText(attacker)
            local useMaximumDamage = attacker.maximumDamageArmed == true
            if useMaximumDamage then
                attacker.maximumDamageArmed = false
                attacker.maximumDamageArmedAt = nil
            end
            local rolledDamage = math.max(0, tonumber(message.roll and message.roll.resultado) or 0)
            local originalRolledDamage = rolledDamage
            local maximumValue = nil
            if useMaximumDamage and ConfiguredSpells.MaximumDamage.fromRoll ~= nil then
                maximumValue = ConfiguredSpells.MaximumDamage.fromRoll(message.roll)
                if maximumValue ~= nil then
                    rolledDamage = math.max(0, maximumValue)
                    postChat("DANO MAXIMO de " .. tostring(attacker.name or "Combatente") ..
                             ": " .. tostring(originalRolledDamage) .. " substituido por " ..
                             tostring(rolledDamage) .. " na magia.")
                else
                    postChat("DANO MAXIMO nao conseguiu ler os dados da magia; " ..
                             "o dano rolado foi mantido.")
                end
            end
            local damageBuff = tonumber(attacker.damageBuff) or 0
            local damage = math.max(0, rolledDamage + damageBuff)
            local damageBuffNote = damageBuff ~= 0 and
                ("; buff de Dano " .. signedNumber(damageBuff)) or ""
            local maximumDamageNote = maximumValue ~= nil and "; DANO MAXIMO" or ""
            damageBuffNote = damageBuffNote .. maximumDamageNote
            local effectName = damageNameFromContent(message.content)
            postChat((attacker.name or "Combatente") .. " usou " .. effectName .. " em " ..
                     tostring(#targets) .. " alvo(s): " .. saveType .. " CD " ..
                     tostring(saveCD) .. ", dano base " .. tostring(damage) ..
                     maximumDamageNote .. ".")

            for i = 1, #targets do
                local target = targets[i]
                local character = room:findBibliotecaItem(tonumber(target.characterCode))
                if character ~= nil then
                    openCharacterSheet(character, function(characterSheet)
                        local bonus, autoFail = resistanceBonus(target, character,
                                                               characterSheet, saveType)
                        if autoFail then
                            applyAreaSaveDamage(attacker, target, character, characterSheet,
                                damage, effectName, saveType, saveCD, nil, false,
                                mode, damageBuffNote)
                            return
                        end
                        room.chat:rolarDados("1d20 + " .. tostring(bonus),
                            "[T20 Combate] " .. saveType .. " CD " .. tostring(saveCD) ..
                            " - " .. (target.name or "Combatente"),
                            function(rolled)
                                local result = tonumber(rolled.resultado) or 0
                                applyAreaSaveDamage(attacker, target, character, characterSheet,
                                    damage, effectName, saveType, saveCD, result,
                                    result >= saveCD, mode, damageBuffNote)
                            end)
                    end)
                end
            end
            sheet.lastCapture = "Resolvendo area contra " .. tostring(#targets) .. " alvo(s)"
            return true
        end
        function ConfiguredSpells.trimText(value)
            local text = tostring(value or "")
            text = string.gsub(text, "^%s+", "")
            text = string.gsub(text, "%s+$", "")
            return text
        end

        function ConfiguredSpells.root(combatant, characterSheet)
            if combatant ~= nil and combatant.isIndependent == true then return combatant end
            return characterSheet
        end

        function ConfiguredSpells.nodes(root)
            return childNodes(root, "t20cConfiguredSpells")
        end

        function ConfiguredSpells.find(root, spellId)
            local spells = ConfiguredSpells.nodes(root)
            for i = 1, #spells do
                if tostring(spells[i].spellId or "") == tostring(spellId or "") then
                    return spells[i]
                end
            end
            return nil
        end

        function ConfiguredSpells.modeText(spell)
            local mode = tostring(spell and spell.resolutionMode or "automatic")
            if mode == "defense" then
                return "Ataque " .. signedNumber(tonumber(spell.attackBonus) or 0) .. " x Defesa"
            end
            if mode == "save_half" or mode == "save_none" then
                local resultText = mode == "save_half" and "metade" or "anula"
                return tostring(spell.saveType or "Resistencia") .. " CD " ..
                       tostring(spell.saveCD or "?") .. " (" .. resultText .. ")"
            end
            return "dano automatico"
        end

        ConfiguredSpells.syncSummary = function(combatant, characterSheet)
            if combatant == nil or characterSheet == nil then return end
            local root = ConfiguredSpells.root(combatant, characterSheet)
            local spells = ConfiguredSpells.nodes(root)
            local summary
            if #spells == 0 then
                summary = "Nenhuma magia cadastrada"
            else
                local names = {}
                for i = 1, #spells do
                    names[#names + 1] = tostring(spells[i].spellName or "Magia")
                end
                summary = "Magias (" .. tostring(#spells) .. "): " .. table.concat(names, ", ")
            end
            pcall(function() combatant.spellSummary = summary end)
            if self.lblSpellSummary ~= nil and selectedCombatant ~= nil and
               tostring(selectedCombatant.combatantId or "") ==
               tostring(combatant.combatantId or "") then
                self.lblSpellSummary.text = summary
            end
        end
        function ConfiguredSpells.validDamageFormula(value)
            local formula = ConfiguredSpells.trimText(value)
            if formula == "" or string.len(formula) > 80 then return false, nil end
            if string.find(formula, "[^0-9dD%+%-%*/%(%)%.%s]") ~= nil then return false, nil end
            if string.find(formula, "%d") == nil then return false, nil end
            return true, formula
        end

        function ConfiguredSpells.saveDefinition(combatant, characterSheet, existing, data)
            local root = ConfiguredSpells.root(combatant, characterSheet)
            if root == nil then return false end
            local spell = existing
            if spell == nil then
                root.t20cNextConfiguredSpellId = (tonumber(root.t20cNextConfiguredSpellId) or 0) + 1
                local container = childContainer(root, "t20cConfiguredSpells", true)
                spell = NDB.createChildNode(container, "spell")
                if spell == nil then return false end
                spell.spellId = "spell-" .. tostring(root.t20cNextConfiguredSpellId)
            end
            spell.spellName = data.spellName
            spell.pmCost = data.pmCost
            spell.damageFormula = data.damageFormula
            spell.resolutionMode = data.resolutionMode
            spell.attackBonus = data.resolutionMode == "defense" and data.attackBonus or nil
            spell.saveType = (data.resolutionMode == "save_half" or
                              data.resolutionMode == "save_none") and data.saveType or nil
            spell.saveCD = (data.resolutionMode == "save_half" or
                            data.resolutionMode == "save_none") and data.saveCD or nil
            ConfiguredSpells.syncSummary(combatant, characterSheet)
            sheet.lastCapture = "Magia salva: " .. data.spellName .. " — " ..
                                ConfiguredSpells.modeText(spell)
            return true
        end

        function ConfiguredSpells.chooseResolution(combatant, characterSheet, existing, data)
            local choices = {
                "Ataque contra Defesa",
                "Dano automatico (sem teste)",
                "Reflexos: sucesso reduz a metade", "Reflexos: sucesso anula",
                "Fortitude: sucesso reduz a metade", "Fortitude: sucesso anula",
                "Vontade: sucesso reduz a metade", "Vontade: sucesso anula"
            }
            local configs = {
                {resolutionMode="defense"}, {resolutionMode="automatic"},
                {resolutionMode="save_half", saveType="Reflexos"},
                {resolutionMode="save_none", saveType="Reflexos"},
                {resolutionMode="save_half", saveType="Fortitude"},
                {resolutionMode="save_none", saveType="Fortitude"},
                {resolutionMode="save_half", saveType="Vontade"},
                {resolutionMode="save_none", saveType="Vontade"}
            }
            Dialogs.choose("Como a magia e resolvida?", choices,
                function(selected, selectedIndex)
                    if not selected or configs[selectedIndex] == nil then return end
                    local config = configs[selectedIndex]
                    data.resolutionMode = config.resolutionMode
                    data.saveType = config.saveType
                    data.attackBonus = nil
                    data.saveCD = nil
                    if config.resolutionMode == "defense" then
                        Dialogs.inputQuery("Ataque da magia", "Bonus total de ataque:",
                            tostring(existing and existing.attackBonus or 0),
                            function(value)
                                local bonus = tonumber(value)
                                if bonus == nil then
                                    showMessage("Informe um bonus numerico, como 8 ou -2.")
                                    return
                                end
                                data.attackBonus = bonus
                                ConfiguredSpells.saveDefinition(combatant, characterSheet, existing, data)
                            end)
                        return
                    end
                    if config.resolutionMode == "automatic" then
                        ConfiguredSpells.saveDefinition(combatant, characterSheet, existing, data)
                        return
                    end
                    Dialogs.inputQuery("Resistencia da magia", "Classe de Dificuldade (CD):",
                        tostring(existing and existing.saveCD or 10),
                        function(value)
                            local cd = tonumber(value)
                            if cd == nil or cd < 0 then
                                showMessage("Informe uma CD numerica valida, como 20.")
                                return
                            end
                            data.saveCD = cd
                            ConfiguredSpells.saveDefinition(combatant, characterSheet, existing, data)
                        end)
                end)
        end

        function ConfiguredSpells.openWizard(combatant, characterSheet, existing)
            local initialName = existing and existing.spellName or ""
            Dialogs.inputQuery("Magia", "Nome da magia:", tostring(initialName or ""),
                function(nameValue)
                    local spellName = ConfiguredSpells.trimText(nameValue)
                    if spellName == "" then
                        showMessage("Informe o nome da magia.")
                        return
                    end
                    Dialogs.inputQuery("Custo da magia", "Custo base em PM:",
                        tostring(existing and existing.pmCost or 0),
                        function(pmValue)
                            local pmCost = tonumber(pmValue)
                            if pmCost == nil or pmCost < 0 or pmCost > 999 then
                                showMessage("Informe um custo de PM entre 0 e 999.")
                                return
                            end
                            pmCost = math.floor(pmCost)
                            Dialogs.inputQuery("Dano da magia", "Formula de dano (ex.: 6d6+4):",
                                tostring(existing and existing.damageFormula or "1d6"),
                                function(damageValue)
                                    local valid, damageFormula = ConfiguredSpells.validDamageFormula(damageValue)
                                    if not valid then
                                        showMessage("Use uma formula de dados valida, como 6d6+4.")
                                        return
                                    end
                                    ConfiguredSpells.chooseResolution(combatant, characterSheet, existing, {
                                        spellName=spellName,
                                        pmCost=pmCost,
                                        damageFormula=damageFormula
                                    })
                                end)
                        end)
                end)
        end

        function ConfiguredSpells.choiceData(combatant, characterSheet)
            local root = ConfiguredSpells.root(combatant, characterSheet)
            local spells = ConfiguredSpells.nodes(root)
            local labels = {}
            for i = 1, #spells do
                labels[i] = tostring(spells[i].spellName or "Magia") .. " — " ..
                            tostring(spells[i].damageFormula or "0") .. " — " ..
                            ConfiguredSpells.modeText(spells[i])
            end
            return spells, labels
        end

        function ConfiguredSpells.add()
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                ConfiguredSpells.openWizard(combatant, characterSheet, nil)
            end)
        end

        function ConfiguredSpells.requestCast(attacker, spellId)
            if attacker == nil then return false end
            if #getCombatantTargets(attacker) == 0 then
                showMessage("Marque pelo menos um alvo antes de usar a magia.")
                return false
            end
            if isLocalGM() then
                if ConfiguredSpells.cast ~= nil then ConfiguredSpells.cast(attacker, spellId) end
                return true
            end
            NDB.broadcastMessage(sheet, "t20c_target_request", {
                attackerId=tostring(ensureCombatantId(attacker)),
                action="configured_spell_cast",
                spellId=tostring(spellId or "")
            })
            sheet.lastCapture = "Magia enviada ao mestre para resolucao automatica"
            return true
        end

        function ConfiguredSpells.chooseToCast()
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                local spells, labels = ConfiguredSpells.choiceData(combatant, characterSheet)
                if #spells == 0 then
                    showMessage("Cadastre uma magia primeiro.")
                    return
                end
                Dialogs.choose("Usar magia", labels,
                    function(selected, selectedIndex)
                        if not selected or spells[selectedIndex] == nil then return end
                        ConfiguredSpells.requestCast(combatant, spells[selectedIndex].spellId)
                    end)
            end)
        end

        function ConfiguredSpells.chooseToEdit()
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                local spells, labels = ConfiguredSpells.choiceData(combatant, characterSheet)
                if #spells == 0 then
                    showMessage("Nenhuma magia cadastrada para editar.")
                    return
                end
                Dialogs.choose("Editar magia", labels,
                    function(selected, selectedIndex)
                        if not selected or spells[selectedIndex] == nil then return end
                        ConfiguredSpells.openWizard(combatant, characterSheet, spells[selectedIndex])
                    end)
            end)
        end

        function ConfiguredSpells.chooseToRemove()
            if not canManageSelectedConditions() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                local spells, labels = ConfiguredSpells.choiceData(combatant, characterSheet)
                if #spells == 0 then
                    showMessage("Nenhuma magia cadastrada para remover.")
                    return
                end
                Dialogs.choose("Remover magia", labels,
                    function(selected, selectedIndex)
                        local spell = spells[selectedIndex]
                        if not selected or spell == nil then return end
                        local spellName = spell.spellName or "Magia"
                        Dialogs.choose("Confirmar remocao", {"Remover " .. spellName, "Cancelar"},
                            function(confirmSelected, confirmIndex)
                                if not confirmSelected or confirmIndex ~= 1 then return end
                                NDB.deleteNode(spell)
                                ConfiguredSpells.syncSummary(combatant, characterSheet)
                                sheet.lastCapture = "Magia removida: " .. spellName
                            end)
                    end)
            end)
        end

        function ConfiguredSpells.spendPM(attacker, character, characterSheet, baseCost)
            local extraCost = math.max(0, tonumber(attacker.pmExtra) or
                                          tonumber(characterSheet.t20cPmExtra) or 0)
            local totalCost = math.max(0, math.floor(tonumber(baseCost) or 0) + extraCost)
            local currentPM
            if attacker.isIndependent == true then
                currentPM = tonumber(attacker.currentPM)
                if currentPM == nil then currentPM = tonumber(characterSheet.PMs_Atuais) end
                if currentPM == nil then currentPM = tonumber(attacker.maxPM) end
            else
                currentPM = tonumber(characterSheet.PMs_Atuais)
            end
            currentPM = currentPM or 0
            if currentPM < totalCost then
                postChat((attacker.name or "Personagem") .. " tentou conjurar, mas possui " ..
                         tostring(currentPM) .. " PM e precisa de " .. tostring(totalCost) .. ".")
                return false, totalCost, currentPM
            end
            local remaining = currentPM - totalCost
            attacker.currentPM = remaining
            if attacker.isIndependent ~= true then characterSheet.PMs_Atuais = remaining end
            if syncCombatantToken ~= nil then
                syncCombatantToken(attacker, character, characterSheet)
            end
            return true, totalCost, remaining
        end

        function ConfiguredSpells.naturalD20(roll)
            if roll == nil or roll.ops == nil then return nil end
            for i = 1, #roll.ops do
                local op = roll.ops[i]
                if op.tipo == "dado" and tonumber(op.face) == 20 and
                   op.resultados ~= nil and op.resultados[1] ~= nil then
                    return tonumber(op.resultados[1])
                end
            end
            return nil
        end

        function ConfiguredSpells.applyAutomaticDamage(attacker, target, character, characterSheet,
                                                       spellName, damage, suffix)
            local remaining = applyDamage(target, character, characterSheet, damage, spellName, true)
            postChat((attacker.name or "Combatente") .. " usou " .. spellName .. " em " ..
                     (target.name or "Combatente") .. ": " .. tostring(damage) ..
                     " de dano aplicado" .. suffix ..
                     (remaining and ("; PV restante " .. tostring(remaining)) or "") .. ".")
        end

        ConfiguredSpells.cast = function(attacker, spellId)
            if not isLocalGM() or attacker == nil then return false end
            local casterCharacter = room:findBibliotecaItem(tonumber(attacker.characterCode))
            if casterCharacter == nil then return false end
            openCharacterSheet(casterCharacter, function(casterSheet)
                syncConditionEffects(attacker, casterCharacter, casterSheet)
                local root = ConfiguredSpells.root(attacker, casterSheet)
                local spell = ConfiguredSpells.find(root, spellId)
                if spell == nil then
                    postChat("A magia selecionada nao foi encontrada.")
                    return
                end
                local targets = getCombatantTargets(attacker)
                if #targets == 0 then
                    postChat((attacker.name or "Personagem") ..
                             " tentou usar uma magia sem alvos marcados.")
                    return
                end
                local definition = {
                    spellName=tostring(spell.spellName or "Magia"),
                    pmCost=tonumber(spell.pmCost) or 0,
                    damageFormula=tostring(spell.damageFormula or "0"),
                    resolutionMode=tostring(spell.resolutionMode or "automatic"),
                    attackBonus=tonumber(spell.attackBonus) or 0,
                    saveType=tostring(spell.saveType or "Reflexos"),
                    saveCD=tonumber(spell.saveCD) or 10
                }
                local spent, totalCost, remainingPM = ConfiguredSpells.spendPM(
                    attacker, casterCharacter, casterSheet, definition.pmCost)
                if not spent then return end
                postChat((attacker.name or "Personagem") .. " conjurou " .. definition.spellName ..
                         " por " .. tostring(totalCost) .. " PM; " .. tostring(remainingPM) ..
                         " PM restante(s). Alvos: " .. tostring(#targets) .. ".")

                room.chat:rolarDados(definition.damageFormula,
                    "[T20 Combate] Dano de " .. definition.spellName,
                    function(damageRoll)
                        local rolledDamage = math.max(0, tonumber(damageRoll.resultado) or 0)
                        local damageBuff = tonumber(attacker.damageBuff) or 0
                        local baseDamage = math.max(0, rolledDamage + damageBuff)
                        local damageBuffNote = damageBuff ~= 0 and
                            ("; buff de Dano " .. signedNumber(damageBuff)) or ""
                        for i = 1, #targets do
                            local target = targets[i]
                            local targetCharacter = room:findBibliotecaItem(tonumber(target.characterCode))
                            if targetCharacter ~= nil then
                                openCharacterSheet(targetCharacter, function(targetSheet)
                                    if definition.resolutionMode == "automatic" then
                                        ConfiguredSpells.applyAutomaticDamage(attacker, target, targetCharacter,
                                            targetSheet, definition.spellName, baseDamage, damageBuffNote)
                                        return
                                    end
                                    if definition.resolutionMode == "defense" then
                                        syncConditionEffects(target, targetCharacter, targetSheet)
                                        local defense = tonumber(target.effectiveDefense) or
                                                        tonumber(targetSheet.CA)
                                        if defense == nil then
                                            postChat("A Defesa de " .. (target.name or "alvo") ..
                                                     " nao esta disponivel; alvo ignorado.")
                                            return
                                        end
                                        local attackBonus = definition.attackBonus +
                                            (tonumber(attacker.mentalPenalty) or 0) +
                                            (tonumber(attacker.attackBuff) or 0)
                                        room.chat:rolarDados("1d20 + " .. tostring(attackBonus),
                                            "[T20 Combate] Ataque de " .. definition.spellName ..
                                            " - " .. (target.name or "Alvo"),
                                            function(attackRoll)
                                                local total = tonumber(attackRoll.resultado) or 0
                                                local natural = ConfiguredSpells.naturalD20(attackRoll)
                                                local critical = natural == 20
                                                local hit = natural ~= 1 and (critical or total >= defense)
                                                if not hit then
                                                    postChat((attacker.name or "Combatente") .. " usou " ..
                                                        definition.spellName .. " contra " ..
                                                        (target.name or "Combatente") .. " (" ..
                                                        tostring(total) .. " vs Defesa " .. tostring(defense) ..
                                                        "): ERRO. Nenhum dano aplicado.")
                                                    return
                                                end
                                                local appliedDamage = critical and baseDamage * 2 or baseDamage
                                                local remaining = applyDamage(target, targetCharacter, targetSheet,
                                                    appliedDamage, definition.spellName, true)
                                                postChat((attacker.name or "Combatente") .. " usou " ..
                                                    definition.spellName .. " contra " ..
                                                    (target.name or "Combatente") .. " (" ..
                                                    tostring(total) .. " vs Defesa " .. tostring(defense) ..
                                                    "): " .. (critical and "CRITICO, " or "ACERTO, ") ..
                                                    tostring(appliedDamage) .. " de dano aplicado" ..
                                                    damageBuffNote ..
                                                    (remaining and ("; PV restante " .. tostring(remaining)) or "") .. ".")
                                            end)
                                        return
                                    end
                                    local bonus, autoFail = resistanceBonus(target, targetCharacter,
                                                                             targetSheet, definition.saveType)
                                    if autoFail then
                                        applyAreaSaveDamage(attacker, target, targetCharacter, targetSheet,
                                            baseDamage, definition.spellName, definition.saveType,
                                            definition.saveCD, nil, false, definition.resolutionMode,
                                            damageBuffNote)
                                        return
                                    end
                                    room.chat:rolarDados("1d20 + " .. tostring(bonus),
                                        "[T20 Combate] " .. definition.saveType .. " CD " ..
                                        tostring(definition.saveCD) .. " - " ..
                                        (target.name or "Combatente"),
                                        function(saveRoll)
                                            local result = tonumber(saveRoll.resultado) or 0
                                            applyAreaSaveDamage(attacker, target, targetCharacter, targetSheet,
                                                baseDamage, definition.spellName, definition.saveType,
                                                definition.saveCD, result, result >= definition.saveCD,
                                                definition.resolutionMode, damageBuffNote)
                                        end)
                                end)
                            end
                        end
                        sheet.lastCapture = "Magia resolvida: " .. definition.spellName ..
                                            " contra " .. tostring(#targets) .. " alvo(s)"
                    end)
            end)
            return true
        end
        function ConfiguredSpells.QuickNPC.askNumber(title, prompt, initial, minimum, maximum, callback)
            Dialogs.inputQuery(title, prompt, tostring(initial or 0),
                function(value)
                    if value == nil then return end
                    local number = tonumber(value)
                    if number == nil or (minimum ~= nil and number < minimum) or
                       (maximum ~= nil and number > maximum) then
                        local rangeText = minimum ~= nil and maximum ~= nil and
                            (" entre " .. tostring(minimum) .. " e " .. tostring(maximum)) or " valido"
                        showMessage("Informe um numero" .. rangeText .. ".")
                        return
                    end
                    callback(number)
                end)
        end

        function ConfiguredSpells.QuickNPC.askResistances(data, callback)
            Dialogs.inputQuery("Resistencias", "Fortitude/Reflexos/Vontade (ex.: 8/5/3):",
                tostring(data.fortitude or 0) .. "/" .. tostring(data.reflexes or 0) ..
                "/" .. tostring(data.will or 0),
                function(value)
                    if value == nil then return end
                    local fort, refl, will = string.match(tostring(value),
                        "^%s*(%-?%d+)%s*/%s*(%-?%d+)%s*/%s*(%-?%d+)%s*$")
                    if fort == nil then
                        showMessage("Use o formato Fortitude/Reflexos/Vontade, como 8/5/3.")
                        return
                    end
                    data.fortitude = tonumber(fort)
                    data.reflexes = tonumber(refl)
                    data.will = tonumber(will)
                    callback()
                end)
        end

        function ConfiguredSpells.QuickNPC.askAttackDescription(data, attack)
            Dialogs.inputQuery("Descricao do ataque", "Observacoes (opcional):", "",
                function(value)
                    if value == nil then return end
                    attack.description = tostring(value or "")
                    data.attacks[#data.attacks + 1] = attack
                    ConfiguredSpells.QuickNPC.chooseNextAttack(data)
                end)
        end

        function ConfiguredSpells.QuickNPC.askAttackType(data, attack)
            Dialogs.inputQuery("Tipo de dano", "Ex.: Corte, Perfuracao, Fogo:", "Fisico",
                function(value)
                    if value == nil then return end
                    attack.damageType = ConfiguredSpells.trimText(value)
                    ConfiguredSpells.QuickNPC.askAttackDescription(data, attack)
                end)
        end

        function ConfiguredSpells.QuickNPC.askAttackCritical(data, attack)
            Dialogs.inputQuery("Critico do ataque", "Margem/multiplicador (ex.: 19/x3):", "20/x2",
                function(value)
                    if value == nil then return end
                    attack.critical = ConfiguredSpells.trimText(value)
                    if attack.critical == "" then attack.critical = "20/x2" end
                    ConfiguredSpells.QuickNPC.askAttackType(data, attack)
                end)
        end

        function ConfiguredSpells.QuickNPC.askAttackDamage(data, attack)
            Dialogs.inputQuery("Dano do ataque", "Formula de dano (ex.: 1d8+4):", "1d6",
                function(value)
                    if value == nil then return end
                    local valid, formula = ConfiguredSpells.validDamageFormula(value)
                    if not valid then
                        showMessage("Use uma formula de dano valida, como 1d8+4.")
                        return
                    end
                    attack.damage = formula
                    ConfiguredSpells.QuickNPC.askAttackCritical(data, attack)
                end)
        end

        function ConfiguredSpells.QuickNPC.askAttackBonus(data, attack)
            ConfiguredSpells.QuickNPC.askNumber("Bonus de ataque", "Bonus total do ataque:", 0,
                -999, 999,
                function(value)
                    attack.bonus = value
                    ConfiguredSpells.QuickNPC.askAttackDamage(data, attack)
                end)
        end

        function ConfiguredSpells.QuickNPC.askAttackRange(data, attack)
            Dialogs.inputQuery("Alcance do ataque", "Ex.: Corpo a corpo, Curto, 9m:",
                "Corpo a corpo",
                function(value)
                    if value == nil then return end
                    attack.range = ConfiguredSpells.trimText(value)
                    ConfiguredSpells.QuickNPC.askAttackBonus(data, attack)
                end)
        end

        function ConfiguredSpells.QuickNPC.askAttack(data)
            Dialogs.inputQuery("Ataque do NPC", "Nome do ataque:", "Ataque",
                function(value)
                    if value == nil then return end
                    local name = ConfiguredSpells.trimText(value)
                    if name == "" then
                        showMessage("Informe o nome do ataque.")
                        return
                    end
                    local attack = {name=name}
                    ConfiguredSpells.QuickNPC.askAttackRange(data, attack)
                end)
        end

        function ConfiguredSpells.QuickNPC.chooseNextAttack(data)
            Dialogs.choose("Ataques iniciais",
                {"Adicionar outro ataque", "Concluir e criar a ficha"},
                function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex == 1 then
                        ConfiguredSpells.QuickNPC.askAttack(data)
                    else
                        ConfiguredSpells.QuickNPC.createCharacter(data)
                    end
                end)
        end

        function ConfiguredSpells.QuickNPC.fillCharacterSheet(character, characterSheet, data)
            NDB.beginUpdate(characterSheet)
            characterSheet.NOME_DO_PERSONAGEM = data.name
            characterSheet.JOGADOR = "NPC"
            characterSheet["RAÇA"] = tostring(data.creatureType or "Ameaça")
            characterSheet.ORIGEM = tostring(data.source or "Tormenta20")
            characterSheet.CLASSE = "Ameaça ND " .. tostring(data.nd or "?")
            characterSheet.Lv = 1
            characterSheet.PVs_Totais = data.hp
            characterSheet.PVs_Atuais = data.hp
            characterSheet.PMs_Totais = data.pm
            characterSheet.PMs_Atuais = data.pm

            local attributeValues = {
                For=tonumber(data.strength) or 0, Des=tonumber(data.dexterity) or 0,
                Con=tonumber(data.constitution) or 0, Int=tonumber(data.intelligence) or 0,
                Sab=tonumber(data.wisdom) or 0, Car=tonumber(data.charisma) or 0
            }
            for field, modifier in pairs(attributeValues) do
                characterSheet[field] = 10 + (modifier * 2)
                characterSheet["Mod" .. field] = modifier
            end

            characterSheet.SeleAtribDefe = "Des"
            characterSheet.arm_pesa = false
            characterSheet.B_Arm1 = 0
            characterSheet.B_Esc2 = 0
            characterSheet.Pa = 0
            characterSheet.Pe = 0
            characterSheet.Outros_B_CA = data.defense - 10
            characterSheet.CA = data.defense

            local skillAttributes = {
                Acro="Des", Ades="Car", Atle="For", Atua="Car", Cava="Des",
                Conh="Int", Cura="Sab", Dipl="Car", Enga="Car", Fort="Con",
                Furt="Des", Guer="Int", Inic="Des", Inti="Car", Intu="Sab",
                Inve="Int", Joga="Car", Ladi="Des", Luta="For", Mist="Int",
                Nobr="Car", Ofi1="Int", Ofi2="Int", Perc="Sab", Pilo="Des",
                Pont="Des", Refl="Des", Reli="Sab", Sobr="Sab", Vont="Sab"
            }
            for skillId, attributeId in pairs(skillAttributes) do
                local modifier = tonumber(attributeValues[attributeId]) or 0
                characterSheet["checkTrei" .. skillId] = false
                characterSheet["nv" .. skillId] = 0
                characterSheet["trei" .. skillId] = 0
                characterSheet["atrib" .. skillId] = attributeId
                characterSheet["outr" .. skillId] = 0
                characterSheet["total" .. skillId] = modifier
            end
            local importedSkills = data.skills or {}
            for i = 1, #importedSkills do
                local sourceSkill = importedSkills[i]
                local skillId = tostring(sourceSkill.id or "")
                local attributeId = skillAttributes[skillId]
                if attributeId ~= nil then
                    local total = tonumber(sourceSkill.total) or 0
                    local modifier = tonumber(attributeValues[attributeId]) or 0
                    characterSheet["outr" .. skillId] = total - modifier
                    characterSheet["total" .. skillId] = total
                    if skillId == "Ofi1" then
                        characterSheet["Ofício_1"] = tostring(sourceSkill.name or "Ofício")
                    elseif skillId == "Ofi2" then
                        characterSheet["Ofício_2"] = tostring(sourceSkill.name or "Ofício")
                    end
                end
            end
            characterSheet.t20cQuickNPC = true
            characterSheet.t20cQuickNPCVersion = 3
            characterSheet.t20cThreatId = data.threatId
            characterSheet.t20cThreatND = data.nd
            characterSheet.t20cThreatSource = data.source
            characterSheet.t20cThreatSourcePage = data.sourcePage
            characterSheet.t20cThreatType = data.creatureType
            if data.replaceThreatGenerated == true then
                local oldAttacks = childNodes(characterSheet, "listaDeAtaques")
                for i = #oldAttacks, 1, -1 do
                    pcall(function() NDB.deleteNode(oldAttacks[i]) end)
                end
                local oldTrackerAbilities = childNodes(characterSheet, "t20cNpcAbilities")
                for i = #oldTrackerAbilities, 1, -1 do
                    if oldTrackerAbilities[i].t20cThreatGenerated == true or
                       tostring(oldTrackerAbilities[i].abilityId or "") == "official-statblock" then
                        pcall(function() NDB.deleteNode(oldTrackerAbilities[i]) end)
                    end
                end
                local oldFibAbilities = childNodes(characterSheet, "listaRacaOrigem")
                for i = #oldFibAbilities, 1, -1 do
                    if oldFibAbilities[i].t20cThreatGenerated == true then
                        pcall(function() NDB.deleteNode(oldFibAbilities[i]) end)
                    end
                end
            end

            local abilityContainer = childContainer(characterSheet, "t20cNpcAbilities", true)
            local fibAbilityContainer = childContainer(characterSheet, "listaRacaOrigem", true)
            local function addImportedAbility(abilityId, abilityName, actionType,
                                              description, pmCost, rollFormula)
                local ability = NDB.createChildNode(abilityContainer, "ability")
                ability.abilityId = abilityId
                ability.abilityName = abilityName
                ability.actionType = actionType
                ability.description = description
                ability.pmCost = pmCost
                ability.rollFormula = rollFormula
                ability.t20cThreatGenerated = true

                local fibAbility = NDB.createChildNode(fibAbilityContainer, "habilidade")
                fibAbility.nomeHabilidade = abilityName
                fibAbility.origemHabilidade = tostring(data.source or "Fonte") .. " - " ..
                                             tostring(actionType or "Passiva")
                fibAbility.descricaoHabilidade = description
                fibAbility.t20cThreatGenerated = true
            end
            if data.statblock ~= nil and tostring(data.statblock) ~= "" then
                addImportedAbility("official-statblock",
                    "Ficha oficial (" .. tostring(data.source or "Fonte") .. " p. " ..
                    tostring(data.sourcePage or "?") .. ")", "Passiva",
                    tostring(data.statblock), 0, "0")
            end
            local importedAbilities = data.abilities or {}
            for i = 1, #importedAbilities do
                local source = importedAbilities[i]
                addImportedAbility("official-ability-" .. tostring(i),
                    tostring(source.name or "Habilidade oficial"),
                    tostring(source.actionType or "Passiva"),
                    tostring(source.description or ""), tonumber(source.pmCost) or 0,
                    tostring(source.rollFormula or "0"))
            end
            local attackContainer = childContainer(characterSheet, "listaDeAtaques", true)
            local attacks = data.attacks or {}
            for i = 1, #attacks do
                local source = attacks[i]
                local attack = NDB.createChildNode(attackContainer, "ataque")
                attack.nomeAtaque = source.name
                attack.alcanceAtaque = source.range
                attack.bonusAtaque = tostring(source.bonus)
                attack.danoAtaque = source.damage
                attack.criticoAtaque = source.critical
                attack.tipoAtaque = source.damageType
                attack.descricaoAtaque = source.description
                attack.t20cThreatGenerated = true
            end
            NDB.endUpdate(characterSheet)

            if data.avatar ~= nil and data.avatar ~= "" then
                pcall(function() character:asyncUpdate({avatar=data.avatar}) end)
            end

if data.addToTracker == false then
                sheet.lastCapture = "Ficha importada: " .. tostring(data.name or "Ameaca")
                if data.onFilled ~= nil then pcall(data.onFilled, true) end
                return
            end

            local lastNode = nil
            local quantity = math.max(1, math.floor(tonumber(data.quantity) or 1))
            for i = 1, quantity do
                lastNode = addCombatant(character, "npc")
            end
            if lastNode ~= nil then
                self.rclCombatants.selectedNode = lastNode
                self.rclCombatants:sort()
            end
            sheet.lastCapture = "NPC rapido criado: " .. data.name .. " x" ..
                                tostring(quantity)
            postChat(data.name .. " foi criado em " .. tostring(data.libraryPath or "/") ..
                     " e adicionado ao tracker (" .. tostring(quantity) .. " copia(s)).")
        end

        function ConfiguredSpells.QuickNPC.libraryPath(item)
            local parts = {}
            local current = item
            local guard = 0
            while current ~= nil and guard < 64 do
                guard = guard + 1
                if tostring(current.tipo or "") == "biblioteca" then break end
                table.insert(parts, 1, tostring(current.nome or "Pasta"))
                current = current.pai
            end
            if #parts == 0 then return "/" end
            return "/" .. table.concat(parts, "/")
        end

        function ConfiguredSpells.QuickNPC.collectMonsterFolders(item, matches, visited)
            if item == nil then return end
            local identity = tostring(item.codigoInterno or item.objectID or item)
            if visited[identity] then return end
            visited[identity] = true
            local itemType = tostring(item.tipo or "")
            if itemType == "diretorio" and
               string.lower(ConfiguredSpells.trimText(item.nome)) == "monstros" then
                matches[#matches + 1] = {
                    item=item,
                    path=ConfiguredSpells.QuickNPC.libraryPath(item)
                }
            end
            local children = item.filhos or item.children or {}
            for i = 1, #children do
                local child = children[i]
                local childType = child and tostring(child.tipo or "") or ""
                if childType == "diretorio" then
                    ConfiguredSpells.QuickNPC.collectMonsterFolders(child, matches, visited)
                end
            end
        end

        function ConfiguredSpells.QuickNPC.createCharacterInFolder(data, destination, path)
            if destination == nil or destination.asyncCreateChar == nil then
                showMessage("A pasta escolhida nao permite criar personagens.")
                return
            end
            data.libraryPath = path or "/"
            sheet.lastCapture = "Criando ficha rapida de " .. data.name .. " em " ..
                                data.libraryPath .. "..."
            destination:asyncCreateChar({
                name=data.name,
                dataType=FIB_DATA_TYPE,
                visible=false,
                ownerLogin=nil
            }):thenDo(
                function(character)
                    if character == nil then
                        showMessage("O Firecast nao retornou a ficha criada.")
                        return
                    end
                    character:asyncOpenNDB():thenDo(
                        function(characterSheet)
                            ConfiguredSpells.QuickNPC.fillCharacterSheet(character, characterSheet, data)
                        end,
                        function(errorMessage)
                            showMessage("A ficha foi criada, mas nao pode ser preenchida: " ..
                                        tostring(errorMessage))
                        end)
                end,
                function(errorMessage)
                    showMessage("Nao foi possivel criar o NPC em " .. data.libraryPath .. ": " ..
                                tostring(errorMessage))
                end)
        end

        function ConfiguredSpells.QuickNPC.createCharacter(data)
            if room == nil or room.biblioteca == nil or
               room.biblioteca.asyncCreateChar == nil then
                showMessage("A biblioteca desta mesa nao permite criar personagens pelo plugin.")
                return
            end
            local matches = {}
            ConfiguredSpells.QuickNPC.collectMonsterFolders(room.biblioteca, matches, {})
            if #matches == 1 then
                ConfiguredSpells.QuickNPC.createCharacterInFolder(
                    data, matches[1].item, matches[1].path)
                return
            end
            if #matches > 1 then
                local labels = {}
                for i = 1, #matches do labels[i] = matches[i].path end
                Dialogs.choose("Escolha a pasta Monstros", labels,
                    function(selected, selectedIndex)
                        if not selected or matches[selectedIndex] == nil then return end
                        local target = matches[selectedIndex]
                        ConfiguredSpells.QuickNPC.createCharacterInFolder(
                            data, target.item, target.path)
                    end)
                return
            end
            Dialogs.choose("Pasta Monstros nao encontrada",
                {"Criar a pasta Monstros", "Salvar na raiz da biblioteca", "Cancelar"},
                function(selected, selectedIndex)
                    if not selected or selectedIndex == 3 then return end
                    if selectedIndex == 2 then
                        ConfiguredSpells.QuickNPC.createCharacterInFolder(
                            data, room.biblioteca, "/")
                        return
                    end
                    room.biblioteca:asyncCreateDir({name="Monstros", visible=false}):thenDo(
                        function(folder)
                            ConfiguredSpells.QuickNPC.createCharacterInFolder(
                                data, folder, "/Monstros")
                        end,
                        function(errorMessage)
                            showMessage("Nao foi possivel criar a pasta Monstros: " ..
                                        tostring(errorMessage))
                        end)
                end)
        end
        function ConfiguredSpells.QuickNPC.askAvatar(data)
            Dialogs.choose("Token do NPC",
                {"Escolher imagem enviada ao Firecast", "Informar uma URL", "Continuar sem token"},
                function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex == 1 then
                        if Dialogs.selectImageURL == nil then
                            showMessage("Esta versao do Firecast nao possui o seletor de imagens.")
                            ConfiguredSpells.QuickNPC.askAvatar(data)
                            return
                        end
                        Dialogs.selectImageURL("",
                            function(imageURL)
                                data.avatar = ConfiguredSpells.trimText(imageURL)
                                ConfiguredSpells.QuickNPC.chooseNextAttack(data)
                            end,
                            function()
                                ConfiguredSpells.QuickNPC.askAvatar(data)
                            end)
                    elseif selectedIndex == 2 then
                        Dialogs.inputQuery("Token do NPC", "URL da imagem do token/avatar:", "",
                            function(value)
                                if value == nil then
                                    ConfiguredSpells.QuickNPC.askAvatar(data)
                                    return
                                end
                                data.avatar = ConfiguredSpells.trimText(value)
                                ConfiguredSpells.QuickNPC.chooseNextAttack(data)
                            end)
                    else
                        data.avatar = ""
                        ConfiguredSpells.QuickNPC.chooseNextAttack(data)
                    end
                end)
        end

        function ConfiguredSpells.QuickNPC.start()
            if not requireGM() then return end
            local data = {attacks={}}
            Dialogs.inputQuery("NPC Rapido", "Nome do monstro:", "Novo NPC",
                function(value)
                    if value == nil then return end
                    data.name = ConfiguredSpells.trimText(value)
                    if data.name == "" then
                        showMessage("Informe o nome do NPC.")
                        return
                    end
                    ConfiguredSpells.QuickNPC.askNumber("Quantidade",
                        "Quantas copias independentes?", 1, 1, 50,
                        function(quantity)
                            data.quantity = math.floor(quantity)
                            ConfiguredSpells.QuickNPC.askNumber("Pontos de Vida",
                                "PV maximo:", 10, 1, 999999,
                                function(hp)
                                    data.hp = math.floor(hp)
                                    ConfiguredSpells.QuickNPC.askNumber("Pontos de Mana",
                                        "PM maximo:", 0, 0, 999999,
                                        function(pm)
                                            data.pm = math.floor(pm)
                                            ConfiguredSpells.QuickNPC.askNumber("Defesa",
                                                "Defesa do NPC:", 10, 0, 9999,
                                                function(defense)
                                                    data.defense = math.floor(defense)
                                                    ConfiguredSpells.QuickNPC.askNumber("Iniciativa",
                                                        "Bonus de Iniciativa:", 0, -999, 999,
                                                        function(initiative)
                                                            data.initiative = initiative
                                                            ConfiguredSpells.QuickNPC.askResistances(data,
                                                                function()
                                                                    ConfiguredSpells.QuickNPC.askNumber(
                                                                        "Constituicao",
                                                                        "Modificador de Constituicao:",
                                                                        0, -999, 999,
                                                                        function(constitution)
                                                                            data.constitution = constitution
                                                                            ConfiguredSpells.QuickNPC.askAvatar(data)
                                                                        end)
                                                                end)
                                                        end)
                                                end)
                                        end)
                                end)
                        end)
                end)
        end

        function ConfiguredSpells.QuickNPC.Abilities.isNPC(combatant)
            return combatant ~= nil and
                   (combatant.combatantType == "npc" or combatant.isIndependent == true)
        end

        function ConfiguredSpells.QuickNPC.Abilities.nodes(characterSheet)
            return childNodes(characterSheet, "t20cNpcAbilities")
        end

        function ConfiguredSpells.QuickNPC.Abilities.find(characterSheet, abilityId)
            local abilities = ConfiguredSpells.QuickNPC.Abilities.nodes(characterSheet)
            for i = 1, #abilities do
                if tostring(abilities[i].abilityId or "") == tostring(abilityId or "") then
                    return abilities[i]
                end
            end
            return nil
        end

        function ConfiguredSpells.QuickNPC.Abilities.syncSummary(combatant, characterSheet)
            if combatant == nil or characterSheet == nil then return end
            if not ConfiguredSpells.QuickNPC.Abilities.isNPC(combatant) then
                combatant.abilitySummary = "Habilidades rapidas: somente NPCs"
                return
            end
            local abilities = ConfiguredSpells.QuickNPC.Abilities.nodes(characterSheet)
            if #abilities == 0 then
                combatant.abilitySummary = "Nenhuma habilidade cadastrada"
                return
            end
            local names = {}
            for i = 1, #abilities do
                names[#names + 1] = tostring(abilities[i].abilityName or "Habilidade")
            end
            combatant.abilitySummary = "Habilidades (" .. tostring(#abilities) .. "): " ..
                                       table.concat(names, ", ")
        end

        function ConfiguredSpells.QuickNPC.Abilities.ensureSelected(callback)
            if not requireGM() then return end
            withSelectedSheet(function(combatant, character, characterSheet)
                if not ConfiguredSpells.QuickNPC.Abilities.isNPC(combatant) then
                    showMessage("As habilidades rapidas estao disponiveis apenas para NPCs.")
                    return
                end
                callback(combatant, character, characterSheet)
            end)
        end

        function ConfiguredSpells.QuickNPC.Abilities.save(combatant, characterSheet, existing, data)
            local ability = existing
            if ability == nil then
                characterSheet.t20cNextNpcAbilityId =
                    (tonumber(characterSheet.t20cNextNpcAbilityId) or 0) + 1
                local container = childContainer(characterSheet, "t20cNpcAbilities", true)
                ability = NDB.createChildNode(container, "ability")
                ability.abilityId = "ability-" .. tostring(characterSheet.t20cNextNpcAbilityId)
            end
            ability.abilityName = data.abilityName
            ability.actionType = data.actionType
            ability.description = data.description
            ability.pmCost = data.pmCost
            ability.rollFormula = data.rollFormula
            ConfiguredSpells.QuickNPC.Abilities.syncSummary(combatant, characterSheet)
            sheet.lastCapture = "Habilidade salva: " .. data.abilityName
        end

        function ConfiguredSpells.QuickNPC.Abilities.askRoll(combatant, characterSheet, existing, data)
            Dialogs.inputQuery("Rolagem da habilidade",
                "Formula opcional (ex.: 2d6+4; use 0 para nenhuma):",
                tostring(existing and existing.rollFormula or "0"),
                function(value)
                    if value == nil then return end
                    local formula = ConfiguredSpells.trimText(value)
                    if formula == "" then formula = "0" end
                    if formula ~= "0" then
                        local valid, normalized = ConfiguredSpells.validDamageFormula(formula)
                        if not valid then
                            showMessage("Use uma formula valida, como 2d6+4, ou 0.")
                            return
                        end
                        formula = normalized
                    end
                    data.rollFormula = formula
                    ConfiguredSpells.QuickNPC.Abilities.save(
                        combatant, characterSheet, existing, data)
                end)
        end

        function ConfiguredSpells.QuickNPC.Abilities.askCost(combatant, characterSheet, existing, data)
            ConfiguredSpells.QuickNPC.askNumber("Custo da habilidade", "Custo em PM:",
                existing and existing.pmCost or 0, 0, 999,
                function(value)
                    data.pmCost = math.floor(value)
                    ConfiguredSpells.QuickNPC.Abilities.askRoll(
                        combatant, characterSheet, existing, data)
                end)
        end

        function ConfiguredSpells.QuickNPC.Abilities.askDescription(combatant, characterSheet,
                                                                    existing, data)
            Dialogs.inputQuery("Descricao da habilidade", "Texto da habilidade:",
                tostring(existing and existing.description or ""),
                function(value)
                    if value == nil then return end
                    data.description = tostring(value or "")
                    ConfiguredSpells.QuickNPC.Abilities.askCost(
                        combatant, characterSheet, existing, data)
                end)
        end

        function ConfiguredSpells.QuickNPC.Abilities.chooseType(combatant, characterSheet,
                                                                existing, data)
            local choices = {"Padrao", "Movimento", "Reacao", "Livre", "Passiva"}
            Dialogs.choose("Tipo de habilidade", choices,
                function(selected, selectedIndex)
                    if not selected or choices[selectedIndex] == nil then return end
                    data.actionType = choices[selectedIndex]
                    ConfiguredSpells.QuickNPC.Abilities.askDescription(
                        combatant, characterSheet, existing, data)
                end)
        end

        function ConfiguredSpells.QuickNPC.Abilities.openWizard(combatant, characterSheet, existing)
            Dialogs.inputQuery("Habilidade do NPC", "Nome da habilidade:",
                tostring(existing and existing.abilityName or ""),
                function(value)
                    if value == nil then return end
                    local name = ConfiguredSpells.trimText(value)
                    if name == "" then
                        showMessage("Informe o nome da habilidade.")
                        return
                    end
                    ConfiguredSpells.QuickNPC.Abilities.chooseType(
                        combatant, characterSheet, existing, {abilityName=name})
                end)
        end

        function ConfiguredSpells.QuickNPC.Abilities.choiceData(characterSheet)
            local abilities = ConfiguredSpells.QuickNPC.Abilities.nodes(characterSheet)
            local labels = {}
            for i = 1, #abilities do
                labels[i] = tostring(abilities[i].abilityName or "Habilidade") .. " [" ..
                            tostring(abilities[i].actionType or "Livre") .. "]"
            end
            return abilities, labels
        end

        function ConfiguredSpells.QuickNPC.Abilities.add()
            ConfiguredSpells.QuickNPC.Abilities.ensureSelected(
                function(combatant, character, characterSheet)
                    ConfiguredSpells.QuickNPC.Abilities.openWizard(
                        combatant, characterSheet, nil)
                end)
        end

        function ConfiguredSpells.QuickNPC.Abilities.view(ability)
            showMessage(tostring(ability.abilityName or "Habilidade") .. " [" ..
                        tostring(ability.actionType or "Livre") .. "]\nCusto: " ..
                        tostring(ability.pmCost or 0) .. " PM\nRolagem: " ..
                        tostring(ability.rollFormula or "nenhuma") .. "\n\n" ..
                        tostring(ability.description or "Sem descricao."))
        end

        function ConfiguredSpells.QuickNPC.Abilities.use(combatant, character, characterSheet, ability)
            local spent, totalCost, remainingPM = ConfiguredSpells.spendPM(
                combatant, character, characterSheet, tonumber(ability.pmCost) or 0)
            if not spent then return end
            local abilityName = tostring(ability.abilityName or "Habilidade")
            postChat((combatant.name or "NPC") .. " usa " .. abilityName .. " [" ..
                     tostring(ability.actionType or "Livre") .. "] — " ..
                     tostring(ability.description or "Sem descricao.") .. " (" ..
                     tostring(totalCost) .. " PM; " .. tostring(remainingPM) .. " restante(s)).")
            local formula = tostring(ability.rollFormula or "0")
            if formula ~= "" and formula ~= "0" then
                room.chat:rolarDados(formula, "[T20 Combate] " .. abilityName .. " - " ..
                                     (combatant.name or "NPC"))
            end
            sheet.lastCapture = "Habilidade usada: " .. abilityName
        end

        function ConfiguredSpells.QuickNPC.Abilities.chooseToViewOrUse()
            ConfiguredSpells.QuickNPC.Abilities.ensureSelected(
                function(combatant, character, characterSheet)
                    local abilities, labels =
                        ConfiguredSpells.QuickNPC.Abilities.choiceData(characterSheet)
                    if #abilities == 0 then
                        showMessage("Nenhuma habilidade cadastrada.")
                        return
                    end
                    Dialogs.choose("Habilidades do NPC", labels,
                        function(selected, selectedIndex)
                            local ability = abilities[selectedIndex]
                            if not selected or ability == nil then return end
                            Dialogs.choose(ability.abilityName or "Habilidade",
                                {"Ver descricao", "Usar e enviar ao chat"},
                                function(actionSelected, actionIndex)
                                    if not actionSelected then return end
                                    if actionIndex == 1 then
                                        ConfiguredSpells.QuickNPC.Abilities.view(ability)
                                    else
                                        ConfiguredSpells.QuickNPC.Abilities.use(
                                            combatant, character, characterSheet, ability)
                                    end
                                end)
                        end)
                end)
        end

        function ConfiguredSpells.QuickNPC.Abilities.chooseToEdit()
            ConfiguredSpells.QuickNPC.Abilities.ensureSelected(
                function(combatant, character, characterSheet)
                    local abilities, labels =
                        ConfiguredSpells.QuickNPC.Abilities.choiceData(characterSheet)
                    if #abilities == 0 then
                        showMessage("Nenhuma habilidade cadastrada para editar.")
                        return
                    end
                    Dialogs.choose("Editar habilidade", labels,
                        function(selected, selectedIndex)
                            if not selected or abilities[selectedIndex] == nil then return end
                            ConfiguredSpells.QuickNPC.Abilities.openWizard(
                                combatant, characterSheet, abilities[selectedIndex])
                        end)
                end)
        end

        function ConfiguredSpells.QuickNPC.Abilities.chooseToRemove()
            ConfiguredSpells.QuickNPC.Abilities.ensureSelected(
                function(combatant, character, characterSheet)
                    local abilities, labels =
                        ConfiguredSpells.QuickNPC.Abilities.choiceData(characterSheet)
                    if #abilities == 0 then
                        showMessage("Nenhuma habilidade cadastrada para remover.")
                        return
                    end
                    Dialogs.choose("Remover habilidade", labels,
                        function(selected, selectedIndex)
                            local ability = abilities[selectedIndex]
                            if not selected or ability == nil then return end
                            local name = ability.abilityName or "Habilidade"
                            Dialogs.choose("Confirmar remocao", {"Remover " .. name, "Cancelar"},
                                function(confirmSelected, confirmIndex)
                                    if not confirmSelected or confirmIndex ~= 1 then return end
                                    NDB.deleteNode(ability)
                                    ConfiguredSpells.QuickNPC.Abilities.syncSummary(
                                        combatant, characterSheet)
                                    sheet.lastCapture = "Habilidade removida: " .. name
                                end)
                        end)
                end)
        end
        local function captureAttackAutomation(message)
            if not isLocalGM() then return false end
            if message == nil or message.player == nil then return false end
            local content = tostring(message.content or "")
            local lower = string.lower(content)
            if string.find(lower, "[t20 combate]", 1, true) ~= nil then return false end

            if message.type == "standard" then
                if string.find(lower, "golpe de mestre", 1, true) ~= nil or
                   string.find(lower, "conjura", 1, true) ~= nil and
                   string.find(lower, "perfeita", 1, true) ~= nil then
                    return beginPendingAttack(message, true)
                end
                return false
            end
            if message.type ~= "dice" or message.roll == nil then return false end

            local heading = contentHeading(content)
            if string.find(heading, "dano", 1, true) ~= nil or
               string.find(heading, "crítico", 1, true) ~= nil or
               string.find(heading, "critico", 1, true) ~= nil then
                if ConfiguredSpells.BestOfTwo.consumeSuppressedDamage ~= nil and
                   ConfiguredSpells.BestOfTwo.consumeSuppressedDamage(message) then
                    return true
                end
                if resolvePendingDamage(message) then return true end
                return resolvePreparedAreaDamage(message)
            end
            if string.find(heading, "ataque", 1, true) ~= nil then
                if ConfiguredSpells.BestOfTwo.captureArmedAttack ~= nil and
                   ConfiguredSpells.BestOfTwo.captureArmedAttack(message) then
                    return true
                end
                local magicAttacker = findAttackerForPlayer(message.player)
                local magicMode = magicAttacker and tostring(magicAttacker.areaMode or "") or ""
                if magicAttacker ~= nil and magicAttacker.areaArmed == true and
                   (magicMode == "save_half" or magicMode == "save_none") then
                    local attackerId = tostring(ensureCombatantId(magicAttacker))
                    sheet.lastCapture = "Ataque da magia recebido; aguardando o Dano automatico da ficha"
                    setTimeout(function()
                        local waiting = findCombatantById(attackerId)
                        if waiting ~= nil and waiting.areaArmed == true then
                            sheet.lastCapture = "O dano nao foi rolado: edite o ataque e preencha o campo Dano"
                        end
                    end, 5000)
                    return true
                end
                return beginPendingAttack(message, false)
            end
            return false
        end
        local function captureInitiative(message)
            if not isLocalGM() then return end
            if message == nil then return end
            if message.room ~= nil and tonumber(message.room.codigoInterno) ~=
               tonumber(room.codigoInterno) then return end

            captureAttackAutomation(message)
            local content = string.lower(tostring(message.content or ""))

            if message.type == "standard" then
                local requestedId = string.match(content, "t20c_end:([%w%-]+)")
                if requestedId ~= nil and
                   requestedId == string.lower(tostring(sheet.currentCombatantId or "")) then
                    local currentCombatant = nil
                    local nodes = getCombatants()
                    for i = 1, #nodes do
                        if string.lower(tostring(ensureCombatantId(nodes[i]))) == requestedId then
                            currentCombatant = nodes[i]
                            break
                        end
                    end

                    local player = message.player
                    if currentCombatant ~= nil and player ~= nil then
                        local character = room:findBibliotecaItem(tonumber(currentCombatant.characterCode))
                        local mainCode = tonumber(player.personagemPrincipal)
                        local isOwner = character ~= nil and character.dono == player
                        local isMain = mainCode ~= nil and mainCode >= 0 and
                                       tonumber(currentCombatant.characterCode) == mainCode
                        if isOwner or isMain then
                            advanceTurn()
                        end
                    end
                end
                return
            end

            if message.type ~= "dice" or message.roll == nil then return end
            if string.find(content, "iniciativa", 1, true) == nil then return end

            local requestedCodeText, requestedId =
                string.match(content, "t20c_init:(%d+):([%w%-]+)")
            local requestedCode = tonumber(requestedCodeText)
            if requestedCode ~= nil then
                local player = message.player
                if player == nil then return end
                local character = room:findBibliotecaItem(requestedCode)
                if character == nil or character.tipo ~= "personagem" or
                   character.dataType ~= FIB_DATA_TYPE then return end

                local ownerLogin = character.dono and character.dono.login or nil
                local senderLogin = player.login
                local senderMain = tonumber(player.personagemPrincipal)
                local senderIsGM = player.isMestre == true
                local isOwner = character.dono == player or
                                (ownerLogin ~= nil and tostring(ownerLogin) ~= "" and
                                 tostring(ownerLogin) == tostring(senderLogin or ""))
                local isMain = senderMain ~= nil and senderMain >= 0 and
                               senderMain == requestedCode
                if not senderIsGM and not isOwner and not isMain then return end

                local combatant = nil
                if requestedId ~= nil and requestedId ~= "none" then
                    combatant = findCombatantById(requestedId)
                    if combatant ~= nil and
                       tonumber(combatant.characterCode) ~= requestedCode then
                        combatant = nil
                    end
                end
                if combatant == nil then combatant = addCombatant(character, "player") end
                if combatant == nil then return end

                combatant.initiative = tonumber(message.roll.resultado) or 0
                openCharacterSheet(character, function(characterSheet)
                    updateCombatantFromSheet(combatant, character, characterSheet)
                    combatant.initiativeMod = tonumber(characterSheet.totalInic) or 0
                    self.rclCombatants:sort()
                end)
                sheet.lastCapture = "Capturada: " ..
                                    (character.nome or player.nick or "Personagem") ..
                                    " = " .. tostring(combatant.initiative)
                self.rclCombatants:sort()
                return
            end

            if string.find(content, "[t20 combate]", 1, true) ~= nil then return end

            local player = message.player
            if player == nil or tonumber(player.personagemPrincipal) == nil or
               tonumber(player.personagemPrincipal) < 0 then return end
            local character = room:findBibliotecaItem(tonumber(player.personagemPrincipal))
            if character == nil or character.tipo ~= "personagem" or
               character.dataType ~= FIB_DATA_TYPE then return end

            local combatant = addCombatant(character, "player")
            if combatant == nil then return end
            combatant.initiative = tonumber(message.roll.resultado) or 0
            openCharacterSheet(character, function(characterSheet)
                updateCombatantFromSheet(combatant, character, characterSheet)
                combatant.initiativeMod = tonumber(characterSheet.totalInic) or 0
                self.rclCombatants:sort()
            end)
            sheet.lastCapture = "Capturada: " .. (character.nome or player.nick or "Personagem") ..
                                " = " .. tostring(combatant.initiative)
            self.rclCombatants:sort()
        end        function ConfiguredSpells.InitiativeSync.schedule()
            if ConfiguredSpells.InitiativeSync.pending == true then return end
            ConfiguredSpells.InitiativeSync.pending = true
            setTimeout(function()
                ConfiguredSpells.InitiativeSync.pending = false
                if self.rclCombatants ~= nil then self.rclCombatants:sort() end
            end, 1)
        end

        function ConfiguredSpells.InitiativeSync.install()
            if ConfiguredSpells.InitiativeSync.observer ~= nil then
                ConfiguredSpells.InitiativeSync.observer.enabled = false
                ConfiguredSpells.InitiativeSync.observer = nil
            end
            if sheet == nil then return end
            local observer = NDB.newObserver(sheet)
            if observer == nil then return end
            observer.onDeepChanged = function(node, attribute)
                if attribute == "initiative" or attribute == "initiativeMod" or
                   attribute == "name" or attribute == "instanceIndex" then
                    ConfiguredSpells.InitiativeSync.schedule()
                end
            end
            observer.onDeepChildAdded = function(node)
                ConfiguredSpells.InitiativeSync.schedule()
            end
            observer.onDeepChildRemoved = function(node)
                ConfiguredSpells.InitiativeSync.schedule()
            end
            ConfiguredSpells.InitiativeSync.observer = observer
            ConfiguredSpells.InitiativeSync.schedule()
        end

        function ConfiguredSpells.InitiativeSync.shutdown()
            if ConfiguredSpells.InitiativeSync.observer ~= nil then
                ConfiguredSpells.InitiativeSync.observer.enabled = false
                ConfiguredSpells.InitiativeSync.observer = nil
            end
            ConfiguredSpells.InitiativeSync.pending = false
        end
        function ConfiguredSpells.PanelResize.clamp(value)
            local formHeight = tonumber(self.height) or 720
            local maximum = math.max(180, formHeight - 430)
            return math.max(120, math.min(maximum, tonumber(value) or 360))
        end

        function ConfiguredSpells.PanelResize.apply(value, persist)
            if self.detailScope == nil then return end
            local height = ConfiguredSpells.PanelResize.clamp(value)
            self.detailScope.height = height
            if persist == true and sheet ~= nil then
                sheet.detailPanelHeight = height
            end
        end

        function ConfiguredSpells.PanelResize.begin(event)
            if event ~= nil and event.button ~= nil and event.button ~= "left" then return end
            ConfiguredSpells.PanelResize.active = true
            ConfiguredSpells.PanelResize.startHeight = tonumber(self.detailScope.height) or 360
            ConfiguredSpells.PanelResize.startY = (tonumber(self.combatSplitter.top) or 0) +
                                                   (tonumber(event and event.y) or 0)
            if self.resizeOverlay ~= nil then self.resizeOverlay.visible = true end
        end

        function ConfiguredSpells.PanelResize.move(event)
            if ConfiguredSpells.PanelResize.active ~= true then return end
            local currentY = tonumber(event and event.y) or
                             ConfiguredSpells.PanelResize.startY or 0
            local targetHeight = (ConfiguredSpells.PanelResize.startHeight or 360) +
                                 currentY - (ConfiguredSpells.PanelResize.startY or currentY)
            ConfiguredSpells.PanelResize.apply(targetHeight, false)
        end

        function ConfiguredSpells.PanelResize.finish()
            if ConfiguredSpells.PanelResize.active ~= true then
                if self.resizeOverlay ~= nil then self.resizeOverlay.visible = false end
                return
            end
            ConfiguredSpells.PanelResize.active = false
            if self.resizeOverlay ~= nil then self.resizeOverlay.visible = false end
            ConfiguredSpells.PanelResize.apply(self.detailScope.height, true)
        end

        function ConfiguredSpells.PanelResize.toggle()
            local current = tonumber(self.detailScope and self.detailScope.height) or 360
            if current > 260 then
                ConfiguredSpells.PanelResize.apply(160, true)
            else
                ConfiguredSpells.PanelResize.apply(360, true)
            end
        end

        function ConfiguredSpells.PanelResize.restore()
            local saved = sheet ~= nil and tonumber(sheet.detailPanelHeight) or nil
            ConfiguredSpells.PanelResize.apply(saved or 360, false)
        end

        function ConfiguredSpells.MaximumDamage.fromFormula(value)
            local text = tostring(value or "")
            local formula = string.match(text, "^(.-)%s*=") or text
            formula = string.gsub(formula, "%s+", "")
            if formula == "" then return nil end
            local first = string.sub(formula, 1, 1)
            if first ~= "+" and first ~= "-" then formula = "+" .. formula end

            local total = 0
            local foundDice = false
            local index = 1
            while index <= string.len(formula) do
                local sign = string.sub(formula, index, index)
                if sign ~= "+" and sign ~= "-" then return nil end
                local nextPlus = string.find(formula, "+", index + 1, true)
                local nextMinus = string.find(formula, "-", index + 1, true)
                local nextIndex = string.len(formula) + 1
                if nextPlus ~= nil and nextPlus < nextIndex then nextIndex = nextPlus end
                if nextMinus ~= nil and nextMinus < nextIndex then nextIndex = nextMinus end
                local term = string.sub(formula, index + 1, nextIndex - 1)
                if term == "" then return nil end

                local countText, sidesText =
                    string.match(term, "^(%d*)[dD](%d+)$")
                local termValue = nil
                if sidesText ~= nil then
                    local count = tonumber(countText)
                    if count == nil then count = 1 end
                    termValue = count * (tonumber(sidesText) or 0)
                    foundDice = true
                else
                    termValue = tonumber(term)
                end
                if termValue == nil then return nil end
                if sign == "-" then total = total - termValue
                else total = total + termValue end
                index = nextIndex
            end
            if not foundDice then return nil end
            return math.max(0, total)
        end

        function ConfiguredSpells.MaximumDamage.fromRoll(roll)
            if roll == nil then return nil end
            local total = tonumber(roll.resultado)
            local foundDice = false
            if total ~= nil and roll.ops ~= nil then
                for i = 1, #roll.ops do
                    local op = roll.ops[i]
                    local face = op and tonumber(op.face) or nil
                    if op ~= nil and op.tipo == "dado" and face ~= nil and
                       op.resultados ~= nil then
                        for j = 1, #op.resultados do
                            local rolled = tonumber(op.resultados[j])
                            if rolled ~= nil then
                                total = total + face - rolled
                                foundDice = true
                            end
                        end
                    end
                end
            end
            if foundDice then return math.max(0, total) end
            return ConfiguredSpells.MaximumDamage.fromFormula(roll.asString)
        end

        function ConfiguredSpells.MaximumDamage.findArmedAttacker(player)
            if player == nil then return nil end
            local playerLogin = tostring(player.login or "")
            local localLogin = room and room.meuJogador and
                               tostring(room.meuJogador.login or "") or ""
            local isMessageGM = player.isMestre == true or
                (isLocalGM() and playerLogin ~= "" and playerLogin == localLogin)
            local function isCandidate(combatant)
                return combatant ~= nil and combatant.maximumDamageArmed == true and
                       hasCombatantTargets(combatant)
            end
            if isMessageGM and isCandidate(selectedCombatant) then
                return selectedCombatant
            end

            local mainCode = tonumber(player.personagemPrincipal)
            local chosen = nil
            local chosenAt = -1
            local nodes = getCombatants()
            for i = 1, #nodes do
                local combatant = nodes[i]
                if isCandidate(combatant) then
                    local allowed = isMessageGM
                    if not allowed and mainCode ~= nil and mainCode >= 0 and
                       tonumber(combatant.characterCode) == mainCode then
                        allowed = true
                    end
                    if not allowed then
                        local character = room:findBibliotecaItem(
                            tonumber(combatant.characterCode))
                        local ownerLogin = character and character.dono and
                                           tostring(character.dono.login or "") or ""
                        allowed = ownerLogin ~= "" and ownerLogin == playerLogin
                    end
                    if allowed then
                        local armedAt = tonumber(combatant.maximumDamageArmedAt) or 0
                        if chosen == nil or armedAt >= chosenAt then
                            chosen = combatant
                            chosenAt = armedAt
                        end
                    end
                end
            end
            return chosen
        end

        function ConfiguredSpells.MaximumDamage.arm(attacker, armed)
            if not isLocalGM() or attacker == nil then return false end
            local enabled = armed == true
            if enabled and #getCombatantTargets(attacker) == 0 then
                postChat(tostring(attacker.name or "Combatente") ..
                         " tentou preparar dano maximo, mas nao possui alvos marcados.")
                return false
            end
            attacker.maximumDamageArmed = enabled
            attacker.maximumDamageArmedAt = enabled and System.getTickCount() or nil
            if enabled then
                sheet.lastCapture = "Dano maximo preparado para " ..
                                    tostring(attacker.name or "Combatente") ..
                                    "; agora role o ataque na ficha"
                postChat(tostring(attacker.name or "Combatente") ..
                         " preparou DANO MAXIMO para o proximo ataque ou magia.")
            else
                sheet.lastCapture = "Dano maximo cancelado para " ..
                                    tostring(attacker.name or "Combatente")
            end
            return true
        end

        function ConfiguredSpells.MaximumDamage.request(attacker, armed)
            if isLocalGM() then
                ConfiguredSpells.MaximumDamage.arm(attacker, armed)
                return
            end
            NDB.broadcastMessage(sheet, "t20c_target_request", {
                attackerId=tostring(ensureCombatantId(attacker)),
                action="maximum_damage_arm",
                armed=armed == true
            })
            sheet.lastCapture = armed == true and
                "Preparacao de dano maximo enviada ao mestre; role o ataque na ficha" or
                "Cancelamento de dano maximo enviado ao mestre"
        end

        function ConfiguredSpells.MaximumDamage.start()
            local attacker = selectedCombatant
            if attacker == nil then
                showMessage("Selecione primeiro quem causara o dano.")
                return
            end
            if not ConfiguredSpells.canManageCombatant(attacker) then
                showMessage("Voce so pode usar dano maximo com um personagem que controla.")
                return
            end
            local armed = attacker.maximumDamageArmed ~= true
            if armed and #getCombatantTargets(attacker) == 0 then
                showMessage("Marque ao menos um alvo antes de preparar o dano maximo.")
                return
            end
            ConfiguredSpells.MaximumDamage.request(attacker, armed)
            if armed then
                showMessage("Dano maximo preparado. Role o ataque ou a magia pela ficha. " ..
                            "Todos os dados de dano serao usados no valor maximo uma vez.")
            else
                showMessage("Dano maximo cancelado.")
            end
        end

        function ConfiguredSpells.BestOfTwo.formula(bonus)
            bonus = tonumber(bonus) or 0
            local bonusText = string.format("%.0f", math.abs(bonus))
            if bonus < 0 then return "1d20 - " .. bonusText end
            return "1d20 + " .. bonusText
        end

        function ConfiguredSpells.BestOfTwo.parseCritical(value)
            local text = string.lower(tostring(value or ""))
            local margin = tonumber(string.match(text, "(%d%d)")) or 20
            local multiplier = tonumber(string.match(text, "x%s*(%d+)")) or 2
            margin = math.max(2, math.min(20, margin))
            multiplier = math.max(2, math.min(10, multiplier))
            return margin, multiplier
        end

        function ConfiguredSpells.BestOfTwo.criticalDamageFormula(formula, multiplier)
            formula = tostring(formula or "0")
            multiplier = tonumber(multiplier) or 2
            local replaced = false
            local result = string.gsub(formula, "(%d+)%s*[dD]%s*(%d+)",
                function(count, sides)
                    if replaced then return count .. "d" .. sides end
                    replaced = true
                    return tostring((tonumber(count) or 0) * multiplier) .. "d" .. sides
                end, 1)
            return result
        end

        function ConfiguredSpells.BestOfTwo.attackData(combatant, characterSheet, attackIndex)
            local attacks = childNodes(characterSheet, "listaDeAtaques")
            local index = math.floor(tonumber(attackIndex) or 0)
            local node = attacks[index]
            if node == nil then return nil end
            local rawBonus = tostring(node.bonusAtaque or "0")
            local bonus = tonumber(rawBonus) or tonumber(string.match(rawBonus, "[-+]?%d+")) or 0
            if combatant ~= nil and combatant.isIndependent == true then
                bonus = bonus + (tonumber(combatant.attackPenalty) or 0) +
                                (tonumber(combatant.attackBuff) or 0)
            end
            local name = ConfiguredSpells.trimText(node.nomeAtaque)
            if name == "" then name = "Ataque " .. tostring(index) end
            local margin, multiplier =
                ConfiguredSpells.BestOfTwo.parseCritical(node.criticoAtaque)
            return {
                index=index,
                name=name,
                bonus=bonus,
                damage=tostring(node.danoAtaque or ""),
                margin=margin,
                multiplier=multiplier
            }
        end

        function ConfiguredSpells.BestOfTwo.choiceData(combatant, characterSheet)
            local attacks = childNodes(characterSheet, "listaDeAtaques")
            local result = {}
            local labels = {}
            for i = 1, #attacks do
                local data = ConfiguredSpells.BestOfTwo.attackData(combatant, characterSheet, i)
                if data ~= nil then
                    result[#result + 1] = data
                    local bonusText = data.bonus >= 0 and ("+" .. tostring(data.bonus)) or
                                      tostring(data.bonus)
                    labels[#labels + 1] = data.name .. " (" .. bonusText ..
                        "; crit " .. tostring(data.margin) .. "/x" ..
                        tostring(data.multiplier) .. ")"
                end
            end
            return result, labels
        end

        function ConfiguredSpells.BestOfTwo.attackDataByName(combatant, characterSheet,
                                                              attackName)
            local attacks = childNodes(characterSheet, "listaDeAtaques")
            local wanted = normalizeAttackName(attackName)
            local partial = nil
            for i = 1, #attacks do
                local data = ConfiguredSpells.BestOfTwo.attackData(
                    combatant, characterSheet, i)
                if data ~= nil then
                    local candidate = normalizeAttackName(data.name)
                    if candidate == wanted then return data end
                    if wanted ~= "" and candidate ~= "" and
                       (string.find(wanted, candidate, 1, true) ~= nil or
                        string.find(candidate, wanted, 1, true) ~= nil) then
                        if partial ~= nil then partial = false else partial = data end
                    end
                end
            end
            if partial ~= false and partial ~= nil then return partial end
            if #attacks == 1 then
                return ConfiguredSpells.BestOfTwo.attackData(
                    combatant, characterSheet, 1)
            end
            return nil
        end

        function ConfiguredSpells.BestOfTwo.findArmedAttacker(player)
            if player == nil then return nil end
            local isMessageGM = player.isMestre == true
            local function isCandidate(combatant)
                return combatant ~= nil and combatant.bestOfTwoArmed == true and
                       hasCombatantTargets(combatant)
            end
            if isMessageGM and isCandidate(selectedCombatant) then
                return selectedCombatant
            end

            local mainCode = tonumber(player.personagemPrincipal)
            local playerLogin = tostring(player.login or "")
            local chosen = nil
            local chosenAt = -1
            local nodes = getCombatants()
            for i = 1, #nodes do
                local combatant = nodes[i]
                if isCandidate(combatant) then
                    local allowed = isMessageGM
                    if not allowed and mainCode ~= nil and mainCode >= 0 and
                       tonumber(combatant.characterCode) == mainCode then
                        allowed = true
                    end
                    if not allowed then
                        local character = room:findBibliotecaItem(
                            tonumber(combatant.characterCode))
                        local ownerLogin = character and character.dono and
                                           tostring(character.dono.login or "") or ""
                        allowed = ownerLogin ~= "" and ownerLogin == playerLogin
                    end
                    if allowed then
                        local armedAt = tonumber(combatant.bestOfTwoArmedAt) or 0
                        if chosen == nil or armedAt >= chosenAt then
                            chosen = combatant
                            chosenAt = armedAt
                        end
                    end
                end
            end
            return chosen
        end

        function ConfiguredSpells.BestOfTwo.arm(attacker, armed)
            if not isLocalGM() or attacker == nil then return false end
            local enabled = armed == true
            if enabled and #getCombatantTargets(attacker) == 0 then
                postChat(tostring(attacker.name or "Combatente") ..
                         " tentou preparar melhor de 2d20, mas nao possui alvos marcados.")
                return false
            end
            attacker.bestOfTwoArmed = enabled
            attacker.bestOfTwoArmedAt = enabled and System.getTickCount() or nil
            if enabled then
                sheet.lastCapture = "Melhor de 2d20 preparado para " ..
                                    tostring(attacker.name or "Combatente") ..
                                    "; agora role o ataque na ficha"
                postChat(tostring(attacker.name or "Combatente") ..
                         " preparou melhor de 2d20 para o proximo ataque da ficha.")
            else
                sheet.lastCapture = "Melhor de 2d20 cancelado para " ..
                                    tostring(attacker.name or "Combatente")
            end
            return true
        end

        function ConfiguredSpells.BestOfTwo.captureArmedAttack(message)
            if not isLocalGM() or message == nil or message.player == nil or
               message.roll == nil then return false end
            local attacker = ConfiguredSpells.BestOfTwo.findArmedAttacker(message.player)
            if attacker == nil or tostring(attacker.areaMode or "defense") ~= "defense" then
                return false
            end

            local firstNatural = firstNaturalD20(message.roll)
            if firstNatural == nil then return false end
            local character = room:findBibliotecaItem(tonumber(attacker.characterCode))
            if character == nil then
                ConfiguredSpells.BestOfTwo.arm(attacker, false)
                postChat("Nao foi possivel abrir a ficha de " ..
                         tostring(attacker.name or "Combatente") .. ".")
                return true
            end

            local attackName = attackNameFromContent(message.content)
            local key = playerMessageKey(message.player)
            local maximumDamage = attacker.maximumDamageArmed == true
            if maximumDamage then
                attacker.maximumDamageArmed = false
                attacker.maximumDamageArmedAt = nil
            end
            attacker.bestOfTwoArmed = false
            attacker.bestOfTwoArmedAt = nil
            if key ~= nil and key ~= "" then
                ConfiguredSpells.BestOfTwo.suppressedDamage[key] = {
                    attackName=attackName,
                    startedAt=System.getTickCount()
                }
            end

            local rawTotal = tonumber(message.roll.resultado) or firstNatural
            local effectiveBonus = rawTotal - firstNatural
            if attacker.isIndependent == true then
                effectiveBonus = effectiveBonus +
                    (tonumber(attacker.attackPenalty) or 0) +
                    (tonumber(attacker.attackBuff) or 0)
            end
            local attackerId = tostring(ensureCombatantId(attacker))
            openCharacterSheet(character, function(characterSheet)
                local currentAttacker = findCombatantById(attackerId)
                if currentAttacker == nil then return end
                syncConditionEffects(currentAttacker, character, characterSheet)
                updateCombatantFromSheet(currentAttacker, character, characterSheet)
                local attack = ConfiguredSpells.BestOfTwo.attackDataByName(
                    currentAttacker, characterSheet, attackName)
                if attack == nil then
                    if key ~= nil then ConfiguredSpells.BestOfTwo.suppressedDamage[key] = nil end
                    postChat("Nao foi possivel identificar o ataque " .. attackName ..
                             " na ficha de " ..
                             tostring(currentAttacker.name or "Combatente") .. ".")
                    sheet.lastCapture = "Melhor de 2d20 cancelado: ataque nao identificado"
                    return
                end
                attack.bonus = effectiveBonus
                attack.maximumDamage = maximumDamage
                room.chat:rolarDados(ConfiguredSpells.BestOfTwo.formula(effectiveBonus),
                    "[T20 Combate] Melhor de 2d20 (dado extra) - " .. attack.name ..
                    " - " .. tostring(currentAttacker.name or "Combatente"),
                    function(secondRoll)
                        local secondTotal = tonumber(secondRoll.resultado) or 0
                        local secondNatural = ConfiguredSpells.naturalD20(secondRoll) or
                                              (secondTotal - effectiveBonus)
                        local total = math.max(firstNatural, secondNatural) + effectiveBonus
                        ConfiguredSpells.BestOfTwo.resolveDamage(
                            currentAttacker, attack, firstNatural, secondNatural, total)
                    end)
            end)
            sheet.lastCapture = "Primeiro d20 recebido de " .. attackName ..
                                "; rolando somente o dado extra"
            return true
        end

        function ConfiguredSpells.BestOfTwo.consumeSuppressedDamage(message)
            local key = message and playerMessageKey(message.player) or nil
            local pending = key and ConfiguredSpells.BestOfTwo.suppressedDamage[key] or nil
            if pending == nil then return false end
            local elapsed = System.getTickCount() - (tonumber(pending.startedAt) or 0)
            if elapsed < 0 or elapsed > 20000 then
                ConfiguredSpells.BestOfTwo.suppressedDamage[key] = nil
                return false
            end
            local damageName = damageNameFromContent(message.content)
            if normalizeAttackName(pending.attackName) ~= normalizeAttackName(damageName) then
                return false
            end
            ConfiguredSpells.BestOfTwo.suppressedDamage[key] = nil
            sheet.lastCapture = "Dano original de " .. damageName ..
                                " ignorado; usando o resultado do melhor de 2d20"
            return true
        end

        function ConfiguredSpells.BestOfTwo.resolveDamage(attacker, attack, firstNatural,
                                                           secondNatural, total)
            local useMaximumDamage = attack.maximumDamage == true or
                                     attacker.maximumDamageArmed == true
            if attacker.maximumDamageArmed == true then
                attacker.maximumDamageArmed = false
                attacker.maximumDamageArmedAt = nil
            end
            local targets = getCombatantTargets(attacker)
            local hitTargets = {}
            local criticalThreat = math.max(firstNatural, secondNatural) >= attack.margin
            local chosenNatural = math.max(firstNatural, secondNatural)
            for i = 1, #targets do
                local target = targets[i]
                local defense = tonumber(target.effectiveDefense)
                if defense == nil then
                    postChat("A Defesa de " .. tostring(target.name or "alvo") ..
                             " nao esta disponivel; alvo ignorado.")
                else
                    local hit = chosenNatural ~= 1 and
                                (chosenNatural == 20 or total >= defense)
                    local comparison = "dados " .. tostring(firstNatural) .. " e " ..
                        tostring(secondNatural) .. "; melhor " .. tostring(chosenNatural) ..
                        "; total " .. tostring(total) .. " vs Defesa " .. tostring(defense)
                    if hit then
                        hitTargets[#hitTargets + 1] = {
                            combatant=target,
                            comparison=comparison,
                            critical=criticalThreat
                        }
                    else
                        local reason = criticalThreat and
                            "AMEACA DE CRITICO, mas nao superou a Defesa; ERRO" or "ERRO"
                        postChat(tostring(attacker.name or "Combatente") .. " atacou " ..
                                 tostring(target.name or "Combatente") .. " com " ..
                                 attack.name .. " (" .. comparison .. "): " .. reason ..
                                 ". Nenhum dano aplicado.")
                    end
                end
            end
            if #hitTargets == 0 then
                sheet.lastCapture = "Melhor de 2d20: nenhum alvo atingido"
                return
            end

            local valid, baseFormula = ConfiguredSpells.validDamageFormula(attack.damage)
            if not valid then
                postChat("O ataque " .. attack.name ..
                         " acertou, mas o campo Dano da ficha nao possui uma formula valida.")
                sheet.lastCapture = "Preencha o Dano de " .. attack.name .. " na ficha"
                return
            end
            local damageFormula = criticalThreat and
                ConfiguredSpells.BestOfTwo.criticalDamageFormula(
                    baseFormula, attack.multiplier) or baseFormula
            room.chat:rolarDados(damageFormula,
                "[T20 Combate] Dano " .. (criticalThreat and "critico" or "normal") ..
                " - " .. attack.name .. " - " .. tostring(attacker.name or "Combatente"),
                function(damageRoll)
                    local rolledDamage = tonumber(damageRoll.resultado) or 0
                    local originalRolledDamage = rolledDamage
                    local maximumValue = nil
                    if useMaximumDamage and ConfiguredSpells.MaximumDamage.fromRoll ~= nil then
                        maximumValue = ConfiguredSpells.MaximumDamage.fromRoll(damageRoll)
                        if maximumValue ~= nil then
                            rolledDamage = maximumValue
                            postChat("DANO MAXIMO de " ..
                                     tostring(attacker.name or "Combatente") .. ": " ..
                                     tostring(originalRolledDamage) .. " substituido por " ..
                                     tostring(rolledDamage) .. " em " .. attack.name .. ".")
                        else
                            postChat("DANO MAXIMO nao conseguiu ler os dados de " ..
                                     attack.name .. "; o dano rolado foi mantido.")
                        end
                    end
                    local damageBuff = tonumber(attacker.damageBuff) or 0
                    local damage = math.max(0, rolledDamage + damageBuff)
                    local buffNote = damageBuff ~= 0 and
                        ("; buff de Dano " .. signedNumber(damageBuff)) or ""
                    local maximumDamageNote = maximumValue ~= nil and "; DANO MAXIMO" or ""
                    for i = 1, #hitTargets do
                        local info = hitTargets[i]
                        local target = info.combatant
                        local character = room:findBibliotecaItem(tonumber(target.characterCode))
                        if character ~= nil then
                            openCharacterSheet(character, function(characterSheet)
                                local remaining = applyDamage(target, character, characterSheet,
                                                              damage, attack.name, true)
                                local status = info.critical and "CRITICO" or "ACERTO"
                                local autoNote = chosenNatural == 20 and
                                                 "; 20 natural, acerto automatico" or ""
                                local suffix = remaining and
                                               ("; PV restante " .. tostring(remaining)) or ""
                                postChat(tostring(attacker.name or "Combatente") .. " atacou " ..
                                         tostring(target.name or "Combatente") .. " com " ..
                                         attack.name .. " (" .. info.comparison .. autoNote ..
                                         "): " .. status .. ", " .. tostring(damage) ..
                                         " de dano aplicado" .. buffNote .. maximumDamageNote .. suffix .. ".")
                            end)
                        end
                    end
                    sheet.lastCapture = "Melhor de 2d20 resolvido: " .. attack.name ..
                                        " contra " .. tostring(#hitTargets) .. " alvo(s)"
                end)
        end

        function ConfiguredSpells.BestOfTwo.resolve(attacker, attackIndex)
            if not isLocalGM() or attacker == nil or room == nil or room.chat == nil then return end
            local targets = getCombatantTargets(attacker)
            if #targets == 0 then
                postChat(tostring(attacker.name or "Combatente") ..
                         " tentou atacar com melhor de 2d20, mas nao possui alvos marcados.")
                return
            end
            local character = room:findBibliotecaItem(tonumber(attacker.characterCode))
            if character == nil then return end
            openCharacterSheet(character, function(characterSheet)
                syncConditionEffects(attacker, character, characterSheet)
                updateCombatantFromSheet(attacker, character, characterSheet)
                local attack = ConfiguredSpells.BestOfTwo.attackData(
                    attacker, characterSheet, attackIndex)
                if attack == nil then
                    postChat("O ataque selecionado nao existe mais na ficha de " ..
                             tostring(attacker.name or "Combatente") .. ".")
                    return
                end
                room.chat:rolarDados(ConfiguredSpells.BestOfTwo.formula(attack.bonus),
                    "[T20 Combate] Melhor de 2d20 (dado 1) - " .. attack.name ..
                    " - " .. tostring(attacker.name or "Combatente"),
                    function(firstRoll)
                        local firstTotal = tonumber(firstRoll.resultado) or 0
                        local firstNatural = ConfiguredSpells.naturalD20(firstRoll) or
                                             (firstTotal - attack.bonus)
                        room.chat:rolarDados(ConfiguredSpells.BestOfTwo.formula(attack.bonus),
                            "[T20 Combate] Melhor de 2d20 (dado 2) - " .. attack.name ..
                            " - " .. tostring(attacker.name or "Combatente"),
                            function(secondRoll)
                                local secondTotal = tonumber(secondRoll.resultado) or 0
                                local secondNatural = ConfiguredSpells.naturalD20(secondRoll) or
                                                      (secondTotal - attack.bonus)
                                local total = math.max(firstNatural, secondNatural) + attack.bonus
                                ConfiguredSpells.BestOfTwo.resolveDamage(
                                    attacker, attack, firstNatural, secondNatural, total)
                            end)
                    end)
            end)
        end

        function ConfiguredSpells.BestOfTwo.request(attacker, armed)
            if isLocalGM() then
                ConfiguredSpells.BestOfTwo.arm(attacker, armed)
                return
            end
            NDB.broadcastMessage(sheet, "t20c_target_request", {
                attackerId=tostring(ensureCombatantId(attacker)),
                action="best_of_two_arm",
                armed=armed == true
            })
            sheet.lastCapture = armed == true and
                "Preparacao de melhor de 2d20 enviada ao mestre; role o ataque na ficha" or
                "Cancelamento de melhor de 2d20 enviado ao mestre"
        end

        function ConfiguredSpells.BestOfTwo.start()
            local attacker = selectedCombatant
            if attacker == nil then
                showMessage("Selecione primeiro quem fara o ataque.")
                return
            end
            if not ConfiguredSpells.canManageCombatant(attacker) then
                showMessage("Voce so pode atacar com um personagem que controla.")
                return
            end
            local armed = attacker.bestOfTwoArmed ~= true
            if armed and #getCombatantTargets(attacker) == 0 then
                showMessage("Marque ao menos um alvo antes de atacar.")
                return
            end
            ConfiguredSpells.BestOfTwo.request(attacker, armed)
            if armed then
                showMessage("Melhor de 2d20 preparado. Agora clique no dado do ataque na ficha. " ..
                            "O modo sera usado uma vez e desligado automaticamente.")
            else
                showMessage("Melhor de 2d20 cancelado.")
            end
        end
        function ConfiguredSpells.Opposed.formula(bonus)
            bonus = tonumber(bonus) or 0
            local bonusText = string.format("%.0f", math.abs(bonus))
            if bonus < 0 then return "1d20 - " .. bonusText end
            return "1d20 + " .. bonusText
        end

        function ConfiguredSpells.Opposed.bonusText(bonus)
            bonus = tonumber(bonus) or 0
            if bonus >= 0 then return "+" .. tostring(bonus) end
            return tostring(bonus)
        end

        function ConfiguredSpells.Opposed.attackChoices(combatant, characterSheet)
            local result = {}
            local labels = {}
            local adjustment = 0
            if combatant ~= nil and combatant.isIndependent == true then
                adjustment = (tonumber(combatant.attackPenalty) or 0) +
                             (tonumber(combatant.attackBuff) or 0)
            end
            local attacks = childNodes(characterSheet, "listaDeAtaques")
            for i = 1, #attacks do
                local rawBonus = tostring(attacks[i].bonusAtaque or "0")
                local bonus = tonumber(rawBonus) or
                              tonumber(string.match(rawBonus, "[-+]?%d+")) or 0
                bonus = bonus + adjustment
                local name = ConfiguredSpells.trimText(attacks[i].nomeAtaque)
                if name == "" then name = "Ataque " .. tostring(i) end
                result[#result + 1] = {name=name, bonus=bonus}
                labels[#labels + 1] = name .. " (" ..
                    ConfiguredSpells.Opposed.bonusText(bonus) .. ")"
            end
            return result, labels
        end

        function ConfiguredSpells.Opposed.chooseAttack(combatant, title, callback)
            local character = room and
                room:findBibliotecaItem(tonumber(combatant and combatant.characterCode)) or nil
            if character == nil then
                showMessage("Nao foi possivel abrir a ficha de " ..
                            tostring(combatant and combatant.name or "combatente") .. ".")
                return
            end
            openCharacterSheet(character, function(characterSheet)
                updateCombatantFromSheet(combatant, character, characterSheet)
                local attacks, labels =
                    ConfiguredSpells.Opposed.attackChoices(combatant, characterSheet)
                if #attacks == 0 then
                    showMessage(tostring(combatant.name or "Este combatente") ..
                                " nao possui ataques cadastrados na ficha.")
                    return
                end
                if #attacks == 1 then
                    callback(attacks[1])
                    return
                end
                Dialogs.choose(title, labels, function(selected, selectedIndex)
                    if not selected or attacks[selectedIndex] == nil then return end
                    callback(attacks[selectedIndex])
                end)
            end)
        end

        function ConfiguredSpells.Opposed.rollPair(testName, attacker, target,
                                                   attackerBonus, targetBonus,
                                                   attackerLabel, targetLabel, attempt)
            if room == nil or room.chat == nil then return end
            attempt = tonumber(attempt) or 1
            local suffix = attempt > 1 and
                (" - desempate " .. tostring(attempt - 1)) or ""
            room.chat:rolarDados(ConfiguredSpells.Opposed.formula(attackerBonus),
                "[T20 Combate] " .. testName .. " - " ..
                tostring(attacker.name or "Combatente") .. " [" ..
                tostring(attackerLabel or "Teste") .. "]" .. suffix,
                function(attackerRoll)
                    room.chat:rolarDados(ConfiguredSpells.Opposed.formula(targetBonus),
                        "[T20 Combate] " .. testName .. " - " ..
                        tostring(target.name or "Combatente") .. " [" ..
                        tostring(targetLabel or "Teste") .. "]" .. suffix,
                        function(targetRoll)
                            local attackerTotal = tonumber(attackerRoll.resultado) or 0
                            local targetTotal = tonumber(targetRoll.resultado) or 0
                            local winner = nil
                            local tieReason = ""
                            if attackerTotal > targetTotal then winner = attacker
                            elseif targetTotal > attackerTotal then winner = target
                            elseif attackerBonus > targetBonus then
                                winner = attacker
                                tieReason = " (empate no total; maior bonus)"
                            elseif targetBonus > attackerBonus then
                                winner = target
                                tieReason = " (empate no total; maior bonus)"
                            else
                                postChat(testName .. ": " ..
                                    tostring(attacker.name or "Combatente") .. " " ..
                                    tostring(attackerTotal) .. " x " .. tostring(targetTotal) .. " " ..
                                    tostring(target.name or "Combatente") ..
                                    "; total e bonus empatados, rolando novamente.")
                                setTimeout(function()
                                    ConfiguredSpells.Opposed.rollPair(testName, attacker, target,
                                        attackerBonus, targetBonus, attackerLabel, targetLabel,
                                        attempt + 1)
                                end, 100)
                                return
                            end
                            local resultText = testName .. ": " ..
                                tostring(attacker.name or "Combatente") .. " " ..
                                tostring(attackerTotal) .. " x " .. tostring(targetTotal) .. " " ..
                                tostring(target.name or "Combatente") .. " - " ..
                                tostring(winner.name or "Combatente") .. " venceu" .. tieReason .. "."
                            postChat(resultText)
                            sheet.lastCapture = resultText
                        end)
                end)
        end

        function ConfiguredSpells.Opposed.resolve(attacker, target, mode)
            if attacker == nil or target == nil or attacker == target then return end
            if mode == "attack" then
                ConfiguredSpells.Opposed.chooseAttack(attacker,
                    "Ataque de " .. tostring(attacker.name or "combatente"),
                    function(attackerAttack)
                        ConfiguredSpells.Opposed.chooseAttack(target,
                            "Ataque de " .. tostring(target.name or "adversario"),
                            function(targetAttack)
                                ConfiguredSpells.Opposed.rollPair("Ataque x Ataque",
                                    attacker, target, attackerAttack.bonus, targetAttack.bonus,
                                    attackerAttack.name, targetAttack.name, 1)
                            end)
                    end)
                return
            end

            Dialogs.inputQuery("Teste oposto", "Nome do teste:", "Teste livre",
                function(testValue)
                    if testValue == nil then return end
                    local testName = ConfiguredSpells.trimText(testValue)
                    if testName == "" then testName = "Teste livre" end
                    Dialogs.inputQuery("Bonus de " .. tostring(attacker.name or "combatente"),
                        "Informe o bonus total, sem o d20:", "0",
                        function(attackerValue)
                            if attackerValue == nil then return end
                            local attackerBonus = tonumber(attackerValue)
                            if attackerBonus == nil or math.abs(attackerBonus) > 1000 then
                                showMessage("Informe um bonus numerico valido, como 5 ou -2.")
                                return
                            end
                            Dialogs.inputQuery("Bonus de " ..
                                tostring(target.name or "adversario"),
                                "Informe o bonus total, sem o d20:", "0",
                                function(targetValue)
                                    if targetValue == nil then return end
                                    local targetBonus = tonumber(targetValue)
                                    if targetBonus == nil or math.abs(targetBonus) > 1000 then
                                        showMessage("Informe um bonus numerico valido, como 5 ou -2.")
                                        return
                                    end
                                    ConfiguredSpells.Opposed.rollPair(testName, attacker, target,
                                        attackerBonus, targetBonus, "Bonus " ..
                                        ConfiguredSpells.Opposed.bonusText(attackerBonus),
                                        "Bonus " .. ConfiguredSpells.Opposed.bonusText(targetBonus), 1)
                                end)
                        end)
                end)
        end

        function ConfiguredSpells.Opposed.request(attacker, target, mode)
            if isLocalGM() then
                ConfiguredSpells.Opposed.resolve(attacker, target, mode)
                return
            end
            NDB.broadcastMessage(sheet, "t20c_target_request", {
                attackerId=tostring(ensureCombatantId(attacker)),
                targetId=tostring(ensureCombatantId(target)),
                action="opposed_check", opposedMode=mode
            })
            sheet.lastCapture = "Teste oposto enviado ao mestre: " ..
                                tostring(attacker.name or "Combatente") .. " x " ..
                                tostring(target.name or "Combatente")
        end

        function ConfiguredSpells.Opposed.chooseMode(attacker, target)
            Dialogs.choose("Teste oposto: " .. tostring(attacker.name or "Combatente") ..
                           " x " .. tostring(target.name or "Adversario"),
                {"Ataque x Ataque (usa as fichas)",
                 "Teste livre (bonus informados)", "Cancelar"},
                function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex == 1 then
                        ConfiguredSpells.Opposed.request(attacker, target, "attack")
                    elseif selectedIndex == 2 then
                        ConfiguredSpells.Opposed.request(attacker, target, "free")
                    end
                end)
        end

        function ConfiguredSpells.Opposed.start()
            local attacker = selectedCombatant
            if attacker == nil then
                showMessage("Selecione primeiro o combatente que fara o teste.")
                return
            end
            if not ConfiguredSpells.canManageCombatant(attacker) then
                showMessage("Voce so pode iniciar testes com um personagem que controla.")
                return
            end
            local targets = getCombatantTargets(attacker)
            if #targets == 0 then
                showMessage("Marque ao menos um alvo para o combatente selecionado.")
                return
            end
            if #targets == 1 then
                ConfiguredSpells.Opposed.chooseMode(attacker, targets[1])
                return
            end
            local names = {}
            for i = 1, #targets do names[i] = targets[i].name or "Combatente" end
            Dialogs.choose("Adversario do teste oposto", names,
                function(selected, selectedIndex)
                    if not selected or targets[selectedIndex] == nil then return end
                    ConfiguredSpells.Opposed.chooseMode(attacker, targets[selectedIndex])
                end)
        end

        function ConfiguredSpells.UIMenus.addCombatant()
            if not requireGM() then return end
            Dialogs.choose("Adicionar combatente",
                {"NPC da biblioteca", "Ficha rapida de NPC", "Jogador", "Cancelar"},
                function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex == 1 then chooseCharacterToAdd("npc")
                    elseif selectedIndex == 2 then ConfiguredSpells.QuickNPC.start()
                    elseif selectedIndex == 3 then chooseCharacterToAdd("player") end
                end)
        end

        function ConfiguredSpells.UIMenus.initiative()
            Dialogs.choose("Iniciativa e ordem",
                {"Rolar selecionado", "Rolar todas (mestre)", "Valor manual (mestre)",
                 "Remover selecionado (mestre)", "Remover todos do tracker (mestre)", "Cancelar"},
                function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex == 1 then rollSelectedInitiative()
                    elseif selectedIndex == 2 then rollAllInitiatives()
                    elseif selectedIndex == 3 then setManualInitiative()
                    elseif selectedIndex == 4 then removeSelectedCombatant()
                    elseif selectedIndex == 5 then clearInitiative() end
                end)
        end

        function ConfiguredSpells.UIMenus.more()
            Dialogs.choose("Mais acoes",
                {"Iniciativa e ordem", "Teste oposto", "Preparar melhor de 2d20",
                 "Preparar dano maximo", "Remover todos do tracker (mestre)",
                 "Sincronizar tokens (mestre)", "Areas de magia",
                 "Reiniciar combate (mestre)", "Fim da cena (mestre)", "Cancelar"},
                function(selected, selectedIndex)
                    if not selected then return end
                    if selectedIndex == 1 then ConfiguredSpells.UIMenus.initiative()
                    elseif selectedIndex == 2 then ConfiguredSpells.Opposed.start()
                    elseif selectedIndex == 3 then ConfiguredSpells.BestOfTwo.start()
                    elseif selectedIndex == 4 then ConfiguredSpells.MaximumDamage.start()
                    elseif selectedIndex == 5 then clearInitiative()
                    elseif selectedIndex == 6 then syncAllTokenBars()
                    elseif selectedIndex == 7 then SpellAreas.manageSpellAreas()
                    elseif selectedIndex == 8 then restartCombat()
                    elseif selectedIndex == 9 then endScene() end
                end)
        end
        local function initialize()
            room = Firecast.getMesaDe(self)
            if room == nil then return end
            sheet.round = tonumber(sheet.round) or 1
            sheet.nextCombatantId = tonumber(sheet.nextCombatantId) or 0
            sheet.currentName = sheet.currentName or "Nenhum"
            sheet.lastCapture = sheet.lastCapture or "Aguardando rolagens de Iniciativa no chat"
            repairCombatants()
            ConfiguredSpells.InitiativeSync.install()
            registerSceneDragIntegration()
            if isLocalGM() then
                local auraCombatants = getCombatants()
                for i = 1, #auraCombatants do
                    auraCombatants[i].bestOfTwoArmed = false
                    auraCombatants[i].bestOfTwoArmedAt = nil
                    auraCombatants[i].maximumDamageArmed = false
                    auraCombatants[i].maximumDamageArmedAt = nil
                    if syncCombatantAuras ~= nil then syncCombatantAuras(auraCombatants[i]) end
                end
                clearAllTurnHighlights()
                refreshTurnHighlight(findCombatantById(sheet.currentCombatantId))
                setTimeout(function()
                    forEachRoomToken(function(token, scene)
                        if PlayerDown.resizeMarkerOnToken(token) then
                            pcall(function() scene:sendDelayedUpdates() end)
                        end
                    end)
                end, 500)
            end

            if chatReceiver ~= nil then chatReceiver:disable(); chatReceiver = nil end
            chatReceiver = Firecast.Messaging.newReceiver("ChatMessage", captureInitiative)
            if targetRequestListener ~= nil then
                pcall(function() targetRequestListener:destroy() end)
                targetRequestListener = nil
            end
            if isLocalGM() then
                targetRequestListener = NDB.newBroadcastListener(
                    sheet, "t20c_target_request", handleTargetRequest)
            end
        end

        local function shutdown()
            if chatReceiver ~= nil then chatReceiver:disable(); chatReceiver = nil end
            if targetRequestListener ~= nil then
                pcall(function() targetRequestListener:destroy() end)
                targetRequestListener = nil
            end
            pendingAttacks = {}
            ConfiguredSpells.BestOfTwo.suppressedDamage = {}
            npcRemovalPending = {}
            ConfiguredSpells.InitiativeSync.shutdown()
            clearAllTurnHighlights()
            if cancelTokenLink ~= nil then cancelTokenLink() end
            unregisterSceneDragIntegration()
            for key, entry in pairs(sheetObservers) do
                if entry.observer ~= nil then entry.observer.enabled = false end
            end
            sheetObservers = {}
            selectedCombatant = nil
            selectedCharacter = nil
            selectedCharacterSheet = nil
        end    ]]></script>

    <rectangle align="client" color="#171a22">
        <layout align="top" height="60" padding="{left=10,right=10,top=7,bottom=5}">
            <label align="top" height="25" text="T20 COMBATE" fontSize="19" fontStyle="bold"
                   fontColor="#f4b942" horzTextAlign="center"/>
            <layout align="client">
                <label align="left" width="58" text="Rodada:" fontSize="12" fontColor="#bfc7d5"/>
                <label align="left" width="38" field="round" fontSize="14" fontStyle="bold" fontColor="white"/>
                <label align="left" width="47" text="Turno:" fontSize="12" fontColor="#bfc7d5"/>
                <label align="client" field="currentName" fontSize="14" fontStyle="bold" fontColor="white"
                       textTrimming="character"/>
            </layout>
        </layout>

        <layout align="top" height="66" padding="{left=7,right=7,top=2,bottom=2}">
            <layout align="top" height="29">
                <button align="left" width="155" text="Minha iniciativa"
                        onClick="rollMyInitiative();"/>
                <button align="left" width="130" text="+ Combatente" margins="{left=4}"
                        onClick="ConfiguredSpells.UIMenus.addCombatant();"/>
                <button align="client" text="Mais acoes" margins="{left=4}"
                        onClick="ConfiguredSpells.UIMenus.more();"/>
            </layout>
            <layout align="top" height="29" margins="{top=4}">
                <button align="left" width="90" text="Voltar" onClick="previousTurn();"/>
                <button align="left" width="170" text="Encerrar meu turno" margins="{left=4}"
                        onClick="requestEndMyTurn();"/>
                <button align="client" text="Proximo" margins="{left=4}" onClick="nextTurn();"/>
            </layout>
        </layout>
        <layout align="top" height="22" padding="{left=9,right=9}">
            <label align="client" field="lastCapture" fontSize="11" fontColor="#8f9bad"
                   textTrimming="character"/>
        </layout>

        <dataScopeBox name="detailScope" align="top" height="360" visible="false"
                      padding="{left=8,right=8,top=4,bottom=6}">
            <scrollBox align="client">
            <rectangle align="top" height="508" color="#20242e" xradius="6" yradius="6"
                       padding="{left=10,right=10,top=7,bottom=7}">
                <label align="top" height="24" field="name" fontSize="16"
                       fontStyle="bold" fontColor="#f4b942" textTrimming="character"/>
                <layout align="top" height="30">
                    <label align="left" width="24" text="PV" fontSize="12" fontStyle="bold"
                           fontColor="#bfc7d5" vertTextAlign="center"/>
                    <label align="left" width="36" field="currentHP" fontSize="14" fontStyle="bold"
                           fontColor="white" horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="10" text="/" fontColor="#8f9bad"
                           horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="36" field="maxHP" fontSize="12" fontColor="#bfc7d5"
                           horzTextAlign="center" vertTextAlign="center"/>
                    <button align="left" width="34" text="-1" margins="{left=4}"
                            onClick="adjustSelectedHP(-1);"/>
                    <button align="left" width="34" text="-5" margins="{left=3}"
                            onClick="adjustSelectedHP(-5);"/>
                    <button align="left" width="34" text="+1" margins="{left=3}"
                            onClick="adjustSelectedHP(1);"/>
                    <button align="left" width="34" text="+5" margins="{left=3}"
                            onClick="adjustSelectedHP(5);"/>
                    <button align="client" text="Definir" margins="{left=4}" onClick="defineSelectedHP();"/>
                </layout>
                <layout align="top" height="30">
                    <label align="left" width="24" text="PM" fontSize="12" fontStyle="bold"
                           fontColor="#85d7ff" vertTextAlign="center"/>
                    <label align="left" width="36" field="currentPM" fontSize="14" fontStyle="bold"
                           fontColor="white" horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="10" text="/" fontColor="#8f9bad"
                           horzTextAlign="center" vertTextAlign="center"/>
                    <label align="left" width="36" field="maxPM" fontSize="12" fontColor="#bfc7d5"
                           horzTextAlign="center" vertTextAlign="center"/>
                    <button align="left" width="34" text="-1" margins="{left=4}"
                            onClick="ConfiguredSpells.adjustSelectedPM(-1);"/>
                    <button align="left" width="34" text="-5" margins="{left=3}"
                            onClick="ConfiguredSpells.adjustSelectedPM(-5);"/>
                    <button align="left" width="34" text="+1" margins="{left=3}"
                            onClick="ConfiguredSpells.adjustSelectedPM(1);"/>
                    <button align="left" width="34" text="+5" margins="{left=3}"
                            onClick="ConfiguredSpells.adjustSelectedPM(5);"/>
                    <button align="client" text="Definir" margins="{left=4}"
                            onClick="ConfiguredSpells.defineSelectedPM();"/>
                </layout>
                <label align="top" height="22" field="effectsText" fontSize="10"
                       fontColor="#8f9bad" textTrimming="character"/>
                <label align="top" height="18" text="Condicoes e efeitos"
                       fontSize="12" fontStyle="bold" fontColor="#bfc7d5"/>
                <label align="top" height="45" field="conditionsText"
                       fontSize="12" fontColor="white" wordWrap="true"/>
                <layout align="top" height="29" margins="{top=3}">
                    <button align="left" width="115" text="+ Condicao" onClick="chooseConditionToAdd();"/>
                    <button align="left" width="105" text="Remover" margins="{left=5}"
                            onClick="chooseConditionToRemove();"/>
                    <button align="client" text="Limpar todas" margins="{left=5}"
                            onClick="clearSelectedConditions();"/>
                </layout>
                <layout align="top" height="29" margins="{top=3}">
                    <button align="left" width="115" text="+ Buff/Debuff" onClick="chooseQuickBuffToAdd();"/>
                    <button align="left" width="110" text="Remover efeito" margins="{left=5}"
                            onClick="chooseQuickBuffToRemove();"/>
                    <button align="client" text="Limpar efeitos" margins="{left=5}"
                            onClick="clearSelectedBuffs();"/>
                </layout>
                <label align="top" height="20" field="tokenLinkText" fontSize="10"
                       fontColor="#8f9bad" textTrimming="character"/>
                <layout align="top" height="29" margins="{top=3}">
                    <button align="left" width="105" text="Vincular token" onClick="linkSelectedToken();"/>
                    <button align="left" width="82" text="Desvinc." margins="{left=5}"
                            onClick="unlinkSelectedToken();"/>
                    <button align="left" width="78" text="Barras" margins="{left=5}"
                            onClick="syncSelectedTokenBars();"/>
                    <button align="client" text="Auras" margins="{left=5}"
                            onClick="manageSelectedAuras();"/>
                </layout>
                <label align="top" height="34" field="targetText" fontSize="11" fontStyle="bold"
                       fontColor="#f4b942" wordWrap="true"/>
                <layout align="top" height="29" margins="{top=3}">
                    <button align="left" width="85" text="+ Alvos" onClick="markSelectedTarget();"/>
                    <button align="left" width="80" text="Finalizar" margins="{left=4}"
                            onClick="finishTargetSelection();"/>
                    <button align="left" width="80" text="Remover" margins="{left=4}"
                            onClick="chooseTargetToRemove();"/>
                    <button align="client" text="Limpar" margins="{left=4}"
                            onClick="clearSelectedTarget();"/>
                </layout>
                <label align="top" height="18" text="MAGIAS CONFIGURADAS" margins="{top=4}"
                       fontSize="11" fontStyle="bold" fontColor="#bfc7d5"/>
                <label name="lblSpellSummary" align="top" height="24" fontSize="10"
                       fontColor="#f4b942" textTrimming="character"/>
                <layout align="top" height="29" margins="{top=3}">
                    <button align="left" width="82" text="+ Magia" onClick="ConfiguredSpells.add();"/>
                    <button align="left" width="88" text="Usar magia" margins="{left=4}"
                            onClick="ConfiguredSpells.chooseToCast();"/>
                    <button align="left" width="72" text="Editar" margins="{left=4}"
                            onClick="ConfiguredSpells.chooseToEdit();"/>
                    <button align="client" text="Remover" margins="{left=4}"
                            onClick="ConfiguredSpells.chooseToRemove();"/>
                </layout>
                <label align="top" height="22" field="abilitySummary" margins="{top=3}"
                       fontSize="10" fontColor="#85d7ff" textTrimming="character"/>
                <layout align="client" margins="{top=3}">
                    <button align="left" width="88" text="+ Habilidade"
                            onClick="ConfiguredSpells.QuickNPC.Abilities.add();"/>
                    <button align="left" width="92" text="Ver/Usar" margins="{left=4}"
                            onClick="ConfiguredSpells.QuickNPC.Abilities.chooseToViewOrUse();"/>
                    <button align="left" width="70" text="Editar" margins="{left=4}"
                            onClick="ConfiguredSpells.QuickNPC.Abilities.chooseToEdit();"/>
                    <button align="client" text="Remover" margins="{left=4}"
                            onClick="ConfiguredSpells.QuickNPC.Abilities.chooseToRemove();"/>
                </layout>
            </rectangle>
            </scrollBox>
        </dataScopeBox>
        <rectangle name="combatSplitter" align="top" height="13" color="#11141b"
                   hitTest="true" cursor="hSplit"
                   hint="Arraste para ajustar o espaco da iniciativa; duplo clique alterna o tamanho">
            <label align="client" text="ARRASTE PARA AJUSTAR" fontSize="8"
                   fontColor="#667085" horzTextAlign="center" vertTextAlign="center"
                   hitTest="false"/>
            <event name="onMouseDown"><![CDATA[
                ConfiguredSpells.PanelResize.begin(event);
            ]]></event>
            <event name="onDblClick"><![CDATA[
                ConfiguredSpells.PanelResize.toggle();
            ]]></event>
        </rectangle>
        <layout align="top" height="22" padding="{left=9,right=9}">
            <label align="client" text="ORDEM DE INICIATIVA — ARRASTE PARA O MAPA" fontSize="10" fontStyle="bold"
                   fontColor="#bfc7d5" vertTextAlign="center"/>
        </layout>

        <recordList name="rclCombatants" field="combatants" templateForm="frmT20CombatantItem"
                    align="client" selectable="true" itemHeight="64" layout="vertical"
                    padding="{left=5,right=5,top=4,bottom=4}">
            <event name="onCompare"><![CDATA[
                local initA = tonumber(nodeA.initiative) or 0
                local initB = tonumber(nodeB.initiative) or 0
                if initA ~= initB then return initB - initA end
                local modA = tonumber(nodeA.initiativeMod) or 0
                local modB = tonumber(nodeB.initiativeMod) or 0
                if modA ~= modB then return modB - modA end
                return Utils.compareStringPtBr(nodeA.name or "", nodeB.name or "")
            ]]></event>
            <event name="onSelect"><![CDATA[
                selectedCombatant = self.rclCombatants.selectedNode
                selectedCharacter = nil
                selectedCharacterSheet = nil
                self.detailScope:setNodeObject(selectedCombatant)
                self.detailScope.visible = selectedCombatant ~= nil
                if self.lblSpellSummary ~= nil then
                    self.lblSpellSummary.text = selectedCombatant ~= nil and
                        "Carregando magias da ficha..." or ""
                end
                if selectedCombatant ~= nil and room ~= nil then
                    local combatant = selectedCombatant
                    local character = room:findBibliotecaItem(tonumber(combatant.characterCode))
                    if character ~= nil then
                        openCharacterSheet(character, function(characterSheet)
                            updateCombatantFromSheet(combatant, character, characterSheet)
                            if selectedCombatant ~= nil and
                               tostring(selectedCombatant.combatantId) == tostring(combatant.combatantId) then
                                selectedCharacter = character
                                selectedCharacterSheet = characterSheet
                            end
                        end)
                    end
                end
            ]]></event>
            <event name="onEndEnumeration"><![CDATA[
                if self.rclCombatants.selectedNode == nil and sheet ~= nil then
                    local nodes = getCombatants()
                    if #nodes > 0 then self.rclCombatants.selectedNode = nodes[1] end
                end
            ]]></event>
        </recordList>
        <rectangle name="resizeOverlay" align="none" left="0" top="0" width="430" height="720"
                   anchors="left top right bottom" visible="false" opacity="0.01"
                   color="#000000" hitTest="true" cursor="hSplit">
            <event name="onMouseMove"><![CDATA[
                ConfiguredSpells.PanelResize.move(event);
            ]]></event>
            <event name="onMouseUp"><![CDATA[
                ConfiguredSpells.PanelResize.move(event);
                ConfiguredSpells.PanelResize.finish();
            ]]></event>
            <event name="onMouseLeave"><![CDATA[
                ConfiguredSpells.PanelResize.finish();
            ]]></event>
        </rectangle>
    </rectangle>
    <event name="onNodeReady">
        initialize();
        ConfiguredSpells.PanelResize.restore();
    </event>
    <event name="onNodeUnready">
        shutdown();
    </event>
    <event name="onHide">
        if cancelTokenLink ~= nil then cancelTokenLink(); end;
    </event>
    <event name="onShow">
        if sheet ~= nil and chatReceiver == nil then initialize(); end;
        ConfiguredSpells.PanelResize.restore();
    </event>
    <event name="onResize">
        ConfiguredSpells.PanelResize.restore();
    </event>
</form>
